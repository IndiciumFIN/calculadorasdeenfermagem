{"identificador": "BR_FED_COFEN_PORT_2011_N_01010_CONSIDERANDO_001", "normativo": "BR_FED_COFEN_PORT_2011_N_01010", "tipo_dispositivo": "considerando", "localizador": "Considerando 1", "dispositivo_superior": null, "ordem": 3, "transcricao_literal": "CONSIDERANDO a Resolução COFEN nº. 242/2000, art. 13, inciso XXXIII e art. 22, inciso I;", "sha256_texto": "d5cd2a0df84cb21f985d932352a4f1acc31fe7b10f0e4d34e14385cda748fad4", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2011_N_01010_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2011_N_01010_CONSIDERANDO_002", "normativo": "BR_FED_COFEN_PORT_2011_N_01010", "tipo_dispositivo": "considerando", "localizador": "Considerando 2", "dispositivo_superior": null, "ordem": 4, "transcricao_literal": "CONSIDERANDO a praxe da Administração Pública Federal de suspender suas atividades por ocasião do fim de ano, notadamente o Poder Judiciário que adota o recesso forense;", "sha256_texto": "71bfe5d9745ddac46cfdd8ee30b6ae57524dfbf0588aa7dee55b53d78107ea22", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2011_N_01010_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2011_N_01010_CONSIDERANDO_003", "normativo": "BR_FED_COFEN_PORT_2011_N_01010", "tipo_dispositivo": "considerando", "localizador": "Considerando 3", "dispositivo_superior": null, "ordem": 5, "transcricao_literal": "CONSIDERANDO a deliberação da Diretoria que determinou a adoção do recesso de final de ano com a suspensão das atividades do Cofen, baixam as seguintes determinações:", "sha256_texto": "bc95a7ddd7a50e3d0d8de7683d9fcc8a7183e43bde87af9434579d8c33ecf222", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2011_N_01010_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2011_N_01010_ART_001", "normativo": "BR_FED_COFEN_PORT_2011_N_01010", "tipo_dispositivo": "artigo", "localizador": "Art. 1º", "dispositivo_superior": null, "ordem": 6, "transcricao_literal": "Art. 1º Suspender as atividades do Cofen durante o período de 19 de dezembro de 2011 a 02 de janeiro de 2012.", "sha256_texto": "24c35d7f836c3256166066171bc37217168868bd14ce05b7ef5e90ec139616f1", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2011_N_01010_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
