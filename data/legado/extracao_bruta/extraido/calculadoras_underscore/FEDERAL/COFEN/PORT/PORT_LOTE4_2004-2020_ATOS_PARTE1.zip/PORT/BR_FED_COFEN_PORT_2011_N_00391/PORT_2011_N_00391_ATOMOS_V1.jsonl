{"identificador": "BR_FED_COFEN_PORT_2011_N_00391_PARAGRAFO_TEXTO_001", "normativo": "BR_FED_COFEN_PORT_2011_N_00391", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": null, "ordem": 3, "transcricao_literal": "estatuídas no art. 22, inciso XV, do Regimento Interno do Cofen, aprovado pela Resolução nº.242/2000, e;", "sha256_texto": "ab121bba618ee7dc44f974532840972fca433a44cb03a17da74dc33e5f4ef9a3", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2011_N_00391_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2011_N_00391_CONSIDERANDO_001", "normativo": "BR_FED_COFEN_PORT_2011_N_00391", "tipo_dispositivo": "considerando", "localizador": "Considerando 1", "dispositivo_superior": null, "ordem": 4, "transcricao_literal": "CONSIDERANDO que a Lei n.º 7.498/1986, que trata sobre a regulamentação do exercício da Enfermagem, até então vigente, representa os anseios e a realidade da época da sua edição;", "sha256_texto": "4c41035a6d267304fc1da7c8272a3d3824d50416a2eb7ebdc2d693413138440c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2011_N_00391_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2011_N_00391_CONSIDERANDO_002", "normativo": "BR_FED_COFEN_PORT_2011_N_00391", "tipo_dispositivo": "considerando", "localizador": "Considerando 2", "dispositivo_superior": null, "ordem": 5, "transcricao_literal": "CONSIDERANDO que o momento atual clama por uma regulamentação que condiga com os anseios e necessidades do presente, com reflexos para o futuro;", "sha256_texto": "572fbf6aebc4c6af6eaf3871ce3c94a26ee5ea75d296eaffa139bf8efff0463e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2011_N_00391_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2011_N_00391_CONSIDERANDO_003", "normativo": "BR_FED_COFEN_PORT_2011_N_00391", "tipo_dispositivo": "considerando", "localizador": "Considerando 3", "dispositivo_superior": null, "ordem": 6, "transcricao_literal": "CONSIDERANDO que o meio hábil de regulamentação do exercício profissional da Enfermagem reclama estudos e providências necessárias, ouvidas as categorias que a compõe;", "sha256_texto": "52dd192f796af090d6fe2b8282624b45c629a72984b78f00a3e337d2ca6aec8a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2011_N_00391_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
