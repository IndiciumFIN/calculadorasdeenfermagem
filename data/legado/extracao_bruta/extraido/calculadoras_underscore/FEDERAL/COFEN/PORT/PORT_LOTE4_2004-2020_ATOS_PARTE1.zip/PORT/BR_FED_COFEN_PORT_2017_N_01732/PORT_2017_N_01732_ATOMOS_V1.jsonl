{"identificador": "BR_FED_COFEN_PORT_2017_N_01732_CONSIDERANDO_005", "normativo": "BR_FED_COFEN_PORT_2017_N_01732", "tipo_dispositivo": "considerando", "localizador": "Considerando 5", "dispositivo_superior": null, "ordem": 7, "transcricao_literal": "CONSIDERANDO a deliberação do Plenário do Cofen, em sua 493ª Reunião Ordinária, baixam as seguintes determinações:", "sha256_texto": "cd27151468e08f8f8d6ac0eed0f81dbabc0a6ed0749a2fcabeb19f1b37cbdc3f", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2017_N_01732_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "EQUIVALENTE_OCR", "similaridade": 99.1, "cobertura_vocabulario": 0.9, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
