{"identificador": "BR_FED_COFEN_PORT_2023_N_01674_ART_001", "normativo": "BR_FED_COFEN_PORT_2023_N_01674", "tipo_dispositivo": "artigo", "localizador": "Art. 1º", "dispositivo_superior": null, "ordem": 5, "transcricao_literal": "Art. 1º Estabelecer o recesso de final de ano dos empregados públicos e demais colaboradores do Conselho Federal de Enfermagem – Cofen, no período 26 de dezembro de 2023 a 5 de janeiro de 2024.", "sha256_texto": "1e2bb0eedfa5736377dba891d8ac97c9eb1eae27d0a977b20d0755333ccab449", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2023_N_01674_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PORT_2023_N_01674_ART_002", "normativo": "BR_FED_COFEN_PORT_2023_N_01674", "tipo_dispositivo": "artigo", "localizador": "Art. 2º", "dispositivo_superior": null, "ordem": 6, "transcricao_literal": "Art. 2º Determinar que o expediente, no dia 22 de dezembro de 2023, se encerre às 12h, sendo que os serviços considerados essenciais, assim como todas as chefias, ficarão em estado de sobreaviso para quaisquer eventualidades, no período vespertino.", "sha256_texto": "ddd14bd3dde6e9e0a83fc2871acdd8e51f8679c5858941ebba0ea1e73c84bcfa", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2023_N_01674_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PORT_2023_N_01674_ART_003", "normativo": "BR_FED_COFEN_PORT_2023_N_01674", "tipo_dispositivo": "artigo", "localizador": "Art. 3º", "dispositivo_superior": null, "ordem": 7, "transcricao_literal": "Art. 3º Determinar que todas as Chefias de Departamentos, Chefias de Divisões, Chefia da Secretaria-Geral e Assessores Comissionados fiquem disponíveis para atender quaisquer eventualidades, durante o período do recesso de 26 de dezembro a 5 de janeiro de 2024.", "sha256_texto": "bd2489eed1c9792b6ae6640169481981c52ed46476d0f35e9d996441df46c582", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2023_N_01674_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
