{"identificador": "BR_FED_COFEN_PORT_2015_N_01561_CONSIDERANDO_001", "normativo": "BR_FED_COFEN_PORT_2015_N_01561", "tipo_dispositivo": "considerando", "localizador": "Considerando 1", "dispositivo_superior": null, "ordem": 4, "transcricao_literal": "CONSIDERANDO os termos da Decisão Cofen nº 40/2015;", "sha256_texto": "8f76abe8c34904d3783ae332fbdd0eb6aedb6c229c3a54863ab22e2c4389ce1c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2015_N_01561_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2015_N_01561_CONSIDERANDO_002", "normativo": "BR_FED_COFEN_PORT_2015_N_01561", "tipo_dispositivo": "considerando", "localizador": "Considerando 2", "dispositivo_superior": null, "ordem": 5, "transcricao_literal": "CONSIDERANDO a deliberação da 471ª Reunião Ordinária do Plenário do Cofen, baixam as seguintes determinações:", "sha256_texto": "9f9574cca17a2329b71f248e2ca4def230457324d2886df879fee481c205dbef", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2015_N_01561_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2015_N_01561_ART_001", "normativo": "BR_FED_COFEN_PORT_2015_N_01561", "tipo_dispositivo": "artigo", "localizador": "Art. 1º", "dispositivo_superior": null, "ordem": 6, "transcricao_literal": "Art. 1º Estabelecer o recesso de final de ano dos servidores do Cofen no período de 21 de dezembro de 2015 a 04 de janeiro de 2016, devendo-se retornar ao trabalho no dia 05 de janeiro de 2016.", "sha256_texto": "bf221a3e05337e4a48d2b14d2feae83ec1392e7c934259956b509c069569aec7", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2015_N_01561_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2015_N_01561_ART_002", "normativo": "BR_FED_COFEN_PORT_2015_N_01561", "tipo_dispositivo": "artigo", "localizador": "Art. 2º", "dispositivo_superior": null, "ordem": 7, "transcricao_literal": "Art. 2º No período referido no artigo anterior, estarão suspensos todos os prazos relativos aos atos que eventualmente devam ser praticados nos processos em trâmite no âmbito do Cofen, sejam eles éticos disciplinares, administrativos, eleitorais ou quaisquer outros.", "sha256_texto": "df378d34f29ba079090a68e29e66a31f2cfca250157506738c6b9b32dd256902", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2015_N_01561_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
