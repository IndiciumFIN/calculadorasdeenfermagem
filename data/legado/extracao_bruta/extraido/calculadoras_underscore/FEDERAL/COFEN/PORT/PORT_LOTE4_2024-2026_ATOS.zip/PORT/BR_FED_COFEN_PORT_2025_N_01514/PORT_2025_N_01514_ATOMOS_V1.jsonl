{"identificador": "BR_FED_COFEN_PORT_2025_N_01514_CONSIDERANDO_002", "normativo": "BR_FED_COFEN_PORT_2025_N_01514", "tipo_dispositivo": "considerando", "localizador": "Considerando 2", "dispositivo_superior": "BR_FED_COFEN_PORT_2025_N_01514_SECAO_001", "ordem": 4, "transcricao_literal": "CONSIDERANDO a composição do Plenário do Cofen eleito para o período compreendido de 23 de abril de 2024 a 22 de abril de 2027, conforme Decisão Cofen nº 25 de 20 de fevereiro de 2024 (SEI nº 0287105);", "sha256_texto": "d8188ba8897b459af964ee9c94054b17fcddb228c7a5f859237bbc867885e21a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2025_N_01514_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PORT_2025_N_01514_CONSIDERANDO_003", "normativo": "BR_FED_COFEN_PORT_2025_N_01514", "tipo_dispositivo": "considerando", "localizador": "Considerando 3", "dispositivo_superior": "BR_FED_COFEN_PORT_2025_N_01514_SECAO_001", "ordem": 5, "transcricao_literal": "CONSIDERANDO que, nos termos do art. 21, XIV, do Regimento Interno do Cofen, compete ao Federal acompanhar o funcionamento dos Conselhos Regionais de Enfermagem, zelando pela sua manutenção, uniformidade de procedimentos, regularidade administrativa e financeira, adotando, quando necessário, providências convenientes a bem da sua eficiência, inclusive com a designação de Plenários;", "sha256_texto": "9254d139d02b5b17316c5655c0423c01392ca5deedd8c02cc0c5418c7997959f", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2025_N_01514_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
