{"identificador": "BR_FED_COFEN_PORT_2025_N_00036_ART_003", "normativo": "BR_FED_COFEN_PORT_2025_N_00036", "tipo_dispositivo": "artigo", "localizador": "Art. 3º", "dispositivo_superior": null, "ordem": 11, "transcricao_literal": "Art. 3º A concessão de Suprimento de Fundos será limitada ao valor de R$ 25.000,00 (vinte e cinco mil reais). Sendo que, a efetiva concessão ocorrerá apenas após a emissão e aprovação da Proposta de concessão.", "sha256_texto": "247f1fc8d4f31f72ed573cbe52ca92cf6a90f011a7700632dbb71bd7a335460d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2025_N_00036_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PORT_2025_N_00036_ART_004", "normativo": "BR_FED_COFEN_PORT_2025_N_00036", "tipo_dispositivo": "artigo", "localizador": "Art. 4º", "dispositivo_superior": null, "ordem": 12, "transcricao_literal": "Art. 4º O Suprimento de Fundos será concedido na modalidade de Cartão de Pagamento.", "sha256_texto": "acaf06204773faa198c59f4264eecd2cb5ee7cf401b3cf2eec2d48f82831f360", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2025_N_00036_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PORT_2025_N_00036_ART_004_PAR_UNICO", "normativo": "BR_FED_COFEN_PORT_2025_N_00036", "tipo_dispositivo": "paragrafo", "localizador": "Parágrafo único", "dispositivo_superior": "BR_FED_COFEN_PORT_2025_N_00036_ART_004", "ordem": 13, "transcricao_literal": "Parágrafo único. O período de aplicação será de até 30 (trinta) dias, prorrogável por igual período, desde que devidamente justificado e aprovado pelo Ordenador de Despesas, não podendo ultrapassar o término do exercício financeiro.", "sha256_texto": "0a25c27714af5252e76f3d389871489b59909fbc3b9062d0d387ca940527294d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2025_N_00036_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PORT_2025_N_00036_ART_005", "normativo": "BR_FED_COFEN_PORT_2025_N_00036", "tipo_dispositivo": "artigo", "localizador": "Art. 5º", "dispositivo_superior": null, "ordem": 14, "transcricao_literal": "Art. 5º Na Proposta de Concessão deverão ser indicadas pelo proponente as naturezas das despesas que pretende utilizar o Suprimento de Fundos, para que seja autorizada a realização dos respectivos subelementos de despesas.", "sha256_texto": "db574acd820f879e9d8f8fcef1abfd7d643bf75a036ee19f63427c1c6de06dbc", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2025_N_00036_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
