{"identificador": "BR_FED_COFEN_NAOATO_2010_SN_CARTA_ENVIADA_AOS_PARLAMENTARES_PARAGRAFO_TEXTO_001", "normativo": "BR_FED_COFEN_NAOATO_2010_SN_CARTA_ENVIADA_AOS_PARLAMENTARES", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_NAOATO_2010_SN_CARTA_ENVIADA_AOS_PARLAMENTARES_SECAO_001", "ordem": 2, "transcricao_literal": "EM NOSSO NOME E EM NOME DE 5.000 PROFISSIONAIS DE SAÚDE QUE ATUAM NA REDE SARAH DE HOSPITAIS DE REABILITAÇÃO, EM 6 UNIDADES DA FEDERAÇÃO, REALIZANDO MAIS DE UM MILHÃO E TREZENTOS MIL ATENDIMENTOS DE BRASILEIROS, TOTALIZANDO ACIMA DE DEZESSEIS MILHÕES E QUINHENTOS MIL PROCEDIMENTOS POR ANO, PROTESTAMOS VEEMENTEMENTE CONTRA O PROJETO DE LEI QUE VISA DEFINIR O ALCANCE DO ATO MÉDICO, ORA EM TRAMITAÇÃO NO SENADO FEDERAL.", "sha256_texto": "300dac7d7cf573863262e677ee6bf81870d4e5a0b9a937e97e7a2d3a5258e72a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2010_SN_CARTA_ENVIADA_AOS_PARLAMENTARES_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2010_SN_CARTA_ENVIADA_AOS_PARLAMENTARES_PARAGRAFO_TEXTO_002", "normativo": "BR_FED_COFEN_NAOATO_2010_SN_CARTA_ENVIADA_AOS_PARLAMENTARES", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_NAOATO_2010_SN_CARTA_ENVIADA_AOS_PARLAMENTARES_SECAO_001", "ordem": 3, "transcricao_literal": "A REDE SARAH, COMO OUTRAS INSTITUIÇÕES DE RENOME INTERNACIONAL, SE PROJETOU IMPLANTANDO DESDE OS SEUS PRIMÓRDIOS UMA ATUAÇÃO MULTIDISCIPLINAR, NA QUAL VÁRIOS PROFISSIONAIS DE VÁRIAS ÁREAS DO CONHECIMENTO SE DEDICAM À REABILITAÇÃO DE PESSOAS QUE FICARAM INCAPACITADAS.", "sha256_texto": "574989a66a0fb317cc135a62c15cab486f460eb00c715d35590a32bc755f2ba5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2010_SN_CARTA_ENVIADA_AOS_PARLAMENTARES_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2010_SN_CARTA_ENVIADA_AOS_PARLAMENTARES_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_NAOATO_2010_SN_CARTA_ENVIADA_AOS_PARLAMENTARES", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_NAOATO_2010_SN_CARTA_ENVIADA_AOS_PARLAMENTARES_SECAO_001", "ordem": 4, "transcricao_literal": "INTERDICIPLINARIEDADE IMPLICA EM CO-RESPONSABILIDADE E NA EM UMA VISÃO VERTICAL DA AÇÃO DE SAÚDE. A APROVAÇÃO DO PROJETO DE LEI DO ATO MÉDICO, COMO PROPOSTO, COLOCA O BRASIL NA IDADE MÉDIA, NA CONTRAMÃO DE TUDO O QUE ESTÁ SENDO FEITO NO MUNDO.", "sha256_texto": "5723a49668b8315f6c5d6cf2f70154888208b8bd5141e84b4f676574ff0afbb5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2010_SN_CARTA_ENVIADA_AOS_PARLAMENTARES_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2010_SN_CARTA_ENVIADA_AOS_PARLAMENTARES_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_NAOATO_2010_SN_CARTA_ENVIADA_AOS_PARLAMENTARES", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_NAOATO_2010_SN_CARTA_ENVIADA_AOS_PARLAMENTARES_SECAO_001", "ordem": 5, "transcricao_literal": "ALÉM DO MAIS QUEREMOS DECLARAR ENFATICAMENTE: É IMPRESCINDÍVEL A REJEIÇÃO PURA E SIMPLES DE TAL PROJETO E NÃO SUA “AMENIZAÇÃO”, COMO TEM SIDO FEITO EM RELATÓRIOS. ESTE PROJETO SIGNIFICA NA PRÁTICA A EXTINÇÃO DA POSSIBILIDADE DE QUALQUER PROGRESSO NÃO SÓ NA REABILITAÇÃO, MAS EM QUALQUER ÁREA DA SAÚDE.", "sha256_texto": "d8eb10c026a5a00b32dde7be6ea9fa600f7fab7659c3564f979d4c543813a806", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2010_SN_CARTA_ENVIADA_AOS_PARLAMENTARES_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
