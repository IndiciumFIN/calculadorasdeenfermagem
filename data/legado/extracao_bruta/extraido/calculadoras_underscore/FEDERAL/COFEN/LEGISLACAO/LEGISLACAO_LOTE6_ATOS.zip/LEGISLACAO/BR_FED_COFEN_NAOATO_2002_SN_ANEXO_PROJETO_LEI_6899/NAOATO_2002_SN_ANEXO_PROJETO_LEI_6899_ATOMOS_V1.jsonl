{"identificador": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_ART_001", "normativo": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899", "tipo_dispositivo": "artigo", "localizador": "Art. 1º", "dispositivo_superior": null, "ordem": 5, "transcricao_literal": "Art.1º Fica criado o Atestado de Saúde, para licenças e dispensas de atividades, inclusive para efeitos de ausência legal.", "sha256_texto": "19520fad4b847dfb7c3b57ef84f99475af951d4d5cad63c7232074908b9e6f79", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_ART_002", "normativo": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899", "tipo_dispositivo": "artigo", "localizador": "Art. 2º", "dispositivo_superior": null, "ordem": 6, "transcricao_literal": "Art.2º O Atestado de Saúde tem seu uso privativo pelos Profissionais de Saúde, com nível superior, de profissões regulamentadas em Lei, que possuam em suas respectivas Legislações, direito a atenderem em consultório, e ainda a prescreverem tratamentos terapêuticos, limitados às áreas de suas atuações profissionais, instituídas em Leis próprias.", "sha256_texto": "30e9e3b045aeadf8e79f9e7b1bb984403269be035d476ee48ff85d03b6e343ca", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_ART_003", "normativo": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899", "tipo_dispositivo": "artigo", "localizador": "Art. 3º", "dispositivo_superior": null, "ordem": 7, "transcricao_literal": "Art.3º Esta Lei entra em vigor na data de sua publicação.", "sha256_texto": "e0fb3757f25017dffef47e2c05a7ab5571e938c0c8b86b5f48c0e5f7a3afa275", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_SECAO_001", "normativo": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899", "tipo_dispositivo": "secao", "localizador": "JUSTIFICAÇÃO", "dispositivo_superior": null, "ordem": 8, "transcricao_literal": "JUSTIFICAÇÃO", "sha256_texto": "9524cf5b79c280aab7d146b31a07de9e2272789e3a3783765b683da8ce400eb3", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_SECAO_001", "ordem": 9, "transcricao_literal": "O dinamismo e a evolução das Profissões na Área de Saúde, não mais coaduna-se com conceitos arcaicos, de uma visão unilateral, onde os mesmos são somente as enfermidades. Muito pelo contrário, conforme regem os modernos conceitos, eles são múltiplos, dentre os quais inserem-se as doenças.", "sha256_texto": "d5bb61542a920a274ac7431a76599f5c3b9c04e8ca6e84b8e0b095a0e1c1d030", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_SECAO_001", "ordem": 10, "transcricao_literal": "A visão holística do ser humano, é imprescindível no século XXI, onde a própria Organização Mundial de saúde – OMS, conceitua saúde, como o completo bem estar bio-psíquico-social.", "sha256_texto": "cda984f1f0b2e2a983e5a43cd5670da2715d96b0305ebe0757923cc1734021f1", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_SECAO_001", "ordem": 11, "transcricao_literal": "Atualmente, para atingir-se o patamar da recuperação, não mais atua um único profissional, mas sim, uma equipe multiprofissional e interdisciplinar.", "sha256_texto": "12c4ca09ce1023b79c23e07b95cf136f9d09bd0871aab73e43c3c459f0bc805e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_SECAO_001", "ordem": 12, "transcricao_literal": "Leis decretadas e sancionadas pelo Congresso Nacional, ampliaram, por conta dessa visão holística, as Ações dos Profissionais de Saúde, com nível superior.", "sha256_texto": "ccfd0d3d1edfda20fd90b88cc452558bc7279ec9d1727e83070fe8e8fab44969", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_SECAO_001", "ordem": 13, "transcricao_literal": "Psicólogos, Fisioterapeutas, Enfermeiros, Fonoaudiólogos, Médicos e Nutricionistas, possuem suas ações bem delineadas e fixadas, em Leis que regulam os respectivos Exercícios Profissionais.", "sha256_texto": "ccac0912b3e7edb3cbe7b3d512bc3fcc2537b257f15a66b9297429cafaff3d63", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_SECAO_001", "ordem": 14, "transcricao_literal": "Podem, com base nas Legislações supracitadas, atender em consultórios, requerem exames laboratoriais, fazerem encaminhamentos, praticarem Terapias Alternativas, etc.", "sha256_texto": "697e70f7fec4339ccf6eb6fecc065ba9338338193b3889cf097d8250e229af4d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 7", "dispositivo_superior": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_SECAO_001", "ordem": 15, "transcricao_literal": "Nada mais justo, que um cliente que encontre-se sob cuidados desses Profissionais, possam apresentar no local que desempenha suas atividades, o atestado de saúde, que comprove o tratamento a que submete-se.", "sha256_texto": "e68ceef199d49b2cdf44c153275a5d12a8f37c8cc2c1793db7870f96c17d29d0", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 8", "dispositivo_superior": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_SECAO_001", "ordem": 16, "transcricao_literal": "Anexamos, como forma de subsidiar os Nobres Pares, as Leis nºs 6.965/81, 4.119/62, 7.498/86, 8.234/91, Decreto-Lei nº 938/69 e ainda os Decretos nºs 20.931/32, 94.406/87, 53.464/64 e 87.218/82.", "sha256_texto": "081b28ce172b68d1f2c60e2e80416c00c48866745ae075b58b4560adfa592c07", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 9", "dispositivo_superior": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_SECAO_001", "ordem": 17, "transcricao_literal": "Este é o projeto que submetemos, que pela Justiça do qual se reverte o mesmo, até mesmo por não haver Lei Federal sobre o tema, esperamos que seja aprovado.", "sha256_texto": "dc18eeca3dbd7ab7d43ca58f93ba82ad96b431ef4e0ab2bcc85fa86cfcb0acc0", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2002_SN_ANEXO_PROJETO_LEI_6899_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
