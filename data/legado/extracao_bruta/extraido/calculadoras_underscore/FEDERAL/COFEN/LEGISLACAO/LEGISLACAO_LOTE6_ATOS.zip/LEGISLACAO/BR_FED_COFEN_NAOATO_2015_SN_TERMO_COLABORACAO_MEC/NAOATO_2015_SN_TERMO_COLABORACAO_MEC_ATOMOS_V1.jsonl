{"identificador": "BR_FED_COFEN_NAOATO_2015_SN_TERMO_COLABORACAO_MEC_PARAGRAFO_TEXTO_013", "normativo": "BR_FED_COFEN_NAOATO_2015_SN_TERMO_COLABORACAO_MEC", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 7", "dispositivo_superior": "BR_FED_COFEN_NAOATO_2015_SN_TERMO_COLABORACAO_MEC_SECAO_002", "ordem": 15, "transcricao_literal": "Em consonância com o disposto no Art. 37 do Decreto nº 5.773/06, nos processos de Autorização, Reconhecimento e de Renovação de Reconhecimento de cursos da área de Enfermagem, o Conselho Federal de Enfermagem poderá elaborar relatório de manifestação técnica acerca das condições objetivas da oferta destes cursos a partir da análise dos projetos pedagógicos informados pelas respectivas IES no âmbito do Sistema e-MEC;", "sha256_texto": "8d0c5d8d9259340e4e7ee5b2fc2505a33c64c584df499688741f5ef24dc61677", "fonte_literal": "PDF_SITE_OCR", "arquivo_fonte": "NAOATO_2015_SN_TERMO_COLABORACAO_MEC_PDF_SITE.pdf", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "OCR_NAO_LITERAL_REVISAO_HUMANA_OBRIGATORIA", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2015_SN_TERMO_COLABORACAO_MEC_PARAGRAFO_TEXTO_014", "normativo": "BR_FED_COFEN_NAOATO_2015_SN_TERMO_COLABORACAO_MEC", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 8", "dispositivo_superior": "BR_FED_COFEN_NAOATO_2015_SN_TERMO_COLABORACAO_MEC_SECAO_002", "ordem": 16, "transcricao_literal": "O relatório de manifestação técnica terá formato eletrônico, definido pela SESu/MEC, e será parte integrante do processo regulatório de Autorização, Reconhecimento e de Renovação de Reconhecimento de cursos no âmbito do Sistema e-MEC;", "sha256_texto": "dd8673ead1bd41061285a81a4e5bb1e9626ce4d8877b64cd085957f2aa74f11c", "fonte_literal": "PDF_SITE_OCR", "arquivo_fonte": "NAOATO_2015_SN_TERMO_COLABORACAO_MEC_PDF_SITE.pdf", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "OCR_NAO_LITERAL_REVISAO_HUMANA_OBRIGATORIA", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2015_SN_TERMO_COLABORACAO_MEC_PARAGRAFO_TEXTO_015", "normativo": "BR_FED_COFEN_NAOATO_2015_SN_TERMO_COLABORACAO_MEC", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 9", "dispositivo_superior": "BR_FED_COFEN_NAOATO_2015_SN_TERMO_COLABORACAO_MEC_SECAO_002", "ordem": 17, "transcricao_literal": "O Conselho Federal de Enfermagem definirá uma comissão de especialistas nas áreas de sua responsabilidade, composta por profissionais a ele vinculados, para elaborar as referidas manifestações técnicas, bem como para estabelecer a interlocução com a SESu/MEC;", "sha256_texto": "a80e785cf807afe1198994c9eb74c59bd18755daecb230e8d851e216856d8b39", "fonte_literal": "PDF_SITE_OCR", "arquivo_fonte": "NAOATO_2015_SN_TERMO_COLABORACAO_MEC_PDF_SITE.pdf", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "OCR_NAO_LITERAL_REVISAO_HUMANA_OBRIGATORIA", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2015_SN_TERMO_COLABORACAO_MEC_PARAGRAFO_TEXTO_016", "normativo": "BR_FED_COFEN_NAOATO_2015_SN_TERMO_COLABORACAO_MEC", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 10", "dispositivo_superior": "BR_FED_COFEN_NAOATO_2015_SN_TERMO_COLABORACAO_MEC_SECAO_002", "ordem": 18, "transcricao_literal": "A SESu/MEC disponibilizará ao Conselho Federal de Enfermagem, no sistema e-MEC, o acesso aos projetos pedagógicos dos cursos em processo de Autorização, Reconhecimento e Renovação de Reconhecimento referentes às áreas sob sua responsabilidade;", "sha256_texto": "1095b4f178444768993d9ceb344ff6c62b99c9c609ceee0cee89e0d00a6f040d", "fonte_literal": "PDF_SITE_OCR", "arquivo_fonte": "NAOATO_2015_SN_TERMO_COLABORACAO_MEC_PDF_SITE.pdf", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "OCR_NAO_LITERAL_REVISAO_HUMANA_OBRIGATORIA", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2015_SN_TERMO_COLABORACAO_MEC_PARAGRAFO_TEXTO_017", "normativo": "BR_FED_COFEN_NAOATO_2015_SN_TERMO_COLABORACAO_MEC", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 11", "dispositivo_superior": "BR_FED_COFEN_NAOATO_2015_SN_TERMO_COLABORACAO_MEC_SECAO_002", "ordem": 19, "transcricao_literal": "A SESwMEC realizará, junto à comissão de especialistas do Conselho Federal de Enfermagem, processo de capacitação para a elaboração dos relatórios de manifestação técnica acerca das condições objetivas de oferta destes cursos;", "sha256_texto": "cf8caa2e15cfca8484b0c9de3779ef10757d7aa8e836c623c69333014010a4ca", "fonte_literal": "PDF_SITE_OCR", "arquivo_fonte": "NAOATO_2015_SN_TERMO_COLABORACAO_MEC_PDF_SITE.pdf", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "OCR_NAO_LITERAL_REVISAO_HUMANA_OBRIGATORIA", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2015_SN_TERMO_COLABORACAO_MEC_PARAGRAFO_TEXTO_018", "normativo": "BR_FED_COFEN_NAOATO_2015_SN_TERMO_COLABORACAO_MEC", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 12", "dispositivo_superior": "BR_FED_COFEN_NAOATO_2015_SN_TERMO_COLABORACAO_MEC_SECAO_002", "ordem": 20, "transcricao_literal": "A referida manifestação técnica do Conselho Federal de Enfermagem poderá servir de subsídio para a decisão da SESu/MEC acerca da Autorização, do Reconhecimento ou da Renovação do Reconhecimento do curso, em conjunto com a análise documental, com o relatório de avaliação elaborado pelo INEP na visita in loco dos especialistas e com a observância dos indicadores de qualidade da educação superior;", "sha256_texto": "72218fee737e21b331d51870c86b9b125a1cf15995c868b5f6b65e82a96699a6", "fonte_literal": "PDF_SITE_OCR", "arquivo_fonte": "NAOATO_2015_SN_TERMO_COLABORACAO_MEC_PDF_SITE.pdf", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "OCR_NAO_LITERAL_REVISAO_HUMANA_OBRIGATORIA", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2015_SN_TERMO_COLABORACAO_MEC_PARAGRAFO_TEXTO_019", "normativo": "BR_FED_COFEN_NAOATO_2015_SN_TERMO_COLABORACAO_MEC", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 13", "dispositivo_superior": "BR_FED_COFEN_NAOATO_2015_SN_TERMO_COLABORACAO_MEC_SECAO_002", "ordem": 21, "transcricao_literal": "Quando houver manifestação técnica do Conselho Federal de Enfermagem, a mesma deverá ser encaminhada à SESu/MEC em prazo condizente com os definidos no Art. 37 do Decreto nº 5.773/06, de forma a não obstaculizar a", "sha256_texto": "2030c6f4a5d0b0270384d5fa1be1d61378c1b4239b112ff024d4473f2f95ed87", "fonte_literal": "PDF_SITE_OCR", "arquivo_fonte": "NAOATO_2015_SN_TERMO_COLABORACAO_MEC_PDF_SITE.pdf", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "OCR_NAO_LITERAL_REVISAO_HUMANA_OBRIGATORIA", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2015_SN_TERMO_COLABORACAO_MEC_PARAGRAFO_TEXTO_020", "normativo": "BR_FED_COFEN_NAOATO_2015_SN_TERMO_COLABORACAO_MEC", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 14", "dispositivo_superior": "BR_FED_COFEN_NAOATO_2015_SN_TERMO_COLABORACAO_MEC_SECAO_002", "ordem": 22, "transcricao_literal": "tramitação normal dos processos no MEC;", "sha256_texto": "b69f7b92d8acd12b6f1da511a02f3323e34d1adb7a632f4ef9b573441b67f0c5", "fonte_literal": "PDF_SITE_OCR", "arquivo_fonte": "NAOATO_2015_SN_TERMO_COLABORACAO_MEC_PDF_SITE.pdf", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "OCR_NAO_LITERAL_REVISAO_HUMANA_OBRIGATORIA", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2015_SN_TERMO_COLABORACAO_MEC_ALINEA_001", "normativo": "BR_FED_COFEN_NAOATO_2015_SN_TERMO_COLABORACAO_MEC", "tipo_dispositivo": "alinea", "localizador": "Alínea h", "dispositivo_superior": "BR_FED_COFEN_NAOATO_2015_SN_TERMO_COLABORACAO_MEC_PARAGRAFO_TEXTO_020", "ordem": 23, "transcricao_literal": "h) O Conselho Federal de Enfermagem poderá encaminhar reflexões sobre as disposições das diretrizes curriculares, bem como sugestões de critérios e requisitos necessários ao aperfeiçoamento dos procedimentos de autorização de cursos da área de Enfermagem;", "sha256_texto": "e943c90ee9c189bfa188b0795805c5719dc1b511db3d24d979982dfca8c0f700", "fonte_literal": "PDF_SITE_OCR", "arquivo_fonte": "NAOATO_2015_SN_TERMO_COLABORACAO_MEC_PDF_SITE.pdf", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "OCR_NAO_LITERAL_REVISAO_HUMANA_OBRIGATORIA", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
