{"identificador": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_INFORME_PARLAMENTAR_ANEXO_001_NOTA_RODAPE_001", "normativo": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_INFORME_PARLAMENTAR", "tipo_dispositivo": "nota_rodape", "localizador": "Nota de rodapé 1", "dispositivo_superior": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_INFORME_PARLAMENTAR_ANEXO_001", "ordem": 8, "transcricao_literal": "* A matéria define ato médico e estabelece que as atividades de prevenção que envolvam procedimentos diagnósticos de enfermidades ou impliquem indicação terapêutica são atos privativos do profissional médico, entre outros aspectos.", "sha256_texto": "528a3b36892b6c665c2859f8a9f324a712389d8fba5e78900f87ad366ceec21b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2002_SN_ANEXO_INFORME_PARLAMENTAR_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_INFORME_PARLAMENTAR_ANEXO_001_NOTA_RODAPE_002", "normativo": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_INFORME_PARLAMENTAR", "tipo_dispositivo": "nota_rodape", "localizador": "Nota de rodapé 2", "dispositivo_superior": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_INFORME_PARLAMENTAR_ANEXO_001", "ordem": 9, "transcricao_literal": "* O projeto é de autoria do Senador Geraldo Althoff (PFL/SC) fundamentado em Resolução do Conselho Federal de Medicina. Incluído na pauta da Comissão de Constituição, Justiça e Cidadania, Senado Federal, desde 13/11/2002, provocou polêmica entre os membros daquela comissão e ocasionou reexame da matéria. A proposição foi encaminhada ao COFEN pelo Informe Parlamentar nº 23, de 21 de novembro de 2002.", "sha256_texto": "a90c12f937ca99618f55559991470401426b6eb4c7a2b2e1c181e15336bd43b9", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2002_SN_ANEXO_INFORME_PARLAMENTAR_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_INFORME_PARLAMENTAR_ANEXO_001_NOTA_RODAPE_003", "normativo": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_INFORME_PARLAMENTAR", "tipo_dispositivo": "nota_rodape", "localizador": "Nota de rodapé 3", "dispositivo_superior": "BR_FED_COFEN_NAOATO_2002_SN_ANEXO_INFORME_PARLAMENTAR_ANEXO_001", "ordem": 10, "transcricao_literal": "* O relator foi substituído na referida comissão, por questões regimentais, em 27/11/2002, pelo Senador Antonio Carlos Júnior (PFL/BA) que apresentou seu parecer em 04/12/2002. Aprovado o parecer favorável com 03 emendas, a matéria segue para a Comissão de Assuntos Sociais na qual será apreciado o mérito. A comissão tem poder terminativo da matéria, ou seja, só será apreciada a decisão da comissão pelo Plenário se houver recurso de 10% dos senadores.", "sha256_texto": "c24b028492e203506c589453525e9feff77231ee92a9ce6a673918b8fb62bf50", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2002_SN_ANEXO_INFORME_PARLAMENTAR_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
