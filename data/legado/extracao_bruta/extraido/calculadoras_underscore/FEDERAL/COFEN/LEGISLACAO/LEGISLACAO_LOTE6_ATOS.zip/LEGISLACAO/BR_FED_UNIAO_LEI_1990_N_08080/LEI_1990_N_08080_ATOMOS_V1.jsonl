{"identificador": "BR_FED_UNIAO_LEI_1990_N_08080_ART_004", "normativo": "BR_FED_UNIAO_LEI_1990_N_08080", "tipo_dispositivo": "artigo", "localizador": "Art. 4º", "dispositivo_superior": null, "ordem": 22, "transcricao_literal": "Art. 4º O conjunto de ações e serviços de saúde, prestados por órgãos e instituições públicas federais, estaduais e municipais, da Administração direta e indireta e das fundações mantidas pelo Poder Público, constitui o Sistema Único de Saúde (SUS).", "sha256_texto": "90f0d527ac8911ed98da719c36a84c035a3cfb44dc794d85e599d682f6cf435e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "LEI_1990_N_08080_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
