{"identificador": "BR_FED_UNIAO_LEI_1990_N_08080_SECAO_004", "normativo": "BR_FED_UNIAO_LEI_1990_N_08080", "tipo_dispositivo": "secao", "localizador": "DAS DISPOSIÇÕES GERAIS", "dispositivo_superior": null, "ordem": 13, "transcricao_literal": "DAS DISPOSIÇÕES GERAIS", "sha256_texto": "4b92c5b7a2a337a952303b82078cc0a20bf414349fe9bd96d57c21233ba764b1", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "LEI_1990_N_08080_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_UNIAO_LEI_1990_N_08080_ART_002", "normativo": "BR_FED_UNIAO_LEI_1990_N_08080", "tipo_dispositivo": "artigo", "localizador": "Art. 2º", "dispositivo_superior": null, "ordem": 14, "transcricao_literal": "Art. 2º A saúde é um direito fundamental do ser humano, devendo o Estado prover as condições indispensáveis ao seu pleno exercício.", "sha256_texto": "ea15e851616d6b931e9d972777c895b02b0182a9d8e18a9078c6e2fa4b89971e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "LEI_1990_N_08080_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_UNIAO_LEI_1990_N_08080_ART_002_PAR_01", "normativo": "BR_FED_UNIAO_LEI_1990_N_08080", "tipo_dispositivo": "paragrafo", "localizador": "§ 1º", "dispositivo_superior": "BR_FED_UNIAO_LEI_1990_N_08080_ART_002", "ordem": 15, "transcricao_literal": "§ 1º O dever do Estado de garantir a saúde consiste na formulação e execução de políticas econômicas e sociais que visem à redução de riscos de doenças e de outros agravos e no estabelecimento de condições que assegurem acesso universal e igualitário às ações e aos serviços para a sua promoção, proteção e recuperação.", "sha256_texto": "9ba6b0b7cee8b7212188d04753fde6de242ddae50b54676da0beb49cfa6bf5e5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "LEI_1990_N_08080_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_UNIAO_LEI_1990_N_08080_ART_002_PAR_02", "normativo": "BR_FED_UNIAO_LEI_1990_N_08080", "tipo_dispositivo": "paragrafo", "localizador": "§ 2º", "dispositivo_superior": "BR_FED_UNIAO_LEI_1990_N_08080_ART_002", "ordem": 16, "transcricao_literal": "§ 2º O dever do Estado não exclui o das pessoas, da família, das empresas e da sociedade.", "sha256_texto": "c8e1797388a5e11b2794a78944478ec248737b59e0017a79d633d789c8e8c008", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "LEI_1990_N_08080_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_UNIAO_LEI_1990_N_08080_ART_003", "normativo": "BR_FED_UNIAO_LEI_1990_N_08080", "tipo_dispositivo": "artigo", "localizador": "Art. 3º", "dispositivo_superior": null, "ordem": 17, "transcricao_literal": "Art. 3º A saúde tem como fatores determinantes e condicionantes, entre outros, a alimentação, a moradia, o saneamento básico, o meio ambiente, o trabalho, a renda, a educação, o transporte, o lazer e o acesso aos bens e serviços essenciais; os níveis de saúde da população expressam a organização social e econômica do País.", "sha256_texto": "c87f8fcb2fcc45cf4916f913254eb0e7ed4e9e579e0660725aefdfdbacdd01c2", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "LEI_1990_N_08080_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_UNIAO_LEI_1990_N_08080_ART_003_PAR_UNICO", "normativo": "BR_FED_UNIAO_LEI_1990_N_08080", "tipo_dispositivo": "paragrafo", "localizador": "Parágrafo único", "dispositivo_superior": "BR_FED_UNIAO_LEI_1990_N_08080_ART_003", "ordem": 18, "transcricao_literal": "Parágrafo único. Dizem respeito também à saúde as ações que, por força do disposto no artigo anterior, se destinam a garantir às pessoas e à coletividade condições de bem-estar físico, mental e social.", "sha256_texto": "a521f74fc7d735d0d4d93aae763df5ac914ba3d0409108f5ec0c0b50871f589e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "LEI_1990_N_08080_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
