{"identificador": "BR_FED_UNIAO_DECR_2016_N_08754_PARAGRAFO_TRANSCRITO_002", "normativo": "BR_FED_UNIAO_DECR_2016_N_08754", "tipo_dispositivo": "paragrafo_transcrito", "localizador": "Parágrafo (transcrito)", "dispositivo_superior": "BR_FED_UNIAO_DECR_2016_N_08754_ARTIGO_TRANSCRITO_001", "ordem": 5, "transcricao_literal": "§ 3\u0001 O aumento de vagas em cursos de graduação em Direito, Medicina, Odontologia, Psicologia e Enfermagem, inclusive em universidades e centros universitários, depende de autorização do Ministério da Educação, conforme regulamento.", "sha256_texto": "1152d5aa7cbdeee26b4449c6b521f1e08c73bd9b456c5e714eb028739a799054", "fonte_literal": "PDF_SITE_TEXTO", "arquivo_fonte": "DECR_2016_N_08754_PDF_SITE.pdf", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_PDF_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_UNIAO_DECR_2016_N_08754_PARAGRAFO_TRANSCRITO_003", "normativo": "BR_FED_UNIAO_DECR_2016_N_08754", "tipo_dispositivo": "paragrafo_transcrito", "localizador": "Parágrafo (transcrito)", "dispositivo_superior": "BR_FED_UNIAO_DECR_2016_N_08754_ARTIGO_TRANSCRITO_001", "ordem": 6, "transcricao_literal": "§ 4\u0001 O prazo para a manifestação dos Conselhos prevista no § 2o é de sessenta dias, prorrogável por igual período, a requerimento do Conselho interessado, e terá caráter opinativo.", "sha256_texto": "2192a78b1b1a6a8528ee4472084086f86d636c8d0049e1823855629500f10a00", "fonte_literal": "PDF_SITE_TEXTO", "arquivo_fonte": "DECR_2016_N_08754_PDF_SITE.pdf", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_PDF_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_UNIAO_DECR_2016_N_08754_ARTIGO_TRANSCRITO_002", "normativo": "BR_FED_UNIAO_DECR_2016_N_08754", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 36 (transcrito)", "dispositivo_superior": null, "ordem": 7, "transcricao_literal": "“Art. 36. O reconhecimento de cursos de graduação em Direito, Medicina, Odontologia, Psicologia e Enfermagem deverá ser submetido, respectivamente, à manifestação, em caráter opinativo, do Conselho Federal da Ordem dos Advogados do Brasil e do Conselho Nacional de Saúde.", "sha256_texto": "29738a94bf26860a43d49b91044d9255c11cb57b03847ebd65361f6febfbb56a", "fonte_literal": "PDF_SITE_TEXTO", "arquivo_fonte": "DECR_2016_N_08754_PDF_SITE.pdf", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_PDF_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
