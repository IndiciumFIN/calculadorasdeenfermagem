{"identificador": "BR_FED_UNIAO_DECR_2016_N_08754_PARAGRAFO_TRANSCRITO_004", "normativo": "BR_FED_UNIAO_DECR_2016_N_08754", "tipo_dispositivo": "paragrafo_transcrito", "localizador": "Parágrafo (transcrito)", "dispositivo_superior": "BR_FED_UNIAO_DECR_2016_N_08754_ARTIGO_TRANSCRITO_003", "ordem": 9, "transcricao_literal": "§ 1º No caso de curso correspondente a profissão regulamentada, a Secretaria abrirá prazo para que o órgão de regulamentação profissional, de âmbito nacional, possa oferecer subsídios à decisão do Ministério da Educação, em caráter opinativo, no prazo de sessenta dias.", "sha256_texto": "dc5b105c0d8fed85a4540fa17ae101b1ffc5d86ada85a7e538409342ebb26718", "fonte_literal": "PDF_SITE_TEXTO", "arquivo_fonte": "DECR_2016_N_08754_PDF_SITE.pdf", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_PDF_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
