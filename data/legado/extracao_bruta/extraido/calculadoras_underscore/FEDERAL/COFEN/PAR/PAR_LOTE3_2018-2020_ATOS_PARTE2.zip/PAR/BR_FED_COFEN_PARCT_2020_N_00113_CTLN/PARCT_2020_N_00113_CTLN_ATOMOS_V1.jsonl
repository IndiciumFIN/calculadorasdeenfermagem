{"identificador": "BR_FED_COFEN_PARCT_2020_N_00113_CTLN_ITEM_001", "normativo": "BR_FED_COFEN_PARCT_2020_N_00113_CTLN", "tipo_dispositivo": "item", "localizador": "Item 3.32", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00113_CTLN_SECAO_004", "ordem": 26, "transcricao_literal": "3.32 Nenhum indivíduo pode administrar, intencionalmente, radiações ionizantes em seres humanos a menos que:", "sha256_texto": "1e9eb20ee5d6b8988614bf569dc8f1e922f40a9cc324fc5943842ac94adede5c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00113_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "numeracao": "3.32"}
