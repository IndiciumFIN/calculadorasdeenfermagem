{"identificador": "BR_FED_COFEN_PARCONS_2014_N_00128_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARCONS_2014_N_00128", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": null, "ordem": 5, "transcricao_literal": "Atendendo ao Despacho da Presidência do Cofen proveniente da 442 ROP do Cofen encaminhando a essa conselheira para análise e providências.", "sha256_texto": "32958a02e4917c97bfb1a472afa4c76ce9e03f24594baa4e7cb66c554a11373d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2014_N_00128_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2014_N_00128_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARCONS_2014_N_00128", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": null, "ordem": 6, "transcricao_literal": "Buscando atender tal demanda essa conselheira tomou ciência da existência do PAD 056/2014, também despachado a essa conselheira, com o mesmo conteúdo de solicitação.", "sha256_texto": "1405ccf90c1beca5f754b7abc60675b4ea6e5d510cad0a3932169d385d458cc7", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2014_N_00128_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2014_N_00128_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_PARCONS_2014_N_00128", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": null, "ordem": 7, "transcricao_literal": "Na Fl. 01 de ambos PAD,s há o mesmo oficio do então Presidente do Coren-PB, Dr. Ronaldo Miguel Bezerra cujo que solicita Parecer Jurídico do Conselho Federal de Enfermagem acerca da coleta de material sanguíneo pelo técnico de laboratório, visto que o Parecer Jurídico do Coren-PB, entende tratar-se de atividade prevista no Decreto N° 94.406/87 que deva ser realizado por profissional de Enfermagem.", "sha256_texto": "c4a41f160369e297c608023a98dd426c68f5dfb758df7d9fe01a00ae3b824854", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2014_N_00128_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2014_N_00128_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARCONS_2014_N_00128", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": null, "ordem": 8, "transcricao_literal": "Da fundamentação e análise", "sha256_texto": "a857121e08227d06dfd2ec64a65efe1b50525e1bbb207d932b1091068cf99f9a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2014_N_00128_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2014_N_00128_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_PARCONS_2014_N_00128", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 7", "dispositivo_superior": null, "ordem": 9, "transcricao_literal": "A leitura cuidadosa de cada um dos PAD ‘s desvelou a essa conselheira que há o Parecer Jurídico de lavra do Dr. Rafael de Jesus Rocha, Procurador do Cofen, as Fl. 17 a 23 do PAD Cofen 258/2013, que deixa claro que o simples fato de um Decreto N° 94.406/87 regulamentar o exercício a profissão de enfermagem não implica, necessariamente, que todas as atividades nele mencionadas só possam ser desempenhadas por profissionais de enfermagem.", "sha256_texto": "dd37be88e6383edf1cd403e77173a1e1586d8119366068a4550b79bb83d9b57c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2014_N_00128_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2014_N_00128_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_PARCONS_2014_N_00128", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 8", "dispositivo_superior": null, "ordem": 10, "transcricao_literal": "Afirma que essa restrição somente ocorrerá quando a competência for privativa. Inexistindo restrição trata-se de atuação compartilhada.", "sha256_texto": "791270a1fbd56f3f83ec15b7eabe3dbdf167ff6ea6f9d947314b57a9889ee134", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2014_N_00128_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2014_N_00128_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_COFEN_PARCONS_2014_N_00128", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 9", "dispositivo_superior": null, "ordem": 11, "transcricao_literal": "Tal parecer foi ratificado pelo Dr. Maxmilian Patriota Carneiro, que conclui ( … ) inexiste óbice jurídico a que os técnicos de laboratórios de análises clínicas realizem a coleta de material sanguíneo para a feitura de testes de exames em laboratórios de análises clínicas”.", "sha256_texto": "455991cb8ab01d97eab7ead8505939e48474150177031baabdfb472e7cde998f", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2014_N_00128_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2014_N_00128_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARCONS_2014_N_00128", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 10", "dispositivo_superior": null, "ordem": 12, "transcricao_literal": "Esse parecer ratificado foi aprovado pelo Procurador Geral do Cofen Dr. Luiz Gustavo Muglia no dia 20 de fevereiro de 2014.", "sha256_texto": "97c9d7fce099adaa6fc10445fc57d84e70925d70289d32de8c45fc95b965df86", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2014_N_00128_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2014_N_00128_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_PARCONS_2014_N_00128", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 11", "dispositivo_superior": null, "ordem": 13, "transcricao_literal": "Parecer", "sha256_texto": "ec8ae9624d88f92b14490ceb7bb4f5b75d4ded65e4f5a7575966bc3c32d87bf1", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2014_N_00128_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2014_N_00128_PARAGRAFO_TEXTO_012", "normativo": "BR_FED_COFEN_PARCONS_2014_N_00128", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 12", "dispositivo_superior": null, "ordem": 14, "transcricao_literal": "Diante do exposto, sou de parecer que o PAD Cofen N°56/2014 seja apensado ao PAD Cofen N° 258/2013 e que sejam encaminhados os pareceres jurídicos ao Presidente do CorenPB, Dr. Ronaldo Miguel Bezerra, desde que seja aprovado por esse Egrégio Plenário.", "sha256_texto": "28590f3c2afecf61c5699fd74f31837e19b44260cf575b08b04a82ff07a0d9a8", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2014_N_00128_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
