{"identificador": "BR_FED_COFEN_PARTEC_2021_N_00001_ARI_ITEM_LISTA_003", "normativo": "BR_FED_COFEN_PARTEC_2021_N_00001_ARI", "tipo_dispositivo": "item_lista", "localizador": "Item de lista 3", "dispositivo_superior": "BR_FED_COFEN_PARTEC_2021_N_00001_ARI_PARAGRAFO_TEXTO_004", "ordem": 12, "transcricao_literal": "Foi emitido parecer da CTEP com a conclusão de que o Egrégio Plenário dê apreciação desfavorável quanto ao registo de títulos da faculdade de Piracanjunba de GO, pois não se identificam nos autos desse PAD que de respaldo a solicitação apresentada.", "sha256_texto": "9271cbfec37c64c3e4c1d8eefead24c42d0d4df9b1df0a20c4f5ba8e8e0f4313", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARTEC_2021_N_00001_ARI_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "3"}
