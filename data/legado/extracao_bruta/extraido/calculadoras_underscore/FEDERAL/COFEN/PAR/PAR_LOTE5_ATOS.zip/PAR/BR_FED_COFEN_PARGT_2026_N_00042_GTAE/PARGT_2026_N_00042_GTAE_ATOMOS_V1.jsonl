{"identificador": "BR_FED_COFEN_PARGT_2026_N_00042_GTAE_ITEM_005", "normativo": "BR_FED_COFEN_PARGT_2026_N_00042_GTAE", "tipo_dispositivo": "item", "localizador": "Item 5", "dispositivo_superior": "BR_FED_COFEN_PARGT_2026_N_00042_GTAE_SECAO_002", "ordem": 13, "transcricao_literal": "5. Nos termos do art. 22, § 1º, do Código Eleitoral do Sistema Cofen/Conselhos Regionais de Enfermagem, compete excepcionalmente ao Cofen apreciar o recurso quando inviabilizado seu julgamento pelo Plenário Regional em razão da ausência de quórum decorrente de impedimentos ou suspeições.", "sha256_texto": "69104dd61c32978f98a99e158db126fbbe0ab485bce8dea613fa409b22a6cf75", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARGT_2026_N_00042_GTAE_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "numeracao": "5", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
