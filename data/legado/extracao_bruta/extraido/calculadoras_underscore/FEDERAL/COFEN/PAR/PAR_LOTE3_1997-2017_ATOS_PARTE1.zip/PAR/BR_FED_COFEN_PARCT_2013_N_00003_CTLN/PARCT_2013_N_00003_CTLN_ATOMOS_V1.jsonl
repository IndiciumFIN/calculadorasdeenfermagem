{"identificador": "BR_FED_COFEN_PARCT_2013_N_00003_CTLN_ITEM_002", "normativo": "BR_FED_COFEN_PARCT_2013_N_00003_CTLN", "tipo_dispositivo": "item", "localizador": "Item 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2013_N_00003_CTLN_SECAO_003", "ordem": 10, "transcricao_literal": "3. A lei 7498/86 que regulamenta a profissão de enfermagem no Brasil e seu decreto regulamentador 94406/87, definem quem são os profissionais de enfermagem e especificamente em seus art. 7º e 5º, tratam da definição do técnico de enfermagem, que é o profissional titular do diploma", "sha256_texto": "e3a87de3c287f5034ecef8f543f9902624ab0d49e7911794212aae76b1f5ece6", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2013_N_00003_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "numeracao": "3"}
