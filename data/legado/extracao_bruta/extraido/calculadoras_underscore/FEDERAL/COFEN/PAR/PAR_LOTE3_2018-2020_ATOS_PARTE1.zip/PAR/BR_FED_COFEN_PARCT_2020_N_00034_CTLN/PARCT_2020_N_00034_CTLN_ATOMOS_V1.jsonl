{"identificador": "BR_FED_COFEN_PARCT_2020_N_00034_CTLN_ITEM_003", "normativo": "BR_FED_COFEN_PARCT_2020_N_00034_CTLN", "tipo_dispositivo": "item", "localizador": "Item 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00034_CTLN_SECAO_002", "ordem": 24, "transcricao_literal": "4. Vejamos, com base na legislação vigente, diante de inúmeros questionamentos acerca do que realmente compete ao Enfermeiro prescrever, principalmente “se somente” em programas de saúde pública ou “também” em instituições de saúde, em 2017 foram aprovados dois pareceres no Cofen, um da própria CTLN e outro da DPAC – Divisão de Processos Administrativos e Contenciosos, cuja discussão veremos abaixo:", "sha256_texto": "821145b27f212a0d65c4a7f453bf2d4e6535116e31ab72586016ffb2527b94b5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00034_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "numeracao": "4", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
