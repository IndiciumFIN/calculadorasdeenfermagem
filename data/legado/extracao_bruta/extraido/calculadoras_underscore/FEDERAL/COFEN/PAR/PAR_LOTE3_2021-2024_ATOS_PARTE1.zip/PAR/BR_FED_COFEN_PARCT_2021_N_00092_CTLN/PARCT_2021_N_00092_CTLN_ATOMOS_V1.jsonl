{"identificador": "BR_FED_COFEN_PARCT_2021_N_00092_CTLN_PARAGRAFO_TEXTO_002", "normativo": "BR_FED_COFEN_PARCT_2021_N_00092_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": null, "ordem": 5, "transcricao_literal": "Parecer acerca da legalidade da realização de botão anestésico para a fixação de cateter após punção arterial com finalidade de monitorização da Pressão Arterial Média (PAM). O Parecer aponta não haver óbices para a realização do botão anestésico para a fixação do cateter de PAM com fio, pelo Enfermeiro.", "sha256_texto": "6607091db660122994cb1d6bed647f86e2e5ce12c3f2eece23f8a4a64d2a93ee", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00092_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
