{"identificador": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_SECAO_001", "ordem": 7, "transcricao_literal": "Trata-se o presente de solicitação de registro de título de Especialista em Estética avançada com ênfase em Harmonização Facial.", "sha256_texto": "de7b62179b3a6cc2a862731fa8d4f72f3d2f2f04a224764caba9e0966ccd4328", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00029_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_SECAO_001", "ordem": 8, "transcricao_literal": "Apresenta a requerente, cópias do Certificado de formação e histórico escolar referentes ao curso de especialidade em questão, emitidos pela “Faculdade de Governança, Engenharia e Educação de São Paulo”, que ofereceu Curso de “Pós-Graduação em Estética Avançada com ênfase em Harmonização Facial”, com carga horária de 460 horas aulas, sendo 154h/a práticas.", "sha256_texto": "fad6b289f2f4143f80a249de26871740fa4e635f6043501828ada485aa498a4a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00029_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_SECAO_001", "ordem": 9, "transcricao_literal": "Apresenta também a comprovação do registro profissional junto ao Sistema Cofen/Conselhos Regionais de Enfermagem, sob o número Coren-SC 664.268-ENF.", "sha256_texto": "5fc9912faf94264958db90b426306774b2c46a6a7188de20feb4242e93e935cf", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00029_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_SECAO_001", "ordem": 10, "transcricao_literal": "Destaque-se que a Instituição de ensino possui cadastro ativo no Cadastro Nacional de Cursos e Instituições de Educação Superior – Cadastro e-MEC sob o número 23381 e o curso está cadastrado na modalidade Educação a Distância, na área 09 – Saúde e bem-estar.", "sha256_texto": "2633fcbd0fc411ffcfa14137becbe65d7d6c79c933d6c43e4fda44ba7683c457", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00029_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_SECAO_001", "ordem": 11, "transcricao_literal": "Diante do requerimento, enviado pelo Conselho Regional de Enfermagem de Santa Catarina, se manifesta a Divisão de Inscrição, Registro e Cadastro – DIRC/Cofen, solicitando a manifestação da Câmara Técnica de Educação e Pesquisa sobre a possibilidade de registro do certificado em questão, pois a especialização, segundo o setor de registro, não consta do rol de especialidades listadas na norma do Cofen.", "sha256_texto": "68997df441b879bd664507d13863bb61e4a59475c7ff11327962076baafc8b85", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00029_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_SECAO_001", "ordem": 12, "transcricao_literal": "Assim, cabe a essa Câmara Técnica analisar a possiblidade de registro em especialidade de enfermagem.", "sha256_texto": "7e8824eaa7fdfd7185468a61c4a41ae75993fe665b4cfc145506864e70269890", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00029_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_SECAO_002", "normativo": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP", "tipo_dispositivo": "secao", "localizador": "II. FUNDAMENTAÇÃO", "dispositivo_superior": null, "ordem": 13, "transcricao_literal": "II. FUNDAMENTAÇÃO", "sha256_texto": "685155de3de3ed3f2f8f8b81dbe74f0335422a2abbc215c5604d7e9096b7c5c5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00029_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_SECAO_002", "ordem": 14, "transcricao_literal": "Resta claro que o registro de especialidades de enfermagem, cabe ao Sistema Cofen/Conselhos Regionais, assim, vejamos que é necessário considerar o estabelecido no art. 3º e da Resolução Cofen nº 581/2018, ao apontar que:", "sha256_texto": "7d6749cdef7b922e9c000fdec3dcc87e62fdc43f2b3de4684902b8061c090dc5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00029_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_SECAO_002", "ordem": 15, "transcricao_literal": "[…]", "sha256_texto": "b94f345ea5affa7e142e643b8126fe247c9c63bd7242bdd33d9231123deede9b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00029_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_PARAGRAFO_TEXTO_012", "normativo": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_SECAO_002", "ordem": 16, "transcricao_literal": "Os títulos de pós-graduação lato sensu, emitidos por Instituições de Ensino Superior, credenciados pelo Ministério da Educação – MEC, ou Conselho Estadual de Educação-CEE e os Títulos de Pós-graduação stricto sensu reconhecidos pela CAPES, concedidos por Sociedades, Associações, Colégios de Especialistas de Enfermagem ou de outras áreas do conhecimento, serão registrados, no âmbito do Sistema COFEN/Conselhos Regionais de Enfermagem, de acordo com a legislação vigente.", "sha256_texto": "1e924095c9b0853cf75eba4a8565f080d6fe50be8c820699660fa008824c773a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00029_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_PARAGRAFO_TRANSCRITO_001", "normativo": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP", "tipo_dispositivo": "paragrafo_transcrito", "localizador": "Parágrafo (transcrito)", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_SECAO_002", "ordem": 17, "transcricao_literal": "§ 1º Os títulos serão registrados de acordo com a denominação constante no diploma ou certificado apresentado (COFEN, 2018). […]", "sha256_texto": "d658187fa706759e13998455c73dce61c68a58683d73e1f258a348be5f5e0c2d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00029_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_PARAGRAFO_TEXTO_013", "normativo": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_SECAO_002", "ordem": 18, "transcricao_literal": "Segundo a Resolução nº 1 do CNE/CES, de 06.04.2018, que estabelece diretrizes e normas para a oferta dos cursos de pós-graduação lato sensu denominados cursos de especialização, no âmbito do Sistema Federal de Educação Superior, conforme prevê o Art. 39, § 3º, da Lei nº 9.394/1996, e dá outras providências, os cursos de pós-graduação “lato sensu” deverão ter carga horária mínima de 360h/a. Vejamos o que diz a norma do Ministério da Educação citada:", "sha256_texto": "52429b19a0f9dd5c195d6e5707da49f03e6792f1c34ab984451c9a07eeb7e5ee", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00029_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_ART_007", "normativo": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 7º (citado/transcrito)", "dispositivo_superior": null, "ordem": 19, "transcricao_literal": "Art. 7º Para cada curso de especialização será previsto Projeto Pedagógico de Curso (PPC), constituído, dentre outros, pelos seguintes componentes: I – matriz curricular, com a carga mínima de 360 (trezentos e sessenta) horas, contendo disciplinas ou atividades de aprendizagem com efetiva interação no processo educacional, com o respectivo plano de curso, que contenha objetivos, programa, metodologias de ensino aprendizagem, previsão de trabalhos discentes, avaliação e bibliografia;", "sha256_texto": "2eb09e6ac9d056d3393bdac596bf8a992b12372b5fcb4f9039e6a1200b8c0755", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00029_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Artigo citado ou transcrito de outra norma (sequência não inicia em 1 no escopo); não é articulado próprio."}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_PARAGRAFO_TEXTO_014", "normativo": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_SECAO_002", "ordem": 20, "transcricao_literal": "Devemos ainda analisar o que estabelece o Cofen relativo a carga horária de aulas práticas exigidas pelo Cofen para o registro da especialidade em tela, conforme previsão da Resolução Cofen nº 715/2023, que altera a Resolução Cofen nº 529/2016 que normatiza a atuação do enfermeiro na área de estética, senão vejamos:", "sha256_texto": "d7aedd42b3b8f930af73b44b4e027642aa1b2cfe9d7f35ea5feb3662b1ca3712", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00029_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_ARTIGO_TRANSCRITO_001", "normativo": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 1 (transcrito)", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_ART_007", "ordem": 21, "transcricao_literal": "“Art. 1º O artigo 4º da Resolução Cofen nº 529, de 9 de novembro de 2016, publicada no Diário Oficial da União nº 217, de 11 de novembro de 2016, Seção 1, página 216/217, passará a vigorar com a seguinte redação: Art. 4º O Enfermeiro deverá ter pós-graduação lato sensu em estética, de acordo com a legislação estabelecida pelo MEC, e que no mínimo tenha 100 (cem) horas de aulas práticas supervisionadas.”", "sha256_texto": "084325395a1aedf090530e72538706273c3a9db812c92cce34daafb91140161a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00029_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_PARAGRAFO_TEXTO_015", "normativo": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_SECAO_002", "ordem": 22, "transcricao_literal": "Diante de análise preliminar, tem-se que o curso em questão atende ao que estabelece as normatizações do CNE/CES (MEC) e do Cofen, pois que o curso tem carga horária de 460 h/a, sendo que 154h/a são de práticas, sendo que a carga horária mínima estabelecida pela norma educacional prevê o mínimo de 360 h/a, e que as aulas práticas supervisionadas (154 h/a), atende à exigência mínima estabelecida pela norma do Cofen (100h/a).", "sha256_texto": "d93e64e78b7d5f98e4b8e6b1e983ded38e63aa2f3ec82868fdb7d805a271fb95", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00029_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_PARAGRAFO_TEXTO_016", "normativo": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 7", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_SECAO_002", "ordem": 23, "transcricao_literal": "Em semelhante sentido, observando-se a matriz curricular, constante do histórico escolar apresentado, destacamos as disciplinas: 1) Anatomofisiologia da pele e sistema muscular de interesse em harmonização facial (20h/a), distúrbios estéticos e análise facial (16h/a), peelings estéticos e protocolos estéticos faciais (10h/a), eletroterapia aplicada em desordens estéticas faciais (10h/a), preenchimento facial (10h/a), práticas clínicas em estética I e II (40h/a), as quais, em princípio, são aplicáveis às práticas previstas na norma que trata dos procedimentos realizados por Enfermeiros no âmbito da Estética.", "sha256_texto": "f35e817990e843c66b6841557c273db0476c650c5e320c1b436097bfcedaf39a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00029_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_ART_007_INC_III", "normativo": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP", "tipo_dispositivo": "inciso", "localizador": "Inciso III", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_ART_007", "ordem": 24, "transcricao_literal": "III. CONCLUSÃO Considerando a análise dos documentos que constituem o processo SEI 00196.003028/2023-53, que trata do registro do título de Especialista em Estética avançada com ênfase em Harmonização Facial da Enfermeira Kelly Tainah Nunes dos Santos de Souza;", "sha256_texto": "55d37dafcecebf31a176412e589cc438416cf93b7bd0864a3ffc648b28cffc91", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00029_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Dispositivo de artigo citado/transcrito."}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_PARAGRAFO_TEXTO_017", "normativo": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 8", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_SECAO_002", "ordem": 25, "transcricao_literal": "Considerando a Resolução Cofen 581/2018, que trata dos procedimentos para Registro de Títulos de Pós – Graduação Lato e Stricto Sensu concedido a Enfermeiros e aprova a lista das especialidades;", "sha256_texto": "f6a0c9a4056a75c6b4519a31bce33362642bfe87805eec43d42e77457c330340", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00029_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_PARAGRAFO_TEXTO_018", "normativo": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 9", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_SECAO_002", "ordem": 26, "transcricao_literal": "Considerando o entendimento desta CTEP/Cofen que o certificado emitido, com carga horária, 460h/a, atende ao exigido em norma educacional vigente, e que as aulas práticas supervisionadas (154 h/a), atende ao mínimo exigido pela norma interna corporis (100h/a);", "sha256_texto": "414828074f58088e3506eecde6300cf018492fe7d48bf6183c1e06c2b5fe83a4", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00029_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_PARAGRAFO_TEXTO_019", "normativo": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 10", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_SECAO_002", "ordem": 27, "transcricao_literal": "Considerando ser esta Câmara Técnica de Educação e Pesquisa, órgão “permanente de natureza consultiva, propositiva e avaliativa sobre matéria relativa ao exercício da Enfermagem”, segundo Art. 1º do Regimento Interno do Cofen, no entanto, sem competência deliberativa.", "sha256_texto": "2285ec081241237d465d99bcaa8f87a28e90cc7ad5c2ed982daa49c91f8ed05b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00029_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_PARAGRAFO_TEXTO_020", "normativo": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 11", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_SECAO_002", "ordem": 28, "transcricao_literal": "Assim concluímos:", "sha256_texto": "750fe8be3056181e1f775ae17b410a9794fe52775816c7e9a1e080ee79a60998", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00029_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_PARAGRAFO_TEXTO_021", "normativo": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 12", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00029_CTEP_SECAO_002", "ordem": 29, "transcricao_literal": "Sugere, esta Câmara Técnica, ao Egrégio Plenário do Cofen, que neste caso, dê apreciação favorável ao registro do Título de Pós-graduação em Estética com ênfase em Harmonização Facial, da Enfermeira Kelly Tainah Nunes dos Santos de Souza, emitido pela Faculdade de Governança, Engenharia e Educação de São Paulo, devendo este ser registrado na ÁREA I – Saúde Coletiva; Saúde da Criança e do adolescente; Saúde do Adulto (Saúde do homem e Saúde da Mulher; Saúde do Idoso; Urgências e Emergências), item 15 – Enfermagem em estética, e, “de acordo com a denominação constante no diploma ou certificado apresentado”, conforme §1º do Art. 3º da Resolução Cofen nº 581/2018.", "sha256_texto": "68e42703812f4e5799099c4623f534c4b32344ab2aeae3bd6b34d110b328db0c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00029_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
