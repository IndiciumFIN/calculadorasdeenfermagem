{"identificador": "BR_FED_COFEN_PARASS_2017_N_00060_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARASS_2017_N_00060", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": null, "ordem": 6, "transcricao_literal": "Cuida-se de pedido do Conselho Regional de Enfermagem do Ceará que, mediante o Ofício COREN-CE GAB Nº 453, de 18 de setembro de 2017, protocolizado no Cofen em 20/09/2017, questiona se o direito de o profissional obter inscrição remida se dá a partir da inscrição provisória ou somente a partir da inscrição definitiva.", "sha256_texto": "b393359dba7cc3b1188dd2c70601a9e4a2bd159977da9d7d8f00c2e7ba354ab1", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2017_N_00060_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARASS_2017_N_00060_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_PARASS_2017_N_00060", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": null, "ordem": 7, "transcricao_literal": "Recebemos nesta ASSLEGIS os documentos autuados sob o PAD nº 732/2017.", "sha256_texto": "2998698f14caff9848a33ff386afe1d82a2ea964f2d7012c7a8b0b2c79ee4db4", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2017_N_00060_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
