{"identificador": "BR_FED_COFEN_PARCT_2021_N_00001_CTLN_ITEM_LISTA_004", "normativo": "BR_FED_COFEN_PARCT_2021_N_00001_CTLN", "tipo_dispositivo": "item_lista", "localizador": "Item de lista 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00001_CTLN_ART_013", "ordem": 26, "transcricao_literal": "A Resolução Cofen n° 564/2017 referente ao Código de Ética dos Profissionais de Enfermagem – CEPE – que exorta os profissionais de enfermagem à sua fiel observância e cumprimento de acordo com os Princípios da Ética e Bioética, destaca no art. 4º, Capítulo I – Dos Direitos e art. 38, Capítulo II – Dos deveres, respectivamente.", "sha256_texto": "6043f47bd9e43ff819df03180ae1bf5984b904b22c4cb51b04ec16253e178abd", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00001_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "1"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00001_CTLN_ART_004_2", "normativo": "BR_FED_COFEN_PARCT_2021_N_00001_CTLN", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 4º (citado/transcrito)", "dispositivo_superior": null, "ordem": 27, "transcricao_literal": "Art. 4º Participar da prática multiprofissional, interdisciplinar e transdisciplinar com responsabilidade, autonomia e liberdade, observando os preceitos éticos e legais da profissão.", "sha256_texto": "c16b8fcbd16174069f0290a11dbbc5450b2eb8471e53618712950f0162725ed6", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00001_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Artigo citado ou transcrito de outra norma (sequência não inicia em 1 no escopo); não é articulado próprio."}
