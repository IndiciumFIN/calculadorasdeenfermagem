{"identificador": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN_PARAGRAFO_TEXTO_002", "normativo": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN_SECAO_001", "ordem": 5, "transcricao_literal": "Parecer sobre a entrega da Ficha de Atendimento e Prescrição de medicamentos psicotrópicos do Paciente do SAMU de Salvador-BA para o almoxarifado com o objetivo de autorizar a reposição dos psicotrópicos utilizados em atendimento nos serviços do SAMU. O parecer aponta pela legalidade do protocolo estabelecido no Comunicado Interno.", "sha256_texto": "9b5d8f285f26a5d95494657d1502d106a43dd40d3b608ce5b886e748a35b1b91", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2010_N_00049_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN_SECAO_002", "normativo": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN", "tipo_dispositivo": "secao", "localizador": "I – DO HISTORICO", "dispositivo_superior": null, "ordem": 6, "transcricao_literal": "I – DO HISTORICO", "sha256_texto": "9f017c05385577b4028d40255b9e5f63052d2d2a55d2b829bdd580a92c43a390", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2010_N_00049_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN_ITEM_LISTA_001", "normativo": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN", "tipo_dispositivo": "item_lista", "localizador": "Item de lista 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN_SECAO_002", "ordem": 7, "transcricao_literal": "O PAD supracitado, trata de questionamento de profissional enfermeiro(a) não identificado, que questiona sobre o conteúdo de um Comunicado Interno, no âmbito do SAMU de Salvador-BA que determina que na hipótese de se usar psicotrópicos no atendimento, seja anexada a prescrição controlada da medicação à ficha de atendimento do paciente (prontuário), porém, no entendimento do referido profissional, o CI condiciona a reposição do psicotrópicos da unidade móvel de suporte avançado à disponibilização do prontuário do paciente a outros profissionais que não são da intervenção do serviço e portanto não participam da assistência direta ao paciente, o que não é admissível uma vez que o prontuário do paciente contém informações sigilosas, competindo ao profissional da assistência a sua guarda temporária e posteriormente, ao setor específico do Serviço (SAME) a guarda definitiva, pelo que recorre ao Conselho Federal para esclarecimentos a fim de evitar incorrer em infração ética/legal no exercício profissional dos enfermeiros do serviço.", "sha256_texto": "8be82476bd2344504cb1bbf804e6ec437ee4018226d95376e0fdd421bf1487f9", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2010_N_00049_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "1"}
{"identificador": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN_ITEM_LISTA_002", "normativo": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN", "tipo_dispositivo": "item_lista", "localizador": "Item de lista 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN_SECAO_002", "ordem": 8, "transcricao_literal": "Compõe os autos: a) Despacho GAB/PRES nº 0070/2020-JA, ref. ao protocolo COFEN n. 15766904981116222733 (Ouvidoria/COFEN), para abertura de PAD (fls. 1); b) Despacho DGEP/Cofen 034/2020 encaminhando os autos para análise e manifestação da CTLN (fls. 2); c) Protocolo Ouvidoria COFEN n. 15766904981116222733 contendo o objeto do presente parecer (fls. 3 F/V); e Comunicado Interno anexo ao protocolo da Ouvidoria/Cofen (fls. 4).", "sha256_texto": "5986c7357a79f52489396cda32ae8fc58dbc0c507256f03974f23563f5987db4", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2010_N_00049_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "2"}
{"identificador": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN_ITEM_LISTA_003", "normativo": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN", "tipo_dispositivo": "item_lista", "localizador": "Item de lista 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN_SECAO_002", "ordem": 9, "transcricao_literal": "É o relatório, em síntese. Passa-se à análise.", "sha256_texto": "6404752d9e23eb1bbf70ae6d70dd3cdd20ef2b941e5f10b99e4288153687902a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2010_N_00049_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "3"}
{"identificador": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN_SECAO_003", "normativo": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN", "tipo_dispositivo": "secao", "localizador": "II – DA FUNDAMENTAÇÃO E ANÁLISE", "dispositivo_superior": null, "ordem": 10, "transcricao_literal": "II – DA FUNDAMENTAÇÃO E ANÁLISE", "sha256_texto": "7dfb0cbc5614d846a003604254be2329f9c49524e3f8921631f7ff72bbdcacc7", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2010_N_00049_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN_ITEM_001", "normativo": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN", "tipo_dispositivo": "item", "localizador": "Item 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN_SECAO_003", "ordem": 11, "transcricao_literal": "4. Analisando detidamente o Comunicado Interno (incompleto), objeto do questionamento, de fato ficou estabelecido que no Serviço Público de Atendimento Móvel de Urgência de Salvador-BA, o enfermeiro, quando utilizar psicotrópicos durante o plantão, deverá anexar a prescrição médica à ficha de atendimento (prontuário) a qual foi usado o medicamento e levar ambos os documentos ao Almoxarifado para proceder a reposição pelo Farmacêutico ou por funcionário por ele designado.", "sha256_texto": "854e5e0aa50cfe20eb4cb8106c9b91c761bbcf9c60d9f941f85486a445d1df45", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2010_N_00049_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "numeracao": "4"}
{"identificador": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN_ITEM_002", "normativo": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN", "tipo_dispositivo": "item", "localizador": "Item 5", "dispositivo_superior": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN_SECAO_003", "ordem": 12, "transcricao_literal": "5. Consta, ainda, que no almoxarifado o farmacêutico ou o funcionário por ele designado verifica a concordância entre o registro de uso na ficha de atendimento e a prescrição apresentada, e procede a reposição, do contrário, não sendo confirmado o uso do psicotrópico, o mesmo não será reposto.", "sha256_texto": "359c6110fc47c351b34847164c2af50d074b07a17f649575248499327ec39caa", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2010_N_00049_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "numeracao": "5"}
{"identificador": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN_ITEM_003", "normativo": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN", "tipo_dispositivo": "item", "localizador": "Item 6", "dispositivo_superior": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN_SECAO_003", "ordem": 13, "transcricao_literal": "6. Por se tratar de Serviço Público, a responsabilidade legal é daquele que detém a posse dos documentos do paciente, sendo que o Comunicado Interno é um documento público que estabelece um protocolo simples de controle de psicotrópicos, não havendo qualquer ilegalidade no mesmo.", "sha256_texto": "afb63b97e888ca1ddc9c9bae36e16890330742c7f4c6c5659889a91905c0a2e0", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2010_N_00049_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "numeracao": "6"}
{"identificador": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN_ITEM_004", "normativo": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN", "tipo_dispositivo": "item", "localizador": "Item 7", "dispositivo_superior": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN_SECAO_003", "ordem": 14, "transcricao_literal": "7. Sendo assim, quando o enfermeiro cumpre com exatidão os termos do protocolo, entregando os documentos ao servidor público responsável (farmacêutico ou o funcionário por este indicado), transfere a responsabilidade da posse do documento, não podendo ser responsabilizado administrativamente, eticamente, civilmente e penalmente pelos atos daquele que passou, por determinação interna, a ter a posse e a responsabilidade dos documentos do paciente.", "sha256_texto": "be67d71a3f77d88eb5a4e8577324357433659f2f636f49d918bcfc461cb4fbd5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2010_N_00049_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "numeracao": "7"}
{"identificador": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN_ITEM_005", "normativo": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN", "tipo_dispositivo": "item", "localizador": "Item 8", "dispositivo_superior": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN_SECAO_003", "ordem": 15, "transcricao_literal": "8. É notório que tal procedimento, de fato, seja realizado, uma vez que o uso de psicotrópicos exige um controle rigoroso e especial a fim de se evitar o uso indevido e o extraviamento de tais medicações, conforme estabelece a Portaria MS/SVS n. 344, de 12 de maio de 1988, que aprova o Regulamento Técnico sobre substâncias e medicamentos sujeitos a controle especial.", "sha256_texto": "d398459c1b7c1f4e6147fa0cbc16f32c08e1db0768c758d95713db97e5f238ff", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2010_N_00049_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "numeracao": "8"}
{"identificador": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN_ITEM_006", "normativo": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN", "tipo_dispositivo": "item", "localizador": "Item 9", "dispositivo_superior": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN_SECAO_003", "ordem": 16, "transcricao_literal": "9. Assim, a medida não pode ser vista como excessiva, pois vincular a ficha de atendimento à prescrição médica é mais eficiente e eficaz para se comprovar, de fato, o uso adequado dos psicotrópicos do que simplesmente a verificação na receita especial, pelo que se torna uma medica adequada para se evitar extravios dessa medicação especial, dita “controlada”.", "sha256_texto": "80c2c3004876fb6e2bc514e1a44e1bc01d4607ec52212e57120bb12a48042ade", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2010_N_00049_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "numeracao": "9"}
{"identificador": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN_ITEM_007", "normativo": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN", "tipo_dispositivo": "item", "localizador": "Item 10", "dispositivo_superior": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN_SECAO_003", "ordem": 17, "transcricao_literal": "10. Portanto, não se vislumbra, no Comunicado Interno, qualquer tipo de regra ou de conduta imposta ao enfermeiro que resulte descumprimento do Código de Ética dos Profissionais de Enfermagem ou a qualquer outra legislação pátria, resultando em punição, seja ética, administrativa, penal ou cível.", "sha256_texto": "567862bf1ff763c89f9bf053de3af6a03ebd96b316baca81da7c4b76079242f4", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2010_N_00049_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "numeracao": "10"}
{"identificador": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2010_N_00049_CTLN_SECAO_003", "ordem": 18, "transcricao_literal": "É o Parecer, salvo melhor juízo.", "sha256_texto": "516d62e1304c0f38b045f2284a05f895551b1fa0c2fb9374c13e5e1d0a48e125", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2010_N_00049_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
