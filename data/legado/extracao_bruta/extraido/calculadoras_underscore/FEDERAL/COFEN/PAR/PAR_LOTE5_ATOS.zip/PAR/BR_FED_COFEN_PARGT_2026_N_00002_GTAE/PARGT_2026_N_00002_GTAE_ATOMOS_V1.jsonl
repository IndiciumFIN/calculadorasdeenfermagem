{"identificador": "BR_FED_COFEN_PARGT_2026_N_00002_GTAE_ITEM_001", "normativo": "BR_FED_COFEN_PARGT_2026_N_00002_GTAE", "tipo_dispositivo": "item", "localizador": "Item 1", "dispositivo_superior": "BR_FED_COFEN_PARGT_2026_N_00002_GTAE_SECAO_001", "ordem": 8, "transcricao_literal": "1. O senhor Rodrigo Alexandre Teixeira encaminhou correspondência ao Grupo de Trabalho das Eleições (GTAE), na qual faz consulta sobre a abrangência da regra contida no inciso XI do art. 12 do Código Eleitoral do Sistema Cofen/Conselhos Regionais de Enfermagem, aprovado pela Resolução Cofen nº 791/2025, que assim dispõe:", "sha256_texto": "ff13ed6103a2aab2c06891cffafa58eff6e401cde7f6ca0ed9755aa99abe84dd", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARGT_2026_N_00002_GTAE_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "numeracao": "1", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
