{"identificador": "BR_FED_COFEN_PARCT_2017_N_00008_CTLN_P53882_ITEM_001", "normativo": "BR_FED_COFEN_PARCT_2017_N_00008_CTLN_P53882", "tipo_dispositivo": "item", "localizador": "Item 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2017_N_00008_CTLN_P53882_SECAO_002", "ordem": 6, "transcricao_literal": "1. Trata-se de solicitação verbal a esta CTLN, do Presidente do Conselho Federal de Enfermagem, Dr. Manoel Carlos Neri da Silva, parecer referente ao Art. 59 A, Jornada de Trabalho de 12 x 36 horas, do Projeto de Lei da Consolidação das Leis Trabalhistas – CLT.", "sha256_texto": "44e3fd093ebdf30e98f827f3b314951c7b1e9bca17fe640fe244a4a7fb46999f", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2017_N_00008_CTLN_P53882_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "numeracao": "1"}
