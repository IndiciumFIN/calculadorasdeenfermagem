{"identificador": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_SECAO_001", "ordem": 8, "transcricao_literal": "Recebi na data de 21 de junho de 2023 o Processo SEI nº 00196.000635/2022-81 do Conselho Federal de Enfermagem que versa sobre solicitação da Presidência de parecer técnico referente à presença de profissionais especialistas em Unidades de Terapia Intensiva/UTI’s.", "sha256_texto": "579156abe31354a5f5855a91a2f93afd1fdd9b470e88e380a5594024f91f5bb4", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2023_N_00068_REPUB_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_SECAO_001", "ordem": 9, "transcricao_literal": "Fui designada pela Portaria Cofen nº 928/2023, para vistas aos autos, análise e emissão de parecer a ser apreciado pelo pleno do Cofen, conforme Lei n° 5.905 de 12 de julho de 1973 e Regimento Interno da Autarquia, aprovado pela Resolução Cofen n° 421 de 15 de fevereiro de 2012.", "sha256_texto": "22a3854105c8dc78fc3883f258e9d0371e2e345f33989e74532e0d8afa42d825", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2023_N_00068_REPUB_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_SECAO_001", "ordem": 10, "transcricao_literal": "O Processo SEI nº 00196.000635/2022-81 foi autuado após email encaminhado com o questionamento realizado pela Enfermeira Danniele Dantas, por meio da Ouvidoria Cofen no dia 30/08/2022, quanto à presença de enfermeiros generalistas em UTI’s de hospitais universitários.", "sha256_texto": "e89c6296c5c89561015b7b32b91444229db043f0bf32965879f5f59785820fdc", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2023_N_00068_REPUB_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_SECAO_001", "ordem": 11, "transcricao_literal": "Em 27 de março de 2023, a Dra Heloísa Helena Oliveira da Silva, Chefe do Departamento de Gestão do Exercício Profissional – DGEP, encaminhou para conhecimento e deliberação do Plenário o Parecer da Comissão Nacional de Terapia Intensiva – CNTI nº 001/2023. O parecer recomenda que a atuação de profissionais enfermeiros em UTI’s, de serviços públicos, privados ou filantrópicos, seja realizada por enfermeiros especialistas em Terapia Intensiva, com o devido registro de título da especialidade no Coren de sua jurisdição. Que depois de pedido de vista por esta conselheira na 553ª Reunião Ordinária de Plenária no dia 29 de maio de 2023 passo a análise.", "sha256_texto": "af65c2af5dffddd265f149e550f209803c67b65d5fb90f90fbfd573bf2ff9f9d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2023_N_00068_REPUB_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_SECAO_002", "normativo": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB", "tipo_dispositivo": "secao", "localizador": "II. FUNDAMENTAÇÃO", "dispositivo_superior": null, "ordem": 12, "transcricao_literal": "II. FUNDAMENTAÇÃO", "sha256_texto": "685155de3de3ed3f2f8f8b81dbe74f0335422a2abbc215c5604d7e9096b7c5c5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2023_N_00068_REPUB_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_SECAO_002", "ordem": 13, "transcricao_literal": "É importante enfatizar que a Unidade de Terapia Intensiva é um ambiente de acesso restrito, direcionado a cuidados críticos, ou seja, o tratamento de pessoas com risco de vida e que a gravidade, requer recursos tecnológicos cada vez mais avançados aliado ao cuidado multidisciplinar humanizado.", "sha256_texto": "829c73d66b2656cb399334104083151097cc2ddaf3bd937edc48859a778469bb", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2023_N_00068_REPUB_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_SECAO_002", "ordem": 14, "transcricao_literal": "O exercício da Enfermagem deve ser executado seguindo todos os preceitos técnicos, científicos e éticos previstos na legislação vigente, e o conhecimento é um recurso dominante em valor ético voltado à vida e guiado a partir do princípio da Segurança.", "sha256_texto": "4a025f044f6978e0ebab70173a619ecb75f5030b6f49ba97fb16e5f36193b47a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2023_N_00068_REPUB_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_SECAO_002", "ordem": 15, "transcricao_literal": "O Ministério da Saúde define Unidades de Terapia Intensiva como áreas críticas destinadas à internação de pacientes graves, que requerem atenção profissional habilitada, a qual deve ser dimensionada quantitativa e qualitativamente, de acordo com o perfil assistencial de forma contínua, materiais específicos e tecnologias necessárias ao diagnóstico, monitorização e terapia. Sua localização física deve conter os recursos materiais e humanos necessários ao atendimento do paciente grave (BRASIL, 2010).", "sha256_texto": "1ca1901dd3b0fff2c342b19ef21605f685ae58a39a947d390d99e4ee1b81e5a1", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2023_N_00068_REPUB_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_SECAO_002", "ordem": 16, "transcricao_literal": "A Lei nº 7.498/1986, que regulamenta o exercício profissional da Enfermagem no Brasil, elenca como atividades privativas do enfermeiro os cuidados diretos de Enfermagem a pacientes graves com risco de vida, e cuidados de Enfermagem de maior complexidade técnica e que exijam conhecimentos de base científica e capacidade de tomar decisões imediatas.", "sha256_texto": "0ece232019a066b5eb7787bb6f22a17b7122d88b5390246c11ddd0632b856b4d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2023_N_00068_REPUB_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_PARAGRAFO_TEXTO_012", "normativo": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_SECAO_002", "ordem": 17, "transcricao_literal": "A RDC Anvisa nº 7/2010, dispõe sobre os requisitos mínimos para funcionamento de Unidades de Terapia Intensiva entre eles a infraestrutura física e os recursos humanos necessários enfatizando a importância de uma política de educação permanente. (BRASIL, 2010).", "sha256_texto": "760f702cc3a17b863f1610fa9c374d5a663fbd73b33808a5256646cfdc891c52", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2023_N_00068_REPUB_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_PARAGRAFO_TEXTO_013", "normativo": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_SECAO_002", "ordem": 18, "transcricao_literal": "Já a RDC Anvisa nº 137/2017, que altera o artigo 13 da RDC Anvisa nº 7/2010, diz que o Responsável Técnico médico, os coordenadores de Enfermagem e de fisioterapia devem ter título de especialista, conforme estabelecido pelos respectivos conselhos de classe e associações reconhecidas por estes para este fim (BRASIL, 2017).", "sha256_texto": "452291be57c537a4a5635eed417c2e12c7df1cc549677e09ff8dba97ad1907a9", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2023_N_00068_REPUB_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_PARAGRAFO_TEXTO_014", "normativo": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 7", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_SECAO_002", "ordem": 19, "transcricao_literal": "Cumpre-nos esclarecer a temática sobre o cuidado critico onde a legislação legal e infralegal vigentes consideram a necessidade de profissionais que tenham conhecimento científico, técnico e ético atualizado com ênfase em uma política de Educação permanente para o aprimoramento profissional.", "sha256_texto": "b1ffdbfc643f4b62a95e312d77ed36427de1c41a6e014ead25439a143fa4c285", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2023_N_00068_REPUB_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_PARAGRAFO_TEXTO_015", "normativo": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 8", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_SECAO_002", "ordem": 20, "transcricao_literal": "É indiscutível entender a amplitude do processo de trabalho da Enfermagem na UTI e a importância do conhecimento para o atendimento a paciente graves, considerando além da sua complexidade clínica, o aparato tecnológico inerente ao cuidado intensivo e protocolos específicos para atendimento, mas não resta dúvida ao consultarmos a Lei do exercício profissional de Enfermagem que o enfermeiro generalista tem competência técnica e cientifica para atuar com cuidados a pacientes críticos.", "sha256_texto": "f01282b07ba75f03e2c781da10d23be28bbee4c381844e044a63bb71fc9b402e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2023_N_00068_REPUB_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_SECAO_003", "normativo": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB", "tipo_dispositivo": "secao", "localizador": "III. CONCLUSÃO", "dispositivo_superior": null, "ordem": 21, "transcricao_literal": "III. CONCLUSÃO", "sha256_texto": "8c7e1360ea68d3681e2ee822aa41aba75cc7f69f87e83a200f76660890666064", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2023_N_00068_REPUB_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_PARAGRAFO_TEXTO_016", "normativo": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2023_N_00068_REPUB_SECAO_003", "ordem": 22, "transcricao_literal": "Ante ao exposto, em conformidade com a Lei n° 7.498, de 25 de junho de 1986, entende –se que o profissional Enfermeiro, quando de posse de seu diploma de graduação e devidamente inscrito em seu Conselho Profissional, se torna legalmente habilitado para exercer as funções compatíveis com a sua formação em todo território nacional, inclusive aquelas previstas com os cuidados de Enfermagem em UTI de serviços públicos, privados ou filantrópicos. Aliado ao fortalecimento de uma política de Educação permanente para aprimoramento da competência técnica cientifica e ética para atuação com cuidados críticos.", "sha256_texto": "4dd2d044faf7fd1cb03b8439f8aa98011ce3a0888caa6badeec56f918bf2f8b5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2023_N_00068_REPUB_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
