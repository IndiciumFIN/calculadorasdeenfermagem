{"identificador": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_ART_048", "normativo": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 48 (citado/transcrito)", "dispositivo_superior": null, "ordem": 15, "transcricao_literal": "Art. 48. Os diplomas de cursos superiores reconhecidos, quando registrados, terão validade nacional como prova da formação recebida por seu titular.", "sha256_texto": "1a0983ce792860eb169141bcb6b3d216ba865377ce41492f0717edacc849b20c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00022_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Artigo citado ou transcrito de outra norma (sequência não inicia em 1 no escopo); não é articulado próprio."}
