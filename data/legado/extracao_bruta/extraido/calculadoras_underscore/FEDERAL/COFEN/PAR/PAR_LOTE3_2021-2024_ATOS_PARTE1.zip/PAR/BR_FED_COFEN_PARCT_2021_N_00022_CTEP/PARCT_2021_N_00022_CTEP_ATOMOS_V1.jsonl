{"identificador": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 7", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_SECAO_002", "ordem": 19, "transcricao_literal": "A Resolução CNE/CES nº 2/2007, preconiza no seu Artigo 1º:", "sha256_texto": "d007828a505033c564fa98001ce19ffa624f69615ac498238373e4b578f84bdf", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00022_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_ART_001", "normativo": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 1º (citado/transcrito)", "dispositivo_superior": null, "ordem": 20, "transcricao_literal": "Art. 1º Cursos de pós-graduação lato sensu denominados cursos de especialização são programas de nível superior, de educação continuada, com os objetivos de complementar a formação acadêmica, atualizar, incorporar competências técnicas e desenvolver novos perfis profissionais, com vistas ao aprimoramento da atuação no mundo do trabalho e ao atendimento de demandas por profissionais tecnicamente mais qualificados para o setor público, as empresas e as organizações do terceiro setor, tendo em vista o desenvolvimento do país.", "sha256_texto": "bf5739fb15e70e66845e024bfce6a27baded7ea59873dfef05377bab86efafdd", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00022_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Artigo citado ou transcrito de outra norma (sequência não inicia em 1 no escopo); não é articulado próprio."}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_ITEM_LISTA_004", "normativo": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP", "tipo_dispositivo": "item_lista", "localizador": "Item de lista", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_ART_001", "ordem": 21, "transcricao_literal": "1º Os cursos de especialização são abertos a candidatos diplomados em cursos de graduação, que atendam às exigências das instituições ofertantes.", "sha256_texto": "e9e7b249d250cc30d5129ae087d44c42e1fe228d4bd794e542105113f2876f1a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00022_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "•"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_ITEM_LISTA_005", "normativo": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP", "tipo_dispositivo": "item_lista", "localizador": "Item de lista", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_ART_001", "ordem": 22, "transcricao_literal": "2º Os cursos de especialização poderão ser oferecidos presencialmente ou a distância, observadas a legislação, as normas e as demais condições aplicáveis à oferta, à avaliação e à regulação de cada modalidade, bem como o Plano de Desenvolvimento Institucional (PDI).", "sha256_texto": "565810a13f88ed12473147c0bcc736e9ae94d82bcfa559591bb4bfd6247b8269", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00022_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "•"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_ITEM_LISTA_006", "normativo": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP", "tipo_dispositivo": "item_lista", "localizador": "Item de lista", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_ART_001", "ordem": 23, "transcricao_literal": "3º Poderão ser incluídos na categoria de curso de pós-graduação lato sensu aqueles cuja oferta se ajuste aos termos desta Resolução, mediante declaração de equivalência pela Câmara de Educação Superior do Conselho Nacional de Educação.", "sha256_texto": "c8954ecec258a70549409518ba9da70d338ad252c000022cb9565f97bdcad759", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00022_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "•"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 8", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_SECAO_002", "ordem": 24, "transcricao_literal": "[…]", "sha256_texto": "b94f345ea5affa7e142e643b8126fe247c9c63bd7242bdd33d9231123deede9b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00022_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_PARAGRAFO_TEXTO_012", "normativo": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 9", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_SECAO_002", "ordem": 25, "transcricao_literal": "Considerando a Lei Nº 5.905, de 12 de julho de 1973, que “Dispõe sobre a criação dos Conselhos Federal e Regionais de Enfermagem e dá outras providências”, em seu Art. 2º dispõe que: “O Conselho Federal e os Conselhos Regionais são órgãos disciplinadores do exercício da profissão de enfermeiro e das demais profissões compreendidas nos serviços de Enfermagem” (BRASIL, 1973);", "sha256_texto": "db8b6879600df5a395800023e3a0d9f4130b9d181508543cf69a6877444937e2", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00022_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_PARAGRAFO_TEXTO_013", "normativo": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 10", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_SECAO_002", "ordem": 26, "transcricao_literal": "Considerando a Lei nº 7.498, de 25 de junho de 1986, que “Dispõe sobre a regulamentação do exercício da Enfermagem e dá outras providências” (BRASIL, 1986, s/p.), em seu Art. 2º garante que “A Enfermagem e suas atividades Auxiliares somente podem ser exercidas por pessoas legalmente habilitadas e inscritas no Conselho Regional de Enfermagem com jurisdição na área onde ocorre o exercício”;", "sha256_texto": "86ed7004512a1c4f744c5deb43a29301b32de7c2c49c9e39b2894f560cfe69e2", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00022_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_PARAGRAFO_TEXTO_014", "normativo": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 11", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_SECAO_002", "ordem": 27, "transcricao_literal": "Considerando o Decreto Nº 94.406/1987, que “Regulamenta a Lei nº 7.498, de 25 de junho de 1986, que dispõe sobre o exercício da Enfermagem, e dá outras providências” (BRASIL, 1987), em seu Artigo 1º que garante que o “exercício da atividade de Enfermagem, observadas as disposições da Lei 7.498, de 25 de junho de 1986, e respeitados os graus de habilitação, é privativo de Enfermeiro, Técnico de Enfermagem, Auxiliar de Enfermagem e Parteiro e só será permitido ao profissional inscrito no Conselho Regional de Enfermagem da respectiva região”;", "sha256_texto": "73170b869a927634d9aa469456d9728ce602331e768adf9fb57f20bf858a69f8", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00022_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_PARAGRAFO_TEXTO_015", "normativo": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 12", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_SECAO_002", "ordem": 28, "transcricao_literal": "Considerando a Resolução CNE/CES Nº 1, de 6 de abril de 2018 que estabelece as diretrizes e normas para a oferta dos cursos de pós-graduação no Brasil;", "sha256_texto": "5c28b706ea6331566c4e5c80d982e178b77adf31a1f919acd5aae6d5cdd46ca6", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00022_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_PARAGRAFO_TEXTO_016", "normativo": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 13", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_SECAO_002", "ordem": 29, "transcricao_literal": "Considerando o Código de Ética dos Profissionais de Enfermagem (COFEN, 2017), no Capítulo II – Dos Deveres, em seu Art. 55, cita que os profissionais de Enfermagem devem buscar “aprimorar os conhecimentos técnico-científicos, ético-políticos, socioeducativos e culturais, em benefício da pessoa, família e coletividade e do desenvolvimento da profissão”;", "sha256_texto": "85a46f13e2f517bf78ab6f3b6e3b3a4d730c2f608f5864a9463a0092e04a4995", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00022_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_PARAGRAFO_TEXTO_017", "normativo": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 14", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_SECAO_002", "ordem": 30, "transcricao_literal": "Considerando-se ser esta Câmara Técnica, “órgão permanente de natureza consultiva, propositiva e avaliativa sobre matéria relativa ao exercício da Enfermagem”, segundo Art. 1º do Regimento Interno do Cofen, no entanto, sem competência deliberativa (Cofen, 2012);", "sha256_texto": "b1e25c19a672d36de3692a9a06bd29994182b5f6bb7f6284a497fb1dd0b3a5b5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00022_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_PARAGRAFO_TEXTO_018", "normativo": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 15", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_SECAO_002", "ordem": 31, "transcricao_literal": "Considerando-se o Art. 13 do Regimento Interno das Câmaras Técnicas do Cofen, que compete à CTEP: “VI – subsidiar o Sistema Cofen/Coren em ações quer promovam o desenvolvimento técnico-científico em Enfermagem; VII – pronunciar-se, mediante Parecer […]” (COFEN, 2019);", "sha256_texto": "8395b0ff238e5199586b937069cc42acb7f937b27a6db56cbaf2f4e66aa11dfc", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00022_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_PARAGRAFO_TEXTO_019", "normativo": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 16", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_SECAO_002", "ordem": 32, "transcricao_literal": "Considerando por fim a manifestação da chefia do Setor de Inscrição, Registro e Cadastro do Cofen – SIRC/Cofen, por meio do seu memorando nº 147/2022, datado de 09 de maio de 2022, onde, esclarece a questão em relação à mudança de denominação da Instituição de Ensino Superior – IES, que passou a ter a denominação de “Faculdade Venda Nova do Imigrante”, possuindo cadastro regular junto ao portal do Ministério da Educação – e-MEC;", "sha256_texto": "c3f42b8836ed5a54699ce61240d7a19a149e9aa3ab8f8a7ab03dbf0a03b203e1", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00022_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_PARAGRAFO_TEXTO_020", "normativo": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 17", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_SECAO_002", "ordem": 33, "transcricao_literal": "Considerando que fora a inconsistência observada à época, em relação ao registro no e-MEC o motivo do indeferimento do pleito;", "sha256_texto": "818f1cbcb4a80faf04234f33265fbe1490071ff4d3bcab6eaec90799450f8efd", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00022_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_PARAGRAFO_TEXTO_021", "normativo": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 18", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_SECAO_002", "ordem": 34, "transcricao_literal": "Conclui-se:", "sha256_texto": "632dcf9a4e8c510cb19198c7b843196b0a73ada2fde3eb13e2b593164852dd92", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00022_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_PARAGRAFO_TEXTO_022", "normativo": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 19", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_SECAO_002", "ordem": 35, "transcricao_literal": "Após análise dos PAD Nº 0638/2020, em tela, esta Câmara Técnica, com base na Resolução Cofen Nº 581/2018, sugere ao Egrégio Plenário, que neste caso, e desta feita em reanálise, dê apreciação favorável e aprove o registro da Especialização lato sensu em “Ensino de Braille e Libras” e “Educação Especial e Inclusiva e Neuropsicopedagogia Institucional e Clínica”, emitido pela Faculdade Venda Nova do Imigrante/ES, do profissional Antonio Aparecido Caldeira.", "sha256_texto": "d9672d38ffae3860bde71ee5daaef15e36db05fb24e5a0c565b5c6e4f6fe443c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00022_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
