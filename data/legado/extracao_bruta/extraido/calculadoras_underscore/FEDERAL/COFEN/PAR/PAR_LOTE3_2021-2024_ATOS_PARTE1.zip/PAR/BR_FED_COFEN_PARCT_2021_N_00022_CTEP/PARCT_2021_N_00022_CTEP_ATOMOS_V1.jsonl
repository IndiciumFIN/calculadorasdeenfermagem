{"identificador": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_ITEM_LISTA_003", "normativo": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP", "tipo_dispositivo": "item_lista", "localizador": "Item de lista", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00022_CTEP_ART_048", "ordem": 17, "transcricao_literal": "2º Os diplomas de graduação expedidos por universidades estrangeiras serão revalidados por universidades públicas que tenham curso do mesmo nível e área ou equivalente, respeitando-se os acordos internacionais de reciprocidade ou equiparação.", "sha256_texto": "100caa8f250dcd35a4d198eedb3abdff2143ca8391583b707bfde284e220c656", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00022_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "•"}
