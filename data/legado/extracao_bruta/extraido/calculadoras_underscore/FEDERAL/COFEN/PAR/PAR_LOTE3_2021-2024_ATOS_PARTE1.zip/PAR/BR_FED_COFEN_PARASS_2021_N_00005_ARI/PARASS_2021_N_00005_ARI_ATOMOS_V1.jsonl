{"identificador": "BR_FED_COFEN_PARASS_2021_N_00005_ARI_ART_003", "normativo": "BR_FED_COFEN_PARASS_2021_N_00005_ARI", "tipo_dispositivo": "artigo", "localizador": "Art. 3º", "dispositivo_superior": null, "ordem": 22, "transcricao_literal": "Art. 3º Notificar a instituição de ensino superior do teor da decisão para apresentação de defesa no prazo de 15 (quinze) dias, nos termos do parágrafo único, do art. 71, do Decreto nº 9.235/2017; e para apresentação de recurso no prazo de 30 (trinta) dias, nos termos do art. 63, § 2º, do Decreto nº 9.235/2017, por meio eletrônico, pelo Módulo Comunicador do sistema e-MEC.", "sha256_texto": "cb2a4f65cb93ee1888dd2eb0ce3d0fab4be6fc0d17d9d288cc4fac6ee9661243", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2021_N_00005_ARI_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARASS_2021_N_00005_ARI_ART_004", "normativo": "BR_FED_COFEN_PARASS_2021_N_00005_ARI", "tipo_dispositivo": "artigo", "localizador": "Art. 4º", "dispositivo_superior": null, "ordem": 23, "transcricao_literal": "Art. 4º Notificar os órgãos que representaram junto ao MEC sobre a referida apuração.", "sha256_texto": "9c4051d779d81ee9cbe72645615890fd542dec46ec26d286ccf04995b7e5a9f0", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2021_N_00005_ARI_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARASS_2021_N_00005_ARI_ART_004_INC_III", "normativo": "BR_FED_COFEN_PARASS_2021_N_00005_ARI", "tipo_dispositivo": "inciso", "localizador": "Inciso III", "dispositivo_superior": "BR_FED_COFEN_PARASS_2021_N_00005_ARI_ART_004", "ordem": 24, "transcricao_literal": "III. Conclusão Face ao exposto essa assessoria entende que o item VI (suspensão ou restrição da possibilidade de participação em outros programas federais de acesso ao ensino relacionados ao seu curso de Enfermagem) restringe a possibilidade de a IES ofertar Cursos de Pós Graduação em Enfermagem e emitir certificados.", "sha256_texto": "0b6ec15e8bf7e492ce756b55a09a6217f996c8f5e233145fb1bdffdc6a8684c5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2021_N_00005_ARI_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARASS_2021_N_00005_ARI_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_COFEN_PARASS_2021_N_00005_ARI", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARASS_2021_N_00005_ARI_SECAO_002", "ordem": 25, "transcricao_literal": "Ainda, no Sistema e-MEC demostra que todos os Cursos de Especialização da IES estão sob Procedimento Saneador com Medida Cautelar: Portaria N. 198/2020, publicado no Diário Oficial da União – DOU em 26/06/2020.", "sha256_texto": "490b4df444e422a198d1baab23490617b76097d0ee46ff6588472061bf06a36d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2021_N_00005_ARI_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARASS_2021_N_00005_ARI_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARASS_2021_N_00005_ARI", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARASS_2021_N_00005_ARI_SECAO_002", "ordem": 26, "transcricao_literal": "Senhores conselheiros e senhoras conselheiras, tudo o que consta nos autos e especialmente na Portaria nº 198 de 25 de junho de 2020 do Ministério da Educação/Secretaria de Regulação e Supervisão da Educação, cabe somente recomendar que não há amparo legal para o pleito dos impetrantes.", "sha256_texto": "e00050911a8fff66e97ff2d178815dd4e30618b7fa647e172731ef91a4f8bb82", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2021_N_00005_ARI_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
