{"identificador": "BR_FED_COFEN_PARCONS_2017_N_00083_PARAGRAFO_TEXTO_021", "normativo": "BR_FED_COFEN_PARCONS_2017_N_00083", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 14", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2017_N_00083_SECAO_003", "ordem": 34, "transcricao_literal": "Para não gerar anuidade em nome do profissional deverá estar amparado nas situações estabelecidas no art. 41 da Resolução Cofen 448/2013.", "sha256_texto": "6f729934d8fe4b76e6c81a7f236b09d7a643af68839a73c04229baa4160edf26", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2017_N_00083_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARCONS_2017_N_00083_PARAGRAFO_TEXTO_022", "normativo": "BR_FED_COFEN_PARCONS_2017_N_00083", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 15", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2017_N_00083_SECAO_003", "ordem": 35, "transcricao_literal": "Nos atos de fiscalização ou em levantamento proativo por parte do Setor de Registro, constatado o vencimento da validade da carteira, se notifica o profissional. E caso o profissional não tenha procurado o Conselho não o isenta do pagamento das anuidades vencidas.", "sha256_texto": "4d9b66c5cfa0ecf42e467686e49588cf9cf1bf9a7e3caea72f32cc62c558ef47", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2017_N_00083_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
