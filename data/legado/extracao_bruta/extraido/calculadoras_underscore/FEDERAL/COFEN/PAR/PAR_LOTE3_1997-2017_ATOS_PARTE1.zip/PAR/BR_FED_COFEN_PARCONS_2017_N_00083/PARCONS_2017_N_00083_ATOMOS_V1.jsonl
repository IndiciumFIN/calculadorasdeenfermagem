{"identificador": "BR_FED_COFEN_PARCONS_2017_N_00083_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_PARCONS_2017_N_00083", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2017_N_00083_SECAO_003", "ordem": 14, "transcricao_literal": "O profissional deve ter ciência de suas obrigações estabelecidas no art. 53 do Código de Ética. Manter os dados pessoais e profissionais atualizados e regularizados é da responsabilidade do inscrito.", "sha256_texto": "4243b432a423cbe3780e51b25372ad576813babb75136985d8973a4925275778", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2017_N_00083_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
