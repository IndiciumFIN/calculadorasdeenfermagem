{"identificador": "BR_FED_COFEN_PARCONS_2017_N_00083_PARAGRAFO_TEXTO_001", "normativo": "BR_FED_COFEN_PARCONS_2017_N_00083", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2017_N_00083_SECAO_002", "ordem": 6, "transcricao_literal": "Recebi na data de 09/11/2016 o PAD 671/2016, através da Portaria Cofen 1800/2016, para relatoria, contendo de 01 à 19 páginas, devidamente numeradas e rubricadas, que trata de solicitação de parecer jurídico quanto a inscrição suspensa por falta de diploma e carteira de identidade profissional vencida.", "sha256_texto": "8d6864a69a7f6a3f0876907ca6569f4c3b56a4d2e11e86193398b707430a0deb", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2017_N_00083_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "EQUIVALENTE_OCR", "similaridade": 99.7, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARCONS_2017_N_00083_PARAGRAFO_TEXTO_002", "normativo": "BR_FED_COFEN_PARCONS_2017_N_00083", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2017_N_00083_SECAO_002", "ordem": 7, "transcricao_literal": "O PAD foi aberto em 19/08/2016 devido provocação dos Conselhos Regionais do Pará e Minas Gerais.", "sha256_texto": "c3b1992bf490252696cb1742b9012c927f78a04697aa419901028f9f70fad590", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2017_N_00083_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "EQUIVALENTE_OCR", "similaridade": 98.9, "cobertura_vocabulario": 0.889, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARCONS_2017_N_00083_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARCONS_2017_N_00083", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2017_N_00083_SECAO_002", "ordem": 8, "transcricao_literal": "O Coren-PA indaga quais medidas devem ser adotadas em relação a carteira de identidade profissional-CIP vencida ou suspensa. Relata que o Manual de Fiscalização não estampa de forma clara estas medidas a serem tomadas em situação da não apresentação do diploma no prazo de 01 ano e a validade da carteira de identidade profissional vencida.", "sha256_texto": "9140e8eae075111592a24c3c4f11cc4e0df7964043efbb5efed6fd456ad702e3", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2017_N_00083_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARCONS_2017_N_00083_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARCONS_2017_N_00083", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2017_N_00083_SECAO_002", "ordem": 9, "transcricao_literal": "O Coren-MG através do Procurador Geral buscou esclarecer a dúvida da Unidade Financeira do Regional, que indagou o lançamento da anuidade aos profissionais com a carteira vencida. O entendimento do Procurador é a suspensão da cobrança da anuidade, mas continua a gerar os débitos e quando o profissional regularizar a situação cobra-se todo atrasado. Em outra análise o Prurador entende, que o fato gerador da cobrança da anuidade está no ato de inscrição do profisi\\nal no Conselho amparado pelo Código Tributário Nacional e Lei 12.514/2011.", "sha256_texto": "882810ad100caa8422ad7d4bf5423c6ce94595910d02289b2d53709c3d51c95e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2017_N_00083_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "EQUIVALENTE_OCR", "similaridade": 99.1, "cobertura_vocabulario": 0.959, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
