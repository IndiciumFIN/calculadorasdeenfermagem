{"identificador": "BR_FED_COFEN_PARCONS_2017_N_00041_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_PARCONS_2017_N_00041", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2017_N_00041_SECAO_002", "ordem": 10, "transcricao_literal": "Como proposta da Assessoria de Planejamento e Gestão, compondo a iniciativa estratégica do Cofen e, sendo a primeira vez em todo o sistema Cofen/Conselhos Regionais de Enfermagem, pontuando e tomando para si a orientação e sugestão do Tema Nacional para a Semana da Enfermagem, como também, é de notório saber, o empenho do Cofen aos Conselhos Regionais de Enfermagem, na comemoração da Semana de Enfermagem com Treinamentos, Palestras, Cursos, Workshop e diversos outras modalidades de abrangência aos profissionais da enfermagem, motivando, capacitando e elogiando-os como uma maneira de retribuir todo o empenho profissional de cada um.", "sha256_texto": "cbca247f2727277b170d4aec7b42f057806d8744525d3013a836da217eb856ec", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2017_N_00041_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
