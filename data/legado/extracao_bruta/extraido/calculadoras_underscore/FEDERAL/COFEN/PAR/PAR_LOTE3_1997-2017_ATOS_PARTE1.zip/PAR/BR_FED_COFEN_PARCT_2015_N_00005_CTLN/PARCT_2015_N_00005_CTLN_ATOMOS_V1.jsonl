{"identificador": "BR_FED_COFEN_PARCT_2015_N_00005_CTLN_PARAGRAFO_TEXTO_002", "normativo": "BR_FED_COFEN_PARCT_2015_N_00005_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2015_N_00005_CTLN_SECAO_001", "ordem": 5, "transcricao_literal": "O parecer aponta para a lega/idade do Enfermeiro prescrever medicamentos e ter aceite nas farmácias vinculadas e/ou conveniadas com a rede pública.", "sha256_texto": "1b130ea6c322739ff549ceac79ed56f1ee9cfeb7f52cf9f7469aace8346a81ea", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2015_N_00005_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
