{"identificador": "BR_FED_COFEN_PARCT_2015_N_00005_CTLN_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARCT_2015_N_00005_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2015_N_00005_CTLN_SECAO_002", "ordem": 7, "transcricao_literal": "Trata-se de encaminhamento a esta CTLN, pela Secretaria Geral, do PAD Cofen n° 021712015, para emissão de Parecer referente ao questionamento feito pelo Presidente do Conselho Regional de Enfermagem do Piauí, acerca da aceitação da prescrição de medicamentos feita por enfermeiros na Rede de Farmácias Populares do Governo Federal e na Rede de Farmácia Popular do Brasil. Compõem os autos processuais os seguintes documentos: a) Ofício Coen-PI N° 012/GAB PRESIDÊNCIA, datado de 17/0312015, encaminhado pelo Presidente daquele Regional (fi. 01); b) Despacho do Chefe de Gabinete da Presidência Sra. Coordenadora da CTLN solicitando abertura de PAD e posterior envio à CTLN (fl. 02); 2. Encaminhamento à CTLN pelo setor de Arquivo e Protocolo para providências.", "sha256_texto": "df21e5ac3e0e53b08f9ab8a994c0917e17da9c707a3a17519475d2e580288423", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2015_N_00005_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2015_N_00005_CTLN_ITEM_001", "normativo": "BR_FED_COFEN_PARCT_2015_N_00005_CTLN", "tipo_dispositivo": "item", "localizador": "Item 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2015_N_00005_CTLN_SECAO_002", "ordem": 8, "transcricao_literal": "2. É o relatório, em síntese. Passa-se à análise.", "sha256_texto": "923cf2afd25b3effab24cfd365512adbe01221b900c7b15a6c035a8389537c00", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2015_N_00005_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "numeracao": "2"}
