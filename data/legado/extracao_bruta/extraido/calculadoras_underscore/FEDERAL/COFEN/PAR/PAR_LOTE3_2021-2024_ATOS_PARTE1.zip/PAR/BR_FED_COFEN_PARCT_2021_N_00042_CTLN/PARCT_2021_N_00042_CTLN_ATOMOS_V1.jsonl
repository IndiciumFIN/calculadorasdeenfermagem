{"identificador": "BR_FED_COFEN_PARCT_2021_N_00042_CTLN_ITEM_LISTA_005", "normativo": "BR_FED_COFEN_PARCT_2021_N_00042_CTLN", "tipo_dispositivo": "item_lista", "localizador": "Item de lista 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00042_CTLN_SECAO_003", "ordem": 22, "transcricao_literal": "Diante de todo o exposto, resta claro, que a luz da legislação vigente, como profissão regulamentada, o Enfermeiro e Técnico de Enfermagem não podem ser MEI, uma vez que não estão inclusos nas atividades englobadas por essa categoria, que visa a formalização de profissionais autônomos e de profissões não regulamentadas.", "sha256_texto": "0cbb1b0f0d9a366c5bcd72b83dbe0124a36edf442af274c5917ade297456e50b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00042_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "1"}
