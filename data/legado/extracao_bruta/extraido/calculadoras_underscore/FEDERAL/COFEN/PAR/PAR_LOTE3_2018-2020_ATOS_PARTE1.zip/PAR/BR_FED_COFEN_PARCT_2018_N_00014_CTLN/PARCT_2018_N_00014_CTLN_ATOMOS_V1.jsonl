{"identificador": "BR_FED_COFEN_PARCT_2018_N_00014_CTLN_PARAGRAFO_TEXTO_002", "normativo": "BR_FED_COFEN_PARCT_2018_N_00014_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2018_N_00014_CTLN_SECAO_002", "ordem": 6, "transcricao_literal": "Trata-se de encaminhamento de documento em epígrafe, emanado do Coren-ES, solicitando revisão do Parecer Normativo Cofen nº 003/2017, oriundo do Parecer emanado por esta Câmara Técnica CTLN/COFEN nº 005/2017 em que o Ministério da Defesa/ Comando da Aeronáutica/ Escola de Especialista de Aeronáutica solicitou à época parecer quanto à possibilidade de admissão de Enfermeiro em vaga de Técnico de Enfermagem. Compõe os autos: a) Despacho GAB/Presidência nº 02882/2018; b) Ofício nº 603/2018/GAB/PRES/COREN-ES, do Sr. Presidente em exercício Dr. Wladmilson Gama Almeida; c) Despacho do PROJU do Coren-ES; d) Memorando nº 673/2018 da Fiscalização; e) Memorando nº 648/2018 de Enfermeiro Fiscal; f) Ofício Circular nº 0056/2017/GAB/PRES do Cofen; g) Cópia do Parecer Normativo Cofen nº 003/2017.", "sha256_texto": "374672b06bc4acaae8e959e589c5c3a3736557d0451471e7071ddad689310c77", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2018_N_00014_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "EQUIVALENTE_OCR", "similaridade": 99.7, "cobertura_vocabulario": 0.986, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
