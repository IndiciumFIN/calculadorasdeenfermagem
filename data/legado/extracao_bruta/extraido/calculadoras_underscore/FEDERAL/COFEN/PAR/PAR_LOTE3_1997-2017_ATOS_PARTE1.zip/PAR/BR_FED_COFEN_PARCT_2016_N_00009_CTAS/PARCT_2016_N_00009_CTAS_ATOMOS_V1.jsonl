{"identificador": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_PARAGRAFO_TEXTO_001", "normativo": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_SECAO_001", "ordem": 6, "transcricao_literal": "Trata-se do PAD Cofen N. 0303/2016 composto de três folhas encaminhado a esta Câmara Técnica de Atenção à Saúde (CTAS), pelo Sr. Mauro Ricardo Antunes Figueiredo, Chefe de Gabinete do Cofen, para análise, manifestação e demais encaminhamentos cabíveis.", "sha256_texto": "b32fe2f9b953f7239f376416bef425025df3acd580e32f3bce1845e7bb522525", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2016_N_00009_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_SECAO_002", "normativo": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS", "tipo_dispositivo": "secao", "localizador": "II – DO HISTÓRICO DOS FATOS", "dispositivo_superior": null, "ordem": 7, "transcricao_literal": "II – DO HISTÓRICO DOS FATOS", "sha256_texto": "cd0209b91c0efb5827eccf081e25cd44b3983b152af18c343c993fb6666da26c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2016_N_00009_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_PARAGRAFO_TEXTO_002", "normativo": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_SECAO_002", "ordem": 8, "transcricao_literal": "A Sra. Itana Miranda dos Santos, do Departamento de DST/AIDS e Hepatites Virais/SVS do Ministério da Saúde, enviou e-mail para este egrégio conselho, no dia 4 de abril de 2016, solicitando informações parecer sobre a seguinte orientação:", "sha256_texto": "fd1af06c19b7d0feaa0fc4e0f14a152235ab1b8a2f96905ae55366722f244040", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2016_N_00009_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_SECAO_002", "ordem": 9, "transcricao_literal": "“Pacientes com diagnóstico positivo para Sífilis, que necessitam de tratamento IM (Penicilina benzatina 1.200.000 UI – 2,4 milhões UI por semana, totalizando 7,2 milhões UI em 3 semanas) e usam prótese de silicone na região glútea e vasto lateral da coxa.”", "sha256_texto": "5d6728c57da775794d7ef2bcd06543f81009d426628839a424159f1b370d24b4", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2016_N_00009_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_SECAO_003", "normativo": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS", "tipo_dispositivo": "secao", "localizador": "III – DA ANÁLISE", "dispositivo_superior": null, "ordem": 10, "transcricao_literal": "III – DA ANÁLISE", "sha256_texto": "d591ed890754e3494b9e513e0c3af3b6a5294ac4a34474db584e0fed54813c78", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2016_N_00009_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_SECAO_003", "ordem": 11, "transcricao_literal": "A palavra Injeção é definida como “um procedimento em que uma substância é introduzida e depositada por meio de uma agulha estéril nos tecidos corpóreos, geralmente na derme, no tecido cutâneo, no músculo, ou diretamente na corrente sanguínea” (OLIVEIRA; TAKAHASHI; ARAÚJO, 2008).", "sha256_texto": "8caae3f6251b2a166f67d41e0cb7b9523e24a4e39867ed27cddc39eed16a9ac6", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2016_N_00009_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_SECAO_003", "ordem": 12, "transcricao_literal": "Dentre as várias vias de administração de injeção está a intramuscular (IM) a qual permite a inoculação de maiores volumes de soluções, e sua absorção se dá de forma mais rápida devido à vascularização muscular. (OLIVEIRA; TAKAHASHI; ARAÚJO, 2008; WILKINSON; LEUVEN, 2010).", "sha256_texto": "659a003f4d397bf7fd3635c3b3a1e3c309079015bac906d9b8fc5688b2e3f2c8", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2016_N_00009_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_SECAO_003", "ordem": 13, "transcricao_literal": "Antes da realização de uma injeção IM se faz necessária a observação dos seguintes cuidados: leitura da prescrição medicamentosa, identificação do produto a ser injetado (apresentação, dose e validade), escolha do material adequado (seringas, agulhas, luvas, algodão e álcool), definição do local da injeção, habilidade técnica para realização do procedimento e seguimento das normas de biossegurança, começando pela lavagem das mãos (AGÊNCIA NACIONAL DE VIGILÂNCIA SANITÁRIA, 2007; OLIVEIRA; TAKAHASHI; ARAÚJO, 2008).", "sha256_texto": "98506ae8a5c6f86b426385c6f82a0484dff3cf8eac9ed7997304b332fb53f1eb", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2016_N_00009_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_SECAO_003", "ordem": 14, "transcricao_literal": "Trata-se de um procedimento complexo e que, portanto envolve risco. Estudos relatam complicações possíveis relacionadas à aplicação de medicamentos por esta via, tais como abscesso, eritema, embolia, celulite, necrose tecidual, contratura muscular, fibrose e perda de amplitude de movimento articular, entre outras. Desse modo exige-se para realização de injeção IM a habilitação do profissional de saúde com conhecimento das técnicas corretas de injeção, além de conhecimentos de anatomia, microbiologia, fisiologia, farmacologia, bioquímica e matemática (CASSIANE; RANGEL, 1999; DUQUE; CHAGAS, 2009; GODOY; NOGUEIRA; MENDES, 2004; MENEZES; MARQUES, 2007).", "sha256_texto": "188f9ada4902c4f9060bb5716dc37fde478bda5260ccbc4e4b3690b6ac53d3d7", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2016_N_00009_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_SECAO_003", "ordem": 15, "transcricao_literal": "O objeto em tela trata da análise da viabilidade da administração de injeção IM no vasto lateral e região glútea com prótese de silicone. Pois bem, a Sociedade Brasileira de Cirurgia Plástica (SBCP) em suas considerações afirma que a prótese de silicone na região glútea é realizada através da colocação de prótese de gel de silicone dentro do músculo glúteo maior. E a prótese de silicone no vasto lateral, é implantada ao longo e entre dois músculos: sartório e adutor mediano. É importante salientar que ambas as regiões são vascularizadas e inervadas ao longo do seu trajeto, o que coloca em risco a inoculação de produtos por via intramuscular.", "sha256_texto": "a81d811db99d690a40037346e92f547f88d34f784c071d8a079ba7056955ab93", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2016_N_00009_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_SECAO_003", "ordem": 16, "transcricao_literal": "É sabido que na pratica de Enfermagem os músculos mais utilizados são o deltoide e o dorsoglúteo, este último não é bem desenvolvido em crianças menores de 1 ano, devido a presença de camada espessa de tecido adiposo, além do risco de lesão de vasos sanguíneos e do nervo isquiático (anteriormente denominado na nomina anatômica como nervo ciático) (CLAYTON; STOCK, 2006; GILIO, 2009; HEMSWORTH, 2000; OLIVEIRA; TAKAHASHI; ARAÚJO, 2008).", "sha256_texto": "f9b15a1ec0942a88bce713b187d3488fe621cdc2900624033cd72e70659c09e4", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2016_N_00009_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 7", "dispositivo_superior": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_SECAO_003", "ordem": 17, "transcricao_literal": "Há de se lembrar de que o músculo ventro glúteo, outro local para administração de medicamento IM, tem vantagens pelo mesmo ser mais acessível (tanto na posição corpórea supina, prona ou lateral) e de fácil localização, comportando o mesmo volume de fármaco a ser administrado. Esse local de injeção IM deve ser utilizado em maiores de 7 meses (HEMSWORTH, 2000; OLIVEIRA; TAKAHASHI; ARAÚJO, 2008; TAYLOR; LILLIS; LEMONE, 2007). A injeção IM no músculo ventro glúteo é a que representa menor risco, pois:", "sha256_texto": "9cb884560712ecce3c3fe6d12808672065f1e73b6784d05ed28f49d2e8e3bac2", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2016_N_00009_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 8", "dispositivo_superior": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_SECAO_003", "ordem": 18, "transcricao_literal": "[…] é livre de vasos ou nervos importantes e seu tecido subcutâneo de menor espessura, se comparado a outros músculos utilizados para IM. Na prática clínica, esta é uma região muito pouco escolhida e a mudança dessa realidade depende da equipe de enfermagem, que, recebendo treinamento adequado e sendo supervisionada, talvez passe a incorporá-la em sua prática. (FIGUEIREDO, 2010, p. 130)", "sha256_texto": "7406162cc897392418ec72bf3b3bac3393c3ee179d4bb533dfb5b44f2944b1aa", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2016_N_00009_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_PARAGRAFO_TEXTO_012", "normativo": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 9", "dispositivo_superior": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_SECAO_003", "ordem": 19, "transcricao_literal": "Assim considerando o que determina a legislação do exercício profissional de Enfermagem (Lei nº 7.498/86, regulamentada pelo Decreto nº 94.406/87), a Resolução COFEN nº 358/09 e também a Resolução da Diretoria Colegiada (RDC) nº 45/03, da Agência Nacional de Vigilância Sanitária (ANVISA), a qual dispõe sobre o regulamento técnico de boas práticas de utilização das soluções parenterais (SP) em serviços de saúde, compete somente ao Enfermeiro, definir o local e os cuidados a serem observados na realização da injeção IM diante de qualquer situação (AGÊNCIA NACIONAL DE VIGILÂNCIA SANITÁRIA, 2003; BRASIL 1986, 1987; CONSELHO FEDERAL DE ENFERMAGEM, 2009).", "sha256_texto": "11b79e695bde84486cf4e21acb2dc378107f46093650010e95edcbd661cf012e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2016_N_00009_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_SECAO_004", "normativo": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS", "tipo_dispositivo": "secao", "localizador": "IV – DA CONCLUSÃO:", "dispositivo_superior": null, "ordem": 20, "transcricao_literal": "IV – DA CONCLUSÃO:", "sha256_texto": "548a61bee16017839654d8ef95143f312abf62565f5d260a1b7f056572efc089", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2016_N_00009_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_PARAGRAFO_TEXTO_013", "normativo": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2016_N_00009_CTAS_SECAO_004", "ordem": 21, "transcricao_literal": "Ante ao exposto a CTAS conclui que se os volumes máximos a serem injetados por via IM são iguais para o vasto lateral, dorsoglúteo e ventroglúteo sendo a última região mais segura para inoculação de fármacos por ser livre de vasos ou nervos importantes e seu tecido subcutâneo de menor espessura, se comparado a outros músculos, esta deverá ser a via de administração IM, para a atender os esquemas terapêuticos para sífilis e seguimento.", "sha256_texto": "11f62b48885362234ce194a836cff9c81984e0d60c6421e43870ef4ce92156dd", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2016_N_00009_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
