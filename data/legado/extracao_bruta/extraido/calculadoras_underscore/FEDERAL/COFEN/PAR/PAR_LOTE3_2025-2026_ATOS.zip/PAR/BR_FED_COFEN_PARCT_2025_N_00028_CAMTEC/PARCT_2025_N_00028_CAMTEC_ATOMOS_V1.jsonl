{"identificador": "BR_FED_COFEN_PARCT_2025_N_00028_CAMTEC_ITEM_LISTA_014", "normativo": "BR_FED_COFEN_PARCT_2025_N_00028_CAMTEC", "tipo_dispositivo": "item_lista", "localizador": "Item de lista 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2025_N_00028_CAMTEC_ITEM_008", "ordem": 35, "transcricao_literal": "Lidocaína tópica (gel, creme ou spray) apresenta evidências moderadas de redução da dor, podendo ser considerada como opção para pacientes com maior sensibilidade.", "sha256_texto": "e562045ee98fcb83204d1db59c55f2ba9cfdf423bf03c327c8209d78b13d7f7f", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2025_N_00028_CAMTEC_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "2", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARCT_2025_N_00028_CAMTEC_ITEM_LISTA_015", "normativo": "BR_FED_COFEN_PARCT_2025_N_00028_CAMTEC", "tipo_dispositivo": "item_lista", "localizador": "Item de lista 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2025_N_00028_CAMTEC_ITEM_008", "ordem": 36, "transcricao_literal": "Bloqueio paracervical com lidocaína pode reduzir a dor em alguns casos, mas sua eficiência é incerta e pode aumentar efeitos colaterais, como tontura e náusea.", "sha256_texto": "478ec8b95d3f5597441c1a066a10161000e21f1ff4dca512657c4fb21acad7d8", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2025_N_00028_CAMTEC_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "3", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARCT_2025_N_00028_CAMTEC_ITEM_LISTA_016", "normativo": "BR_FED_COFEN_PARCT_2025_N_00028_CAMTEC", "tipo_dispositivo": "item_lista", "localizador": "Item de lista 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2025_N_00028_CAMTEC_ITEM_008", "ordem": 37, "transcricao_literal": "Não há evidências consistentes para recomendar o uso de outras técnicas anestésicas na rotina da inserção do DIU.", "sha256_texto": "6080ee8e072797fe9f9bb1a16b03a35ed9c3efcf35ad697667a373b1afeb5b9a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2025_N_00028_CAMTEC_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "4", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARCT_2025_N_00028_CAMTEC_ITEM_009", "normativo": "BR_FED_COFEN_PARCT_2025_N_00028_CAMTEC", "tipo_dispositivo": "item", "localizador": "Item 11", "dispositivo_superior": "BR_FED_COFEN_PARCT_2025_N_00028_CAMTEC_SECAO_006", "ordem": 38, "transcricao_literal": "11. Diante disso, recomenda-se que a decisão sobre o uso de anestésicos seja individualizada, levando em consideração as preferências da paciente e a experiência do profissional de enfermagem. Essa personalização deve basear-se nas evidências descritas e ser considerada apenas quando estritamente necessária. Estudos adicionais são necessários para avaliar a segurança e eficiência de novas abordagens.", "sha256_texto": "c4f3ed8e697879439f58588262ae345be2e3e3aaf1a8aeb6a9daa6b668a20ca8", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2025_N_00028_CAMTEC_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "numeracao": "11", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
