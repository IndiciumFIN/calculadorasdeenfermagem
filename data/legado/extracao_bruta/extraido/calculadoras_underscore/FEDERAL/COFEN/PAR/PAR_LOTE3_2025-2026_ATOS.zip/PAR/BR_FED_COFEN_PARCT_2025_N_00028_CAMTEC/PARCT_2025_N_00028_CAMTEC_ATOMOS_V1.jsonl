{"identificador": "BR_FED_COFEN_PARCT_2025_N_00028_CAMTEC_ITEM_004", "normativo": "BR_FED_COFEN_PARCT_2025_N_00028_CAMTEC", "tipo_dispositivo": "item", "localizador": "Item 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2025_N_00028_CAMTEC_SUBSECAO_001", "ordem": 16, "transcricao_literal": "4. Os ensaios também relataram possíveis efeitos adversos do bloqueio paracervical, incluindo zumbido, tontura e episódios de vômito. Não foram encontradas evidências suficientes para afirmar que essa técnica melhora a satisfação das pacientes.", "sha256_texto": "291d358dcbec5e07088c992aa8bf30ce1ac4cc9e650ab6c1633b0fff3c24b85d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2025_N_00028_CAMTEC_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "numeracao": "4", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
