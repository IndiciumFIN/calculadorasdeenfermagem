{"identificador": "BR_FED_COFEN_PARCT_2025_N_00028_CAMTEC_ITEM_LISTA_003", "normativo": "BR_FED_COFEN_PARCT_2025_N_00028_CAMTEC", "tipo_dispositivo": "item_lista", "localizador": "Item de lista", "dispositivo_superior": "BR_FED_COFEN_PARCT_2025_N_00028_CAMTEC_ITEM_003", "ordem": 14, "transcricao_literal": "Três estudos demonstraram redução da dor, enquanto outros três não evidenciaram diferença estatisticamente significativa;", "sha256_texto": "ab657f582542526be533fdfdf126ee15b76d4c6fcdc87f8c9052cd1efa9792dd", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2025_N_00028_CAMTEC_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "•", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
