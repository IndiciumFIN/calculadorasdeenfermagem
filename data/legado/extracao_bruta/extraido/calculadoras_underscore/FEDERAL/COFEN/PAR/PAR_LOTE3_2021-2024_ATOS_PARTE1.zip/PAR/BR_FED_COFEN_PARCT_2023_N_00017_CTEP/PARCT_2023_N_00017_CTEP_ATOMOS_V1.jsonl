{"identificador": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_SECAO_001", "ordem": 8, "transcricao_literal": "Trata-se do pedido de registros de especializações, feita pela Profissional de enfermagem Cassia Regina Alves Mendes, em: “Ensino de EJA” e “Atendimento Educacional Especializado” cursadas na Faculdade Venda Nova do Imigrante/ES – FAVENI.", "sha256_texto": "fdd45de406cca9da1eee72458e551500d1bad3e70da3562c1a5cbfa34cd237ab", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00017_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_SECAO_001", "ordem": 9, "transcricao_literal": "Em atenção ao Memorando nº 26/2023 – COFEN/DGEP/DIRC (fl. 01), do Processo SEI nº 00196.000779/2023-18, foi encaminhado pelo Departamento de Gestão do Exercício Profissional-DGEP/Cofen à Câmara Técnica de Educação e Pesquisa – CTEP/Cofen, para análise e elaboração de parecer.", "sha256_texto": "2088f37124ed22547a8ad7f20ef4c387a3fb62865c62d56d820c612238853869", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00017_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_SECAO_001", "ordem": 10, "transcricao_literal": "Instada esta CTEP/Cofen a se manifestar sobre a matéria, passa-se a análise.", "sha256_texto": "dc02ee12f9bd61bd6cdcc78263b67e6571eaef073da565cc43b09cb665b1b1e9", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00017_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_SECAO_002", "normativo": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP", "tipo_dispositivo": "secao", "localizador": "II. FUNDAMENTAÇÃO E ANÁLISE", "dispositivo_superior": null, "ordem": 11, "transcricao_literal": "II. FUNDAMENTAÇÃO E ANÁLISE", "sha256_texto": "1fa6c01d11b45a48d022c33fbd31cd41a937e29617b1e4ba262dee17fd7e5d52", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00017_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_SECAO_002", "ordem": 12, "transcricao_literal": "Com vistas a fundamentar suas solicitações, a requerente Enfermeira Cassia Regina Alves Mendes, apresentou ao Cofen, documentos de comprovação de conclusão do Curso de especialista em “Ensino de EJA” e certificado de especialista em “Atendimento Educacional Especializado”, ambos enviados, via correio eletrônico.", "sha256_texto": "bc91ecc130230be9e13fe8be079bcbd9a95a4934048f1c5a7bb2477fc761ee64", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00017_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_SECAO_002", "ordem": 13, "transcricao_literal": "Sobre as especialidades cursadas e para o qual se solicita registro junto ao Sistema Cofen/Conselhos Regionais de Enfermagem temos a destacar que, em princípio, ambas se relacionam à área do ensino, área esta que a Enfermagem tem forte atuação, tanto no ensino técnico como nos ensinos de graduação e pós-graduação.", "sha256_texto": "2d960a712cc42ee19cf16f8bc8819da2ba2b68b956280435f057bfb949203eb7", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00017_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_SECAO_002", "ordem": 14, "transcricao_literal": "A modalidade de formação EJA – Educação de Jovens e Adultos tem previsão na Lei de Diretrizes e Bases da Educação Nacional (LDB), aprovada pela Lei nº 9.394 de 20 de dezembro de 1996, em seu artigo 37, que assim prevê:", "sha256_texto": "5d1686513ff1536a0b14c6fe3523401b8ed6ee379c90f10ebb2a3453e7f5c41c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00017_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_ART_037", "normativo": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 37 (citado/transcrito)", "dispositivo_superior": null, "ordem": 15, "transcricao_literal": "Art. 37. A educação de jovens e adultos será destinada àqueles que não tiveram acesso ou continuidade de estudos no ensino fundamental e médio na idade própria.", "sha256_texto": "78b29ec6a2aa1bbcb35ab52761106146e4f8efb1862f6fe8ece62941bfd92157", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00017_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Artigo citado ou transcrito de outra norma (sequência não inicia em 1 no escopo); não é articulado próprio."}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_ART_037_PAR_01", "normativo": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP", "tipo_dispositivo": "paragrafo_transcrito", "localizador": "§ 1º", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_ART_037", "ordem": 16, "transcricao_literal": "§ 1o Os sistemas de ensino assegurarão gratuitamente aos jovens e aos adultos, que não puderam efetuar os estudos na idade regular, oportunidades educacionais apropriadas, consideradas as características do alunado, seus interesses, condições de vida e de trabalho, mediante cursos e exames.", "sha256_texto": "66a278814a3adad3a784e01534833e2afb57923d73a39fd238f46f749b21c142", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00017_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_ART_037_PAR_02", "normativo": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP", "tipo_dispositivo": "paragrafo_transcrito", "localizador": "§ 2º", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_ART_037", "ordem": 17, "transcricao_literal": "§ 2o O Poder Público viabilizará e estimulará o acesso e a permanência do trabalhador na escola, mediante ações integradas e complementares entre si.", "sha256_texto": "2acc3e3f340ded1882e74ca5a7710b6f0b2ec302742bd44b85d5e56bacbaabcf", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00017_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_SECAO_002", "ordem": 18, "transcricao_literal": "Destaque-se que, além do ensino fundamental e médio, tal modalidade de ensino também avançou para o ensino técnico integrado, permitindo a realização do ensino médio integrado a um curso técnico, para aqueles que possuam dezoito anos ou mais, tendo-se inclusive a adesão da Rede Federal Tecnológica (Institutos Federais de Educação), que há algum tempo oferecem o curso Técnico de Enfermagem na modalidade EJA.", "sha256_texto": "cd8db2fd306b76ffb366d9d6c840095eb8c2ffce713748d26cd2846bb955a84a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00017_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_SECAO_002", "ordem": 19, "transcricao_literal": "Em semelhante sentido temos o atendimento educacional especializado, que é política de Estado, desde que instituídas as Diretrizes Operacionais da Educação Especial para o Atendimento Educacional Especializado – AEE na educação básica, regulamentado pelo do Decreto nº 6.571, de 18 de setembro de 2008.", "sha256_texto": "2b92f42a0c22cb7bb5ac0e4813aaa938743083ea259beb4ae2bcf356496c108b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00017_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_SECAO_002", "ordem": 20, "transcricao_literal": "Segundo o documento, a educação especial é uma modalidade de ensino que perpassa todos os níveis, etapas e modalidades, realiza o atendimento educacional especializado, disponibiliza os recursos e serviços e orienta quanto a sua utilização no processo de ensino e aprendizagem nas turmas comuns do ensino regular.", "sha256_texto": "9357e9e5cde368b56939c3e16dac1fba2009a928ba86eff27ee9a6c74d51ee02", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00017_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_PARAGRAFO_TEXTO_012", "normativo": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 7", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_SECAO_002", "ordem": 21, "transcricao_literal": "Nesse sentido a especialização em Atendimento Educacional Especializado, vem ao encontro das necessidades de formação de profissionais especializados para atuar com um público que deve ser cada vez mais acolhido e incluído na sociedade e nos processos educacionais, possibilitando acesso ao mercado de trabalho e autonomia a pessoas com necessidades específicas.", "sha256_texto": "fa6919e0af0ef83c86224207a1c74ae4cb543e4f8b37e26156b5ef17a7443ac3", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00017_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_PARAGRAFO_TEXTO_013", "normativo": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 8", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_SECAO_002", "ordem": 22, "transcricao_literal": "No tocante aos documentos apresentados pela requerente, que incluem os cerificados de especialização em “Ensino de EJA” e “Atendimento Educacional Especializado” e ainda histórico escolar, observa-se, pelas disciplinas cursadas, que estas se relacionam a área de educação, possibilitando correlação direta com a grande área III, da Resolução Cofen nº 581/2018 – Ensino e Pesquisa.", "sha256_texto": "3fd4c9f9ba9e4ef9b56f3848ec7c4ac978464e3c071f928c384597b74217b065", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00017_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_PARAGRAFO_TEXTO_014", "normativo": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 9", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_SECAO_002", "ordem": 23, "transcricao_literal": "Sendo estas as considerações necessárias, passamos à conclusão.", "sha256_texto": "d69cec9ada811d9aacb04a0a7ca7e337901b6c8fa011737c48f0cea9ac90094b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00017_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_ART_037_PAR_02_INC_III", "normativo": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP", "tipo_dispositivo": "inciso", "localizador": "Inciso III", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_ART_037_PAR_02", "ordem": 24, "transcricao_literal": "III. CONCLUSÃO Considerando a análise dos documentos que constituem o Processo SEI nº 00196.000779/2023-18, que tem por objeto a análise do pedido formulado pela Enfermeira Cassia Regina Alves Mendes de registros das especializações em: “Ensino de EJA” e “Atendimento Educacional Especializado”, ofertadas pela Faculdade Venda Nova do Imigrante-ES – FAVENI;", "sha256_texto": "1646600b99105c3e83c594f7556a258102cc8c89b317d35196d1baed5a627c77", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00017_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Dispositivo de artigo citado/transcrito."}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_PARAGRAFO_TEXTO_015", "normativo": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 10", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_SECAO_002", "ordem": 25, "transcricao_literal": "Considerando a manifestação da Divisão de Inscrição, Registro e Cadastro do Cofen, por meio do Memorando no 26/2023-COFEN/DGEP/DIRC;", "sha256_texto": "17d91189190ecdc5888ed20576fc5d9ecbc7d5026090b11d0116fc2380319ab2", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00017_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_PARAGRAFO_TEXTO_016", "normativo": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 11", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_SECAO_002", "ordem": 26, "transcricao_literal": "Considerando ser esta Câmara Técnica de Educação e Pesquisa, órgão “permanente de natureza consultiva, propositiva e avaliativa sobre matéria relativa ao exercício da Enfermagem”, segundo art. 1º do Regimento Interno do Cofen, no entanto, sem competência deliberativa;", "sha256_texto": "c4954fa64efd5222ab6345d43d5e3724b975ae325903359f95ee85a9606e8044", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00017_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_PARAGRAFO_TEXTO_017", "normativo": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 12", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00017_CTEP_SECAO_002", "ordem": 27, "transcricao_literal": "Considerando o entendimento de que a solicitação atende ao disposto na Resolução nº 581/2018, sugere esta Câmara Técnica ao Egrégio Plenário do Cofen, que neste caso, dê apreciação favorável aos registros dos títulos de especializações em: “Ensino de EJA” e “Atendimento Educacional Especializado”, requeridos pela Enfermeira Cassia Regina Alves Mendes, emitidos pela Faculdade Venda Nova do Imigrante-ES, devendo estes serem registrados na ÁREA III – Ensino e Pesquisa, item 2) Educação em Enfermagem, do anexo da Resolução Cofen nº 581/2018 e que os títulos sejam registrados “de acordo com a denominação constante no diploma ou certificado apresentado”, conforme §1º do Art. 3º da citada norma.", "sha256_texto": "31938fecdad42299d07bd0253afe66931467645b4a86cf87828a7c1482bc595f", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00017_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
