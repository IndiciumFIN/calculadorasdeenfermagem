{"identificador": "BR_FED_COFEN_PARCT_2014_N_00032_CTLN_PARAGRAFO_TEXTO_001", "normativo": "BR_FED_COFEN_PARCT_2014_N_00032_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2014_N_00032_CTLN_SECAO_001", "ordem": 5, "transcricao_literal": "LEGISLAÇÃO PROFISSIONAL. SOLICITAÇÃO DO MINISTÉRIO PÚBLICO/RS, PARA QUE O COFEN SE MANIFESTE SOBRE A PORTARIA MS/SAS 356/2013, NO QUE TANGE À OBRIGATORIEDADE DA PRESENÇA DE UM ENFERMEIRO NAS UNIDADES DE SUPORTE BÁSICO TERRESTRE DO SAMU, DIANTE DO ESTABELECIDO NO ART. 15 DA LEI 7498/1986. O parecer aponta que a Portaria MS/SAS 356/2013, corrobora com o art. 15 da Lei 7498/1986, uma vez que as atividades de auxiliares e técnicos de enfermagem, só podem ser realizadas sob orientação e supervisão do Enfermeiro.", "sha256_texto": "b54423af1ec03a4f5c47728caf9e92f8a1da7c5ae559944c56cd8564868de179", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2014_N_00032_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "EQUIVALENTE_OCR", "similaridade": 99.8, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
