{"identificador": "BR_FED_COFEN_PARCT_2017_N_00016_CTLN_PARAGRAFO_TEXTO_002", "normativo": "BR_FED_COFEN_PARCT_2017_N_00016_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2017_N_00016_CTLN_SECAO_002", "ordem": 6, "transcricao_literal": "Trata-se de encaminhamento a esta CTLN, do Gabinete da Presidência, através do Despacho P-3234/2017, referente Ofício n° 19-SEI/2017/SVS/MS – Protocolo 2631/2017 que faz consulta ao Cofen quanto a legalidade da atribuição do enfermeiro na realização da anestesia local, bem como na aplicação intralesional da medicação antimoniato de meglumina no tratamento da leishmaniose tegumentar. Compõem os autos processuais os seguintes documentos: a) Oficio n° 19-SEI/2017/SVS/MS ao Presidente do Cofen sobre tratamento intralesional da leishmaniose tegumentar (fls. 01f e v); b) Despacho P-3234/2017 GAB/PRES solicitando emissão de parecer a esta CTLN sobre a matéria (fl. 02).", "sha256_texto": "76248db79371c476cb5115128e459e705c8c2dc08031cba5ea45c928063d60ff", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2017_N_00016_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "EQUIVALENTE_OCR", "similaridade": 99.5, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
