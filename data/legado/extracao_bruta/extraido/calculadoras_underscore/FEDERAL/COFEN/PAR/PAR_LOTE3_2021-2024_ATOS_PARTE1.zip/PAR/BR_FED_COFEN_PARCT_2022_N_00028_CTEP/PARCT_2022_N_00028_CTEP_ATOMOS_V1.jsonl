{"identificador": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP_SECAO_001", "normativo": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP", "tipo_dispositivo": "secao", "localizador": "I. SÍNTESE DOS FATOS", "dispositivo_superior": null, "ordem": 6, "transcricao_literal": "I. SÍNTESE DOS FATOS", "sha256_texto": "f324c26ac18f57695bd490649c0b5f83e641d43bd814e756373a0d8a4c6f77eb", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00028_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP_PARAGRAFO_TEXTO_002", "normativo": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP_SECAO_001", "ordem": 7, "transcricao_literal": "Trata-se o presente do encaminhamento feito pelo Conselho Regional de Enfermagem de São Paulo – Coren-SP, de documentação da Sra. Maria Lucia Marques Boaventura, em que esta requer registro e inscrição de Técnico de Enfermagem, apresentando diploma de certificação por competência emitido pela Escola Técnica Estadual Sylvio de Mattos Carvalho, concedido com base na análise da sua experiência pregressa como Auxiliar de Enfermagem.", "sha256_texto": "0e27d816f520d0304e81708d2a422f16a2642cbdcbfac3e7a282507f7a8602bd", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00028_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP_SECAO_001", "ordem": 8, "transcricao_literal": "Informa o Regional que, em relação à documentação que comprovasse o exercício pregresso na categoria profissional de auxiliar de enfermagem a mesma enviou declaração emitida pela Santa Casa de Jaú, onde exerceu a função de instrumentadora cirúrgica, na modalidade terceirizada, sem vínculo empregatício com o hospital, desde o ano de 1992.", "sha256_texto": "d489159d3f865516cbfd2fa6ac4a5b268597722237537f2dc46b13a56213bee8", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00028_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP_SECAO_001", "ordem": 9, "transcricao_literal": "Instada a Câmara Técnica de Educação e Pesquisa – CTEP/Cofen, por meio do Memorando nº 0340/2022/DGEP/COFEN, para análise e manifestação, segue-se a análise.", "sha256_texto": "d2416f728b8e9c4c8d70ebc4a70650456b0ba18832cc7157b6f0058883547099", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00028_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP_SECAO_002", "normativo": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP", "tipo_dispositivo": "secao", "localizador": "II – DA ANÁLISE E DISCUSSÃO", "dispositivo_superior": null, "ordem": 10, "transcricao_literal": "II – DA ANÁLISE E DISCUSSÃO", "sha256_texto": "cf6c4bf0b36aa4cc4a4460e1944a2283c90118826938c8e8c15ff6f9ddb99dbe", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00028_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP_SECAO_002", "ordem": 11, "transcricao_literal": "Em documento eletrônico encaminhado pelo Coren-SP ao Setor de Inscrição, Registro e Cadastro do Cofen, datado de 5 de abril de 2022, o Regional informa o recebimento do requerimento de inscrição definitiva como Técnica de Enfermagem da profissional Maria Lucia Marques Boaventura e que em seu requerimento esta apresentou o diploma de certificação por competência emitido pelo Centro Paula Souza (Escola Técnica Estadual Sylvio de Mattos Carvalho).", "sha256_texto": "8fa099e0202bb3d10369d15886016dca2daf72d76eb5ca6eb23f91640df3bd1b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00028_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP_SECAO_002", "ordem": 12, "transcricao_literal": "Informa ainda que ao solicitar a documentação que comprovasse o exercício pregresso na categoria de Auxiliar de Enfermagem, a profissional enviou declaração informando que possui inscrição de Auxiliar de Enfermagem e que exerce a função de instrumentadora cirúrgica desde 1992.", "sha256_texto": "9ff2a7635cc51e0738def214560ddcffa12402703703e8b169128caec62af32f", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00028_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP_SECAO_002", "ordem": 13, "transcricao_literal": "Entendendo o Regional que o caso não está previsto na Resolução Cofen nº 683/2021, encaminha ao Conselho Federal de Enfermagem para análise com fundamento nos casos omissos, previstos no artigo 3º da referida norma.", "sha256_texto": "438d30cba7f3e54d8aec33417cb24d18c0f42ca34fb8788a7b7939a1d05aab68", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00028_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP_SECAO_002", "ordem": 14, "transcricao_literal": "Ademais informa o Setor de Cadastro do Coren-SP que, ao solicitarem da requerente a cópia do registro em Carteira de Trabalho e Previdência Social – CTPS, a mesma informou que optou por não ser registrada e trabalhar como autônoma, enviando para a comprovação de tempo de serviço, a declaração do médico da qual integra a equipe e a declaração emitida pela Santa Casa de Jaú.", "sha256_texto": "31acdeba919f73bada5da42f44944e52fd865be935a3403de0f1e84b753e9a57", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00028_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP_SECAO_002", "ordem": 15, "transcricao_literal": "Do caso em tela, de início identifica-se que a profissional que requer o registro de Técnico de Enfermagem, com a apresentação de diploma obtido por meio de Certificação por Competência, o faz com base na previsão da Resolução Cofen nº 683/2021, que define os critérios para o registro profissional dos Técnicos de Enfermagem, titulados por Instituição, na modalidade “Certificação Profissional por Competência” e dá outras providências, senão vejamos:", "sha256_texto": "94fa0e2467a2ebf784c4d844eb355fef7cc9d44c78b89411d72ddee2307ad8f6", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00028_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP_SECAO_002", "ordem": 16, "transcricao_literal": "Apresentou o diploma de Técnico de Enfermagem, emitido pela Escola Técnica Estadual Sylvio de Mattos Carvalho, que certifica sua aprovação no “Processo de Avaliação e Certificação de Competências”, com fundamento no que preceitua o Artigo 41 da Lei nº 9.394/1996 (LDB) e Deliberação do CEE-SP nº 107/2011.", "sha256_texto": "ce5e494b4286ba5be00c1b9b7d300edd3162f93b9c57835cf3b72f5add4186d9", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00028_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 7", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP_SECAO_002", "ordem": 17, "transcricao_literal": "Apresentou declaração de comprovação de tempo de serviço, como instrumentadora cirúrgica, no centro cirúrgico da Santa Casa de Jaú, devidamente assinada pela Coordenadora de Enfermagem daquela Instituição e autenticada pelo 2º Tabelião de Notas e Protestos de Jaú-SP, documento este que, em princípio, se amolda ao previsto no inciso IV do parágrafo único, do artigo 2º, da Resolução Cofen nº 683/2021.", "sha256_texto": "e8ed70d102822c0eb582e651f1d626c82e5a5a87baf19aef06a468e583429235", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00028_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP_PARAGRAFO_TEXTO_012", "normativo": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 8", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP_SECAO_002", "ordem": 18, "transcricao_literal": "Salienta-se que se amolda, em princípio, especialmente em razão da dúvida que possa pairar em relação à instrumentação cirúrgica como atividade do Auxiliar de Enfermagem, o que se esclarece com o contido na redação da alínea j, inciso III, do artigo 11 do Decreto nº 94.406/87, que regulamentou a Lei 7.498/86, que assim reza:", "sha256_texto": "8efa58c942c00519192b5903ed0fcb87b91b3fa26234a44db009486d87d49b14", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00028_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP_ART_011", "normativo": "BR_FED_COFEN_PARCT_2022_N_00028_CTEP", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 11 (citado/transcrito)", "dispositivo_superior": null, "ordem": 19, "transcricao_literal": "Art. 11. O Auxiliar de Enfermagem executa as atividades auxiliares, de nível médio, atribuídas à equipe de enfermagem, cabendo-lhe:", "sha256_texto": "7b8e2ee1f9e117fda95e01b014d30cde7c756bfee68414feb424fd406501a95e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00028_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Artigo citado ou transcrito de outra norma (sequência não inicia em 1 no escopo); não é articulado próprio."}
