{"identificador": "BR_FED_COFEN_PARTEC_2021_N_00007_ARI_PARAGRAFO_TEXTO_025", "normativo": "BR_FED_COFEN_PARTEC_2021_N_00007_ARI", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 7", "dispositivo_superior": "BR_FED_COFEN_PARTEC_2021_N_00007_ARI_SECAO_002", "ordem": 41, "transcricao_literal": "Considerando que as IES que se intermediam por alguma razão, não têm autorização do Ministério da Educação para ações em cursos de Enfermagem e os documentos que instruem os autos do PAD Cofen 0966/2020 deixam claras as contradições com os apresentados publicamente pelo Ministério da Educação.", "sha256_texto": "b74b4b4ea9e30f5488940b3f1a0956e50729f47e6321833d000ecddfb3896c7a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARTEC_2021_N_00007_ARI_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
