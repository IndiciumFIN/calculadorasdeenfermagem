{"identificador": "BR_FED_COFEN_PARCONS_2022_N_00015_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARCONS_2022_N_00015", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": null, "ordem": 9, "transcricao_literal": "Conforme consta nos autos, a Ouvidoria deste Conselho Federal recebeu relato de profissional de enfermagem, em caráter sigiloso, acerca da lavagem de ambulâncias por profissional de enfermagem no estado de Minas Gerais (fls.02/03).", "sha256_texto": "4f392637e148fc89f1ed948c9cee6bb52c490bf58e78d229d32e41e4967b2967", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2022_N_00015_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
