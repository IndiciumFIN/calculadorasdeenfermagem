{"identificador": "BR_FED_COFEN_PARCT_2018_N_00013_CTLN_ALINEA_002", "normativo": "BR_FED_COFEN_PARCT_2018_N_00013_CTLN", "tipo_dispositivo": "alinea", "localizador": "Alínea j", "dispositivo_superior": "BR_FED_COFEN_PARCT_2018_N_00013_CTLN_PARAGRAFO_TEXTO_008", "ordem": 15, "transcricao_literal": "j) prescrição da assistência de enfermagem;", "sha256_texto": "ce813b4d0ae182e4e81f13715bd5729b964a6f27ff3772f4c63c3c37d08e6827", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2018_N_00013_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2018_N_00013_CTLN_ALINEA_003", "normativo": "BR_FED_COFEN_PARCT_2018_N_00013_CTLN", "tipo_dispositivo": "alinea", "localizador": "Alínea l", "dispositivo_superior": "BR_FED_COFEN_PARCT_2018_N_00013_CTLN_PARAGRAFO_TEXTO_008", "ordem": 16, "transcricao_literal": "l) cuidados diretos de enfermagem a pacientes graves com risco de vida;", "sha256_texto": "9c0e86d8ed7fc6944d38d0a23d4a76b81f3c9ad8714ecdba102d9cd0af85a18e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2018_N_00013_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
