{"identificador": "BR_FED_COFEN_PARCT_2023_N_00031_CTEP_PARAGRAFO_TEXTO_016", "normativo": "BR_FED_COFEN_PARCT_2023_N_00031_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 9", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00031_CTEP_SECAO_002", "ordem": 23, "transcricao_literal": "Considerando o entendimento desta CTEP/Cofen que o certificado emitido atende aos normativos que regulamentam as especializações lato sensu no Brasil;", "sha256_texto": "66d2c5f6b122c7c4afda194dbd6716d224a943fd9c698abb45a8d708006129c2", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00031_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00031_CTEP_PARAGRAFO_TEXTO_017", "normativo": "BR_FED_COFEN_PARCT_2023_N_00031_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 10", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00031_CTEP_SECAO_002", "ordem": 24, "transcricao_literal": "Considerando ser esta Câmara Técnica de Educação e Pesquisa, órgão “permanente de natureza consultiva, propositiva e avaliativa sobre matéria relativa ao exercício da Enfermagem”, segundo Art. 1º do Regimento Interno do Cofen, no entanto, sem competência deliberativa.", "sha256_texto": "2285ec081241237d465d99bcaa8f87a28e90cc7ad5c2ed982daa49c91f8ed05b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00031_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
