{"identificador": "BR_FED_COFEN_PARCT_2015_N_00011_CTLN_ART_001", "normativo": "BR_FED_COFEN_PARCT_2015_N_00011_CTLN", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 1º (citado/transcrito)", "dispositivo_superior": null, "ordem": 25, "transcricao_literal": "Art. 1º No âmbito da equipe de Enfermagem, a punção arterial tanto para fins de gasometria como para monitorização da pressão arterial invasiva é um procedimento privativo do Enfermeiro, observadas as disposições legais da profissão.", "sha256_texto": "2af220f45972c01cb612d7570187a9e9594361f0c029b37b711a78e1f78811de", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2015_N_00011_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Artigo citado ou transcrito de outra norma (sequência não inicia em 1 no escopo); não é articulado próprio."}
{"identificador": "BR_FED_COFEN_PARCT_2015_N_00011_CTLN_ART_001_PAR_UNICO", "normativo": "BR_FED_COFEN_PARCT_2015_N_00011_CTLN", "tipo_dispositivo": "paragrafo_transcrito", "localizador": "Parágrafo único", "dispositivo_superior": "BR_FED_COFEN_PARCT_2015_N_00011_CTLN_ART_001", "ordem": 26, "transcricao_literal": "Parágrafo único O Enfermeiro deverá estar dotado dos conhecimentos, competências e habilidades que garantam rigor técnico-científico ao procedimento, atentando para a capacitação contínua necessária à sua realização.", "sha256_texto": "873f4a5de41eb7ffc7f6f302a288c62b9ac63cf524ded237a64e2f73d3de327e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2015_N_00011_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2015_N_00011_CTLN_ART_002", "normativo": "BR_FED_COFEN_PARCT_2015_N_00011_CTLN", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 2º (citado/transcrito)", "dispositivo_superior": null, "ordem": 27, "transcricao_literal": "Art. 2º O procedimento a que se refere o artigo anterior deve ser executado no contexto do Processo de Enfermagem, atendendo-se as determinações da Resolução Cofen nº 358/2009.", "sha256_texto": "f89a6e5f5416842083d091711bb1e501fc6eda0655f9c1cb47130de76ac1f497", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2015_N_00011_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Artigo citado ou transcrito de outra norma (sequência não inicia em 1 no escopo); não é articulado próprio."}
{"identificador": "BR_FED_COFEN_PARCT_2015_N_00011_CTLN_PARAGRAFO_TEXTO_013", "normativo": "BR_FED_COFEN_PARCT_2015_N_00011_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 11", "dispositivo_superior": "BR_FED_COFEN_PARCT_2015_N_00011_CTLN_SECAO_003", "ordem": 28, "transcricao_literal": "[…..]", "sha256_texto": "92603bb328ad46d3c881857f11952bb99a5b26df3a3901077973ca09b74464b0", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2015_N_00011_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2015_N_00011_CTLN_PARAGRAFO_TEXTO_014", "normativo": "BR_FED_COFEN_PARCT_2015_N_00011_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 12", "dispositivo_superior": "BR_FED_COFEN_PARCT_2015_N_00011_CTLN_SECAO_003", "ordem": 29, "transcricao_literal": "Como visto acima, a Resolução Cofen n.º 390/2011, estabeleceu que a realização da punção arterial, tanto para fins de gasometria como para monitorização de pressão arterial invasiva, é privativa do Enfermeiro, considerando que esse profissional é responsável pela realização de cuidados de enfermagem de maior complexidade técnica e que exijam a tomada de decisão pautada em conhecimentos científicos. Além disso, a Resolução citada estabelece que o Enfermeiro obtenha conhecimentos, competências e habilidades que garantam rigor técnico-científico para a realização do procedimento, atentando para a capacitação contínua relacionada à realização da punção arterial, bem como que esse procedimento deve ser realizado, no contexto do Processo de Enfermagem, conforme reza a Resolução Cofen n.º 358/2009.", "sha256_texto": "846e660cabae78c17840223f79e21924f62bf6aab3d7b07b1b8f6c1bfe7e59a5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2015_N_00011_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2015_N_00011_CTLN_PARAGRAFO_TEXTO_015", "normativo": "BR_FED_COFEN_PARCT_2015_N_00011_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 13", "dispositivo_superior": "BR_FED_COFEN_PARCT_2015_N_00011_CTLN_SECAO_003", "ordem": 30, "transcricao_literal": "Pelo exposto acima, esta CTLN entende que o Enfermeiro devidamente capacitado/qualificado, possui a competência legal exigida para executar a punção arterial, no âmbito da equipe de Enfermagem.", "sha256_texto": "4edd54b3d2c767d2c4fb0ad3cccd6d07d3d1a95b1b67f3562f56b94664ad5b17", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2015_N_00011_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
