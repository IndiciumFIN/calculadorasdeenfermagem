{"identificador": "BR_FED_COFEN_OS_2017_N_00009_ART_001", "normativo": "BR_FED_COFEN_OS_2017_N_00009", "tipo_dispositivo": "artigo", "localizador": "Art. 1º", "dispositivo_superior": null, "ordem": 8, "transcricao_literal": "Art. 1º Determinar que o processo de prorrogação contratual deverá ter início com antecedência de 120 (cento e vinte) dias da data de vencimento.", "sha256_texto": "d50e4cc0ad8a12bcca70dec62e92a07cdcaa5942303f2e4aae453a67d46772d8", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "OS_2017_N_00009_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_OS_2017_N_00009_ART_002", "normativo": "BR_FED_COFEN_OS_2017_N_00009", "tipo_dispositivo": "artigo", "localizador": "Art. 2º", "dispositivo_superior": null, "ordem": 9, "transcricao_literal": "Art. 2º O Gestor e/ou fiscal do Contrato deverá juntar aos autos relatório acerca das ocorrências na execução do contrato, atestando a realização satisfatória e dentro do estabelecido nos termos do Contrato.", "sha256_texto": "8676110726494d910ad8e95a68c174bdae54d088730203bdb149ceac91b28976", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "OS_2017_N_00009_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_OS_2017_N_00009_ART_003", "normativo": "BR_FED_COFEN_OS_2017_N_00009", "tipo_dispositivo": "artigo", "localizador": "Art. 3º", "dispositivo_superior": null, "ordem": 10, "transcricao_literal": "Art. 3º O Gestor e/ou fiscal deverá entrar em contato com a empresa questionando-a sobre o interesse na manutenção do vínculo contratual, bem como realizar negociação formal visando à redução do valor pactuado.", "sha256_texto": "099d1989648368fea4155cf493641187240c94a380bc47533e63e6af868a7663", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "OS_2017_N_00009_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
