{"identificador": "BR_FED_COFEN_OS_2018_N_00001_ART_001", "normativo": "BR_FED_COFEN_OS_2018_N_00001", "tipo_dispositivo": "artigo", "localizador": "Art. 1º", "dispositivo_superior": null, "ordem": 7, "transcricao_literal": "Art. 1º Os empregados públicos e colaboradores quando em viagem oficial para o desempenho de missão consignada em Portaria emitida para tal fim, após o retorno da viagem, deverão encaminhar à Chefia de Gabinete do Cofen relatório circunstanciado de todas as atividades desempenhadas e das medidas por ventura implantadas.", "sha256_texto": "9a19e6575f1fad2e3d0c76f1d00d67f870a8593110913e5aed00bc025a5dce7b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "OS_2018_N_00001_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_OS_2018_N_00001_ART_001_PAR_01", "normativo": "BR_FED_COFEN_OS_2018_N_00001", "tipo_dispositivo": "paragrafo", "localizador": "§ 1º", "dispositivo_superior": "BR_FED_COFEN_OS_2018_N_00001_ART_001", "ordem": 8, "transcricao_literal": "§ 1º O relatório deverá ser encaminhado até 8 (oito) dias úteis contados do dia seguinte do retorno ao Cofen, podendo esse prazo ser prorrogado mediante justificativa e a critério do Chefe de Gabinete.", "sha256_texto": "c019f0003af5000d60ddf04169bf832b349891c7dd81c516ec09e6836e1f4078", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "OS_2018_N_00001_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
