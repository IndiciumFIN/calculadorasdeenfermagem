{"identificador": "BR_FED_COFEN_RES_2026_N_00809_ART_002_INC_II", "normativo": "BR_FED_COFEN_RES_2026_N_00809", "tipo_dispositivo": "inciso", "localizador": "Inciso II", "dispositivo_superior": "BR_FED_COFEN_RES_2026_N_00809_ART_002", "ordem": 15, "transcricao_literal": "II - Participar da elaboração de relatórios técnicos de avaliação, incorporação, monitoramento, desinvestimento de tecnologias em saúde e impacto orçamentário;", "sha256_texto": "d1be04f666e2aa247e35b10074f588c7705de50ab6a39289b0bb0f43a4d8ffed", "fonte_literal": "DOU", "arquivo_fonte": "RES_0809_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
