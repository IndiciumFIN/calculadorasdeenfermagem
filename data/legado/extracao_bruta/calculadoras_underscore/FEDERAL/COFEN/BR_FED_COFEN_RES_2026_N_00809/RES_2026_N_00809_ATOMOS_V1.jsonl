{"identificador": "BR_FED_COFEN_RES_2026_N_00809_EMENTA", "normativo": "BR_FED_COFEN_RES_2026_N_00809", "tipo_dispositivo": "ementa", "localizador": "Ementa", "dispositivo_superior": null, "ordem": 1, "transcricao_literal": "Dispõe sobre a atuação dos profissionais de Enfermagem em Avaliação de Tecnologias em Saúde (ATS) no Brasil e dá outras providências.", "sha256_texto": "62a6d8b7a5dd93200400c70b0772f532d47e231d4204fd050c2e136c7777bf40", "fonte_literal": "DOU", "arquivo_fonte": "RES_0809_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00809_PREAMBULO", "normativo": "BR_FED_COFEN_RES_2026_N_00809", "tipo_dispositivo": "preambulo", "localizador": "Preâmbulo", "dispositivo_superior": null, "ordem": 2, "transcricao_literal": "O PRESIDENTE DO CONSELHO FEDERAL DE ENFERMAGEM - Cofen, em conjunto com o Primeiro-Secretário da Autarquia, no uso de suas atribuições legais e regimentais conferidas na Lei nº 5.905 de 12 de julho de 1973, bem como pelo Regimento da Autarquia, aprovado pela Resolução Cofen nº 726, de 15 de setembro de 2023, ou outra que sobrevir;", "sha256_texto": "79e917a2736a07170ef9e1efb024c0df52aa697e2fca4ac146ce6afd161268ee", "fonte_literal": "DOU", "arquivo_fonte": "RES_0809_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00809_CONS_001", "normativo": "BR_FED_COFEN_RES_2026_N_00809", "tipo_dispositivo": "considerando", "localizador": "Considerando 1", "dispositivo_superior": null, "ordem": 3, "transcricao_literal": "CONSIDERANDO a prerrogativa estabelecida ao Cofen no art. 8º, inciso IV, da Lei nº 5.905/1973, de baixar provimentos e expedir instruções, para uniformidade de procedimento e bom funcionamento dos Conselhos Regionais;", "sha256_texto": "6a09be5f35e3ef6d80c0a64da5aad602726c7c149792bb91af4768e6b7fb1480", "fonte_literal": "DOU", "arquivo_fonte": "RES_0809_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00809_CONS_002", "normativo": "BR_FED_COFEN_RES_2026_N_00809", "tipo_dispositivo": "considerando", "localizador": "Considerando 2", "dispositivo_superior": null, "ordem": 4, "transcricao_literal": "CONSIDERANDO o disposto no artigo 21, inciso XII, do Regimento Interno do Cofen, aprovado pela Resolução Cofen nº 726/2023, ou outra que sobrevir, que autoriza o Conselho Federal de Enfermagem baixar Resoluções, Decisões e demais instrumentos legais no âmbito do Sistema Cofen/Conselhos Regionais de Enfermagem;", "sha256_texto": "64adc3cbe8faf2a7d136c01d21909efa439f823304cf8fcb2b55034227b48d6d", "fonte_literal": "DOU", "arquivo_fonte": "RES_0809_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00809_CONS_003", "normativo": "BR_FED_COFEN_RES_2026_N_00809", "tipo_dispositivo": "considerando", "localizador": "Considerando 3", "dispositivo_superior": null, "ordem": 5, "transcricao_literal": "CONSIDERANDO a Lei nº 12.401/2011, que alterou a Lei nº 8.080/1990 para dispor sobre a assistência terapêutica e a incorporação de tecnologias em saúde no SUS, e o Decreto nº 7.646/2011 (e suas atualizações), que regulamenta a Comissão Nacional de Incorporação de Tecnologias no Sistema Único de Saúde (CONITEC) e o processo administrativo de incorporação, exclusão ou alteração de tecnologias no SUS;", "sha256_texto": "b82f7a230d9d5f1bc7e7e25e965636c2ab3a7a85524fc64fe7b2e5d946b8e712", "fonte_literal": "DOU", "arquivo_fonte": "RES_0809_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00809_CONS_004", "normativo": "BR_FED_COFEN_RES_2026_N_00809", "tipo_dispositivo": "considerando", "localizador": "Considerando 4", "dispositivo_superior": null, "ordem": 6, "transcricao_literal": "CONSIDERANDO as Diretrizes Metodológicas Nacionais (CONITEC/REBRATS), para elaboração de Pareceres Técnico-Científicos (PTC) e para avaliação de dispositivos para saúde, que orientam a ATS no Brasil;", "sha256_texto": "407e222aed60d1915f66645460640d37a438734b86f4ae91d17e759daecb725a", "fonte_literal": "DOU", "arquivo_fonte": "RES_0809_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00809_CONS_005", "normativo": "BR_FED_COFEN_RES_2026_N_00809", "tipo_dispositivo": "considerando", "localizador": "Considerando 5", "dispositivo_superior": null, "ordem": 7, "transcricao_literal": "CONSIDERANDO a Resolução Cofen nº 564/2017, ou outra que sobrevier que aprova o código de ética dos profissionais de enfermagem;", "sha256_texto": "f259e7d6440330a7964d3dddd93201e9d88f0b42f520a73d3ed8a4e51f6a5c36", "fonte_literal": "DOU", "arquivo_fonte": "RES_0809_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00809_CONS_006", "normativo": "BR_FED_COFEN_RES_2026_N_00809", "tipo_dispositivo": "considerando", "localizador": "Considerando 6", "dispositivo_superior": null, "ordem": 8, "transcricao_literal": "CONSIDERANDO a Resolução Cofen nº 782/2025, que trata da Anotação de Responsabilidade Técnica (ART) na Enfermagem, alterada pela Resolução Cofen nº 784/2025, ou outra que sobrevier;", "sha256_texto": "1ef227e82f8a35e969f536681446d6b795a9836372b1c208ea8f3e6f9417da53", "fonte_literal": "DOU", "arquivo_fonte": "RES_0809_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00809_CONS_007", "normativo": "BR_FED_COFEN_RES_2026_N_00809", "tipo_dispositivo": "considerando", "localizador": "Considerando 7", "dispositivo_superior": null, "ordem": 9, "transcricao_literal": "CONSIDERANDO a deliberação da 589ª Reunião Ordinária de Plenário do Cofen, Despacho da Assessoria Legislativa (1711731) bem como todos os documentos acostados ao Processo SEI nº 00196.005740/2025-59; resolve:", "sha256_texto": "cb0f421e608d835341b1ec0452180abe882348724b0d39f4c20c013e7034467b", "fonte_literal": "DOU", "arquivo_fonte": "RES_0809_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00809_ART_001", "normativo": "BR_FED_COFEN_RES_2026_N_00809", "tipo_dispositivo": "artigo", "localizador": "Art. 1º", "dispositivo_superior": null, "ordem": 10, "transcricao_literal": "Art. 1º Para efeitos desta Resolução, considera-se:", "sha256_texto": "99763c97e4789576f7db329d83d17bda5b13cadb38f709cec3742ca6bd889915", "fonte_literal": "DOU", "arquivo_fonte": "RES_0809_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00809_ART_001_INC_I", "normativo": "BR_FED_COFEN_RES_2026_N_00809", "tipo_dispositivo": "inciso", "localizador": "Inciso I", "dispositivo_superior": "BR_FED_COFEN_RES_2026_N_00809_ART_001", "ordem": 11, "transcricao_literal": "I - Avaliação de Tecnologias em Saúde (ATS): como processo multidisciplinar, sistemático e explícito para determinar o valor de tecnologias ao longo dos ciclos de vida, com vistas a subsidiar decisões orientadas para resultados e promover equidade, eficiência e qualidade nos sistemas de saúde.", "sha256_texto": "2c8886c1c3d7e7ef35d1e7fcdb8886929571d05c0385b1f245e239d0b38c7f40", "fonte_literal": "DOU", "arquivo_fonte": "RES_0809_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00809_ART_001_INC_II", "normativo": "BR_FED_COFEN_RES_2026_N_00809", "tipo_dispositivo": "inciso", "localizador": "Inciso II", "dispositivo_superior": "BR_FED_COFEN_RES_2026_N_00809_ART_001", "ordem": 12, "transcricao_literal": "II - No campo da ATS, de modo ampliado, incluem-se não apenas artefatos e equipamentos, mas também os saberes e as relações que estruturam o cuidado como acolhimento, escuta qualificada e produção de vínculo e tecnologias leve-duras (saberes estruturados, como protocolos clínicos, diretrizes e processos de trabalho), devendo ambas ser reconhecidas e avaliadas pela ATS por seu impacto concreto na qualidade, na segurança e na humanização do cuidado.", "sha256_texto": "4e85d7128667d87557de649bf3bd4c13867acc2e5238d268f6f9d1c2fbbad082", "fonte_literal": "DOU", "arquivo_fonte": "RES_0809_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00809_ART_002", "normativo": "BR_FED_COFEN_RES_2026_N_00809", "tipo_dispositivo": "artigo", "localizador": "Art. 2º", "dispositivo_superior": null, "ordem": 13, "transcricao_literal": "Art. 2º Compete ao(à) Enfermeiro(a) atuar nos processos de Avaliação de Tecnologias em Saúde (ATS), observadas as competências previstas na legislação profissional e as diretrizes nacionais e internacionais, cabendo-lhe:", "sha256_texto": "272c6f9ffd6b901a2222bd623ba956d9ae0dcc0a6df018dc40f7ee06b0313002", "fonte_literal": "DOU", "arquivo_fonte": "RES_0809_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
