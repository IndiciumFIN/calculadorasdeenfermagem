{"identificador": "BR_FED_COFEN_RES_2026_N_00809_ART_004", "normativo": "BR_FED_COFEN_RES_2026_N_00809", "tipo_dispositivo": "artigo", "localizador": "Art. 4º", "dispositivo_superior": null, "ordem": 20, "transcricao_literal": "Art. 4º É facultado ao(à) Enfermeiro(a) coordenar equipes de ATS voltadas à avaliação de tecnologias relacionadas ao cuidado à saúde, abrangendo dispositivos, processos, protocolos e demais recursos que impactem a segurança, efetividade e eficiência do cuidado.", "sha256_texto": "172b5ecbf3a380353e2c4c60470858d31eeedbb988fb1734956eb1e560f7d69e", "fonte_literal": "DOU", "arquivo_fonte": "RES_0809_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00809_ART_004_PAR_UNICO", "normativo": "BR_FED_COFEN_RES_2026_N_00809", "tipo_dispositivo": "paragrafo", "localizador": "Parágrafo único", "dispositivo_superior": "BR_FED_COFEN_RES_2026_N_00809_ART_004", "ordem": 21, "transcricao_literal": "Parágrafo único: No âmbito da equipe de Enfermagem, é privativo ao Enfermeiro a Coordenação das equipes de ATS.", "sha256_texto": "2ff3dd9cd627f9ad3eedd41d7f49e6581053cc939085c677f68676009701fc07", "fonte_literal": "DOU", "arquivo_fonte": "RES_0809_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00809_ART_005", "normativo": "BR_FED_COFEN_RES_2026_N_00809", "tipo_dispositivo": "artigo", "localizador": "Art. 5º", "dispositivo_superior": null, "ordem": 22, "transcricao_literal": "Art. 5º Recomenda-se para atuação como coordenador de equipes de ATS voltadas ao cuidado de enfermagem, experiência profissional mínima de 2 (dois) anos de atuação documentada na área de gestão assistencial, ou gestão de área técnica ou gestão de ensino/formação.", "sha256_texto": "38d7ed6a57e3c139fd03acceef598df7c95f1df1211091e35106e9489cc69888", "fonte_literal": "DOU", "arquivo_fonte": "RES_0809_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
