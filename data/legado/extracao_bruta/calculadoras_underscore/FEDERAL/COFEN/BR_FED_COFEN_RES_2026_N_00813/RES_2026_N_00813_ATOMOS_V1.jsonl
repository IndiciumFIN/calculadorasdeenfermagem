{"identificador": "BR_FED_COFEN_RES_2026_N_00813_CONS_030", "normativo": "BR_FED_COFEN_RES_2026_N_00813", "tipo_dispositivo": "considerando", "localizador": "Considerando 30", "dispositivo_superior": null, "ordem": 32, "transcricao_literal": "CONSIDERANDO a Decisão Cofen nº 263/2023 que reconhece a Podiatria Clínica como Especialidade do Enfermeiro e a Insere na Área I, Saúde Coletiva; Saúde da Criança e do adolescente; Saúde do Adulto, do Anexo da Resolução Cofen nº 581/2018;", "sha256_texto": "fdc0565ac867fabc4dc34ef59308780f5064e4f138ec942b637092c35607fd33", "fonte_literal": "DOU", "arquivo_fonte": "RES_0813_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00813_CONS_031", "normativo": "BR_FED_COFEN_RES_2026_N_00813", "tipo_dispositivo": "considerando", "localizador": "Considerando 31", "dispositivo_superior": null, "ordem": 33, "transcricao_literal": "CONSIDERANDO os Cadernos de Atenção Básica e Manuais do Ministério da Saúde que estabelecem estratégias para o cuidado à pessoa com doenças crônicas;", "sha256_texto": "41e00dcbf826659244951344bd8e886250168ca79e8567582fbea3b2d6bcb2a8", "fonte_literal": "DOU", "arquivo_fonte": "RES_0813_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00813_CONS_032", "normativo": "BR_FED_COFEN_RES_2026_N_00813", "tipo_dispositivo": "considerando", "localizador": "Considerando 32", "dispositivo_superior": null, "ordem": 34, "transcricao_literal": "CONSIDERANDO a deliberação do Plenário em sua 591ª Reunião Ordinária e tudo o mais que consta nos autos do Processo SEI nº 00196.006864/2025-51; resolve:", "sha256_texto": "3834e8eae8ce2bf853dc0bf45420b429e21f36ee0d7d41ed3fc140dd79754197", "fonte_literal": "DOU", "arquivo_fonte": "RES_0813_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00813_ART_001", "normativo": "BR_FED_COFEN_RES_2026_N_00813", "tipo_dispositivo": "artigo", "localizador": "Art. 1º", "dispositivo_superior": null, "ordem": 35, "transcricao_literal": "Art. 1º Regulamentar a atuação da Equipe de Enfermagem em Podiatria Clínica, respeitados os graus de competência e habilitação técnica e legal, previstos no anexo desta Resolução.", "sha256_texto": "3421e0ad77812e956878de98ab9243260cfd6c3d008f15da0bd19b2ff163c83b", "fonte_literal": "DOU", "arquivo_fonte": "RES_0813_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00813_ART_001_PAR_UNICO", "normativo": "BR_FED_COFEN_RES_2026_N_00813", "tipo_dispositivo": "paragrafo", "localizador": "Parágrafo único", "dispositivo_superior": "BR_FED_COFEN_RES_2026_N_00813_ART_001", "ordem": 36, "transcricao_literal": "Parágrafo único. No âmbito da equipe de Enfermagem em Podiatria Clínica, ficam resguardadas as atividades privativas do Enfermeiro, observadas as disposições legais da profissão.", "sha256_texto": "eb298784e3b8c9a1df548de0f89d0bc173e65b5d270d607641491e5ac3730c3d", "fonte_literal": "DOU", "arquivo_fonte": "RES_0813_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00813_ART_002", "normativo": "BR_FED_COFEN_RES_2026_N_00813", "tipo_dispositivo": "artigo", "localizador": "Art. 2º", "dispositivo_superior": null, "ordem": 37, "transcricao_literal": "Art. 2º A equipe de Enfermagem na Podiatria Clínica atua em todos os níveis de atenção à saúde, promoção, prevenção, tratamento e reabilitação, bem como na gestão, ensino, pesquisa e inovação, respeitadas as competências legais de cada categoria.", "sha256_texto": "b0b54cc37da92977e8c1e6aa8a834c47372b0e3e12c1a9454cc1c51c7d0f950c", "fonte_literal": "DOU", "arquivo_fonte": "RES_0813_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00813_ART_003", "normativo": "BR_FED_COFEN_RES_2026_N_00813", "tipo_dispositivo": "artigo", "localizador": "Art. 3º", "dispositivo_superior": null, "ordem": 38, "transcricao_literal": "Art. 3º O enfermeiro Podiatra atua na área do saber especializado, integralmente dedicada ao cuidado dos membros inferiores, com ênfase na saúde dos pés, incorporando o uso de tecnologias terapêuticas e diagnósticas e atuando na avaliação e no manejo podoposturológico, incluindo a análise estática e dinâmica da postura, dos padrões de apoio plantar, da biomecânica da marcha, da cinesiologia do movimento e dos reflexos neuromotores associados, com vistas à identificação de alterações funcionais, a promoção da saúde, prevenção de agravos, tratamento e reabilitação funcional.", "sha256_texto": "a9db8d521f7f472cc30313125ec979577eacf24e57cbc1f8fd44a7dacd18d693", "fonte_literal": "DOU", "arquivo_fonte": "RES_0813_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00813_ART_004", "normativo": "BR_FED_COFEN_RES_2026_N_00813", "tipo_dispositivo": "artigo", "localizador": "Art. 4º", "dispositivo_superior": null, "ordem": 39, "transcricao_literal": "Art. 4º O Enfermeiro que atua em Podiatria Clínica tem autonomia para atuar em serviços públicos e privados de saúde.", "sha256_texto": "a24a810cb24cde3625d5ee9ddde2a59318bf034afb10e6699a67887e210e39c1", "fonte_literal": "DOU", "arquivo_fonte": "RES_0813_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00813_ART_005", "normativo": "BR_FED_COFEN_RES_2026_N_00813", "tipo_dispositivo": "artigo", "localizador": "Art. 5º", "dispositivo_superior": null, "ordem": 40, "transcricao_literal": "Art. 5º O cuidado podiátrico deve ser precedido de avaliação clínica integral, através da consulta de enfermagem, conforme as etapas do processo de enfermagem.", "sha256_texto": "9191dafb2c93a587c9fbefcac0a47a43531bd0d6e58887cceb9b1f617f1c751d", "fonte_literal": "DOU", "arquivo_fonte": "RES_0813_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00813_ART_006", "normativo": "BR_FED_COFEN_RES_2026_N_00813", "tipo_dispositivo": "artigo", "localizador": "Art. 6º", "dispositivo_superior": null, "ordem": 41, "transcricao_literal": "Art. 6º O Enfermeiro que atua em Podiatria Clínica, no exercício de suas competências legais, pode realizar a prescrição de coberturas, medicamentos e tecnologias adjuvantes, bem como a solicitação de exames complementares, conforme as diretrizes, os protocolos clínicos, os programas de saúde, as evidências científicas e a legislação vigente.", "sha256_texto": "588828074fee7c8099faf6573ebd6afdccbdfcc7b70efa17e5ff19024828b452", "fonte_literal": "DOU", "arquivo_fonte": "RES_0813_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00813_ART_007", "normativo": "BR_FED_COFEN_RES_2026_N_00813", "tipo_dispositivo": "artigo", "localizador": "Art. 7º", "dispositivo_superior": null, "ordem": 42, "transcricao_literal": "Art. 7º Considera-se Enfermeiro Especialista em Podiatria Clínica (Enfermeiro Podiatra) aquele que possuir curso de pós-graduação lato sensu em Podiatria Clínica reconhecido pelo Ministério da Educação (MEC), com carga horária mínima de 360 (trezentas e sessenta) horas, das quais, no mínimo, 30% (trinta por cento) correspondam a atividades práticas supervisionadas, ou título de especialista emitido por sociedade brasileira reconhecida na área de Podiatria.", "sha256_texto": "d3208a14a4eeadfb1ac2fa8a7494b775f9b89f91ee67de05b911cfe890e7c058", "fonte_literal": "DOU", "arquivo_fonte": "RES_0813_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00813_ART_008", "normativo": "BR_FED_COFEN_RES_2026_N_00813", "tipo_dispositivo": "artigo", "localizador": "Art. 8º", "dispositivo_superior": null, "ordem": 43, "transcricao_literal": "Art. 8º O enfermeiro especialista em Dermatologia ou Estomaterapia poderá atuar na área de podiatria clínica, sem aquisição do título de Enfermeiro Especialista em Podiatria Clínica, desde que possua formação teórica e prática específica em Podiatria Clínica compatível com o desenvolvimento das competências previstas nesta Resolução, comprovada por uma das seguintes formas:", "sha256_texto": "7ffe0ef12a226038491878b9c356564c2b851e40069ebffa705acd82ca65d7b8", "fonte_literal": "DOU", "arquivo_fonte": "RES_0813_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00813_ART_008_INC_I", "normativo": "BR_FED_COFEN_RES_2026_N_00813", "tipo_dispositivo": "inciso", "localizador": "Inciso I", "dispositivo_superior": "BR_FED_COFEN_RES_2026_N_00813_ART_008", "ordem": 44, "transcricao_literal": "I - curso de pós-graduação lato sensu em Dermatologia ou Estomaterapia, reconhecido pelo Ministério da Educação (MEC), cuja matriz curricular contemple, no mínimo, 20% (vinte por cento) da carga horária dedicada a conteúdos teóricos e práticos específicos de Podiatria Clínica; ou", "sha256_texto": "4feabdc113e490394982aae351ce39916a7837c502595365118e088c2f7f446e", "fonte_literal": "DOU", "arquivo_fonte": "RES_0813_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00813_ART_008_INC_II", "normativo": "BR_FED_COFEN_RES_2026_N_00813", "tipo_dispositivo": "inciso", "localizador": "Inciso II", "dispositivo_superior": "BR_FED_COFEN_RES_2026_N_00813_ART_008", "ordem": 45, "transcricao_literal": "II - cursos de capacitação complementar em Podiatria Clínica, que somem carga horária mínima de 120 (cento e vinte) horas, contemplando conteúdos teóricos e práticos compatíveis com o desenvolvimento das competências previstas nesta Resolução.", "sha256_texto": "f2f59d58b6c35e27ef6e0a0ec5a64fe488358c77f3ff5c0e8d8aeb33313f1f8e", "fonte_literal": "DOU", "arquivo_fonte": "RES_0813_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00813_ART_009", "normativo": "BR_FED_COFEN_RES_2026_N_00813", "tipo_dispositivo": "artigo", "localizador": "Art. 9º", "dispositivo_superior": null, "ordem": 46, "transcricao_literal": "Art. 9º O profissional deverá buscar o gerenciamento adequado dos resíduos de saúde, o descarte correto de materiais e o uso racional de recursos, de acordo com as normas regulatórias vigentes.", "sha256_texto": "c4696cf2a26c784e4a656430ca298ee4a301718dc8a1ea67467fca762ad80bee", "fonte_literal": "DOU", "arquivo_fonte": "RES_0813_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00813_ART_010", "normativo": "BR_FED_COFEN_RES_2026_N_00813", "tipo_dispositivo": "artigo", "localizador": "Art. 10", "dispositivo_superior": null, "ordem": 47, "transcricao_literal": "Art. 10 É responsabilidade e dever dos profissionais da Enfermagem em podiatria registrar, no prontuário do paciente e em outros documentos próprios da área, seja escrito ou eletrônico, as informações inerentes ao processo de cuidar e ao gerenciamento dos processos de trabalho, necessárias para assegurar a continuidade e a qualidade da assistência.", "sha256_texto": "8016f150a674c0a3c04fe50c1511bc867c3bd8aa77c0670e4c0c95c0029b171c", "fonte_literal": "DOU", "arquivo_fonte": "RES_0813_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
