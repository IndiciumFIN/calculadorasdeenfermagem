{"identificador": "BR_FED_COFEN_RES_2026_N_00813_ART_012", "normativo": "BR_FED_COFEN_RES_2026_N_00813", "tipo_dispositivo": "artigo", "localizador": "Art. 12", "dispositivo_superior": null, "ordem": 49, "transcricao_literal": "Art. 12 Os casos omissos serão resolvidos pelo Conselho Federal de Enfermagem.", "sha256_texto": "bcd925a831651a8e9eaeac480425fda1805ea0c1147437fe734ebb9adb27cbcf", "fonte_literal": "DOU", "arquivo_fonte": "RES_0813_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
