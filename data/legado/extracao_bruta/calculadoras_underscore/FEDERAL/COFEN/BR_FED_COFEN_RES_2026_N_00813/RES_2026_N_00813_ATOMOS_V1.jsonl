{"identificador": "BR_FED_COFEN_RES_2026_N_00813_CONS_027", "normativo": "BR_FED_COFEN_RES_2026_N_00813", "tipo_dispositivo": "considerando", "localizador": "Considerando 27", "dispositivo_superior": null, "ordem": 29, "transcricao_literal": "CONSIDERANDO o Parecer de Conselheiro Federal nº 232/2022/COFEN, que dispõe sobre a Prescrição ou Indicação formal na confecção de formulações em farmácia com manipulação para utilização tópica em tratamento e lesões de pele pelo enfermeiro Especialista em Estomaterapia, Dermatologia ou Podiatria;", "sha256_texto": "9282ce88028f9bbf2f2407ebb21ac38fd02d3f16eafc98eee86dfc22e78a916b", "fonte_literal": "DOU", "arquivo_fonte": "RES_0813_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
