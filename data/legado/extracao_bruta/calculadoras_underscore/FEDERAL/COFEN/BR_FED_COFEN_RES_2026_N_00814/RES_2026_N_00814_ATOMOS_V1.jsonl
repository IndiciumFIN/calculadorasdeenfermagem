{"identificador": "BR_FED_COFEN_RES_2026_N_00814_ART_008_PAR_04", "normativo": "BR_FED_COFEN_RES_2026_N_00814", "tipo_dispositivo": "paragrafo", "localizador": "§ 4º", "dispositivo_superior": "BR_FED_COFEN_RES_2026_N_00814_ART_008", "ordem": 58, "transcricao_literal": "§ 4º O Plano de Recondução ao Limite poderá ser revisado mediante justificativa técnica fundamentada, sempre que fatos supervenientes recomendarem sua atualização.", "sha256_texto": "7d682a35f01dfc20ce6745ed7e789661783ca041c608df14f02a4b1de35ded4d", "fonte_literal": "DOU", "arquivo_fonte": "RES_0814_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00814_ART_008_PAR_05", "normativo": "BR_FED_COFEN_RES_2026_N_00814", "tipo_dispositivo": "paragrafo", "localizador": "§ 5º", "dispositivo_superior": "BR_FED_COFEN_RES_2026_N_00814_ART_008", "ordem": 59, "transcricao_literal": "§ 5º O descumprimento injustificado das medidas previstas no Plano de Recondução ao Limite será comunicado ao Plenário do Conselho Federal de Enfermagem para adoção das providências cabíveis.", "sha256_texto": "7e3c4a621c9b0202d37fcbc3185584ed4f3ab7eb089db54b5515b81feaedde2f", "fonte_literal": "DOU", "arquivo_fonte": "RES_0814_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00814_ART_009", "normativo": "BR_FED_COFEN_RES_2026_N_00814", "tipo_dispositivo": "artigo", "localizador": "Art. 9º", "dispositivo_superior": null, "ordem": 60, "transcricao_literal": "Art. 9º Os Conselhos Federal e Regionais de Enfermagem deverão apresentar, juntamente com a Prestação de Contas Anual, o demonstrativo constante do Anexo I desta Resolução.", "sha256_texto": "fbe932d9412583614d8c433087c4b03e20ec66f1512ce0c70d1449f648d8a295", "fonte_literal": "DOU", "arquivo_fonte": "RES_0814_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00814_ART_009_PAR_01", "normativo": "BR_FED_COFEN_RES_2026_N_00814", "tipo_dispositivo": "paragrafo", "localizador": "§ 1º", "dispositivo_superior": "BR_FED_COFEN_RES_2026_N_00814_ART_009", "ordem": 61, "transcricao_literal": "§ 1º O demonstrativo de que trata o caput tem por finalidade padronizar os critérios de apuração das despesas com pessoal, conferir transparência às informações, subsidiar o acompanhamento dos respectivos indicadores e fortalecer os mecanismos de governança, controle e monitoramento previstos nesta Resolução.", "sha256_texto": "15ece98114e4be092e8195706573dd534124c9ecc41468ee5167e8e1a93ac5a5", "fonte_literal": "DOU", "arquivo_fonte": "RES_0814_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00814_ART_009_PAR_02", "normativo": "BR_FED_COFEN_RES_2026_N_00814", "tipo_dispositivo": "paragrafo", "localizador": "§ 2º", "dispositivo_superior": "BR_FED_COFEN_RES_2026_N_00814_ART_009", "ordem": 62, "transcricao_literal": "§ 2º O cumprimento dos limites de despesa com pessoal será objeto de acompanhamento periódico pela Controladoria-Geral ou pela unidade competente de controle interno de cada Conselho, com vistas ao monitoramento dos indicadores e à adoção tempestiva das medidas necessárias ao atendimento desta Resolução.", "sha256_texto": "3d8612a13d8aff56af3e5c4ebe3ef6bc9cc07e5c6286907dbecbf57968ec7848", "fonte_literal": "DOU", "arquivo_fonte": "RES_0814_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00814_ART_010", "normativo": "BR_FED_COFEN_RES_2026_N_00814", "tipo_dispositivo": "artigo", "localizador": "Art. 10", "dispositivo_superior": null, "ordem": 63, "transcricao_literal": "Art. 10 Os casos omissos serão resolvidos pelo Conselho Federal de Enfermagem.", "sha256_texto": "c07744355faed59ed9e76670465e68f82819f95e5d9958622c94126713d3e0c4", "fonte_literal": "DOU", "arquivo_fonte": "RES_0814_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00814_ART_011", "normativo": "BR_FED_COFEN_RES_2026_N_00814", "tipo_dispositivo": "artigo", "localizador": "Art. 11", "dispositivo_superior": null, "ordem": 64, "transcricao_literal": "Art. 11 Esta Resolução entra em vigor na data de sua publicação, ficando revogado o art. 44 da Resolução Cofen nº 340/2008.", "sha256_texto": "2d31e5b7bb3e236df16e96a5e67e8c166110d9cc3cbf8a43c5d5af9d0c357f4f", "fonte_literal": "DOU", "arquivo_fonte": "RES_0814_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
