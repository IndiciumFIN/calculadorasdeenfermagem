{"identificador": "BR_FED_COFEN_RES_2026_N_00814_EMENTA", "normativo": "BR_FED_COFEN_RES_2026_N_00814", "tipo_dispositivo": "ementa", "localizador": "Ementa", "dispositivo_superior": null, "ordem": 1, "transcricao_literal": "Dispõe sobre os limites de despesa com pessoal no âmbito do Sistema Cofen/Conselhos Regionais de Enfermagem e estabelece critérios para sua apuração, acompanhamento e controle.", "sha256_texto": "57e44fb285f4dabe27a0347f0e9982dc219129bdb93a0c0e7bf7611528048757", "fonte_literal": "DOU", "arquivo_fonte": "RES_0814_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00814_PREAMBULO", "normativo": "BR_FED_COFEN_RES_2026_N_00814", "tipo_dispositivo": "preambulo", "localizador": "Preâmbulo", "dispositivo_superior": null, "ordem": 2, "transcricao_literal": "O CONSELHO FEDERAL DE ENFERMAGEM - COFEN, no uso das atribuições que lhe são conferidas pela Lei nº 5.905, de 12 de julho de 1973, e pelo Regimento da Autarquia, aprovado pela Resolução Cofen nº 726, de 15 de setembro de 2023, ou por outra que lhe sobrevier;", "sha256_texto": "739c1cdb284889efbd1d6a817c312c95e8fb4aac821e2b798712848ea08562a6", "fonte_literal": "DOU", "arquivo_fonte": "RES_0814_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00814_CONS_001", "normativo": "BR_FED_COFEN_RES_2026_N_00814", "tipo_dispositivo": "considerando", "localizador": "Considerando 1", "dispositivo_superior": null, "ordem": 3, "transcricao_literal": "CONSIDERANDO a prerrogativa estabelecida ao Cofen no art. 8º, inciso IV, da Lei nº 5.905/1973, de baixar provimentos e expedir instruções, para uniformidade de procedimento e bom funcionamento dos Conselhos Regionais;", "sha256_texto": "6a09be5f35e3ef6d80c0a64da5aad602726c7c149792bb91af4768e6b7fb1480", "fonte_literal": "DOU", "arquivo_fonte": "RES_0814_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00814_CONS_002", "normativo": "BR_FED_COFEN_RES_2026_N_00814", "tipo_dispositivo": "considerando", "localizador": "Considerando 2", "dispositivo_superior": null, "ordem": 4, "transcricao_literal": "CONSIDERANDO o disposto no art. 21, inciso XII, do Regimento Interno do Cofen, aprovado pela Resolução Cofen nº 726/2023, ou por outra que lhe sobrevier, que autoriza o Conselho Federal de Enfermagem baixar Resoluções, Decisões e demais instrumentos legais no âmbito do Sistema Cofen/Conselhos Regionais de Enfermagem;", "sha256_texto": "0a05b3b4dd04f2c9042bb483c534341fe9f83e935a176c454537e6cd1d1fefbf", "fonte_literal": "DOU", "arquivo_fonte": "RES_0814_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00814_CONS_003", "normativo": "BR_FED_COFEN_RES_2026_N_00814", "tipo_dispositivo": "considerando", "localizador": "Considerando 3", "dispositivo_superior": null, "ordem": 5, "transcricao_literal": "CONSIDERANDO o Regulamento da Administração Financeira e Contábil do Sistema Cofen/Conselhos Regionais de Enfermagem, aprovado pela Resolução Cofen nº 340/2008;", "sha256_texto": "b98ee02235de9a09dffdeb1619232b31b534989505a4d00de20b45a3fcb8981d", "fonte_literal": "DOU", "arquivo_fonte": "RES_0814_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00814_CONS_004", "normativo": "BR_FED_COFEN_RES_2026_N_00814", "tipo_dispositivo": "considerando", "localizador": "Considerando 4", "dispositivo_superior": null, "ordem": 6, "transcricao_literal": "CONSIDERANDO a necessidade de estabelecer parâmetros de governança para o controle das despesas com pessoal, compatíveis com a realidade institucional e financeira das entidades integrantes do Sistema Cofen/Conselhos Regionais de Enfermagem;", "sha256_texto": "e683165b6316dc8cf66de64bc8a75ca92f2551628c93c51b7def4c3e6302d352", "fonte_literal": "DOU", "arquivo_fonte": "RES_0814_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
