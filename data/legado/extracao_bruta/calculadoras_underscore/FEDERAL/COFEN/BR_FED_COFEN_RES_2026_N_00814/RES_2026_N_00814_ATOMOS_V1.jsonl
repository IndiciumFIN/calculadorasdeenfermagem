{"identificador": "BR_FED_COFEN_RES_2026_N_00814_ART_001", "normativo": "BR_FED_COFEN_RES_2026_N_00814", "tipo_dispositivo": "artigo", "localizador": "Art. 1º", "dispositivo_superior": null, "ordem": 8, "transcricao_literal": "Art. 1º Estabelecer os limites de despesa com pessoal, os critérios para apuração da Receita Corrente Líquida Ajustada (RCLA), os mecanismos de governança, controle e os procedimentos para recondução aos limites regulamentares, no âmbito do Sistema Cofen/Conselhos Regionais de Enfermagem.", "sha256_texto": "b70c120f24d916b3f3b33734683a4abbdf544f6e7f05092370e2b47a895349da", "fonte_literal": "DOU", "arquivo_fonte": "RES_0814_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00814_ART_002", "normativo": "BR_FED_COFEN_RES_2026_N_00814", "tipo_dispositivo": "artigo", "localizador": "Art. 2º", "dispositivo_superior": null, "ordem": 9, "transcricao_literal": "Art. 2º O Sistema Cofen/Conselhos Regionais de Enfermagem observará, em relação à despesa total com pessoal, os seguintes limites máximos:", "sha256_texto": "49ec2598a40f9a294bbf5bed325c675fc1894dc635df6e5b6e97a659370b02b2", "fonte_literal": "DOU", "arquivo_fonte": "RES_0814_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
