{"identificador": "BR_FED_COFEN_PARCT_2024_N_00014_CTLNENF_EMENTA", "normativo": "BR_FED_COFEN_PARCT_2024_N_00014_CTLNENF", "tipo_dispositivo": "ementa", "localizador": "Ementa", "dispositivo_superior": null, "ordem": 4, "transcricao_literal": "Parecer técnico sobre obrigatoriedade da checagem das prescrições médicas e de Enfermagem no prontuário de internação hospitalar. Fundamentação em aspectos legais, éticos e normativos para garantir a segurança do paciente, prevenir erros de medicação e promover a qualidade do cuidado prestado pelos profissionais de Enfermagem.", "sha256_texto": "9df7f3a500a7b506e923da1aa38be4ed2650d76c0f7e8cf045fd2562d1223882", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00014_CTLNENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
