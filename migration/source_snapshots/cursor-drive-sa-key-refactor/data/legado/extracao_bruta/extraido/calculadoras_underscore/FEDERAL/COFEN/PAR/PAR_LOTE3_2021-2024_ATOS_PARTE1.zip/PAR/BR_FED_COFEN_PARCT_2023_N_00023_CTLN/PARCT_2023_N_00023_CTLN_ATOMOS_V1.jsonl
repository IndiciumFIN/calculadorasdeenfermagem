{"identificador": "BR_FED_COFEN_PARCT_2023_N_00023_CTLN_ART_012", "normativo": "BR_FED_COFEN_PARCT_2023_N_00023_CTLN", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 12 (citado/transcrito)", "dispositivo_superior": null, "ordem": 21, "transcricao_literal": "Art. 12. O Técnico de Enfermagem exerce atividade de nível médio, envolvendo orientação e acompanhamento do trabalho de enfermagem em grau auxiliar, e participação no planejamento da assistência de enfermagem, cabendo-lhe especialmente:", "sha256_texto": "0f791fccbd334fefc8bf6fcbfb5ba578d6ab0f20598675cb978b703ef8080957", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00023_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Artigo citado ou transcrito de outra norma (sequência não inicia em 1 no escopo); não é articulado próprio."}
