{"identificador": "BR_FED_COFEN_PARCT_2022_N_00041_CTAS_PARAGRAFO_TEXTO_013", "normativo": "BR_FED_COFEN_PARCT_2022_N_00041_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 10", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00041_CTAS_SECAO_002", "ordem": 18, "transcricao_literal": "Após avaliação minuciosa, para pacientes com incontinências urinária e/ou anal, ou para estabelecer programa preventivo de incontinências, quando pertinente, o Enfermeiro estomaterapeuta poderá́:", "sha256_texto": "33c2de5833bb53ec8d958e7347dbf833fbb8f0d5c8a46edde725daab5a66bb71", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00041_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
