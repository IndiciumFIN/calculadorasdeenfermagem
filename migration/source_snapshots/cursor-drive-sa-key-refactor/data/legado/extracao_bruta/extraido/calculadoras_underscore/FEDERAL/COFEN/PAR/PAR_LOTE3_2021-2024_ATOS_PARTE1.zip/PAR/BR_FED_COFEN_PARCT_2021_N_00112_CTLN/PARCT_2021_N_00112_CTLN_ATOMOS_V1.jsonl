{"identificador": "BR_FED_COFEN_PARCT_2021_N_00112_CTLN_ITEM_LISTA_001", "normativo": "BR_FED_COFEN_PARCT_2021_N_00112_CTLN", "tipo_dispositivo": "item_lista", "localizador": "Item de lista", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00112_CTLN_PARAGRAFO_TEXTO_012", "ordem": 29, "transcricao_literal": "2º A atenção domiciliar de enfermagem abrange um conjunto de atividades desenvolvidas por membros da equipe de enfermagem, caracterizadas pela atenção no domicílio do usuário do sistema de saúde que necessita de cuidados técnicos.", "sha256_texto": "a1f4ecd132d20c1dfd64318089603c726193463a0dc63bdcee8ec90906c74f6f", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00112_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "•"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00112_CTLN_ITEM_LISTA_002", "normativo": "BR_FED_COFEN_PARCT_2021_N_00112_CTLN", "tipo_dispositivo": "item_lista", "localizador": "Item de lista", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00112_CTLN_PARAGRAFO_TEXTO_012", "ordem": 30, "transcricao_literal": "3º A atenção domiciliar de Enfermagem pode ser executada no âmbito da Atenção Primaria e Secundária, por Enfermeiros que atuam de forma autônoma ou em equipe multidisciplinar por instituições públicas, privadas ou filantrópicas que ofereçam serviços de atendimento domiciliar.", "sha256_texto": "22dc3bbc58f7460489689d425b2553ed51865f759df27e1d7be8db5b8e4a0a47", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00112_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "•"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00112_CTLN_ITEM_LISTA_003", "normativo": "BR_FED_COFEN_PARCT_2021_N_00112_CTLN", "tipo_dispositivo": "item_lista", "localizador": "Item de lista", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00112_CTLN_PARAGRAFO_TEXTO_012", "ordem": 31, "transcricao_literal": "4º O Técnico de Enfermagem, em conformidade com o disposto na Lei do Exercício Profissional e no Decreto que a regulamenta, participa da execução da atenção domiciliar de enfermagem, naquilo que lhe couber, sob supervisão e orientação do Enfermeiro", "sha256_texto": "a07aa339b0299db18aa3479741621de9ed69e58039679b23c3b7a972f878037f", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00112_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "•"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00112_CTLN_ART_008_INC_II", "normativo": "BR_FED_COFEN_PARCT_2021_N_00112_CTLN", "tipo_dispositivo": "inciso", "localizador": "Inciso II", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00112_CTLN_ART_008", "ordem": 32, "transcricao_literal": "II – DA CONCLUSÃO Diante de todo acima exposto, esta Câmara Técnica reafirma que o Enfermeiro é o responsável direto para estabelecer um Dimensionamento de Pessoal de Enfermagem, que atenda as necessidades e complexidade que cada paciente demanda, independente do serviço em que está sendo atendido.", "sha256_texto": "cab5f712e3692603493343bb222dbd243cc11504b221cc25cbc542131344b240", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00112_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Dispositivo de artigo citado/transcrito."}
