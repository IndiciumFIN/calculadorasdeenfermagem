{"identificador": "BR_FED_COFEN_PARCONS_2015_N_00280_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARCONS_2015_N_00280", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2015_N_00280_SECAO_002", "ordem": 10, "transcricao_literal": "Essa manifestação foi recebida pela Ouvidoria no dia 10/12/2014, encaminhada à Presidência no dia 05 de janeiro de 2015 através do Memorando Ouvidoria Nº 002/2015.", "sha256_texto": "f33715049054f25dfd16c1a897fe01019596a5054524ca7cf5f894cff942be51", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2015_N_00280_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2015_N_00280_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARCONS_2015_N_00280", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2015_N_00280_SECAO_002", "ordem": 11, "transcricao_literal": "Em 23 de março de 2015, por meio de despacho do Sr. Chefe de Gabinete, foi encaminhado à Coordenadora da Câmara Técnica de Legislação e Normas, solicitando manifestação daquela Câmara Técnica ao questionamento procedente da Ouvidoria do COFEN.", "sha256_texto": "68ad4d3036d3b5be13a11f43677b0ce06e96e50beae75ca751333e20c1df480c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2015_N_00280_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2015_N_00280_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_PARCONS_2015_N_00280", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2015_N_00280_SECAO_002", "ordem": 12, "transcricao_literal": "Em resposta, no dia 30 de abril de 2015, através do Memorando n° 12/2015/CTLN/COFEN, esta Câmara Técnica apresenta Minuta de Resolução que regulamenta a matéria e sugere que a mesma seja submetida à consulta pública e ampla divulgação aos Conselhos Regionais e profissionais de enfermagem.", "sha256_texto": "ea4b2c68965c410d5c4166a22036f551cb82ba8c0e942652d7a08714b46de65a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2015_N_00280_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2015_N_00280_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARCONS_2015_N_00280", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2015_N_00280_SECAO_002", "ordem": 13, "transcricao_literal": "Na mesma data, 30/04/2015 é autorizada pela Presidência do COFEN a realização da Consulta Pública, conforme folha 09.", "sha256_texto": "bccd7cef381bd8ad9320180d00ff96eee5cda2ad485fa28417634aa0c6006b54", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2015_N_00280_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2015_N_00280_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_PARCONS_2015_N_00280", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2015_N_00280_SECAO_002", "ordem": 14, "transcricao_literal": "O Departamento de Tecnologia da Informação e Comunicação, informa que a matéria da Minuta de Resolução ficará disponível no site do COFEN de 04/ 05/2015 a 06/08/2015, conforme Memorando nº235/2015/DTIC, em 05 de maio de 2015.", "sha256_texto": "76374dc94dc0137ed5e20b8ff577486061ab8692edb3f72056fd90bf87b49b17", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2015_N_00280_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2015_N_00280_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_PARCONS_2015_N_00280", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2015_N_00280_SECAO_002", "ordem": 15, "transcricao_literal": "A Consulta Pública esteve no site do COFEN por 90 dias e recebeu 371 acessos distribuídos em comentários, críticas e sugestões, 26 estados e o Distrito Federal participaram. A região nordeste foi a que mais contribuiu com o subsídio científico, seguida pela região sudeste.", "sha256_texto": "dd7496b397bdcdb3602e15c46b5b26fc72719d6f7a11f2852749fe5627469c86", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2015_N_00280_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2015_N_00280_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_COFEN_PARCONS_2015_N_00280", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 7", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2015_N_00280_SECAO_002", "ordem": 16, "transcricao_literal": "Embora existam Pareceres dos Conselhos Regionais: SP; Es; DF e Deliberação do Coren MG, todos eles abordam o desbridamento de feridas, mas, não constam em nenhum deles uma regulamentação legalizando a atuação do enfermeiro e d sua equipe aos cuidados de enfermagem.", "sha256_texto": "f42e1585c7f2cbb2480380cc7b7bd2504542dd070889d947362023e8ca523730", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2015_N_00280_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2015_N_00280_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARCONS_2015_N_00280", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 8", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2015_N_00280_SECAO_002", "ordem": 17, "transcricao_literal": "O profissional enfermeiro deverá buscar não somente a competência como também, a habilidade da técnica, que utilizará em sincronismo com o conhecimento e a compreensão sobre o processo patológico e o tratamento específico, sob a luz de uma legislação.", "sha256_texto": "c130c785e859dbe9ab45ff8ffc97552cb8f99d9a164c5a4655e3431b2e0bae6a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2015_N_00280_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2015_N_00280_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_PARCONS_2015_N_00280", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 9", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2015_N_00280_SECAO_002", "ordem": 18, "transcricao_literal": "Segundo Dr. Richard Salcido do Departamento de Reabilitação da Universidade da Pennsylvania – Philadelphia, … “o cuidado sob medida para o paciente é a base do tratamento efetivo das feridas, que tem por fim promover a hemostasia e a cicatrização, reduzir o risco de infecção e o agravamento das lesões, e manter a viabilidade cutânea. Para alcançar um desfecho positivo do tratamento devem ser considerados de modo amplo tanto o paciente quanto a ferida.”", "sha256_texto": "294a348de5525cae8865ea2fa612138f105e932af58a4bf0bab0164fd052e51b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2015_N_00280_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2015_N_00280_PARAGRAFO_TEXTO_012", "normativo": "BR_FED_COFEN_PARCONS_2015_N_00280", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 10", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2015_N_00280_SECAO_002", "ordem": 19, "transcricao_literal": "A Norma Técnica que Regulamenta a Competência da Equipe de Enfermagem no Cuidado às Feridas, está anexo ao referido PAD, fazendo parte integrante deste parecer.", "sha256_texto": "9d4c865d6962f76336fe66ba0dfc1ccc31204ab664acbddb07b1d491e093dfd1", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2015_N_00280_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
