{"identificador": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_SECAO_001", "ordem": 7, "transcricao_literal": "A solicitação refere-se ao pedido de Registro, enviado pelo Conselho Regional de Enfermagem do Rio Grande do Sul – Coren-RS, em 22 de março de 2023, acerca do registro do título de Pós-Graduação Lato Sensu em “Auriculoterapia Neurofisiológica” da Enfermeira Thaiane Araújo de Araújo, registro nº 658913-ENF, curso ofertado pela Faculdade FaCiencia.", "sha256_texto": "69701025b50b331b465603b8281d6dccf0c804e8ab73d057d44c59082008892c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00018_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_SECAO_001", "ordem": 8, "transcricao_literal": "A requerente apresentou, por meio do Regional, e-mail com a referida solicitação do registro de título de especialização da Enfermeira Thaiane Araújo de Araújo em “Auriculoterapia Neurofisiológica”, histórico escolar, registro do curso na Plataforma e- MEC, além da portaria de criação do curso e registro profissional.", "sha256_texto": "8d781bbddfd89c8f9d56ab0cee9b85ac4b9469580b9052aa89deb97532f812ad", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00018_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_SECAO_001", "ordem": 9, "transcricao_literal": "Após a solicitação, por meio de requerimento, manifestou-se a chefe da Divisão de Inscrição, Registro e Cadastro do Cofen, sugerindo o encaminhamento para análise da Câmara Técnica de Educação e Pesquisa – CTEP/Cofen com vistas a emitir parecer acerca da solicitação.", "sha256_texto": "22d1f651020e55a3d713c51e1793487c85cdbf0173748e87ff53e83262e2d3fb", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00018_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_SECAO_001", "ordem": 10, "transcricao_literal": "Instada esta CTEP/Cofen a se manifestar sobre a matéria, passa-se a análise.", "sha256_texto": "dc02ee12f9bd61bd6cdcc78263b67e6571eaef073da565cc43b09cb665b1b1e9", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00018_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_SECAO_002", "normativo": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP", "tipo_dispositivo": "secao", "localizador": "II. FUNDAMENTAÇÃO", "dispositivo_superior": null, "ordem": 11, "transcricao_literal": "II. FUNDAMENTAÇÃO", "sha256_texto": "685155de3de3ed3f2f8f8b81dbe74f0335422a2abbc215c5604d7e9096b7c5c5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00018_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_SECAO_002", "ordem": 12, "transcricao_literal": "No dia 22 de março de 2023 fora recebido, por meio de correio eletrônico, solicitação em que o Coren-RS encaminha documentação para inclusão da especialização “Auriculoterapia Neurofisiológica” no rol de especialidades registradas pelo Cofen.", "sha256_texto": "41eb389189754529129d8aa5a32fbea0e4544172c081c569ef129c258bfe2722", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00018_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_SECAO_002", "ordem": 13, "transcricao_literal": "Tendo em vista a necessidade de fundamentar sua solicitação, foi apresentado pela requerente o certificado em nome de Thaiane Araújo de Araújo, emitido pela Faculdade FaCiencia (Portaria n° 147, de 8 de março de 2022 e publicada em D.O.U de 10/03/2022).", "sha256_texto": "bef8fe227aca7ee63148d2013a60db9de1be82469f3d5f0626f1b6f0fd3ad729", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00018_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_SECAO_002", "ordem": 14, "transcricao_literal": "Sobre a legislação que versa sobre a matéria, destaca-se a Resolução Cofen nº 581/2018 – alterada pela resolução Cofen n° 625/2020 e decisões Cofen nº 065/2021 e 120/2021, que atualizou no âmbito do Sistema Cofen/Conselhos Regionais de Enfermagem os procedimentos para Registro de Títulos de Pós-Graduação Lato e Stricto Sensu concedido a enfermeiros e também aprovou a lista das especialidades.", "sha256_texto": "7a51b8f46494315e1be6489f6c275bf9f524f3bb760acae36c5a62c33e94f817", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00018_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_SECAO_002", "ordem": 15, "transcricao_literal": "As referidas Resoluções não fazem referência à área de atuação profissional em Enfermagem denominada “Auriculoterapia Neurofisiológica”.", "sha256_texto": "09ed4147d67f81f44ae369d54e611ba502a87ff3502f218337231b5d73b163d0", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00018_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_PARAGRAFO_TEXTO_012", "normativo": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_SECAO_002", "ordem": 16, "transcricao_literal": "Sobre o reconhecimento do curso em tela, tem-se anexo ao PAD, documento que comprova que o curso fora registrado e credenciado pela Portaria Ministerial nº 147, de 8 de marco de 2022 – credenciamento EAD, publicado no D.O.U. de 10/03/2022, Seção 1, Pag.47, conforme se avista voto de relator:", "sha256_texto": "5bd0885e1d6e52e879da267ab281e7697c34f06147926f597e45941f57abb4d6", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00018_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_PARAGRAFO_TEXTO_013", "normativo": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_SECAO_002", "ordem": 17, "transcricao_literal": "Nos termos do Decreto nº 9.057/2017 e da Portaria Normativa MEC nº 11/2017, voto favoravelmente ao credenciamento, para a oferta de cursos superiores na modalidade a distância, da Faculdade Sapiência (FACIÊNCIA), com sede na Rua Visconde de Nacar, nº 1.510, Centro, no município de Curitiba, no estado do Paraná, mantida pelo Guindani Instituto de Ensino Pesquisa e Gestão S/S Ltda., com sede no mesmo município e estado, observando-se tanto o prazo de 4 (quatro) anos, conforme dispõe a Portaria Normativa MEC nº 1, de 3 de janeiro de 2017, quanto a exigência avaliativa prevista no Decreto nº 9.235/2017, com abrangência de atuação em sua sede e nos eventuais polos a serem criados pela instituição, a partir da oferta do curso superior de tecnologia em Gestão de Recursos Humanos, com o número de vagas totais anuais a ser fixado pela Secretaria de Regulação e Supervisão da Educação Superior (SERES).", "sha256_texto": "008b41dc8787ed89afceccb82f892e03e156696bc33902dc335e1da2cc667614", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00018_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_PARAGRAFO_TEXTO_014", "normativo": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 7", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_SECAO_002", "ordem": 18, "transcricao_literal": "Tendo em vista o histórico apresentado pela requerente, observa-se que as áreas de competência da referida especialização estão relacionadas às atividades que podem ser desempenhadas por profissionais enfermeiros.", "sha256_texto": "328e6e1d46f97c01ee59796684b57e932f848d26230fd5109595a3573b6f30d4", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00018_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_PARAGRAFO_TEXTO_015", "normativo": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 8", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_SECAO_002", "ordem": 19, "transcricao_literal": "Sobre a Auriculoterapia Neurofisiológica, as publicações mostram que é uma técnica terapêutica que utiliza estímulos em pontos específicos na orelha para tratar diversas condições de saúde, incluindo a dor. Existem muitos estudos que avaliam a eficácia da auriculoterapia, permitindo a realização de revisões sistemáticas no assunto. De fato, várias revisões sistemáticas e meta-análises foram realizadas para avaliar a eficácia da auriculoterapia no alívio da dor em diferentes condições, incluindo dor lombar, dor de cabeça, dor no joelho e dor crônica em geral. Algumas dessas revisões sistemáticas mostraram que a auriculoterapia pode ser eficaz no alívio da dor em algumas dessas condições, embora os resultados nem sempre sejam conclusivos (ARTIOLI; TAVARES; BERTOLINI, 2019).", "sha256_texto": "f9b0a9cb350be25475908e13f668ac90f0e59ec0f0f893d34c040bc829c46b47", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00018_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_PARAGRAFO_TEXTO_016", "normativo": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 9", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_SECAO_002", "ordem": 20, "transcricao_literal": "No entanto, é importante ressaltar que a auriculoterapia não deve ser considerada como uma terapia isolada para o tratamento da dor, e sim como um complemento aos tratamentos convencionais. Além disso, é necessário um diagnóstico correto da causa da dor e um acompanhamento adequado para o tratamento completo da condição de saúde.", "sha256_texto": "69031e9d17ef70a9fe1d4e8488cb0aee3eaa52145638df72135b36fedef36a9c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00018_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_PARAGRAFO_TEXTO_017", "normativo": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 10", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_SECAO_002", "ordem": 21, "transcricao_literal": "Ademais, a acupuntura auricular tem sido investigada como uma alternativa não medicamentosa no tratamento de distúrbios neurológicos dolorosos e não dolorosos, como enxaqueca, dor crônica, ansiedade e depressão. Acredita-se que a técnica possa ativar o sistema nervoso simpático e parassimpático, promovendo a regulação neurofisiológica e melhorando o equilíbrio do organismo (VIEIRA, 2018).", "sha256_texto": "46c752bcd95b167c298c0aa249c8164ccd74860ea1ca87c094d3d5ad67bfdaae", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00018_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_PARAGRAFO_TEXTO_018", "normativo": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 11", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_SECAO_002", "ordem": 22, "transcricao_literal": "Nesse sentido, entende-se que a especialização em tela, isto é, em “Auriculoterapia Neurofisiológica” reúne as condições para ser registrada por este Conselho Federal.", "sha256_texto": "2b1e3eb5ab14619ce408329a6a79e074485947d36a735f8e17338d224be02e55", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00018_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_PARAGRAFO_TEXTO_019", "normativo": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 12", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00018_CTEP_SECAO_002", "ordem": 23, "transcricao_literal": "Sendo estas as considerações necessárias sobre os fatos, passamos à conclusão.", "sha256_texto": "80584b20aeeb8015cc25a08e2bbf86c41790ceca917d8340c611844f558826f8", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00018_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
