{"identificador": "BR_FED_COFEN_PARCT_2018_N_00024_CTAS_ART_011", "normativo": "BR_FED_COFEN_PARCT_2018_N_00024_CTAS", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 11 (citado/transcrito)", "dispositivo_superior": null, "ordem": 15, "transcricao_literal": "Art. 11, inciso I, onde há a definição das ações privativas do enfermeiro e evidencia, na alínea “c” como ação privativa do enfermeiro: o planejamento, organização, coordenação, execução e avaliação dos serviços de assistência de enfermagem e, no inciso II, alínea “f”, descreve que, como integrante da equipe de saúde, o enfermeiro participa da elaboração de medidas e controle sistemático de danos que possam ser causados aos pacientes durante a assistência de enfermagem.", "sha256_texto": "93c617b85416cd26bcbbb24cd23fc47100b454c7a9387d5740731cd280735550", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2018_N_00024_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Artigo citado ou transcrito de outra norma (sequência não inicia em 1 no escopo); não é articulado próprio.", "conferencia_pdf": {"resultado": "EQUIVALENTE_OCR", "similaridade": 74.3, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARCT_2018_N_00024_CTAS_CONSIDERANDO_003", "normativo": "BR_FED_COFEN_PARCT_2018_N_00024_CTAS", "tipo_dispositivo": "considerando", "localizador": "Considerando 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2018_N_00024_CTAS_SECAO_003", "ordem": 16, "transcricao_literal": "CONSIDERANDO a Resolução Cofen nº 358/2009, que dispõe sobre a Sistematização da Assistência de Enfermagem e a implementação do Processo de Enfermagem em ambientes, públicos ou privados, em que ocorre o cuidado profissional de Enfermagem, e dá outras providências, onde todo cuidado de enfermagem deve ser baseado no Processo de Enfermagem e Sistematização da Assistência.", "sha256_texto": "9efd690e773b07533a60221f8afe0e79ccb8c3d9404df999c07b407d160df785", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2018_N_00024_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
