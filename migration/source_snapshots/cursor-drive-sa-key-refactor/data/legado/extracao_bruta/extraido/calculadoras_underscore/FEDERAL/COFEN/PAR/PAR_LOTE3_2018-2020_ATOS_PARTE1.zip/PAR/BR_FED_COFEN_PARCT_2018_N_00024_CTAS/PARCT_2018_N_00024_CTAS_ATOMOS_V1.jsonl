{"identificador": "BR_FED_COFEN_PARCT_2018_N_00024_CTAS_CONSIDERANDO_006", "normativo": "BR_FED_COFEN_PARCT_2018_N_00024_CTAS", "tipo_dispositivo": "considerando", "localizador": "Considerando 6", "dispositivo_superior": "BR_FED_COFEN_PARCT_2018_N_00024_CTAS_SECAO_003", "ordem": 20, "transcricao_literal": "CONSIDERANDO parecer Coren-PE- nº 46/2016, que trata de solicitação de parecer técnico acerca da atribuição dos Técnicos de Enfermagem em relação a verificação de check list do quantitativo e validade de medicações do carro de parada, onde se conclui pela responsabilidade do enfermeiro a tal incumbência e ao técnico de Enfermagem sob supervisão do primeiro.", "sha256_texto": "1eb1d6c80ae186fb04d3392c9c647cb9360be6f70bdc10c3fcd196a61b230a0b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2018_N_00024_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARCT_2018_N_00024_CTAS_CONSIDERANDO_007", "normativo": "BR_FED_COFEN_PARCT_2018_N_00024_CTAS", "tipo_dispositivo": "considerando", "localizador": "Considerando 7", "dispositivo_superior": "BR_FED_COFEN_PARCT_2018_N_00024_CTAS_SECAO_003", "ordem": 21, "transcricao_literal": "CONSIDERANDO parecer Coren-ES nº 001/2017. Ementa: Solicitação de parecer técnico sobre a responsabilidade da conferência, reposição e controle de medicamentos do carro de emergência. Que conclui sobre a responsabilidade da Enfermagem sobre a conferência, reposição e controle de medicamentos no carro de emergência e recomenda que se crie rotinas e normas nas instituições.", "sha256_texto": "160d9c6b0890c9d9574367b8e5326d434c80b9346d97061f7eebb9f167a0f5e4", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2018_N_00024_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
