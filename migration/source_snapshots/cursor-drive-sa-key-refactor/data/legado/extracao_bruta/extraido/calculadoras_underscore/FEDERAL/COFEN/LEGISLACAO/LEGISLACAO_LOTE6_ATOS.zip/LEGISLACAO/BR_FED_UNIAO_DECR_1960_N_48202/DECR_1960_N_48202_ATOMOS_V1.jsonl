{"identificador": "BR_FED_UNIAO_DECR_1960_N_48202_PARAGRAFO_TEXTO_001", "normativo": "BR_FED_UNIAO_DECR_1960_N_48202", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": null, "ordem": 4, "transcricao_literal": "usando da atribuição que lhe confere o artigo 87, item I, da Constituição decreta:", "sha256_texto": "8c5bac4c0cb90fd4df0a09ed13d0232e3830161041b538e8021d38ce5a435d93", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "DECR_1960_N_48202_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_UNIAO_DECR_1960_N_48202_ART_001", "normativo": "BR_FED_UNIAO_DECR_1960_N_48202", "tipo_dispositivo": "artigo", "localizador": "Art. 1º", "dispositivo_superior": null, "ordem": 5, "transcricao_literal": "Art. 1º – Fica instituída a Semana da Enfermagem, a ser celebrada anualmente, de 12 a 20 de maio, datas nas quais ocorreram, respectivamente, em 1820 e 1880, o nascimento de Florence Nightingale e o falecimento de Ana Neri.", "sha256_texto": "f85f0e7922d82bc3375b8af081af1ed12e8368affa8916e38ba95a1e32574ad4", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "DECR_1960_N_48202_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_UNIAO_DECR_1960_N_48202_ART_002", "normativo": "BR_FED_UNIAO_DECR_1960_N_48202", "tipo_dispositivo": "artigo", "localizador": "Art. 2º", "dispositivo_superior": null, "ordem": 6, "transcricao_literal": "Art. 2º – No transcurso da Semana deverá ser dada ampla divulgação às atividades da Enfermagem e posta em relevo a necessidade de congraçamento da classe e suas diferentes categorias profissionais, bem como estudados os problemas de cuja solução possa resultar melhor prestação de serviço ao público.", "sha256_texto": "f8067959418b8e8773ea0a8d68c0dd9f615284fd9fe90576f5e42a23698cd638", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "DECR_1960_N_48202_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_UNIAO_DECR_1960_N_48202_ART_003", "normativo": "BR_FED_UNIAO_DECR_1960_N_48202", "tipo_dispositivo": "artigo", "localizador": "Art. 3º", "dispositivo_superior": null, "ordem": 7, "transcricao_literal": "Art. 3º – Durante a Semana, deverão ser prestadas homenagens a memória de Ana Neri e a outros vultos consagrados da enfermagem.", "sha256_texto": "dadcb0bc7298b49e8a43c33f1ae7104dfee98324c97bf1f14128571c85c39282", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "DECR_1960_N_48202_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
