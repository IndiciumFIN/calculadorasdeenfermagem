{"identificador": "BR_FED_COFEN_PARCT_2019_SN_PARECER_CAMARA_TECNICA_CTFIS_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARCT_2019_SN_PARECER_CAMARA_TECNICA_CTFIS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2019_SN_PARECER_CAMARA_TECNICA_CTFIS_SECAO_002", "ordem": 6, "transcricao_literal": "Trata-se de solicitação de parecer, requerido pela Presidência do Conselho Regional de Enfermagem do Estado do Maranhão, encaminhado ao Presidente do Cofen, por meio de OFÍCIO Nº 052/2017-GAB PRES, solicitando parecer da Câmara Técnica de Fiscalização – CTFIS, sobre questionamento da Unidade de Fiscalização no que diz respeito à exigência de que para proceder à Anotação de Responsabilidade Técnica – ART todos os profissionais de enfermagem que laborem na instituição estejam sem pendências inscricionais junto ao Coren, apesar de tal condição não estar prevista na Resolução Cofen nº 509/2016.", "sha256_texto": "1140015da240ee7a10fc6cde7c6d279795c0dd392fa2cd3ee9dc59c25dcddf2d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2019_SN_PARECER_CAMARA_TECNICA_CTFIS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARCT_2019_SN_PARECER_CAMARA_TECNICA_CTFIS_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARCT_2019_SN_PARECER_CAMARA_TECNICA_CTFIS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2019_SN_PARECER_CAMARA_TECNICA_CTFIS_SECAO_002", "ordem": 7, "transcricao_literal": "Em atendimento à deliberação da 110ª Reunião Ordinária da Câmara Técnica de Fiscalização do Cofen, realizada no período de 21 a 25 de janeiro de 2019, na sede do Cofen em Brasília-DF, na qual fui designada para emissão de parecer sobre o contido no Processo Administrativo Cofen nº 0156/2017, passo a descrever.", "sha256_texto": "b9f71fcc1ced531da19b7462023149610b34eb59df1b9a10c04e495befbca799", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2019_SN_PARECER_CAMARA_TECNICA_CTFIS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "EQUIVALENTE_OCR", "similaridade": 93.1, "cobertura_vocabulario": 0.933, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
