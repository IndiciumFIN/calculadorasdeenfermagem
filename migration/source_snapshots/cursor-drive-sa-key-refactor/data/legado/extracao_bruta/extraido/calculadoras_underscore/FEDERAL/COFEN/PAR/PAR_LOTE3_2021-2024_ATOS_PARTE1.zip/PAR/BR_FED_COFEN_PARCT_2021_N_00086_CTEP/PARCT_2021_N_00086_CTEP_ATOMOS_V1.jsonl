{"identificador": "BR_FED_COFEN_PARCT_2021_N_00086_CTEP_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARCT_2021_N_00086_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00086_CTEP_SECAO_001", "ordem": 8, "transcricao_literal": "Trata-se o presente da análise realizada acerca da documentação apresentada pela Secretaria de Estado de Saúde do Distrito Federal – Superintendência da Região de Saúde Norte, no que diz respeito a suficiência das provas trazidas nos autos do Inquérito Civil no 000332.2020.10.000/0, com vistas a comprovar a regularidade dos estágios desenvolvidos pelos estudantes de Enfermagem no Hospital Regional de Sobradinho, a partir de solicitação demandada pelo Ministério Público do Trabalho a esta Autarquia.", "sha256_texto": "c4318ee844333c68b7af713a48f0785f78aff69ff643d0db1204d6b377e16099", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00086_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00086_CTEP_SECAO_002", "normativo": "BR_FED_COFEN_PARCT_2021_N_00086_CTEP", "tipo_dispositivo": "secao", "localizador": "II – DA FUNDAMENTAÇÃO E ANÁLISE", "dispositivo_superior": null, "ordem": 9, "transcricao_literal": "II – DA FUNDAMENTAÇÃO E ANÁLISE", "sha256_texto": "7dfb0cbc5614d846a003604254be2329f9c49524e3f8921631f7ff72bbdcacc7", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00086_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
