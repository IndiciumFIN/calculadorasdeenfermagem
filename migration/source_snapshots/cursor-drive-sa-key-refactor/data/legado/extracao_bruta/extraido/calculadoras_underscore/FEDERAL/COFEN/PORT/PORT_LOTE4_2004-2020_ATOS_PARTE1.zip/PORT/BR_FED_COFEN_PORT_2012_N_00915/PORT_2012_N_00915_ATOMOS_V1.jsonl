{"identificador": "BR_FED_COFEN_PORT_2012_N_00915_PREAMBULO_001", "normativo": "BR_FED_COFEN_PORT_2012_N_00915", "tipo_dispositivo": "preambulo", "localizador": "Preâmbulo", "dispositivo_superior": null, "ordem": 2, "transcricao_literal": "A Presidente do Conselho Federal de Enfermagem – COFEN, em conjunto com o Primeiro-Secretário da Autarquia, no uso de suas atribuições legais e pelo regimento interno da Autarquia, aprovado pela Resolução Cofen nº. 421/2012;", "sha256_texto": "b43f7a602992d82db3582df7c426c0728e540bdaf20bfd7433a29f215e1a7279", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2012_N_00915_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2012_N_00915_CONSIDERANDO_001", "normativo": "BR_FED_COFEN_PORT_2012_N_00915", "tipo_dispositivo": "considerando", "localizador": "Considerando 1", "dispositivo_superior": null, "ordem": 3, "transcricao_literal": "CONSIDERANDO o memorando nº 326/12/Dpto. Administrativo do Cofen, noticiando a necessidade de reparo e impermeabilização emergencial da caixa coletora de esgoto do Cofen;", "sha256_texto": "d2412538e76e983b2973687e9f22e4d0e6758292cda3cb06475af0051caee609", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2012_N_00915_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2012_N_00915_CONSIDERANDO_002", "normativo": "BR_FED_COFEN_PORT_2012_N_00915", "tipo_dispositivo": "considerando", "localizador": "Considerando 2", "dispositivo_superior": null, "ordem": 4, "transcricao_literal": "CONSIDERANDO o memorando nº 344/12/Dpto. Administrativo do Cofen, informando que para a reforma das caixas coletoras de esgoto é necessário a interrupção da utilização do sistema coletor de esgoto do edifício do Cofen por, no mínimo, 7 (sete) dias, implicando na impossibilidade de utilização de banheiros, torneiras, lavatórios, ralos ou qualquer sistema que utilize água no prédio;", "sha256_texto": "0b54ffd9ca6a91a731005644c396d445aa711ef4911e2d41d0762e89bb562626", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2012_N_00915_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2012_N_00915_CONSIDERANDO_003", "normativo": "BR_FED_COFEN_PORT_2012_N_00915", "tipo_dispositivo": "considerando", "localizador": "Considerando 3", "dispositivo_superior": null, "ordem": 5, "transcricao_literal": "CONSIDERANDO a previsão da realização desses serviços emergenciais no período de 04/08/2012 a 11/08/2012;", "sha256_texto": "1a4125f233772ff971c45a6b5f4537982f92c8bbcd8001c159432d2e4915e995", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2012_N_00915_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2012_N_00915_CONSIDERANDO_004", "normativo": "BR_FED_COFEN_PORT_2012_N_00915", "tipo_dispositivo": "considerando", "localizador": "Considerando 4", "dispositivo_superior": null, "ordem": 6, "transcricao_literal": "CONSIDERANDO tudo o mais que consta nos autos dos PADs Cofen nº 362 e 477, ambos de 2012, baixam as seguintes determinações:", "sha256_texto": "22911d63f9df1ded151beacf897652cfd193111904200b51ded14c1b7a69d0e8", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2012_N_00915_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2012_N_00915_ART_001", "normativo": "BR_FED_COFEN_PORT_2012_N_00915", "tipo_dispositivo": "artigo", "localizador": "Art. 1º", "dispositivo_superior": null, "ordem": 7, "transcricao_literal": "Art. 1º Suspender o expediente na sede do Conselho Federal de Enfermagem nos dias 6 a 10 de agosto de 2012.", "sha256_texto": "f7faadaffd427aa45bf6eb05f1bdc5b85a591cfba06699dfdfebdb52abfca026", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2012_N_00915_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2012_N_00915_ART_002", "normativo": "BR_FED_COFEN_PORT_2012_N_00915", "tipo_dispositivo": "artigo", "localizador": "Art. 2º", "dispositivo_superior": null, "ordem": 8, "transcricao_literal": "Art. 2º Em virtude da realização do 15º CBCENF, os empregados designados para participar do evento, deverão, excepcionalmente, no período descrito no artigo 1º, prestar seus serviços na sede do Conselho Regional de Enfermagem do Ceará.", "sha256_texto": "0dad591cb4278937c1cf03e1bd302d682961ee8a5d5f45b8ce669333e3a0dd5c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2012_N_00915_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
