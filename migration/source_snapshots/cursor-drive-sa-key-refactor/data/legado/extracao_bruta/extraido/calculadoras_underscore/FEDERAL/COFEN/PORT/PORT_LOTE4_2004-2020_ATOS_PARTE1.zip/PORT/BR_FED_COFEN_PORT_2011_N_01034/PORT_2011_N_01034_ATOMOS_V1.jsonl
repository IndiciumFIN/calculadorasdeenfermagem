{"identificador": "BR_FED_COFEN_PORT_2011_N_01034_PREAMBULO_001", "normativo": "BR_FED_COFEN_PORT_2011_N_01034", "tipo_dispositivo": "preambulo", "localizador": "Preâmbulo", "dispositivo_superior": null, "ordem": 2, "transcricao_literal": "O Presidente do Conselho Federal de Enfermagem COFEN, em conjunto com o Primeiro Secretário da Autarquia, no uso das atribuições que lhe são conferidas pela Lei nº 5.905, de 12 de julho de 1973, como bem assim pelo seu Regimento Interno, aprovado pela Resolução COFEN nº 242, de 31 de agosto de 2000; e,", "sha256_texto": "748f2da66e02f7c990bfc8d1f68fa2d49b9caafaa0499508d64eafa04e491c3d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2011_N_01034_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2011_N_01034_CONSIDERANDO_001", "normativo": "BR_FED_COFEN_PORT_2011_N_01034", "tipo_dispositivo": "considerando", "localizador": "Considerando 1", "dispositivo_superior": null, "ordem": 3, "transcricao_literal": "CONSIDERANDO as Resoluções Cofen nºs. 342 de 09 de janeiro de 2009 e 352 de 28 de agosto de 2009, baixam a seguinte determinação:", "sha256_texto": "d8ec56cb802f6001246de1c5eaf30929895ecc50631d7fa67ab3b0e5a45ca716", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2011_N_01034_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2011_N_01034_ART_001", "normativo": "BR_FED_COFEN_PORT_2011_N_01034", "tipo_dispositivo": "artigo", "localizador": "Art. 1º", "dispositivo_superior": null, "ordem": 4, "transcricao_literal": "Art. 1º Exonerar o servidor, Sr. Vicente Junqueira Moragas – registro funcional nº 238, do cargo de Chefe da Divisão de Gestão de Pessoas.", "sha256_texto": "b9835b25b55a67f5eb4edea7ef64f8ddfe37285fc13aad4a1a2f62f5aab5073e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2011_N_01034_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
