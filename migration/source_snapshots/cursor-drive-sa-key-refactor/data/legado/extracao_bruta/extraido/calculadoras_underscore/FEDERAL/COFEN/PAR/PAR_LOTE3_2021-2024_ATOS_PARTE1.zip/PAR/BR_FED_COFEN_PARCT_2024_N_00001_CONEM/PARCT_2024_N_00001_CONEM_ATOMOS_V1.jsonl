{"identificador": "BR_FED_COFEN_PARCT_2024_N_00001_CONEM_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARCT_2024_N_00001_CONEM", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2024_N_00001_CONEM_SECAO_002", "ordem": 10, "transcricao_literal": "Por meio da fiscalização, constatou-se que o vínculo dos empregados que ali laboram não é de enfermeiro ou técnico de enfermagem. Entretanto, no rol de atividades desempenhadas por tais profissionais estão relacionadas as atividades privativas de profissionais da área de enfermagem, definidas na Lei 7498/86 e Decreto 94.406/87, além das atividades relacionadas a área militar.", "sha256_texto": "3d710d65cc6a87259788e9f471ba1c94346e7afdb12a768b3ceb8492495ca5bf", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00001_CONEM_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
