{"identificador": "BR_FED_COFEN_PARCT_2024_N_00001_CONEM_PARAGRAFO_TEXTO_002", "normativo": "BR_FED_COFEN_PARCT_2024_N_00001_CONEM", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2024_N_00001_CONEM_SECAO_002", "ordem": 8, "transcricao_literal": "O Coren-MA recebeu denúncia anônima- 024/2022 do PAD 277/2022, conforme a seguir: “Enfermeiros são coordenados por médicos no setor de saúde da Polícia Militar do Maranhão suas escalas são assinadas por eles e supervisionadas. São chamados de auxiliares de serviço médico, TC QOSPM Solange de Jesus de A. Frazão TEN CEL QOSPM Michael Martins Braga”.", "sha256_texto": "0d3eccde631dfa17e762c473b6e362c0e53bbf63ca789c77aefeed253b794259", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00001_CONEM_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
