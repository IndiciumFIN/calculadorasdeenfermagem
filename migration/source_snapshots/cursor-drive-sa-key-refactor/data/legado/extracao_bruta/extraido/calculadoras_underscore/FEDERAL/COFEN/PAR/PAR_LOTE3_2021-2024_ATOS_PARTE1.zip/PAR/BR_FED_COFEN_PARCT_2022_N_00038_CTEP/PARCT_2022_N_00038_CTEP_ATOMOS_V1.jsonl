{"identificador": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_SECAO_002", "normativo": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP", "tipo_dispositivo": "secao", "localizador": "II – Da Fundamentação e Análise", "dispositivo_superior": null, "ordem": 26, "transcricao_literal": "II – Da Fundamentação e Análise", "sha256_texto": "381145f97aa3ddb2282f4390571d40750a1b24cdf321406e1ffccbc3533943bb", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00038_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_SECAO_002", "ordem": 27, "transcricao_literal": "A Câmara Técnica de Educação e Pesquisa (CTEP/Cofen) para fundamentação, análise e emissão de parecer baseia-se na Legislação Federal, na regulamentação estabelecida pelo Conselho Federal de Enfermagem (Cofen), em políticas de âmbito nacional, literatura e também em práticas que não decorram em implicações éticas.", "sha256_texto": "14907178996d3b69a0a0616941324ff90f417bdaf20dc300ff33eed8d9262b43", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00038_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_SECAO_002", "ordem": 28, "transcricao_literal": "Para pronunciamento acerca do parecer, solicitado à CTEP, do PAD N 0551/2022, que trata de solicitação feita pelo Instituto Nacional do Câncer (INCA) junto ao COREN RJ sobre a participação de enfermeiros estrangeiros (Angola) formados no exterior e sem revalidação ou reconhecimento da profissão no Brasil, tendo em vista um acordo de cooperação internacional que foi realizado pelo Ministério das Relações Exteriores e Ministério da Saúde, por meio do INCA e em parceria com o Instituto Angolano do Câncer e Ministério da Saúde de Angola para qualificação dos referidos profissionais vinculados ao Instituto Angolano na área de Oncologia.", "sha256_texto": "2673bd50f329c7df41be41703e0efb707253c4b9612e29e9dab86270d5fc1910", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00038_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_SECAO_002", "ordem": 29, "transcricao_literal": "Em princípio, vale destacar que o curso denominado “Aperfeiçoamento nos moldes Fellow” oferecido pelo INCA recebeu a solicitação de matricula de 5 (cinco) enfermeiros angolanos a partir de pedido feito pelo Governo daquele país para início das atividades no ano de 2022.", "sha256_texto": "ad700d28a7ca8fff95e098be0a2b86e2bb0287f56bfc3e00559a90dfdb3d7eae", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00038_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_SECAO_002", "ordem": 30, "transcricao_literal": "Outro aspecto a ser considerado diz respeito ao fato de que a modalidade de pós graduação não faz previsão para a necessidade de reconhecimento ou de revalidação do diploma do profissional conforme estabelecido na Lei de Diretrizes e Bases (LDB), Lei 9394/1996, a saber:", "sha256_texto": "2840a76154e8ee6696c77dd251db91eecd9e2866b3e4fde6b47b3c64510b451e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00038_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_ART_044", "normativo": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 44 (citado/transcrito)", "dispositivo_superior": null, "ordem": 31, "transcricao_literal": "Art. 44º. A educação superior abrangerá os seguintes cursos e programas:", "sha256_texto": "253b1fde1dc42dc7bfdaa222c17d4708c47d0a68ee5559dd5c65d8050e9d6e61", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00038_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Artigo citado ou transcrito de outra norma (sequência não inicia em 1 no escopo); não é articulado próprio."}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_ART_044_INC_I", "normativo": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP", "tipo_dispositivo": "inciso", "localizador": "Inciso I", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_ART_044", "ordem": 32, "transcricao_literal": "I – cursos sequenciais por campo de saber, de diferentes níveis de abrangência, abertos a candidatos que atendam aos requisitos estabelecidos pelas instituições de ensino;", "sha256_texto": "4f40ed8ae6c788fcfdbcc2957989f9f746796a78e242cc1b5d729d3d80562d1d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00038_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Dispositivo de artigo citado/transcrito."}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_ART_044_INC_II", "normativo": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP", "tipo_dispositivo": "inciso", "localizador": "Inciso II", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_ART_044", "ordem": 33, "transcricao_literal": "II – de graduação, abertos a candidatos que tenham concluído o ensino médio ou equivalente e tenham sido classificados em processo seletivo;", "sha256_texto": "ff97327d6540a7d992a4de14d5e1e961b44f603339bf749c1093d66c94c76dfd", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00038_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Dispositivo de artigo citado/transcrito."}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_ART_044_INC_III", "normativo": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP", "tipo_dispositivo": "inciso", "localizador": "Inciso III", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_ART_044", "ordem": 34, "transcricao_literal": "III – de pós-graduação, compreendendo programas de mestrado e doutorado, cursos de especialização, aperfeiçoamento e outros, abertos a candidatos diplomados em cursos de graduação e que atendam às exigências das instituições de ensino;", "sha256_texto": "6cf1c3d16924792ecb5ad95574bff66f95ea5c29c092d85e62feb8530baf0ec6", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00038_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Dispositivo de artigo citado/transcrito."}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_ART_044_INC_IV", "normativo": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP", "tipo_dispositivo": "inciso", "localizador": "Inciso IV", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_ART_044", "ordem": 35, "transcricao_literal": "IV – de extensão, abertos a candidatos que atendam aos requisitos estabelecidos em cada caso pelas instituições de ensino.", "sha256_texto": "4f49e886aa4afcab1756f43ef31e03c8ff9b8bab2d8e0dd4aa551db4d424b73b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00038_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Dispositivo de artigo citado/transcrito."}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_SECAO_002", "ordem": 36, "transcricao_literal": "Em relação ao aperfeiçoamento nos moldes Fellow, esta diz respeito a uma modalidade de ensino de pós graduação, com carga horária mínima de 1920 horas e é destinado a profissionais que possuem formação de nível superior da área das Ciências da Saúde e é caracterizado por ser realizado no próprio serviço ou Instituição de Ensino, como o INCA por exemplo, para melhor qualificação do atendimento feito ao usuário do serviço de saúde.", "sha256_texto": "a1474ee39dfdbcd3ca7bd2db0d5efef894841c4e5a69b7a16b17f169e742ed40", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00038_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_SECAO_002", "ordem": 37, "transcricao_literal": "Vale destacar também que no PAD em análise há a descrição da programação do curso bem como a atuação dos enfermeiros angolanos que serão os participantes do referido curso e que será realizado nas dependências do INCA com supervisão direta de profissionais desta instituição.", "sha256_texto": "7130f538ea817cd7a01b7da0587418461a8e1a21e746bd8e8a4ba1e039571e7c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00038_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 7", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_SECAO_002", "ordem": 38, "transcricao_literal": "A partir daí, é preciso salientar que a solicitação feita ao COREN RJ faz referência a uma provável autorização ou licença temporária para que os enfermeiros de Angola, mesmo sem revalidação do diploma no Brasil, possam realizar o aperfeiçoamento em tela.", "sha256_texto": "94d42b2662633eb0dcdf9a4b1e37cde6127ffa5269139e3c969efc2c10465e8b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00038_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 8", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_SECAO_002", "ordem": 39, "transcricao_literal": "Com isso, destaca-se a ausência de regulamentação que oriente para a questão posta em discussão e análise por esta Câmara Técnica de Educação e Pesquisa e a necessidade de estabelecermos amparo para que os profissionais nesta situação possam se qualificar a partir de autorização para este objetivo, isto é, para fins educacionais.", "sha256_texto": "8c84f2561c423474f7a84b9626dd7de9385079320fbf4b18932b84ef59dcf14b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00038_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 9", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_SECAO_002", "ordem": 40, "transcricao_literal": "A partir daí, é importante destacar que o curso de Pós Graduação “Aperfeiçoamento nos moldes Fellow” desenvolvidos pelo INCA tem como objetivo qualificar os profissionais de enfermagem e melhorar a qualidade da assistência prestada ao usuário.", "sha256_texto": "1e5378fa007c0ed1f60b8f698235acc08c784bbf8e850a0ab48aa80afb1961f5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00038_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_PARAGRAFO_TEXTO_012", "normativo": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 10", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_SECAO_002", "ordem": 41, "transcricao_literal": "Vale a pena reforçar também que a resolução 560/2017 que estabelece as normas administrativas para registro de títulos, concessão de inscrição, inscrição remida, suspensão de inscrição, cancelamento e reinscrição, inscrição secundária, substituição e renovação da carteira profissional de identidade e transferência de inscrição, não faz referência para uma autorização temporária que possa possibilitar que enfermeiros formados no exterior e sem revalidação no Brasil façam cursos de pós graduação.", "sha256_texto": "be2a94bb952e4fee6d7cec9d5bb05206b5916f9d498a83610a3156bf437d7f4b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00038_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_PARAGRAFO_TEXTO_013", "normativo": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 11", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_SECAO_002", "ordem": 42, "transcricao_literal": "Além do que, a Lei n° 5.903 de 1973 que dispõe sobre a criação dos Conselhos Federal e Regionais de Enfermagem e dá outras providências também não atribui ao Sistema Cofen/Conselhos Regionais a atribuição para fiscalização de caráter educacional.", "sha256_texto": "783c2d58187ffec67388dc3e4fa47692d014c50665be024d668816dbf30ef9d1", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00038_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_PARAGRAFO_TEXTO_014", "normativo": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 12", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_SECAO_002", "ordem": 43, "transcricao_literal": "Portanto, salienta-se que não há qualquer regulamentação que possibilite autorização ou inscrição temporária para que profissionais enfermeiros formados no exterior possam realizar cursos de aperfeiçoamentos educacionais no Brasil sem o reconhecimento ou revalidação do diploma. No entanto, tendo em vista tal omissão legal, esta Câmara Técnica de Educação e Pesquisa não vê óbice quanto à realização do curso pelos enfermeiros formados no exterior, tendo em vista que se trata de qualificação a partir da formação na pós graduação para atuação em seu próprio país.", "sha256_texto": "6097b73193472aebbc40eb4b1ff72f22164c165976d18c44adf1cd6f09e62cd2", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00038_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_PARAGRAFO_TEXTO_015", "normativo": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 13", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_SECAO_002", "ordem": 44, "transcricao_literal": "Diante do exposto:", "sha256_texto": "a777eec502907d723b4389e3d8a99675daf1a20abfa00c8c54952527893188de", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00038_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_PARAGRAFO_TEXTO_016", "normativo": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 14", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_SECAO_002", "ordem": 45, "transcricao_literal": "Considerando-se a Lei nº 5.905, de 12 de julho de 1973, que “Dispõe sobre a criação dos Conselhos Federal e Regionais de Enfermagem e dá outras providências”, em seu Art. 2º dispõe que: “O Conselho Federal e os Conselhos Regionais são órgãos disciplinadores do exercício da profissão de enfermeiro e das demais profissões compreendidas nos serviços de Enfermagem” (BRASIL, 1973);", "sha256_texto": "4a66ee0b04cee887403e3e21ca8d9290e04d3f16992bc08651966b88f5c77bf0", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00038_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_PARAGRAFO_TEXTO_017", "normativo": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 15", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_SECAO_002", "ordem": 46, "transcricao_literal": "Considerando-se ser esta Câmara Técnica, “órgão permanente de natureza consultiva, propositiva e avaliativa sobre matéria relativa ao exercício da Enfermagem”, segundo Art. 1º do Regimento Interno do Cofen, no entanto, sem competência deliberativa (Cofen, 2012);", "sha256_texto": "b1e25c19a672d36de3692a9a06bd29994182b5f6bb7f6284a497fb1dd0b3a5b5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00038_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_PARAGRAFO_TEXTO_018", "normativo": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 16", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_SECAO_002", "ordem": 47, "transcricao_literal": "Considerando-se o Art. 13 do Regimento Interno das Câmaras Técnicas do Cofen, que compete à CTEP: “VI – subsidiar o Sistema Cofen/Conselhos Regionais em ações que promovam o desenvolvimento técnico-científico em Enfermagem; VII – pronunciar-se, mediante Parecer […]” (COFEN, 2019).", "sha256_texto": "60c3d884c78bec5c2af708c7e3085683aabd492ef2d4dda6682f8e4c23bcb28d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00038_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_PARAGRAFO_TEXTO_019", "normativo": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 17", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_SECAO_002", "ordem": 48, "transcricao_literal": "Considerando que a formação profissional contribui para melhorar a qualidade da assistência prestada ao usuário;", "sha256_texto": "c52dc95aadbe2d71710d8065b95ccaabbfe673be9068627f78b7860772184516", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00038_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_PARAGRAFO_TEXTO_020", "normativo": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 18", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_SECAO_002", "ordem": 49, "transcricao_literal": "Considerando que a autorização em discussão diz respeito a fins exclusivamente educacionais;", "sha256_texto": "5bb82e8228c091ebad204f1a9c2b65998e1ff7df56d3baa462e3d27126a66601", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00038_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_ART_044_INC_III_2", "normativo": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP", "tipo_dispositivo": "inciso", "localizador": "Inciso III", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00038_CTEP_ART_044", "ordem": 50, "transcricao_literal": "III – Da Conclusão Após análise do PAD Nº 0551/2022, esta Câmara Técnica, frente ao exposto, sugere ao egrégio plenário do Conselho Federal de Enfermagem que dê autorização para que os enfermeiros angolanos inscritos no programa “Aperfeiçoamento nos moldes Fellow” possam realizar o curso.", "sha256_texto": "2767ec17b19c17c5be069c21f1b39debcfedb46d59773c989a6305324f1bf47d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00038_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Dispositivo de artigo citado/transcrito."}
