{"identificador": "BR_FED_COFEN_PARCT_2024_N_00019_CTEPIENF_PARAGRAFO_TEXTO_002", "normativo": "BR_FED_COFEN_PARCT_2024_N_00019_CTEPIENF", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2024_N_00019_CTEPIENF_SECAO_001", "ordem": 7, "transcricao_literal": "Trata-se de solicitação do Conselho Regional de Enfermagem do Paraná (Coren-PR) para a inclusão do curso de especialização em manejo técnico de Lesões por Pressão (LPP) no Programa de Educação Continuada (PÓS-TEC), organizado em parceria com a Universidade Federal da Paraíba (UFPB) para a oferta de especialização técnica de nível médio de forma gratuita aos profissionais de Enfermagem.", "sha256_texto": "4038efb9c493e8fa19453288aa65006e30577905cf26377b1e370e697ad50a99", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00019_CTEPIENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARCT_2024_N_00019_CTEPIENF_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARCT_2024_N_00019_CTEPIENF", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2024_N_00019_CTEPIENF_SECAO_001", "ordem": 8, "transcricao_literal": "Diante do exposto, com base no Processo SEI nº 00196.004495/2024-81, instada esta CTEPi/Cofen passa a se manifestar sobre a matéria, com base na análise que se segue.", "sha256_texto": "6cad7a7bcfe3afa58eb1f4594067f38a5b9756f45fd78f94c98a58276f27868d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00019_CTEPIENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
