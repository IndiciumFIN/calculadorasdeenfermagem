{"identificador": "BR_FED_COFEN_PARASS_2018_N_00138_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARASS_2018_N_00138", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARASS_2018_N_00138_SECAO_001", "ordem": 7, "transcricao_literal": "O Presidente do Conselho Regional de Enfermagem, pelo Ofício nº 146, de 5 de dezembro de 2018, faz consulta sobre a possibilidade de o Conselho Regional conceder anistia ou promover a cobrança das multas eleitorais referentes ao pleito realizado em 2017.", "sha256_texto": "d3112e18e21fdc55146ecf3c8467abe9d3e0312aa152fbc7cf004b902031734a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2018_N_00138_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARASS_2018_N_00138_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_PARASS_2018_N_00138", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARASS_2018_N_00138_SECAO_001", "ordem": 8, "transcricao_literal": "Diz que o Coren-AC se encontra na iminência de iniciar tais cobranças.", "sha256_texto": "76f3616388fc3f9bf89475901dca1693b7a2d4854db93b757c571418077353df", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2018_N_00138_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARASS_2018_N_00138_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARASS_2018_N_00138", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARASS_2018_N_00138_SECAO_001", "ordem": 9, "transcricao_literal": "É o relatório. Passe-se ao parecer.", "sha256_texto": "dd2902b99afa2e271ce5deb67654ed073f18adb312130fbf28eac66ca43f5bf8", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2018_N_00138_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARASS_2018_N_00138_SECAO_002", "normativo": "BR_FED_COFEN_PARASS_2018_N_00138", "tipo_dispositivo": "secao", "localizador": "II – PRONUNCIAMENTO DA ASSLEGIS", "dispositivo_superior": null, "ordem": 10, "transcricao_literal": "II – PRONUNCIAMENTO DA ASSLEGIS", "sha256_texto": "c6fa0fb0e1af0e2d9301d1b4a74637128c8735065fe2e921c1be24d80ef1d161", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2018_N_00138_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARASS_2018_N_00138_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_PARASS_2018_N_00138", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARASS_2018_N_00138_SECAO_002", "ordem": 11, "transcricao_literal": "No âmbito do Sistema Cofen/Conselhos Regionais de Enfermagem, o instituto da multa eleitoral está previsto na Lei 5.905/73, e na Resolução Cofen nº 523/2016, que aprovou o Código Eleitoral dos Conselhos de Enfermagem, que assim dispõem respectivamente:", "sha256_texto": "a0fac06f864f0b1598a994e1e09e0d6726751fc8214e3f753ac00e642c6929d5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2018_N_00138_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARASS_2018_N_00138_ARTIGO_TRANSCRITO_001", "normativo": "BR_FED_COFEN_PARASS_2018_N_00138", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 12 (transcrito)", "dispositivo_superior": "BR_FED_COFEN_PARASS_2018_N_00138_SECAO_002", "ordem": 12, "transcricao_literal": "“Art. 12 Os membros dos Conselhos Regionais e respectivos suplentes serão eleitos por voto pessoal, secreto e obrigatório, em época determinada pelo Conselho Federal, em Assembleia Geral especialmente convocada para esse fim.", "sha256_texto": "70b2ba2328f9b2a26fcb59f7adc8b9edd24b535cc07de4e0101c66365cddd690", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2018_N_00138_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARASS_2018_N_00138_PARAGRAFO_TRANSCRITO_001", "normativo": "BR_FED_COFEN_PARASS_2018_N_00138", "tipo_dispositivo": "paragrafo_transcrito", "localizador": "Parágrafo (transcrito)", "dispositivo_superior": "BR_FED_COFEN_PARASS_2018_N_00138_ARTIGO_TRANSCRITO_001", "ordem": 13, "transcricao_literal": "§ 1º …omissis…", "sha256_texto": "bcc8b0d5d10f1e99b68315755258bca2a625c1cb93732b13abe9d1991b628238", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2018_N_00138_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARASS_2018_N_00138_PARAGRAFO_TRANSCRITO_002", "normativo": "BR_FED_COFEN_PARASS_2018_N_00138", "tipo_dispositivo": "paragrafo_transcrito", "localizador": "Parágrafo (transcrito)", "dispositivo_superior": "BR_FED_COFEN_PARASS_2018_N_00138_ARTIGO_TRANSCRITO_001", "ordem": 14, "transcricao_literal": "§ 2º Ao eleitor que, sem causa justa, deixar de votar nas eleições referidas neste artigo, será aplicada pelo Conselho Regional multa em importância correspondente ao valor da anuidade.” (Lei nº 5.905/73 – grifo nosso)", "sha256_texto": "03abe78a0031c295cd2ed7d33b999aa18385f8667b27f35dd58a88058351f9d8", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2018_N_00138_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARASS_2018_N_00138_ARTIGO_TRANSCRITO_002", "normativo": "BR_FED_COFEN_PARASS_2018_N_00138", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 25 (transcrito)", "dispositivo_superior": "BR_FED_COFEN_PARASS_2018_N_00138_SECAO_002", "ordem": 15, "transcricao_literal": "“Art. 25 O eleitor que deixar de votar, sem justa causa, incorrerá em multa na quantia equivalente ao valor atualizado da anuidade de seu quadro profissional.", "sha256_texto": "c4b79e4e3950aba0b1c484e5e0ae7b0174efa1185b7e83f809c94a2f0086784b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2018_N_00138_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARASS_2018_N_00138_PARAGRAFO_TRANSCRITO_003", "normativo": "BR_FED_COFEN_PARASS_2018_N_00138", "tipo_dispositivo": "paragrafo_transcrito", "localizador": "Parágrafo (transcrito)", "dispositivo_superior": "BR_FED_COFEN_PARASS_2018_N_00138_ARTIGO_TRANSCRITO_002", "ordem": 16, "transcricao_literal": "§ 1º Ocorrendo motivo justificável, o profissional comprovará suas razões ao Conselho Regional de sua jurisdição, no prazo de até 120 (cento e vinte) dias, a contar da data da realização do pleito, prorrogável por igual período.", "sha256_texto": "49f1b9bb1ad2a12b32c9b4d8186bc855bf6d4f05ec39e957d9ec258c3021fb2f", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2018_N_00138_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARASS_2018_N_00138_PARAGRAFO_TRANSCRITO_004", "normativo": "BR_FED_COFEN_PARASS_2018_N_00138", "tipo_dispositivo": "paragrafo_transcrito", "localizador": "Parágrafo (transcrito)", "dispositivo_superior": "BR_FED_COFEN_PARASS_2018_N_00138_ARTIGO_TRANSCRITO_002", "ordem": 17, "transcricao_literal": "§ 2º Havendo motivação de ordem superior o Plenário do Conselho Regional de Enfermagem dentro de sua discricionariedade poderá isentar o profissional inscrito do pagamento de multa.", "sha256_texto": "836b90fae1bbe8c20cbab1a96d0b806617e930162681fe72c99844c2c7a8a699", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2018_N_00138_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARASS_2018_N_00138_PARAGRAFO_TRANSCRITO_005", "normativo": "BR_FED_COFEN_PARASS_2018_N_00138", "tipo_dispositivo": "paragrafo_transcrito", "localizador": "Parágrafo (transcrito)", "dispositivo_superior": "BR_FED_COFEN_PARASS_2018_N_00138_ARTIGO_TRANSCRITO_002", "ordem": 18, "transcricao_literal": "§ 3º O Conselho Regional fornecerá a quem justificadamente não votou certidão, isentando-o das sanções legais.", "sha256_texto": "10c576105d8347ce893477407895b1da9f1737153a2e9b4f683a06d38d3e4876", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2018_N_00138_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARASS_2018_N_00138_PARAGRAFO_TRANSCRITO_006", "normativo": "BR_FED_COFEN_PARASS_2018_N_00138", "tipo_dispositivo": "paragrafo_transcrito", "localizador": "Parágrafo (transcrito)", "dispositivo_superior": "BR_FED_COFEN_PARASS_2018_N_00138_ARTIGO_TRANSCRITO_002", "ordem": 19, "transcricao_literal": "§ 4º Considera-se justa causa para efeito deste artigo o fato de o profissional residir em município que não possua mesa receptora de votos, para os casos de votação por urnas manuais.” (Resolução Cofen nº 523/2016 – grifo nosso)", "sha256_texto": "1b06c57cecc6f7c9462ae1836a7e6635fe96761385f00973f15383d04968ad06", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2018_N_00138_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARASS_2018_N_00138_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_PARASS_2018_N_00138", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARASS_2018_N_00138_SECAO_002", "ordem": 20, "transcricao_literal": "Imperioso notar que os dispositivos em comento fazem expressa menção ao fato de deixar de votar “sem justa causa”, mas não define o que seja o motivo justificável. Por esse prisma, “justa causa” revela-se um conceito jurídico indeterminado e, portanto, sujeito as mais diversas interpretações.", "sha256_texto": "9c455eaec3c5b438cfccc0144ba18cd71051d3abba484639fe1a3dff1d9683dc", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2018_N_00138_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARASS_2018_N_00138_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_COFEN_PARASS_2018_N_00138", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARASS_2018_N_00138_SECAO_002", "ordem": 21, "transcricao_literal": "Assevere-se que a inteligência destes artigos é no sentido de que havendo uma justificativa, o eleitor estará isento do pagamento de multa, e, com muito mais razão, se a justificativa for apresentada em caráter geral pelo próprio Conselho Regional, poderá reconhecer a ocorrência de motivos alheios à vontade dos eleitores que deixaram de votar.", "sha256_texto": "9b6c26f5c7825fac3ad7cf7d3212ca3aca05d44383f1f47cb9f2c26d552d7c73", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2018_N_00138_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARASS_2018_N_00138_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARASS_2018_N_00138", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARASS_2018_N_00138_SECAO_002", "ordem": 22, "transcricao_literal": "Saliente-se que segundo o art. 15, incisos III e XIV, da Lei 5.905/73, a aplicação de multas constitui atribuição dos Conselhos Regionais, devendo, por essa razão, a concessão de anistia seguir a mesma sorte, de forma a harmonizar a interpretação de todos os dispositivos de lei invocados neste parecer.", "sha256_texto": "737b7a418dcb8cad3c985862afd68d9fd9cf24a7ed2bc604aa0778172a1c9277", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2018_N_00138_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARASS_2018_N_00138_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_PARASS_2018_N_00138", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARASS_2018_N_00138_SECAO_002", "ordem": 23, "transcricao_literal": "Assim, caso o regional não tenha adotado medida de caráter geral e não havendo apresentação de justificativa individualizada pelo eleitor, deve o Coren iniciar a cobrança das multas na forma como consultado.", "sha256_texto": "d3b3124de9f24f753b5d673d2323c34a28fa0b742b26afcb98d986d375e00493", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2018_N_00138_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
