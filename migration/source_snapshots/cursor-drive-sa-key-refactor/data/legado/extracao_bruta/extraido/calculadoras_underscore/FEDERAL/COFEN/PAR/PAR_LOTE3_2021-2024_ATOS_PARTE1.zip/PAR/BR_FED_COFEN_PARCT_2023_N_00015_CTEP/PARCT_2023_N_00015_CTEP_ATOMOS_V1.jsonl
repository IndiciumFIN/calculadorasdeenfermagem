{"identificador": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_SECAO_001", "normativo": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP", "tipo_dispositivo": "secao", "localizador": "I. RELATÓRIO", "dispositivo_superior": null, "ordem": 4, "transcricao_literal": "I. RELATÓRIO", "sha256_texto": "be40338beec0b641645a8d566c6af53d269630be331c5fbd2db3f4a98e651bf0", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00015_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_PARAGRAFO_TEXTO_002", "normativo": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_SECAO_001", "ordem": 5, "transcricao_literal": "A solicitação em tela diz respeito ao pedido, enviado pelo Conselho Regional de Enfermagem de Minas Gerais – Coren-MG, em 2 de janeiro de 2023, sobre o registro do Título de Pós-Graduação Lato-Sensu em “Preceptoria de Residência Médica no SUS” da Enfermeira Josiane Aparecida Dinalli, registrada sob nº 221900-ENF, tendo o referido curso sido ofertado pela Sociedade Beneficente de Senhoras e Hospital Sírio-Libanês.", "sha256_texto": "9db68ab6e76edfda289c1e854787dd0bca234e6f5522f02823c7abd115d212a8", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00015_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_SECAO_001", "ordem": 6, "transcricao_literal": "Apresenta a requerente, por meio do Regional, e-mail com a referida solicitação em 2 de janeiro de 2023, anexando: registro de enfermeira de Josiane Aparecida Dinalli, diploma do curso em “Preceptoria de Residência Médica no SUS”, histórico escolar e Portaria n° 3.857, de 10 de novembro de 2005.", "sha256_texto": "5fb84799ebcaa7694cab762367859ae70681f3b8b69a8e21968fdd63961d8ae1", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00015_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_SECAO_001", "ordem": 7, "transcricao_literal": "Diante do requerimento, manifestou-se a chefe da Divisão de Inscrição, Registro e Cadastro do Cofen, sugerindo o encaminhamento para análise da Câmara Técnica de Educação e Pesquisa – CTEP/Cofen com vistas a emitir parecer acerca da solicitação.", "sha256_texto": "4d5aaebea02538d909f29257bd6461c9ac04cedf4ad31c59bf41cb5565ef75e8", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00015_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_SECAO_001", "ordem": 8, "transcricao_literal": "Instada esta CTEP/Cofen a se manifestar sobre a matéria, passa-se a análise.", "sha256_texto": "dc02ee12f9bd61bd6cdcc78263b67e6571eaef073da565cc43b09cb665b1b1e9", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00015_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_SECAO_002", "normativo": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP", "tipo_dispositivo": "secao", "localizador": "II. FUNDAMENTAÇÃO", "dispositivo_superior": null, "ordem": 9, "transcricao_literal": "II. FUNDAMENTAÇÃO", "sha256_texto": "685155de3de3ed3f2f8f8b81dbe74f0335422a2abbc215c5604d7e9096b7c5c5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00015_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_SECAO_002", "ordem": 10, "transcricao_literal": "Em 2 de fevereiro de 2022 foi recebido, por meio de correio eletrônico, solicitação em que o Coren-MG encaminha documentação com pedido de registro da especialidade de “Preceptoria de Residência Médica no SUS”, considerando que a mesma não está contemplada no rol de especialidades registradas pelo Cofen.", "sha256_texto": "88b8aee9915451d4c6dc9bb062beabcf18ad6ff7b2feb8539fca1f315b878677", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00015_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_SECAO_002", "ordem": 11, "transcricao_literal": "Com vistas a fundamentar sua solicitação, foi apresentado pela requerente o certificado em nome de Josiane Aparecida Dinalli, emitido pela Sociedade Beneficente de senhoras Hospital Sírio-Libanês (Portaria n° 3.362 de 8 de dezembro de 2017).", "sha256_texto": "d2ec427b54b342c13a2214d9c1980816c02e53a77ac60c34dfafba11106653a5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00015_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_SECAO_002", "ordem": 12, "transcricao_literal": "Em relação à legislação que versa sobre a matéria, tem-se a Resolução Cofen nº 581/2018 – alterada pela resolução COFEN n° 625/2020 e decisões COFEN nº 065/2021 e 120/2021, que atualizou no âmbito do Sistema Cofen/Conselhos Regionais de Enfermagem os procedimentos para Registro de Títulos de Pós-Graduação Lato e Stricto Sensu concedido a enfermeiros e também aprovou a lista das especialidades.", "sha256_texto": "4d54c3927fd6ca96cb58d169f2396956b42227ebfbba27dd59551523f135668f", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00015_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_SECAO_002", "ordem": 13, "transcricao_literal": "As Resoluções citadas não fazem referência à área de atuação profissional em Enfermagem denominada “Preceptoria de Residência Médica no SUS”.", "sha256_texto": "f83266f18a507076542aa2ef349f0a54b941ca92db023302ceab61f5dc84f67d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00015_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_SECAO_002", "ordem": 14, "transcricao_literal": "Em relação ao reconhecimento do curso em tela, tem-se anexo ao PAD, registro em Diário Oficial da União PORTARIA Nº 3.857, DE 10 DE NOVEMBRO DE 2005, onde se avista o credenciamento da Instituição:", "sha256_texto": "5c827ea3b87a52160cb234ce1a98fe6760b4930e7bd7ce482bd00822088a719b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00015_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_SECAO_002", "ordem": 15, "transcricao_literal": "O Ministro de Estado da Educação, usando da competência que lhe foi delegada pelos Decretos nº 1.845, de 28 de março de 1996, e No – 3..860, de 9 de julho de 2001, alterado pelo Decreto No – 3..908, de 4 de setembro de 2001, e tendo em vista o Parecer No 3.45/2005, da Câmara de Educação Superior do Conselho Nacional de Educação, conforme consta dos Processos nºs 23000.003842/2004-51 e 23000.008654/2004-19, do Ministério da Educação, resolve: Art. 1º Credenciar o Instituto de Ensino e Pesquisa do Hospital Sírio-Libanês – IEP/HSL, mantido pela Sociedade Beneficente de Senhoras – Hospital Sírio-Libanês, ambos com sede na cidade de São Paulo, no Estado de São Paulo, para ministrar cursos de especialização, em regime presencial, na área de saúde, com autorização inicial para a oferta dos cursos de especialização em Efetividade e Eficiência em Saúde Baseada em Evidências, Enfermagem em Oncologia, Enfermagem em UTI e Fisioterapia Hospitalar. Art. 2° Esta Portaria entra em vigor na data de sua publicação.", "sha256_texto": "c81d5c087d213f8022da14bee600ab181f7e420ae55ede0b084128d43068f418", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00015_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_PARAGRAFO_TEXTO_012", "normativo": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 7", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_SECAO_002", "ordem": 16, "transcricao_literal": "Dessa forma, como é possível observar, o documento referido, qual seja a Portaria nº 3.857, do Ministério da Educação, de 10 de novembro de 2005, que consta no verso do diploma apresentado pela requerente não abrange, conforme destacado pelo DGEP/Cofen, a Especialização em “Preceptoria de Residência Médica no SUS”.", "sha256_texto": "1d7a323436f882a2a9357d0faf92153c2f24455928aad9347dd03ac45168863a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00015_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_PARAGRAFO_TEXTO_013", "normativo": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 8", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_SECAO_002", "ordem": 17, "transcricao_literal": "Porém, à despeito de não constar da referida Portaria, em consulta formulada junto ao Cadastro Nacional de Cursos e Instituições de Educação Superior – Cadastro e-MEC fora possível constatar o cadastro da especialização em análise.", "sha256_texto": "bf185e1712bee59b49888b0cd434dc0b949a44f76d62208eb00dd447a60fd0fb", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00015_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_PARAGRAFO_TEXTO_014", "normativo": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 9", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_SECAO_002", "ordem": 18, "transcricao_literal": "Em mesmo sentido, considerando o histórico apresentado pela requerente, observa-se as áreas de competência da referida especialização, a saber; Saúde: atenção à saúde e preceptoria; Gestão: gestão do trabalho e da educação em saúde; Educação: educação profissional e produção de conhecimentos em saúde; Projeto aplicativo, sendo possível correlaciona-las com atividades típicas da Enfermagem.", "sha256_texto": "573c30820a9d1de82eb08f8a7b9aee2855788117a980291c63d17a484518be89", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00015_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_PARAGRAFO_TEXTO_015", "normativo": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 10", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_SECAO_002", "ordem": 19, "transcricao_literal": "Sobre a preceptoria na formação médica e/ou multiprofissional, as publicações mostram que a atividade de preceptoria é diversa e de diferentes ordens, como por exemplo, ordens técnica, docente, ética e moral. No entanto, há que se considerar a perspectiva pedagógica relacionada à preceptoria (RAMOS DE OLIVEIRA et al., 2015).", "sha256_texto": "65cb822de0fd55ff3149e3da509bea3c277d4d910e7f8bc0c820aa684bd8f2c6", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00015_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_PARAGRAFO_TEXTO_016", "normativo": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 11", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_SECAO_002", "ordem": 20, "transcricao_literal": "Ainda de acordo com Ramos de Oliveira 2015:", "sha256_texto": "6c4d263d8e98f960b1ef62505f1b5833e71d2283f41250aea3a3ce6e98203400", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00015_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_PARAGRAFO_TEXTO_017", "normativo": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 12", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_SECAO_002", "ordem": 21, "transcricao_literal": "A maior parte dos textos que discorrem sobre a preceptoria na Residência Multiprofissional não considera que o preceptor precise ser da mesma categoria profissional do residente, por entender que “não é da responsabilidade da residência formar especificamente o núcleo e sim da graduação” e que “a proposta da Residência é promover a aquisição de competências de outra ordem que, quando incorporadas, se aliarão ao conhecimento específico de cada área”. Essa compreensão é corroborada pelos documentos oficiais.", "sha256_texto": "2947c429f6b29b34c4b6cf7c20e2d60ee1f747a267fe2b867ff8389570cfff83", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00015_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_PARAGRAFO_TEXTO_018", "normativo": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 13", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_SECAO_002", "ordem": 22, "transcricao_literal": "Nesse sentido, entende-se que a especialização em tela, isto é, em “Preceptoria de Residência Médica no SUS” reúne uma série de condições que possibilitam o seu registro junto ao Sistema Cofen/Conselho Regionais de Enfermagem.", "sha256_texto": "e37f2062b995acc6276ab23766d8deefd3d219ad0e09301602da6a70ca98ff65", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00015_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_PARAGRAFO_TEXTO_019", "normativo": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 14", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00015_CTEP_SECAO_002", "ordem": 23, "transcricao_literal": "Sendo estas as considerações necessárias sobre os fatos, passamos à conclusão.", "sha256_texto": "80584b20aeeb8015cc25a08e2bbf86c41790ceca917d8340c611844f558826f8", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00015_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
