{"identificador": "BR_FED_COFEN_PARCT_2021_N_00013_CTLN_ALINEA_001", "normativo": "BR_FED_COFEN_PARCT_2021_N_00013_CTLN", "tipo_dispositivo": "alinea", "localizador": "Alínea c", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00013_CTLN_INCISO_002", "ordem": 25, "transcricao_literal": "c) prescrição de medicamentos estabelecidos em programas de saúde pública e em rotina aprovada pela instituição de saúde (gf);", "sha256_texto": "8f1a1afca4cc1ad937ca73ee4859a6ee3121f4d414e13a8534a1ef487623c10d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00013_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
