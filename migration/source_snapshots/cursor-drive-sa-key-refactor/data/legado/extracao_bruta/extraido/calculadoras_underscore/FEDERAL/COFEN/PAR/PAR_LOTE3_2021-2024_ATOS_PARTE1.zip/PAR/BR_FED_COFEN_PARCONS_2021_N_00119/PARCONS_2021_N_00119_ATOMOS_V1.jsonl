{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00119_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00119", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2021_N_00119_SECAO_001", "ordem": 10, "transcricao_literal": "O Processo foi encaminhado para a Comissão de Praticas avançadas para emissão de parecer, sendo apreciado na 5180 Rop, com solicitação e concessão de pedido de vistas aos Conselheiros Ronaldo Beserra e Antônio Marcos Freire Gomes, que apresentaram parecer conjunto na 522a ROP, ocasião em que requisitei e foi deferido vistas ao processo.", "sha256_texto": "4dadf1bd1580d0d70279e09935cd9a43bed5a01d9da99ecedcdab58f0aeaae6a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00119_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00119_SECAO_002", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00119", "tipo_dispositivo": "secao", "localizador": "ANÁLISE", "dispositivo_superior": null, "ordem": 11, "transcricao_literal": "ANÁLISE", "sha256_texto": "59dbc54d07e17bc8fcbdf6a21c296c14bc521c545fbd57d88659b0613616b861", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00119_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00119_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00119", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2021_N_00119_SECAO_002", "ordem": 12, "transcricao_literal": "Empreendedorismo na saúde tem que envolver inovação e isso exige do profissional muita dedicação, comprometimento e estudo. Os empreendedores são aqueles que criam novidades e modificam valores.", "sha256_texto": "e3763eab38c0f03f43a3c86845ed434fc5946ecaac9a3d9dbbb0cb69da1440bf", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00119_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00119_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00119", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2021_N_00119_SECAO_002", "ordem": 13, "transcricao_literal": "Considerando que formação dos enfermeiros sempre foi voltada para o aspecto assistencial em instituições de saúde e de pesquisa científica. O consultório e clinicas de enfermagem são espaços, que permitem inovação e autonomia profissional.", "sha256_texto": "454295df416c6194a3626fc200438a46b1a7b56ed5df9decf94ae3236f59f9f1", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00119_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00119_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00119", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2021_N_00119_SECAO_002", "ordem": 14, "transcricao_literal": "A atuação do Enfermeiro em consultórios e clinicas de enfermagem esta respaldada na Resolução 568/2018 (e seus anexos) que regulamenta o funcionamento dos Consultórios e Clínicas de Enfermagem.", "sha256_texto": "06769459743b746bb914155e7981516d64fcdbe0286bc1e76b04f7368e0d2006", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00119_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00119_ART_020", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00119", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 20 (citado/transcrito)", "dispositivo_superior": null, "ordem": 15, "transcricao_literal": "Art. 20 Os Consultórios e Clínicas de Enfermagem ficam obrigados a providenciar e manter registro no Conselho Regional de Enfermagem que tenha jurisdição sobre a região de seu respectivo funcionamento.", "sha256_texto": "c8b05bab44a783fbd6d383c58ddbeadbda93141bea129619114c9f7b695d0d08", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00119_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Artigo citado ou transcrito de outra norma (sequência não inicia em 1 no escopo); não é articulado próprio."}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00119_ART_030", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00119", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 30 (citado/transcrito)", "dispositivo_superior": null, "ordem": 16, "transcricao_literal": "Art. 30 Os Enfermeiros, quando da atuação em Consultórios e Clínicas de Enfermagem, poderão realizar as atividades e competências regulamentadas pela Lei no 7.498, de 25 de junho de 1986, pelo Decreto no 94.406, de 08 de junho de 1987, e pelas Resoluções do Conselho Federal de Enfermagem.", "sha256_texto": "a74e8057cada5a3723f16fd11bf5a96f56fbf9c2b6056d32e4e3986cad1ed199", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00119_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Artigo citado ou transcrito de outra norma (sequência não inicia em 1 no escopo); não é articulado próprio."}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00119_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00119", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2021_N_00119_SECAO_002", "ordem": 17, "transcricao_literal": "Neste sentido nos consultórios e clinicas de enfermagem os profissionais devem atuar de acordo com sua formação especifica elou especialização, podendo este atendimento ser em apenas uma ou outras áreas da enfermagem e todas as ações e atividades de enfermagem deverão ser realizadas em conformidade com a lei do Exercício da profissão — Lei 7498/86 e Resoluções do Conselho Federal de Enfermagem e em consonância com o Código de Ética dos Profissionais de Enfermagem.", "sha256_texto": "4e49a124ec6b9418f04edb8236315fd4c991d65da476688cc20cbe02e69cc09d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00119_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00119_EPIGRAFE_003", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00119", "tipo_dispositivo": "epigrafe", "localizador": "Epígrafe", "dispositivo_superior": null, "ordem": 18, "transcricao_literal": "Lei no. 7.498 de 25 de junho de 1986 que dispõe sobre a Regulamentação do Exercício da Enfermagem e dá outras providências:", "sha256_texto": "26b0f45c345de578184bba294635dd96f6965063e70f9a95cb44a485edc78107", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00119_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00119_ART_011", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00119", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 11 (citado/transcrito)", "dispositivo_superior": null, "ordem": 19, "transcricao_literal": "Art. 11, O Enfermeiro exerce todas as atividades de Enfermagem, cabendo-lhe: I — privativamente: a) direção do órgão de Enfermagem integrante da estrutura básica da instituição de saúde, pública e privada, e chefia de serviço e de unidade de Enfermagem; b) organização e direção dos serviços de Enfermagem e de suas atividades técnicas e auxiliares nas empresas prestadoras desses serviços; i) consulta de Enfermagem; m) cuidados de Enfermagem de maior complexidade técnica e que exijam conhecimentos de base científica e capacidade de tomar decisões imediatas; II — como integrante da equipe de saúde: c) prescrição de medicamentos estabelecidos em programas de saúde pública e em rotina aprovada pela instituição de saúde; j) educação visando à melhoria de saúde da população.", "sha256_texto": "3589ef44903341041d7b133c393d35d32c525e1caaaeecd8e136701af138aa15", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00119_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Artigo citado ou transcrito de outra norma (sequência não inicia em 1 no escopo); não é articulado próprio."}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00119_EPIGRAFE_004", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00119", "tipo_dispositivo": "epigrafe", "localizador": "Epígrafe", "dispositivo_superior": null, "ordem": 20, "transcricao_literal": "Decreto no 94.406, de 08 de junho de 1987 que Regulamenta a Lei ne 7.498, de 25 de junho de 1986, que dispõe sobre o Exercício da Enfermagem, e dá outras providências:", "sha256_texto": "1d2690f3eaf479ed062bc88da977d1319a17cfa90564f489817e51030256bd7a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00119_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00119_ART_082", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00119", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 82 (citado/transcrito)", "dispositivo_superior": null, "ordem": 21, "transcricao_literal": "Art. 82 — Ao Enfermeiro incumbe: II — como integrante da equipe de saúde: c) prescrição de medicamentos previamente estabelecidos em programas de saúde pública e em rotina aprovada pela instituição de saúde; i) participação nos programas e nas atividades de assistência integral à saúde individual e de grupos específicos, particularmente daqueles prioritários e de alto risco; m) participação em programas e atividades de educação sanitária, visando à melhoria de saúde d indivíduo, da família e da população em geral.", "sha256_texto": "ae4992bc4d6b7e63b4513dfe7df8cea864c441454953f9b0907d23ca6d943966", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00119_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Artigo citado ou transcrito de outra norma (sequência não inicia em 1 no escopo); não é articulado próprio."}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00119_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00119", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2021_N_00119_SECAO_002", "ordem": 22, "transcricao_literal": "Os Protocolos assistenciais são considerados importantes instrumentos para o enfrentamento de diversos problemas na assistência e na gestão dos serviços. O emprego de protocolos tem sido uma maneira de efetivar o modelo de atenção proposto pelo SUS.", "sha256_texto": "13b2cb240e8f6f5500b19c71fd96fbd9a859549164bb07737160be34abb9fea0", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00119_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00119_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00119", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2021_N_00119_SECAO_002", "ordem": 23, "transcricao_literal": "O protocolo caracteriza-se como a descrição de uma situação específica de assistência/cuidado, contendo a operacionalização e a especificação sobre o que, quem e como se faz, orientando e respaldando os profissionais em suas condutas para a prevenção, recuperação ou reabilitação da saúde (PIMENTA, 2015).", "sha256_texto": "4bb8598d9c03ee6396e8d8f7fb3e243c3a3e4cd1e0b5bcdbbae8767c8b3a406f", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00119_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00119_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00119", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 7", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2021_N_00119_SECAO_002", "ordem": 24, "transcricao_literal": "Assim, podemos afirmar que os protocolos são instrumentos muito úteis na organização do processo de trabalho e na resolubilidade das ações de saúde no âmbito das unidades de saúde.", "sha256_texto": "2abf4c47d5a34e53be718872cb63df9d201d0259c8c4d289b89f9b4ed0b76597", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00119_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00119_PARAGRAFO_TEXTO_012", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00119", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 8", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2021_N_00119_SECAO_002", "ordem": 25, "transcricao_literal": "E como preconiza o Parecer COREN/PE no 019/2017 […] os protocolos assistenciais não são documentos estáticos e imutáveis, por isso, é desejável que o grupo de criação permaneça presente na implantação e adequações, que por ventura, possam ser necessárias. A evolução das tecnologias em saúde é constante e cada vez mais presente, no dia a dia de quem presta a assistência à saúde, determinando que os prestadores de serviços estejam sempre atualizados, pois os usuários, cada vez mais conscientes de seus direitos, buscam uma assistência mais qualificada e resolutiva.", "sha256_texto": "c2111ce631bcd19e1d4036fd120d45a5eef9ae58b7ff3c0fccc25aedce4b7c25", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00119_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00119_ART_082_INC_III", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00119", "tipo_dispositivo": "inciso", "localizador": "Inciso III", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2021_N_00119_ART_082", "ordem": 26, "transcricao_literal": "III. CONCLUSÃO Ante o exposto e em resposta a consulta realizada pela Enfermeira Mariana Nunes, concluo que as orientações contidas no PROTOCOLO DO ENFERMEIRO NA ESTRATEGIA DA SAUDE DA FAMILIA DO ESTADO DA PARAÍBA, são próprias do processo de trabalho dos enfermeiros que atuam na Estratégia Saúde da Família.", "sha256_texto": "3d87c08bf7967e5c0c74b80a8bd6f6793fb139634d09de4c08c97e65ed5260d1", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00119_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Dispositivo de artigo citado/transcrito."}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00119_PARAGRAFO_TEXTO_013", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00119", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 9", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2021_N_00119_SECAO_002", "ordem": 27, "transcricao_literal": "Os Protocolos do Ministério da Saúde, Estados e Municípios, são elaborados na lógica da equipe multiprofissional, portanto não se adequando aos consultórios", "sha256_texto": "ce076aca588e7caa810d52e43fe3a05f949f85c6af26efdeef1339c8ca68b0ce", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00119_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
