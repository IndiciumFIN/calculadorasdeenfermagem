{"identificador": "BR_FED_COFEN_PARCT_2022_N_00001_CTAB_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARCT_2022_N_00001_CTAB", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00001_CTAB_SECAO_003", "ordem": 10, "transcricao_literal": "No dia 04 de fevereiro de 2022 foi encaminhado ao DGEP pelo Setor de Inscrição, Registro e Cadastro o MEMORANDO N° 043/2022/SIRC/DGEP/COFEN que tratou do Ofício Coren-GO n° 88/2021, protocolo n° 4833/2021-B no qual a referida autarquia de classe solicita emissão de parecer acerca do relato de caso da profissional Larissa Martins Caldas de Souza a qual alegou que a Vigilãncia Sanitária de Goiânia rejeitou a Certidão de Responsabilidade Técnica — CRT, devido ao documento não apresentar a especificação sobre a área de atendimento.", "sha256_texto": "922e9303003dc02d8daa3688727e2022db8eca1ce21f2c2e465e162b23f2ec71", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00001_CTAB_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00001_CTAB_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_PARCT_2022_N_00001_CTAB", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00001_CTAB_SECAO_003", "ordem": 11, "transcricao_literal": "Registros do Ofício/SIRC afirmaram que após análise dos documentos desse setor, constatou-se que a Vigilância Sanitária de Anápolis negou a concessão de alvará sanitário até", "sha256_texto": "1df1dd8255cc890d14a92b40ab5f340273ebfd895608ba645a0c1101bcc8b43e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00001_CTAB_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00001_CTAB_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARCT_2022_N_00001_CTAB", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00001_CTAB_SECAO_003", "ordem": 12, "transcricao_literal": "que a profissional cumpra a exigência realizada pelo órgão, sendo a ela especificação na CRT de que a enfermeira será responsável pela sala de vacina, não aceitando, assim, o documento expedido pelo Coren-GO, mencionando apenas a motivação: Gestão Assistencial e Gestão Técnica.", "sha256_texto": "341ed06cf60bd2f19a032271c61d5dd0f25ccd8e25f61c2678ac645ce3615cf5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00001_CTAB_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
