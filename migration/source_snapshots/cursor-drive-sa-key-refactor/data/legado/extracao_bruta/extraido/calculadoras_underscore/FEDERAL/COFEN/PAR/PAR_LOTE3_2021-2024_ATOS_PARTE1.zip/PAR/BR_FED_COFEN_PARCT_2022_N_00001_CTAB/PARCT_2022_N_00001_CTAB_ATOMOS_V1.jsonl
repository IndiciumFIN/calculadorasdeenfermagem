{"identificador": "BR_FED_COFEN_PARCT_2022_N_00001_CTAB_ITEM_LISTA_004", "normativo": "BR_FED_COFEN_PARCT_2022_N_00001_CTAB", "tipo_dispositivo": "item_lista", "localizador": "Item de lista", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00001_CTAB_PARAGRAFO_TEXTO_009", "ordem": 23, "transcricao_literal": "– elaborar o Código de Deontologia de Enfermagem e alterá-lo, quando necessário, ouvidos os Conselhos Regionais;", "sha256_texto": "b101f1d27b07dc1708c905d9341d3dcfec427f3a64b05d593e7f8e2664663736", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00001_CTAB_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "•"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00001_CTAB_ITEM_LISTA_005", "normativo": "BR_FED_COFEN_PARCT_2022_N_00001_CTAB", "tipo_dispositivo": "item_lista", "localizador": "Item de lista", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00001_CTAB_PARAGRAFO_TEXTO_009", "ordem": 24, "transcricao_literal": "– baixar provimentos e expedir instruções para uniformidade de procedimento e bom funcionamento dos Conselhos Regionais; (grifo nosso)", "sha256_texto": "810d3e3a94f27980c9e3a411ea79e0a96c15a6f51559f28c77ce9bbe1a97c4f6", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00001_CTAB_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "•"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00001_CTAB_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARCT_2022_N_00001_CTAB", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00001_CTAB_SECAO_004", "ordem": 25, "transcricao_literal": "E considerando a Resolução COFEN 509/2016 que em seu Art. l° A Anotação de Responsabilidade Técnica, pelo Serviço de Enfermagem, bem como, as atribuições do Enfermeiro Responsável Técnico, passam a ser regidas por esta Resolução, não cabe a outra instituição pública ou privada obrigar o COFEN a rever seus atos normativos em função de necessidades próprias.", "sha256_texto": "478763da0597cae5e8c9d23c944c14fa0ccc8bf73ac1d51692969ed182ed6a13", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00001_CTAB_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00001_CTAB_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_PARCT_2022_N_00001_CTAB", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00001_CTAB_SECAO_004", "ordem": 26, "transcricao_literal": "Em ressalva salientamos que trata-se de um caso inusitado, haja vista que ao longo da publicação da Resolução supracitada, as CRTs emitidas pelos Conselhos Regionais de Enfermagem foram aceitas sem questionamentos pelas Vigilâncias Sanitárias em todo território brasileiro sendo concedido o alvará sanitário para quem de direito.", "sha256_texto": "55073130514ce90f1988e727c6ed78d572f2f33edfadc6713fd68d5c9d612fde", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00001_CTAB_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00001_CTAB_PARAGRAFO_TEXTO_012", "normativo": "BR_FED_COFEN_PARCT_2022_N_00001_CTAB", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00001_CTAB_SECAO_004", "ordem": 27, "transcricao_literal": "Outrossim quando o referido ato normativo trata a motivação — Gestão Assistencial e a conceitua, ressaltamos que a SALA DE VACINA está dentro do rol do gerenciamento das ações de Enfermagem nos cuidados diretos ao individuo, família e/ou coletividade da promoção e prevenção de saúde.", "sha256_texto": "e2bff30ef0ca562bb4c829e5f70d5bf9fa5645fa452e6ac0205a98062a08294d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00001_CTAB_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00001_CTAB_ART_006_INC_IV", "normativo": "BR_FED_COFEN_PARCT_2022_N_00001_CTAB", "tipo_dispositivo": "inciso", "localizador": "Inciso IV", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00001_CTAB_ART_006", "ordem": 28, "transcricao_literal": "IV — DO PARECER A CTAB/COFEN reitera que a CRT emitida pelo COREN — GO à profissional Larissa Martins Caldas de Souza responde na íntegra à norma prevista para emissão da Anotação de Responsabilide Técnica pelo serviço de enfermagem.", "sha256_texto": "041e44d81e0c270373784f2fbc760eea8441a308d3ab7936a6b230f8b2c6227f", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00001_CTAB_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Dispositivo de artigo citado/transcrito."}
