{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00082_PARAGRAFO_TEXTO_015", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00082", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 15", "dispositivo_superior": null, "ordem": 31, "transcricao_literal": "No que concerne as atribuições dos técnicos de enfermagem, o artigo 12 da Lei faz a seguinte definição:", "sha256_texto": "13d93ae2ce96cb309c46dac9b7691865ba7ffc65d8e40a18bee8b9960ef9fef9", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00082_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00082_PARAGRAFO_TEXTO_016", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00082", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 16", "dispositivo_superior": null, "ordem": 32, "transcricao_literal": "“o Técnico de Enfermagem exerce atividade de nível médio, envolvendo orientação e acompanhamento do trabalho de Enfermagem em grau auxiliar, e participação no planejamento da assistência de Enfermagem, cabendo-lhe especialmente:", "sha256_texto": "79f26e089daa9e874e1317ce27910fe2b871167d91ff9a44f157e173203e9a99", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00082_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00082_ITEM_LISTA_005", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00082", "tipo_dispositivo": "item_lista", "localizador": "Item de lista", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2021_N_00082_PARAGRAFO_TEXTO_016", "ordem": 33, "transcricao_literal": "1º Participar da programação da assistência de Enfermagem;", "sha256_texto": "0574fbb6e128d45c42392b09603ab1b83ff587cd00b734d40ba13703e70bab38", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00082_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "•"}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00082_ITEM_LISTA_006", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00082", "tipo_dispositivo": "item_lista", "localizador": "Item de lista", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2021_N_00082_PARAGRAFO_TEXTO_016", "ordem": 34, "transcricao_literal": "2º Executar ações assistenciais de Enfermagem, exceto as privativas do Enfermeiro, observado o disposto no Parágrafo único do Art. 11 desta Lei;", "sha256_texto": "2d3fe5f9d9f7883b630c3f0d89796c823fc6de85334e3cceb1bfdf639ad93a1d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00082_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "•"}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00082_ITEM_LISTA_007", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00082", "tipo_dispositivo": "item_lista", "localizador": "Item de lista", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2021_N_00082_PARAGRAFO_TEXTO_016", "ordem": 35, "transcricao_literal": "3º Participar da orientação e supervisão do trabalho de Enfermagem em grau auxiliar;", "sha256_texto": "43301ae7cbef62d20615bc31c07fea20ecb29884664183d5db0234e3acc45009", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00082_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "•"}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00082_ITEM_LISTA_008", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00082", "tipo_dispositivo": "item_lista", "localizador": "Item de lista", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2021_N_00082_PARAGRAFO_TEXTO_016", "ordem": 36, "transcricao_literal": "4º Participar da equipe de saúde.", "sha256_texto": "a9c69a136302bc5f84fc515450cbd324f6bfacce5d05c43d10ac64e451c6b496", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00082_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "•"}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00082_PARAGRAFO_TEXTO_017", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00082", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 17", "dispositivo_superior": null, "ordem": 37, "transcricao_literal": "Nota-se que o dispositivo da lei não revela atribuições para o técnico de enfermagem quanto a elaboração de parecer técnico. O decreto regulamentador, na mesma toada da lei, também nada revela acerca da existência de possível competência legal. Neste cenário onde a lei e o decreto são imperiosos, discordo da manifestação da CTLN quando esta afirma que, com base no art. 11, I, “h”, o enfermeiro pode ser auxiliado por técnico ou auxiliares de enfermagem na elaboração de pareceres sobre matéria de enfermagem, pelo simples fato de que estamos tratando aqui do rol de atividades privativas do enfermeiro, cuja delegação, inclusive, encontra obstáculo nas próprias competências do técnico quando o art. 12, §, 2º afirma que este executará ações assistenciais de enfermagem, exceto as privativas do enfermeiro, ou seja, todas as que estão elencadas no artigo 11 da Lei.", "sha256_texto": "34a66118fba4f6bee79432ceff02496a76593f614a1f74e56d942d3972a97487", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00082_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00082_PARAGRAFO_TEXTO_018", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00082", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 18", "dispositivo_superior": null, "ordem": 38, "transcricao_literal": "Logo, ainda que não seja uma atividade assistencial, a emissão de parecer em matéria de enfermagem, em nosso entendimento, não comporta a possibilidade de auxílio, no sentido estrito, para sua execução.", "sha256_texto": "80205319855f697b907814981f190d414cd011239a26ce2c42b644af8f608ab1", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00082_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00082_PARAGRAFO_TEXTO_019", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00082", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 19", "dispositivo_superior": null, "ordem": 39, "transcricao_literal": "Depreende-se assim, por força da lei cuja finalidade foi fixar competências e definir atribuições legais aos agentes que exercem a profissão de enfermagem, não se encontrar parâmetros para que o técnico de enfermagem possa emitir parecer em matérias técnicas que envolvam o exercício profissional.", "sha256_texto": "f311b6c62320ff61041afd8330dc5816131813298822583546cf79eb4b0763a3", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00082_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00082_PARAGRAFO_TEXTO_020", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00082", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 20", "dispositivo_superior": null, "ordem": 40, "transcricao_literal": "Noutro giro é incontroverso o reconhecimento que o Sistema Cofen/Conselhos Regionais vem fazendo ao trabalho do técnico de enfermagem, seja pela sua capacidade técnica, seja pela sua atuação política. Tanto é que a Resolução Cofen nº 612/2019, que criou o novo Código Eleitoral do Sistema previu no artigo 12. § 1º que os cargos de tesoureiros nos Regionais serão ocupados preferencialmente por técnicos ou auxiliares de enfermagem, na convicção de que, no caso, o técnico de enfermagem pode assumir responsabilidades que vão além das previsões legais fixadas na lei do exercício profissional.", "sha256_texto": "96462f9fd917004ee366db83f623f5befa72a69a2f63aa07d27c1e9085cc1917", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00082_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00082_PARAGRAFO_TEXTO_021", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00082", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 21", "dispositivo_superior": null, "ordem": 41, "transcricao_literal": "Percebam a responsabilidade asseverada pelo normativo interno ao técnico de enfermagem, sendo ela uma das mais importantes no campo da gestão da autarquia pública pois envolve a gestão financeira do Coren, devendo realizar, dirigir e supervisionar os serviços financeiros e de tesouraria, assinar com presidente proposta orçamentária e demais documentos vinculados a gestão financeira, entre outros.", "sha256_texto": "e096430fba45cccd9e9d0d44b41f233a17252ebaaba87c87bafad96c15d78e75", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00082_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00082_PARAGRAFO_TEXTO_022", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00082", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 22", "dispositivo_superior": null, "ordem": 42, "transcricao_literal": "Com efeito, pelo papel relevante que tem na gestão, inclusive fazendo parte da diretoria, cuja função é administrar o Coren, deve ter o preparo e o conhecimento necessário para desempenhar suas funções com competência, podendo inclusive opinar, sob a forma de parecer técnico, acerca de matérias que se relacionem a sua esfera de atuação, quais sejam, finanças e gestão interna do Regional.", "sha256_texto": "a6ff9c3b3019912ff627dcb2eb22ce60e614b969ac3cfba0f4feb4d2f225309e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00082_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00082_PARAGRAFO_TEXTO_023", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00082", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 23", "dispositivo_superior": null, "ordem": 43, "transcricao_literal": "Ressalto, a quem possa entender tratar-se de uma burla a lei nº 7.498/86 passível de questionamento, que as manifestações sob a forma de parecer técnico sempre devem ser apreciadas no Plenário do Regional que tem o poder máximo de aprovar ou reprovar pareceres técnicos, assumindo a responsabilidade, o Pleno, de ser o autor daquela deliberação, cuja responsabilidades, positivas ou negativas, legais ou ilegais, recaem sobre aqueles que votaram com voto vencedor.", "sha256_texto": "77db40535a04263965360235c38e33081244c5c956232e192e711c5f4af69dc4", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00082_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00082_PARAGRAFO_TEXTO_024", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00082", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 24", "dispositivo_superior": null, "ordem": 44, "transcricao_literal": "Como síntese da indagação inicial, feita a Ouvidoria do Cofen, entendo que não há previsão legal para técnicos de enfermagem emitirem parecer sobre matérias relacionadas ao exercício profissional da enfermagem, contudo, pela ocupação efetiva do cargo de tesoureiro e como membro da diretoria do Regional poderão fazê-lo em matérias pertinentes a sua pasta e a gestão de um modo geral, conforme entendimento a ser decidido pelo presidente do Regional, a quem é concedido o poder de delegar relator para os processos.", "sha256_texto": "88ccad4e1706efc65b2fdc60ae8b85a24b637d4015467a919dc0597511bf9fd5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00082_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00082_PARAGRAFO_TEXTO_025", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00082", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 25", "dispositivo_superior": null, "ordem": 45, "transcricao_literal": "Por fim, a exclusão de pareceres, já devidamente aprovados em Plenário do Regional exige decisão motivada do gestor, justificando as razões pelas quais adotou aquele ato administrativo. Não pode o gestor novo, ao seu bel prazer, ainda que presente vício de origem nas deliberações, agir sem a devida motivação, devendo colocar a matéria em Plenário para aprovação, sob pena de descumprimento de princípio constitucional, com a consequente responsabilização .", "sha256_texto": "6ef3528d6225ff07e28e25a9dacfdb0d312f74929905e2af610cd6ff51d51bcd", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00082_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_2021_N_00082_PARAGRAFO_TEXTO_026", "normativo": "BR_FED_COFEN_PARCONS_2021_N_00082", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 26", "dispositivo_superior": null, "ordem": 46, "transcricao_literal": "Este é o parecer, S.M.J", "sha256_texto": "5574279747af801cfba8a2b3f0bdd5d2ecc06579f468cd5c3a4d2e980aadef50", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2021_N_00082_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
