{"identificador": "BR_FED_COFEN_PARCT_2021_N_00085_CTLN_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_PARCT_2021_N_00085_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00085_CTLN_SECAO_005", "ordem": 16, "transcricao_literal": "Por envolver a garantia da segurança do paciente, é mister compreender que o transporte do mesmo, carece de assistência contínua e que necessita da equipe de enfermagem, durante todo o seu processo. Para isso, deve-se assegurar a atuação de profissionais em quantitativo suficiente de acordo com o grau de complexidade que o caso requeira.", "sha256_texto": "e3d2062a04531285155e75b5987dc96dd4e56cfa96e373f3cb94150add0e33ad", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00085_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
