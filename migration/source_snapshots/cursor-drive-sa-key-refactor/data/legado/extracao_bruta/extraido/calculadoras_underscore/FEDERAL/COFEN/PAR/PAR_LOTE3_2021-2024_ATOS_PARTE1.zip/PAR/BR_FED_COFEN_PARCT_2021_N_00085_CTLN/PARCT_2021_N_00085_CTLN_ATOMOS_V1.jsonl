{"identificador": "BR_FED_COFEN_PARCT_2021_N_00085_CTLN_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_PARCT_2021_N_00085_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00085_CTLN_SUBSECAO_001", "ordem": 18, "transcricao_literal": "Não compete aos profissionais de Enfermagem a condução do meio (maca e/ou cadeira de rodas) em que o paciente está sendo transportado.", "sha256_texto": "926aa974232eb33a023ef67c3e87714d466576ae3efc6487c255d0b857f69e0a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00085_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
