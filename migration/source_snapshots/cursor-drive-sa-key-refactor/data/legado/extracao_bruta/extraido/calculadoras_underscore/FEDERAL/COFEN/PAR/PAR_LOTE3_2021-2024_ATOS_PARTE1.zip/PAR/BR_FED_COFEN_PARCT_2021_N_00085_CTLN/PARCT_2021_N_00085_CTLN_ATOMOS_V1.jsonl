{"identificador": "BR_FED_COFEN_PARCT_2021_N_00085_CTLN_PARAGRAFO_TEXTO_002", "normativo": "BR_FED_COFEN_PARCT_2021_N_00085_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00085_CTLN_SECAO_001", "ordem": 6, "transcricao_literal": "Trata-se de questionamento do Coren Paraíba, através do Ofício nº 403/2021, em que informa e requer parecer do Cofen, especificamente da CTLN, sobre a situação de dois hospitais privados que demitiram seus profissionais maqueiros e atribuíram aos profissionais de enfermagem que prestam assistência na instituição, as atividades daqueles profissionais.", "sha256_texto": "13d52f208f765a5ec3ab04848fc0912c6026f849f3aabbc328096523ddac1abe", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00085_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
