{"identificador": "BR_FED_COFEN_PARCT_2021_N_00085_CTLN_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARCT_2021_N_00085_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00085_CTLN_SECAO_002", "ordem": 8, "transcricao_literal": "A questão suscitada pelo Coren-PB é tratada pela Resolução Cofen nº 588/2018, que aprova a normatização de atuação da equipe de Enfermagem no processo de transporte de pacientes em ambiente interno aos serviços de saúde. A referida Resolução é muito clara em suas considerações, não apenas observando seus artigos, mas seu Anexo, que é parte integrante da mesma, como citaremos abaixo:", "sha256_texto": "de3ea0133d174563a14f8d438fef050d3f83ea9cc26ce91a690c2ab2129f718b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00085_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00085_CTLN_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARCT_2021_N_00085_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00085_CTLN_SECAO_002", "ordem": 9, "transcricao_literal": "[…] Art. 2º Os profissionais de Enfermagem participam do processo de transporte do paciente em ambiente interno aos serviços de saúde, obedecidas as recomendações insertas no anexo deste normativo.", "sha256_texto": "3b0f4cd0264a48178eee77a4d75f6f99e66b7ac5b52001a8613b4a45ad9e2b3a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00085_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00085_CTLN_ART_003", "normativo": "BR_FED_COFEN_PARCT_2021_N_00085_CTLN", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 3º (citado/transcrito)", "dispositivo_superior": null, "ordem": 10, "transcricao_literal": "Art. 3º O transporte do paciente hospitalizado faz parte das competências da equipe de enfermagem, devendo os serviços de saúde assegurar as condições necessárias para atuação do profissional responsável pela condução do meio (maca ou cadeira de rodas).", "sha256_texto": "7c1000e79c2cf330a95a0780f775489c8eedc170fef9e8b2761a5535b57ee54d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00085_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Artigo citado ou transcrito de outra norma (sequência não inicia em 1 no escopo); não é articulado próprio."}
