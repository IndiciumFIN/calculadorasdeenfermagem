{"identificador": "BR_FED_COFEN_PARCT_2020_N_00035_CTLN_PARAGRAFO_TEXTO_002", "normativo": "BR_FED_COFEN_PARCT_2020_N_00035_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00035_CTLN_SECAO_002", "ordem": 6, "transcricao_literal": "Trata-se de DESPACHO da lavra do Chefe do Departamento de Gestão do Exercício Profissional – DGEP/COFEN, DR. WALKíRIO COSTA ALMEIDA (fl. 02) encaminhando os autos à CTLN para emissão de parecer acerca do pedido de “autorização para prescrever e solicitar exames em consultório particular de enfermagem”, ou ainda “a ampliação da prescrição de medicamentos e solicitação de exames, em clínicas e consultórios de enfermagem particulares” (gn). O questionamento realizado pela Dra. Isabella Costa Gama (fl.03 – v).", "sha256_texto": "f1787dafe8dbd2f36b281dcb5b7726329920d3ee43741b493e6307b4dfc3d365", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00035_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
