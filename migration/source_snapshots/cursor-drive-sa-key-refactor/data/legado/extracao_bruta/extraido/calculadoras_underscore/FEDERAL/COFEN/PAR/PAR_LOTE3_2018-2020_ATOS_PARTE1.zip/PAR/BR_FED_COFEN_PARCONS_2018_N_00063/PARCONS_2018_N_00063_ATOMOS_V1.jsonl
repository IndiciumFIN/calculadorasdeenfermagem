{"identificador": "BR_FED_COFEN_PARCONS_2018_N_00063_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_PARCONS_2018_N_00063", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2018_N_00063_SECAO_001", "ordem": 10, "transcricao_literal": "Em cumprimento ao expresso na Portaria Cofen Nº 1346 de 2017 recebi da lavra do Excelentíssimo Senhor Presidente do Conselho Federal de Enfermagem, o PAD COFEN 024/2017 para análise e emissão de parecer.", "sha256_texto": "6e523d138551b77208f3e7b5de15cf3ca03692c5aba5154794063b1442512af7", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2018_N_00063_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARCONS_2018_N_00063_SECAO_002", "normativo": "BR_FED_COFEN_PARCONS_2018_N_00063", "tipo_dispositivo": "secao", "localizador": "II. DOS FATOS", "dispositivo_superior": null, "ordem": 11, "transcricao_literal": "II. DOS FATOS", "sha256_texto": "ba22c3c5e25e22b227960e63c251e20978c9ee4214b96a37d9bb277e7771145d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2018_N_00063_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "EQUIVALENTE_OCR", "similaridade": 83.3, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARCONS_2018_N_00063_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARCONS_2018_N_00063", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2018_N_00063_SECAO_002", "ordem": 12, "transcricao_literal": "Trata-se de esclarecimento enviado via Ouvidoria Cofen com a seguinte questão: “ é permitida a retirada de Sonda Vesical de Demora pelo Técnico de Enfermagem?”. Em resposta a tal quesito, foi emitida uma resposta pela colaboradora Enf. Dra. Rita de Cássia Duarte Neves com o seguinte parecer: “ante o exposto, em resposta ao questionamento de V.Sa, as atividades privativas do Enfermeiro não podem ser executadas pelo Técnico de Enfermagem, portanto cabe exclusivamente ao Enfermeiro, a realização de qualquer tipo de sondagem vesical que envolva a inserção de dispositivos urinários, conforme resolução citada acima…”.", "sha256_texto": "05a33c0b19d910bc88fb10ec4f87b1ca387ce0508196ebc017ff3d8b031282a8", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2018_N_00063_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARCONS_2018_N_00063_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_PARCONS_2018_N_00063", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2018_N_00063_SECAO_002", "ordem": 13, "transcricao_literal": "Não contente com a resposta, a solicitante reafirma o questionamento, alegando que sua dúvida é quanto a retirada da sonda vesical e não a inserção.", "sha256_texto": "796c4da1851cf4ad1f8b900eecf1bfa9a5ce44493d1502a4e08ea63768e0b523", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2018_N_00063_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARCONS_2018_N_00063_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_PARCONS_2018_N_00063", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2018_N_00063_SECAO_002", "ordem": 14, "transcricao_literal": "Encaminhado para Parecer da CTLN que em parecer 21/2017 é da seguinte conclusão: “ ante o exposto, fica claro para esta Câmara Técnica que a inserção da Sonda Vesical de Demora é realizada privativamente pelo Enfermeiro, o que torna lícito ao Técnico de Enfermagem poder realizar a retirada da sonda vesical de demora, desde que capacitado, sob supervisão e orientação do Enfermeiro, nos termos determinados pela Lei”.", "sha256_texto": "42380cae3b7b47379b7e678429d0fd1c6f1db0846526089702d74f1c550b666e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2018_N_00063_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
