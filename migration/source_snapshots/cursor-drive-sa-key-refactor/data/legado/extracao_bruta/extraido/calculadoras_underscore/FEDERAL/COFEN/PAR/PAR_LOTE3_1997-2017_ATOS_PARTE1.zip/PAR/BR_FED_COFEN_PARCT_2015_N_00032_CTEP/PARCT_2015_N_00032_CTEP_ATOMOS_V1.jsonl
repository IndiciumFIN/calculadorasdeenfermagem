{"identificador": "BR_FED_COFEN_PARCT_2015_N_00032_CTEP_ARTIGO_TRANSCRITO_001", "normativo": "BR_FED_COFEN_PARCT_2015_N_00032_CTEP", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 2 (transcrito)", "dispositivo_superior": "BR_FED_COFEN_PARCT_2015_N_00032_CTEP_SECAO_002", "ordem": 19, "transcricao_literal": "“Art. 2º Os títulos de pós-graduação lato e stricto sensu por Instituições de Ensino Superior, especialmente credenciadas pelo Ministério da Educação – MEC, ou concedidos por Sociedades, Associações ou Colégios de Especialistas, Enfermagem ou de outras áreas do conhecimento, serão registrados, no âmbito do Sistema Cofen / Conselhos Regionais de Enfermagem, de acordo com a legislação Vigente § 1º Os títulos serão registrados de acordo com a denominação constante do diploma ou certificado apresentado (grifo nosso).", "sha256_texto": "765c54b6fe4620ccbca63dd98fb9ae5e1a699b5e16b839acb316e38a33677893", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2015_N_00032_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2015_N_00032_CTEP_ART_005", "normativo": "BR_FED_COFEN_PARCT_2015_N_00032_CTEP", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 5º (citado/transcrito)", "dispositivo_superior": null, "ordem": 20, "transcricao_literal": "Art. 5º As Especialidades de Enfermagem e suas áreas de abrangência reconhecidas pelo Cofen, encontram-se listadas no anexo desta Resolução.” Analisando o Historio Escolar do curso que a profissional concluiu, constatamos a presença de Disciplinas com enfoque na área da Vigilância Sanitária.", "sha256_texto": "a7bee8d2987796279538f73acfc4141acea47f414242b158abce96ccad3af2af", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2015_N_00032_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Artigo citado ou transcrito de outra norma (sequência não inicia em 1 no escopo); não é articulado próprio."}
