{"identificador": "BR_FED_COFEN_PARCT_2015_N_00003_CTAS_ITEM_LISTA_002", "normativo": "BR_FED_COFEN_PARCT_2015_N_00003_CTAS", "tipo_dispositivo": "item_lista", "localizador": "Item de lista 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2015_N_00003_CTAS_PARAGRAFO_TEXTO_010", "ordem": 20, "transcricao_literal": "Fugulin FMT. Dimensionamento de enfermagem: avaliação do quadro de pessoal de enfermagem nas unidades de internação de um hospital escola [tese]. São Paulo: Escola de Enfermagem, Universidade de São Paulo; 2002.", "sha256_texto": "25f2bc4ebefd1d2595da823c7ff076f8e354d7dd5f699a20dd6efdfc3d6b0a14", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2015_N_00003_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "2"}
{"identificador": "BR_FED_COFEN_PARCT_2015_N_00003_CTAS_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_PARCT_2015_N_00003_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARCT_2015_N_00003_CTAS_SECAO_003", "ordem": 21, "transcricao_literal": "A Resolução Cofen 293/2004 e seus anexos I, II, III e IV, estabelecem os parâmetros para dimensionar o quantitativo mínimo dos diferentes níveis de formação dos profissionais de enfermagem, para a cobertura assistencial, nas instituições de saúde (Art. 1°, Res. Cofen 293/2004)", "sha256_texto": "7ef4b60a55cb972d92335ff13eb6b7c3bded02c59a142c03b61e8c0dc01e17b4", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2015_N_00003_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2015_N_00003_CTAS_PARAGRAFO_TEXTO_012", "normativo": "BR_FED_COFEN_PARCT_2015_N_00003_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_COFEN_PARCT_2015_N_00003_CTAS_SECAO_003", "ordem": 22, "transcricao_literal": "Os referidos parâmetros representam normas técnicas mínimas, constituindo-se em referências para orientar gestores e gerentes das instituições de saúde no planejamento, programação e priorização das ações de saúde a serem desenvolvidas (§1°, Art. 1°, Res. Cofen 293/2004).", "sha256_texto": "1781b8f1a1cae8a4bb3c21b16182954bed0a83b345c38452f71f14d882228ad1", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2015_N_00003_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
