{"identificador": "BR_FED_COFEN_OS_2017_N_00010_CONSIDERANDO_002", "normativo": "BR_FED_COFEN_OS_2017_N_00010", "tipo_dispositivo": "considerando", "localizador": "Considerando 2", "dispositivo_superior": null, "ordem": 4, "transcricao_literal": "CONSIDERANDO que o art. 37, caput, da Constituição Federal de 1988 consagrou o Princípio da Publicidade dos atos administrativos com objetivo de possibilitar o acesso de todos cidadãos às informações sobre os atos da Administração Pública;", "sha256_texto": "b9d952da34eb38b41f706bf65a8fcd501c4a2bec851ed1a8e8391936493bed80", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "OS_2017_N_00010_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_OS_2017_N_00010_CONSIDERANDO_003", "normativo": "BR_FED_COFEN_OS_2017_N_00010", "tipo_dispositivo": "considerando", "localizador": "Considerando 3", "dispositivo_superior": null, "ordem": 5, "transcricao_literal": "CONSIDERANDO o que dispõe a Lei nº 12.527/2011 – Lei de Acesso à Informação;", "sha256_texto": "8e5846acf19aae56ffb31736c12a48201fda77d623d54fae1947d7ec19c8cd22", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "OS_2017_N_00010_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_OS_2017_N_00010_CONSIDERANDO_004", "normativo": "BR_FED_COFEN_OS_2017_N_00010", "tipo_dispositivo": "considerando", "localizador": "Considerando 4", "dispositivo_superior": null, "ordem": 6, "transcricao_literal": "CONSIDERANDO o Acórdão do Tribunal de Contas da União – TCU nº 096/2016, que determina aos Conselhos Profissionais o cumprimento da Lei nº 12.527/2011, em especial no que tange aos 9.1.1.4 e 97.1, no que diz respeito à obrigatoriedade de publicação de informações sobre a estrutura, legislação, composição, data, horário, local das reuniões, contatos, deliberações, resoluções e atas de seus órgãos colegiados (art. 7º, V, e 9º, II, da Lei 12.527/2011) (item III.5 do relatório);", "sha256_texto": "63e7062182b60750bb3c6c5d2abf95da0dfb4828ceb3ef4fe957a24d71f0d361", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "OS_2017_N_00010_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "EQUIVALENTE_OCR", "similaridade": 99.6, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_OS_2017_N_00010_CONSIDERANDO_005", "normativo": "BR_FED_COFEN_OS_2017_N_00010", "tipo_dispositivo": "considerando", "localizador": "Considerando 5", "dispositivo_superior": null, "ordem": 7, "transcricao_literal": "CONSIDERANDO a necessidade em se regulamentar o disposto no art. 22, inciso XIV do Regimento Interno do Cofen, o qual dispõe que é competência do Cofen dar publicidade de seus atos, preferencialmente por meio eletrônico, e por publicação no Diário Oficial, nos casos exigidos em lei;", "sha256_texto": "ad2f8f298dbd0d8f70bd176c8269c47706b59afd225a6e5dfc6745d99897e751", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "OS_2017_N_00010_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_OS_2017_N_00010_CONSIDERANDO_006", "normativo": "BR_FED_COFEN_OS_2017_N_00010", "tipo_dispositivo": "considerando", "localizador": "Considerando 6", "dispositivo_superior": null, "ordem": 8, "transcricao_literal": "CONSIDERANDO que cabe ao Presidente do Cofen, segundo o art. 25, inciso XXI do Regimento Interno do Cofen, publicar seus atos oficiais, preferencialmente por meio eletrônico ou Diário Oficial da União, na forma da Lei;", "sha256_texto": "0d7be1cda5bb0526656f9fe28110a274ed2d038127243b024ffa763c704e122c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "OS_2017_N_00010_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
