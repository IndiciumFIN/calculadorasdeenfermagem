{"identificador": "BR_FED_COFEN_PARPLEN_2025_N_00211_PLENARIO_PARAGRAFO_TEXTO_016", "normativo": "BR_FED_COFEN_PARPLEN_2025_N_00211_PLENARIO", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARPLEN_2025_N_00211_PLENARIO_SECAO_003", "ordem": 23, "transcricao_literal": "Ante ao exposto conclui-se que na Equipe de Enfermagem o aprazamento pode ser realizado pelo Enfermeiro e técnico de Enfermagem sob a supervisão do Enfermeiro. Recomenda – se que o Enfermeiro organize os procedimentos operacionais padrão e educação permanente para que a equipe de Enfermagem realize o aprazamento com segurança e conhecimento científico.", "sha256_texto": "91a910ab001245d2c10bfd3aa33b0c8287dd0babd8798bd98e1b4ec214f7f71a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARPLEN_2025_N_00211_PLENARIO_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
