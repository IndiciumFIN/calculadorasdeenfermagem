{"identificador": "BR_FED_COFEN_PORT_2010_N_00091_PREAMBULO_001", "normativo": "BR_FED_COFEN_PORT_2010_N_00091", "tipo_dispositivo": "preambulo", "localizador": "Preâmbulo", "dispositivo_superior": null, "ordem": 2, "transcricao_literal": "O Presidente do Conselho Federal de Enfermagem – COFEN, em conjunto com o Primeiro Secretário da Autarquia, no uso de suas atribuições legais e regimentais instituídas pelo Regimento Interno da Autarquia, aprovado pela Resolução COFEN nº. 242, de 31 de agosto de 2000;", "sha256_texto": "15aa4c61e36b3b61a382b846ea30974aa153a723a49eacce5616f539526c5033", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2010_N_00091_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2010_N_00091_CONSIDERANDO_001", "normativo": "BR_FED_COFEN_PORT_2010_N_00091", "tipo_dispositivo": "considerando", "localizador": "Considerando 1", "dispositivo_superior": null, "ordem": 3, "transcricao_literal": "CONSIDERANDO que à Diretoria do Conselho Federal de Enfermagem compete administrá-lo, na forma do preconiza o art. 22, inciso I, da Resolução COFEN nº. 242, de 31 de agosto de 2000;", "sha256_texto": "dc964fdb368b18df9352b253571820819aeeb0f0a7e6c51d3227075ee484c0b2", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2010_N_00091_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2010_N_00091_CONSIDERANDO_002", "normativo": "BR_FED_COFEN_PORT_2010_N_00091", "tipo_dispositivo": "considerando", "localizador": "Considerando 2", "dispositivo_superior": null, "ordem": 4, "transcricao_literal": "CONSIDERANDO os termos da Portaria nº. 834, de 6 de novembro de 2009, do Ministério de Planejamento, Orçamento e Gestão, que divulga os dias de feriados nacionais e de pontos facultativos no ano de 2010;", "sha256_texto": "54601a4948cf0ebde20671faeb3842a46fb5a0837e0da79bc029e61eda9c6795", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2010_N_00091_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2010_N_00091_CONSIDERANDO_003", "normativo": "BR_FED_COFEN_PORT_2010_N_00091", "tipo_dispositivo": "considerando", "localizador": "Considerando 3", "dispositivo_superior": null, "ordem": 5, "transcricao_literal": "CONSIDERANDO a necessidade de realização de obras de instalação dos aparelhos de refrigeração e rede elétrica;", "sha256_texto": "a3108ea668a98af5c11fa48d761224d0f678b033a2dbbf46c236857f49791bce", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2010_N_00091_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
