{"identificador": "BR_FED_COFEN_PARCT_2014_N_00030_CTLN_ITEM_LISTA_005", "normativo": "BR_FED_COFEN_PARCT_2014_N_00030_CTLN", "tipo_dispositivo": "item_lista", "localizador": "Item de lista 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2014_N_00030_CTLN_PARAGRAFO_TEXTO_005", "ordem": 24, "transcricao_literal": "Como podemos observar acima, as atribuições do ENFERMEIRO no cuidado e assistência a pacientes graves e nas atividades que exigem maior complexidade técnica encontram-se muito bem definidas, no Âmbito do Sistema Cofen/Conselhos Regionais de Enfermagem, normatizadas em Lei Federal e em Decreto Federal, não havendo que se falar em conflito atribuições.", "sha256_texto": "c145de8a7c193d4c0cc41977b7e86014eafe4bcc99812c1b32311402ec415c20", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2014_N_00030_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "3"}
