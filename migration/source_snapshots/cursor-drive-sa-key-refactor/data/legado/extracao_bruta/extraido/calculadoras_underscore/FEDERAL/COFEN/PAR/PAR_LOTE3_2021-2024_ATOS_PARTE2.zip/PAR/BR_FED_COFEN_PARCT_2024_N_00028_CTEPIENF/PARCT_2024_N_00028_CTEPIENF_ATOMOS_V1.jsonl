{"identificador": "BR_FED_COFEN_PARCT_2024_N_00028_CTEPIENF_EMENTA", "normativo": "BR_FED_COFEN_PARCT_2024_N_00028_CTEPIENF", "tipo_dispositivo": "ementa", "localizador": "Ementa", "dispositivo_superior": null, "ordem": 4, "transcricao_literal": "Análise do pedido de reconsideração sobre a exigência de código autenticador do SISTEC para certificados de especialização técnica de nível médio, emitidos pelo Centro de Treinamento em Saúde de Goiás (CTS-GO), conforme manifestação protocolada no COFEN. Avaliação das resoluções pertinentes e da normativa do MEC, considerando o impacto para a instituição e seus alunos.", "sha256_texto": "c5efd5667f2e0d6f655114c241778277600d8e57fa55cac0582423b12536015a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00028_CTEPIENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
