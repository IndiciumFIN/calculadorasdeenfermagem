{"identificador": "BR_FED_CN_PL_2002_N_00005_EPIGRAFE_001", "normativo": "BR_FED_CN_PL_2002_N_00005", "tipo_dispositivo": "epigrafe", "localizador": "Epígrafe", "dispositivo_superior": null, "ordem": 1, "transcricao_literal": "PROJETO DE LEI Nº 05/2002", "sha256_texto": "e3a1c53359425cb02b9a40d691ffa4f0aedad6e0bd50586ea6c90a608d14bca0", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PL_2002_N_00005_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_CN_PL_2002_N_00005_EMENTA", "normativo": "BR_FED_CN_PL_2002_N_00005", "tipo_dispositivo": "ementa", "localizador": "Ementa", "dispositivo_superior": null, "ordem": 2, "transcricao_literal": "O PLS 05/2002 é polêmico, e no entender do sistema COFEN/CORENs, foi apresentado de forma equivocada, visto que o mesmo, se aprovado na forma como se encontra, afetará profundamente o atual modelo de saúde. Há pontos positivos e negativos, que entendemos serão expostos na tramitação do mesmo.", "sha256_texto": "764c3817b5926ea62fcfedc0786a855d4e1f85820c304f4283557f6fcff8b8e7", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PL_2002_N_00005_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_CN_PL_2002_N_00005_PARAGRAFO_TEXTO_001", "normativo": "BR_FED_CN_PL_2002_N_00005", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": null, "ordem": 3, "transcricao_literal": "Em outubro/2003 comparecemos ao gabinete do Senador Augusto Botelho que requereu vista do PL 05/2002, já que o mesmo teve parecer favorável da Senadora Relatora Íris Araújo.", "sha256_texto": "b39e27fac626dcf32a6a2b3aaa51951a6b5dae90a42d65d95b1090d4e6dccc59", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PL_2002_N_00005_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_CN_PL_2002_N_00005_PARAGRAFO_TEXTO_002", "normativo": "BR_FED_CN_PL_2002_N_00005", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": null, "ordem": 4, "transcricao_literal": "Leia abaixo integralmente o PLS 05/2002, e ao final participe, enviando sua opinião ao Senador Augusto Botelho", "sha256_texto": "66999f408c5014465cd5e9e21286e883db5778c24c39483b615ab30619526a53", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PL_2002_N_00005_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_CN_PL_2002_N_00005_EPIGRAFE_002", "normativo": "BR_FED_CN_PL_2002_N_00005", "tipo_dispositivo": "epigrafe", "localizador": "Epígrafe", "dispositivo_superior": null, "ordem": 5, "transcricao_literal": "PROJETO DE LEI DO SENADO Nº 005 , DE 2002", "sha256_texto": "dada81d273c6594dc48efd4a978bc4a6fd413557854a550593b3a0319f0fa3c2", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PL_2002_N_00005_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_CN_PL_2002_N_00005_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_CN_PL_2002_N_00005", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": null, "ordem": 6, "transcricao_literal": "Altera os arts. 2º e 23 da Lei nº 7.498, de 25 de junho de 1986, que dispõe sobre a regulamentação do exercício da enfermagem e dá outras providências, para estabelecer prazo a partir do qual não serão concedidos novos registros de atendentes, auxiliares e técnicos de enfermagem e de parteiras, assegurar aos profissionais existentes acesso diferenciado aos cursos de graduação de nível superior em enfermagem e dar outras providências.", "sha256_texto": "8bf29d45635b5f6ae7e589a43200f13a1254fe2fbaf8453453fb0224076be215", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PL_2002_N_00005_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_CN_PL_2002_N_00005_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_CN_PL_2002_N_00005", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": null, "ordem": 7, "transcricao_literal": "O Congresso Nacional decreta:", "sha256_texto": "4f8253407ae5290593531d83e6db943825385d53c9f8dc4d7e5b91ef48997018", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PL_2002_N_00005_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_CN_PL_2002_N_00005_ART_001", "normativo": "BR_FED_CN_PL_2002_N_00005", "tipo_dispositivo": "artigo", "localizador": "Art. 1º", "dispositivo_superior": null, "ordem": 8, "transcricao_literal": "Art. 1º – O art. 2º da Lei nº 7.498 de 25 de junho de 1986, passa a vigorar com a seguinte redação:", "sha256_texto": "5c146cb4b24650c85cc501d16a4c5ea60075a3080bb67d5481b80843099a05bb", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PL_2002_N_00005_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_CN_PL_2002_N_00005_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_CN_PL_2002_N_00005", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": null, "ordem": 9, "transcricao_literal": "“”Art. 2º", "sha256_texto": "96e919e947a875ad0a7e3ef05843d397706afe3b87497c7ee1e5d385414450bf", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PL_2002_N_00005_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_CN_PL_2002_N_00005_PARAGRAFO_TRANSCRITO_001", "normativo": "BR_FED_CN_PL_2002_N_00005", "tipo_dispositivo": "paragrafo_transcrito", "localizador": "Parágrafo (transcrito)", "dispositivo_superior": "BR_FED_CN_PL_2002_N_00005_ART_001", "ordem": 10, "transcricao_literal": "§ 1º A enfermagem é exercida privativamente pelo Enfermeiro, pelo Técnico de Enfermagem e pela Parteira, respeitados os respectivos graus de habilitação.", "sha256_texto": "3176d5b8f0afa745e65448c70d66599a54d1993c93801d7b9f8942b7263efb6b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PL_2002_N_00005_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_CN_PL_2002_N_00005_PARAGRAFO_TRANSCRITO_002", "normativo": "BR_FED_CN_PL_2002_N_00005", "tipo_dispositivo": "paragrafo_transcrito", "localizador": "Parágrafo (transcrito)", "dispositivo_superior": "BR_FED_CN_PL_2002_N_00005_ART_001", "ordem": 11, "transcricao_literal": "§ 2º Os auxiliares e técnicos de enfermagem e as parteiras em exercício na data de entrada em vigor desta lei terão acesso diferenciado aos cursos de graduação e enfermagem.", "sha256_texto": "9f04b1695ed2183f468a7c7fc10d37d8aa4d491febe1689f57f65c5a88b1d0f3", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PL_2002_N_00005_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_CN_PL_2002_N_00005_PARAGRAFO_TRANSCRITO_003", "normativo": "BR_FED_CN_PL_2002_N_00005", "tipo_dispositivo": "paragrafo_transcrito", "localizador": "Parágrafo (transcrito)", "dispositivo_superior": "BR_FED_CN_PL_2002_N_00005_ART_001", "ordem": 12, "transcricao_literal": "§ 3º A partir de 31 de dezembro de 2012, não mais será admitida a inscrição de auxiliares e técnicos de enfermagem e de parteiras, assegurando-se àqueles inscritos nos conselhos regionais de enfermagem até essa data o exercício das atividades de que tratam os artigos 12 e 13.””", "sha256_texto": "39f4177aed30d1e9f74086250a220586cb0ec2c452963e8364b416e9aa65e4da", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PL_2002_N_00005_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_CN_PL_2002_N_00005_ART_002", "normativo": "BR_FED_CN_PL_2002_N_00005", "tipo_dispositivo": "artigo", "localizador": "Art. 2º", "dispositivo_superior": null, "ordem": 13, "transcricao_literal": "Art. 2º – O art. 23 da Lei nº7.498, de 25 de junho de 1986, passa a vigorar com a seguinte redação:", "sha256_texto": "7c793352ad2c6534e863af38feff6bb54fba2538e63b9179cc5b1b4d790c87ed", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PL_2002_N_00005_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_CN_PL_2002_N_00005_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_CN_PL_2002_N_00005", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": null, "ordem": 14, "transcricao_literal": "“”Art.23", "sha256_texto": "4adff1b2ac2d4c4bc347e945800634a28997b27b1ed1ee11d6c5b7006767e928", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PL_2002_N_00005_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_CN_PL_2002_N_00005_PARAGRAFO_TRANSCRITO_004", "normativo": "BR_FED_CN_PL_2002_N_00005", "tipo_dispositivo": "paragrafo_transcrito", "localizador": "Parágrafo (transcrito)", "dispositivo_superior": "BR_FED_CN_PL_2002_N_00005_ART_002", "ordem": 15, "transcricao_literal": "§ 1º É assegurado aos atendentes de enfermagem, admitidos antes da vigência desta lei, o exercício das atividades elementares da enfermagem, observado o disposto no art. 15. (NR)", "sha256_texto": "fc0b8f588028a32b766779094e10e7dadbb803dc3b3203e46a7be827120e8c77", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PL_2002_N_00005_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_CN_PL_2002_N_00005_ART_002_PAR_02", "normativo": "BR_FED_CN_PL_2002_N_00005", "tipo_dispositivo": "paragrafo", "localizador": "§ 2º", "dispositivo_superior": "BR_FED_CN_PL_2002_N_00005_ART_002", "ordem": 16, "transcricao_literal": "§ 2º A partir de 31 de dezembro de 2012, não mais será concedida a autorização de que trata o caput deste artigo.””", "sha256_texto": "7f2708c08177411727bed543360b7d9fb752de3908d99cef8e5b417b389b5141", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PL_2002_N_00005_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_CN_PL_2002_N_00005_ART_003", "normativo": "BR_FED_CN_PL_2002_N_00005", "tipo_dispositivo": "artigo", "localizador": "Art. 3º", "dispositivo_superior": null, "ordem": 17, "transcricao_literal": "Art. 3º – Esta lei entra em vigor na data de sua publicação.", "sha256_texto": "4180355474804afcb35ca6efc9009a1e20726e246d957b262774f74018fc7190", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PL_2002_N_00005_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_CN_PL_2002_N_00005_SECAO_001", "normativo": "BR_FED_CN_PL_2002_N_00005", "tipo_dispositivo": "secao", "localizador": "JUSTIFICAÇÃO", "dispositivo_superior": null, "ordem": 18, "transcricao_literal": "JUSTIFICAÇÃO", "sha256_texto": "9524cf5b79c280aab7d146b31a07de9e2272789e3a3783765b683da8ce400eb3", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PL_2002_N_00005_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_CN_PL_2002_N_00005_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_CN_PL_2002_N_00005", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_CN_PL_2002_N_00005_SECAO_001", "ordem": 19, "transcricao_literal": "É inquestionável que se quisermos ver empreendida um profunda mudança na estrutura do atendimento público de saúde no Brasil nosso foco de atenção deve centrar-se na qualificação dos profissionais de enfermagem, pois eles formam a base de todo sistema.", "sha256_texto": "bdbb884ceceadf3f5e63e0751835a3edafaff5c7b57cdc296668257a5bed12c0", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PL_2002_N_00005_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_CN_PL_2002_N_00005_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_CN_PL_2002_N_00005", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_CN_PL_2002_N_00005_SECAO_001", "ordem": 20, "transcricao_literal": "Ademais há que se reconhecer que não basta que nos preocupemos com a formação dos futuros profissionais. Nossa realidade demonstra ser impossível ignorarmos a importância de assegurar a qualificação do trabalhador já atuante e que carece da devida escolarização.", "sha256_texto": "57f295adef511289f50ad1432416904aa7b4efbc0c628339817a955f2d080f9b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PL_2002_N_00005_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_CN_PL_2002_N_00005_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_CN_PL_2002_N_00005", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_CN_PL_2002_N_00005_SECAO_001", "ordem": 21, "transcricao_literal": "Segundo estimativas do Ministério da Saúde, temos hoje no mercado de trabalho, sem qualificação técnica adequada às funções que desempenham, um contingente de 225 mil trabalhadores em todo o território nacional.", "sha256_texto": "7505d60e810d0e9d4fb9635ab4995d67fafb2c9303843e563dafd15c3e8e15b1", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PL_2002_N_00005_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_CN_PL_2002_N_00005_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_CN_PL_2002_N_00005", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_CN_PL_2002_N_00005_SECAO_001", "ordem": 22, "transcricao_literal": "Depreende-se dos dados disponíveis no site do referido Ministério que um expressivo número de profissionais seriam beneficiados com a entrada em vigor da lei ora proposta. Temos em torno de 12 mil enfermeiros que ministram cursos de Qualificação Profissional de nível técnico de Auxiliar de Enfermagem e ainda não dispõem da titulação em nível superior.", "sha256_texto": "b9644baa982a791862b29776581cc3cea7a39c312d096df84138753c4c9bfe8c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PL_2002_N_00005_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_CN_PL_2002_N_00005_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_CN_PL_2002_N_00005", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_CN_PL_2002_N_00005_SECAO_001", "ordem": 23, "transcricao_literal": "A experiência positiva de várias unidades da Federação- seguindo o disposto no Art. 87 da Lei de Diretrizes e Bases da Educação Nacional – com os programas de capacitação para todos seus professores primários, me encoraja a propor tratamento similar para os profissionais do setor de enfermagem.", "sha256_texto": "37ac5e14c6b55039df2d3e00b4e87c70aa971dada6d82da37f9aa32d93be6a45", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PL_2002_N_00005_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_CN_PL_2002_N_00005_PARAGRAFO_TEXTO_012", "normativo": "BR_FED_CN_PL_2002_N_00005", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_CN_PL_2002_N_00005_SECAO_001", "ordem": 24, "transcricao_literal": "Reitero que auxiliares e técnicos de enfermagem constituem, em nosso meio, o esteio dos serviços de saúde e de sua qualificação depende, em grande parte, a melhoria desses serviços.", "sha256_texto": "2bf2d70bb03da4d03ba96ad4683571f44204e9220bdfeb928268c41f1a3721c1", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PL_2002_N_00005_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
