{"identificador": "BR_FED_COFEN_PARCT_2017_N_00004_CTAS_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARCT_2017_N_00004_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2017_N_00004_CTAS_SECAO_003", "ordem": 15, "transcricao_literal": "A Resolução COFEN n° 358/2009 em seus artigos 40 e 5° estabelecem que ao Enfermeiro compete privativamente a prescrição da assistência de Enfermagem, incumbe a liderança na execução e avaliação do Processo de Enfermagem, de modo a alcançar os resultados de enfermagem esperados, delegando ao Auxiliar e Técnico sua execução, sob sua supervisão e orientação.", "sha256_texto": "dec7b86f23af836cc7d50d4a4540c613a5dd4a0d9d9d4499af953cc0428d15dd", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2017_N_00004_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "EQUIVALENTE_OCR", "similaridade": 99.1, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
