{"identificador": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_SECAO_001", "ordem": 7, "transcricao_literal": "Trata-se o presente da solicitação de Registro de Título de Especialização em Constelação Familiar Hellinger da Enfermeira Eleine Aparecida Penha Martins, em que se apresenta o questionamento do Conselho Regional de Enfermagem do Paraná – Coren-PR: “É possível fazer o registro desta especialização em Constelação Familiar Hellinger”?", "sha256_texto": "5461a3f61c807ca2c46156fe5ba250edb0c717fddedf876525f491f03d6c9172", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00023_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_SECAO_001", "ordem": 8, "transcricao_literal": "Apresenta a requerente o certificado e o histórico escolar do referido curso, emitidos pela Faculdade Innovare, instituição de ensino localizada no estado de São Paulo/SP. Tem-se nos autos que o curso em tela está devidamente cadastrado junto ao Cadastro Nacional de Cursos e Instituições de Educação Superior – Cadastro e-MEC.", "sha256_texto": "67a04112720d585fc7b77d2c9da3efd1b8fc2ff8beafd4c8cc51ba62ec48709b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00023_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_SECAO_001", "ordem": 9, "transcricao_literal": "Diante do requerimento, manifestou-se a chefe da Divisão de Inscrição, Registro e Cadastro do Cofen – DIRC/Cofen, sugerindo o encaminhamento para análise da Câmara Técnica de Educação e Pesquisa – CTEP/Cofen com vistas a emissão de parecer.", "sha256_texto": "244f7975a15d0060ebd8516bbd27d6982f8b12f803c53f19026b5592f6b8978d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00023_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_SECAO_001", "ordem": 10, "transcricao_literal": "Instada esta CTEP/Cofen a se manifestar sobre a matéria, passa-se a análise.", "sha256_texto": "dc02ee12f9bd61bd6cdcc78263b67e6571eaef073da565cc43b09cb665b1b1e9", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00023_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_SECAO_002", "normativo": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP", "tipo_dispositivo": "secao", "localizador": "II. FUNDAMENTAÇÃO", "dispositivo_superior": null, "ordem": 11, "transcricao_literal": "II. FUNDAMENTAÇÃO", "sha256_texto": "685155de3de3ed3f2f8f8b81dbe74f0335422a2abbc215c5604d7e9096b7c5c5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00023_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_SECAO_002", "ordem": 12, "transcricao_literal": "Recebeu esta Câmara Técnica, para análise e manifestação, os documentos em que a Enfermeira Eleine Aparecida Penha Martins, solicita o registro do Curso pós-graduação lato sensu em “Constelação Familiar Hellinger”. Com vistas a fundamentar sua solicitação, a requerente apresentou certificado e o histórico escolar do mencionado curso.", "sha256_texto": "236619d3b0980736893225155d0cece041ce0a617c45835d55e67f3e1c507ca1", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00023_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_SECAO_002", "ordem": 13, "transcricao_literal": "Para fundamentar o presente parecer, a CTEP/Cofen baseou-se na Resolução Cofen nº 581/2018 e na literatura afeta e pertinente ao objeto em análise.", "sha256_texto": "e0a02fdff488657d28c41b522fe7e8fd3e219116135eab35149eeac94a23f98c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00023_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_SECAO_002", "ordem": 14, "transcricao_literal": "Destaque-se que, embora a Resolução Cofen retro mencionada não liste no seu rol a especialidade “Constelação Familiar Hellinger”, esta apresenta estreita relação com as demais práticas integrativas já consolidadas e desenvolvidas por profissionais de Enfermagem.", "sha256_texto": "86859e9c10f64f0acd0e59ac379fb4a72a40341047aedd1d1dd95f48e66bc6f7", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00023_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_SECAO_002", "ordem": 15, "transcricao_literal": "As Práticas Integrativas e Complementares em Saúde – PICS, onde se situa a Constelação Familiar, são tratamentos baseados em conhecimentos tradicionais, voltados para prevenir várias doenças tais como hipertensão arterial sistêmica e depressão.", "sha256_texto": "8e358b773a66ea5b676ecb0b5618abe787cbe3229c416327edf8ec6841cc7e94", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00023_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_SECAO_002", "ordem": 16, "transcricao_literal": "No entendimento de que na composição dos processos de cuidados que visam a dimensão holística do ser humano, o conhecimento adquirido na especialização em Constelação Familiar Hellinger é matéria necessária a ser discutida e valorizada na Enfermagem, como também é uma área de conhecimento afeta aos processos relacionais de cuidado, que permeiam a formação do enfermeiro, sobretudo em áreas de estudo da Enfermagem.", "sha256_texto": "63ecfb604fa86562ec3c3167779093ae0b18403374905826600d907aef9d462b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00023_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_PARAGRAFO_TEXTO_012", "normativo": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_SECAO_002", "ordem": 17, "transcricao_literal": "No sentido dos normativos externos ao Sistema, tem-se a Portaria n° 702, de 21 de março de 2018, do Ministério da Saúde, que altera a Portaria de Consolidação nº 2/GM/MS, de 28 de setembro de 2017, para incluir novas práticas na Política Nacional de Práticas Integrativas e Complementares – PNPIC, dentre as quais a Constelação Familiar, que assim é definida:", "sha256_texto": "6257217b660f4af13fcd5dc344522082b2848b989ad3bda9c9223909410c790e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00023_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_PARAGRAFO_TEXTO_013", "normativo": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 7", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_SECAO_002", "ordem": 18, "transcricao_literal": "(…) A constelação familiar é uma técnica de representação espacial das relações familiares que permite identificar bloqueios emocionais de gerações ou membros da família. Desenvolvida nos anos 80 pelo psicoterapeuta alemão Bert Hellinger, que defende a existência de um inconsciente familiar – além do inconsciente individual e do inconsciente coletivo – atuando em cada membro de uma família. Hellinger denomina “ordens do amor” às leis básicas do relacionamento humano – a do pertencimento ou vínculo, a da ordem de chegada ou hierarquia, e a do equilíbrio – que atuam ao mesmo tempo, onde houver pessoas convivendo (…).", "sha256_texto": "ce013fa09ac1b214d8b1a33741e6a3da7029fe37cf8d10d0034db59647b1d04d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00023_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_PARAGRAFO_TEXTO_014", "normativo": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 8", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_SECAO_002", "ordem": 19, "transcricao_literal": "Sendo estas as considerações necessárias sobre o questionamento suscitado pelo Conselho Regional de Enfermagem do Paraná – Coren-PR, passamos à conclusão.", "sha256_texto": "3e016a438de56d0a44270efc317fbccf1c47bc84c8ab3cabeab979d1329b1ca8", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00023_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_SECAO_003", "normativo": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP", "tipo_dispositivo": "secao", "localizador": "III. CONCLUSÃO", "dispositivo_superior": null, "ordem": 20, "transcricao_literal": "III. CONCLUSÃO", "sha256_texto": "8c7e1360ea68d3681e2ee822aa41aba75cc7f69f87e83a200f76660890666064", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00023_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_PARAGRAFO_TEXTO_015", "normativo": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_SECAO_003", "ordem": 21, "transcricao_literal": "Considerando a análise dos documentos que constituem o processo, em tela, que contêm o requerimento efetuado pelo Coren – PR, a partir de manifestação da Enfermeira Eleine Aparecida Penha Martins, que solicita registro de título de Especialização em “Constelação Familiar de Hellinger”;", "sha256_texto": "69d39f58062e34e49f66e12f6987167f992f390092426932f5af6fb3db66dd30", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00023_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_PARAGRAFO_TEXTO_016", "normativo": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_SECAO_003", "ordem": 22, "transcricao_literal": "Considerando a pertinência da área de conhecimento para a solicitação do registro para a Enfermagem, conforme fundamentado na análise;", "sha256_texto": "25b968de9fc34bdee14e2cf716aa75f3513e628a6b487c060e72b6ff1814ee03", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00023_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_PARAGRAFO_TEXTO_017", "normativo": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_SECAO_003", "ordem": 23, "transcricao_literal": "Considerando o fato de que a dúvida para o registro da especialidade junto ao DIRC/Cofen se deu pelo motivo desta não constar no rol da Resolução Cofen nº 581/2018, questão tida por sanada em razão de que pertencente ao grupo das Práticas Integrativas e Complementares, já reconhecidas, inclusive pelo Ministério da Saúde;", "sha256_texto": "c602e0de886bcfefb760096390d07a8daf099a4bad5c2e63c52baf6ee67762bb", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00023_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_PARAGRAFO_TEXTO_018", "normativo": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_SECAO_003", "ordem": 24, "transcricao_literal": "Considerando ser esta Câmara Técnica de Educação e Pesquisa, órgão “permanente de natureza consultiva, propositiva e avaliativa sobre matéria relativa ao exercício da Enfermagem”, segundo Art. 1º do Regimento Interno do Cofen, no entanto, sem competência deliberativa.", "sha256_texto": "2285ec081241237d465d99bcaa8f87a28e90cc7ad5c2ed982daa49c91f8ed05b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00023_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_PARAGRAFO_TEXTO_019", "normativo": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_SECAO_003", "ordem": 25, "transcricao_literal": "Assim concluímos:", "sha256_texto": "750fe8be3056181e1f775ae17b410a9794fe52775816c7e9a1e080ee79a60998", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00023_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_PARAGRAFO_TEXTO_020", "normativo": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00023_CTEP_SECAO_003", "ordem": 26, "transcricao_literal": "Sugere esta Câmara Técnica ao Egrégio Plenário do Conselho Federal de Enfermagem-Cofen, que neste caso, dê apreciação favorável ao Registro de Título de Pós-graduação lato sensu em “Constelação Familiar Hellinger” da Enfermeira Eleine Aparecida Penha Martins, cujos documentos foram emitidos pela Faculdade Innovare, devendo esta ser registrada na Área I, item 30) Enfermagem em Práticas Integrativas e Complementares.", "sha256_texto": "d7b5a8e4e1ac3064eedd9acc045aa6d6295582271212029dd74821f7dbbf1607", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00023_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
