{"identificador": "BR_FED_COFEN_PARCT_2018_N_00032_CTLN_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARCT_2018_N_00032_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 8", "dispositivo_superior": "BR_FED_COFEN_PARCT_2018_N_00032_CTLN_SECAO_003", "ordem": 17, "transcricao_literal": "Recentemente também fora exarado o parecer CTLN/COFEN nº 22/2018, tratando do botão anestésico, caracteriza e endossa que:", "sha256_texto": "0ddf10c26450b0260be2fa9a79cb158a0a7266dc794c735f4532dc5bf3e2c978", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2018_N_00032_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
