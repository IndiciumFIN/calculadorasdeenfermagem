{"identificador": "BR_FED_COFEN_PARCT_2021_N_00053_CTLN_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_PARCT_2021_N_00053_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00053_CTLN_SECAO_003", "ordem": 25, "transcricao_literal": "Direito: Art. 22 Recusar-se a executar atividades que na?o sejam de sua compete?ncia te?cnica, cienti?fica, e?tica e legal ou que na?o oferec?am seguranc?a ao profissional, a? pessoa, a? fami?lia e a? coletividade.", "sha256_texto": "8f4426e5a9a8e0af218538e70993268d442769b2a064bf92a2dbe919fe90ad6b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00053_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00053_CTLN_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_PARCT_2021_N_00053_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00053_CTLN_SECAO_003", "ordem": 26, "transcricao_literal": "Deveres: Art. 45 Prestar assistência de Enfermagem livre de danos decorrentes de imperícia, negligência ou imprudência. E, Art. 59 Somente aceitar encargos ou atribuições quando se julgar técnica, cientifica e legalmente apto para o desempenho seguro para si e para outrem.", "sha256_texto": "507f59b4ba3b718150fbf7f15d30ce84ae17db20e0d902fbe0b1c60eefba1436", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00053_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00053_CTLN_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_COFEN_PARCT_2021_N_00053_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00053_CTLN_SECAO_003", "ordem": 27, "transcricao_literal": "Proibições: Art. 78 Administrar medicamentos sem conhecer indicação, ac?a?o da droga, via de administração e potenciais riscos, respeitados os graus de formação do profissional. E Art. 79 Prescrever medicamentos que não estejam estabelecidos em programas de saúde pública e/ou em rotina aprovada em instituição de saúde, exceto em situações de emergência.", "sha256_texto": "8996cc1780dc8cb4acab10b1ac134d2d1c713fab836c5273155eccb5d51457bf", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00053_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00053_CTLN_ITEM_LISTA_009", "normativo": "BR_FED_COFEN_PARCT_2021_N_00053_CTLN", "tipo_dispositivo": "item_lista", "localizador": "Item de lista 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00053_CTLN_PARAGRAFO_TEXTO_009", "ordem": 28, "transcricao_literal": "Considerando que os procedimentos de analgesia estão inseridos na prática dos cuidados de Enfermagem, buscamos amparo em Pareceres do Cofen, para sustentar o apoio a realização da Terapia Neural pelo Profissional Enfermeiro, oportuno se faz citar os Pareceres Cofen que tratam de atividade pertinente a tal procedimento, conforme segue: Parecer Cofen nº 15/2014; Parecer de Conselheiro nº 263/2017; Parecer CTLN/Cofen nº 22/2018; Parecer CTLN/Cofen nº 32/2018", "sha256_texto": "b3e47adb689b5ecec60d7fdec172787d9454b08fa6792af839f9e861ba020cf0", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00053_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "1"}
