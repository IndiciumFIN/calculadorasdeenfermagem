{"identificador": "BR_FED_COFEN_PARCT_2016_N_00018_CTAS_PARAGRAFO_TEXTO_002", "normativo": "BR_FED_COFEN_PARCT_2016_N_00018_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2016_N_00018_CTAS_SECAO_001", "ordem": 6, "transcricao_literal": "Trata-se do PAD Cofen N° 0687/2016 composto de duas folhas encaminhado a esta Câmara Técnica de Atenção à Saúde (CTAS), pelo Dr. Gilvan Brolini, Coordenador das Câmaras Técnicas do Cofen para análise e emissão de parecer.", "sha256_texto": "2086ea1e4bc30dfd90320606eaa040d272461af0f61b755736d41e89010996b8", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2016_N_00018_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
