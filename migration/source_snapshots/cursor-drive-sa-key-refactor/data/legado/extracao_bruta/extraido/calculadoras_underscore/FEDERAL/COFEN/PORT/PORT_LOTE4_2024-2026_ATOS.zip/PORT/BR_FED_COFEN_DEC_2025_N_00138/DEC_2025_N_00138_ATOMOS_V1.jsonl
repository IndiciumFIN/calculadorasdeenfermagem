{"identificador": "BR_FED_COFEN_DEC_2025_N_00138_PREAMBULO_001", "normativo": "BR_FED_COFEN_DEC_2025_N_00138", "tipo_dispositivo": "preambulo", "localizador": "Preâmbulo", "dispositivo_superior": null, "ordem": 3, "transcricao_literal": "O CONSELHO FEDERAL DE ENFERMAGEM – COFEN, no uso das atribuições que lhe são conferidas pela Lei nº 5.905, de 12 de julho de 1973, e pelo Regimento da Autarquia, aprovado pela Resolução Cofen nº 726, de 15 de setembro de 2023;", "sha256_texto": "919c429ecbfeb6b2d11fc8a78566d32e378bd895c24fcaf671f4194d00bda9f4", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "DEC_2025_N_00138_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_DEC_2025_N_00138_CONSIDERANDO_001", "normativo": "BR_FED_COFEN_DEC_2025_N_00138", "tipo_dispositivo": "considerando", "localizador": "Considerando 1", "dispositivo_superior": null, "ordem": 4, "transcricao_literal": "CONSIDERANDO a prerrogativa estabelecida ao Cofen no art. 8º, inciso IV, da Lei nº 5.905/1973, de baixar provimentos e expedir instruções, para uniformidade de procedimento e bom funcionamento do Sistema Cofen/Conselhos Regionais de Enfermagem;", "sha256_texto": "841255981e71a8fc42c469e6aff8b0423cb57f1816a7b28cde2322f61c09600c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "DEC_2025_N_00138_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_DEC_2025_N_00138_CONSIDERANDO_002", "normativo": "BR_FED_COFEN_DEC_2025_N_00138", "tipo_dispositivo": "considerando", "localizador": "Considerando 2", "dispositivo_superior": null, "ordem": 5, "transcricao_literal": "CONSIDERANDO o disposto no art. 21, inciso XII, do Regimento Interno do Cofen, aprovado pela Resolução Cofen nº 726/2023, que autoriza o Conselho Federal de Enfermagem baixar Resoluções, Decisões e demais instrumentos legais no âmbito do Sistema Cofen/Conselhos Regionais de Enfermagem;", "sha256_texto": "155449ccac861973febb5e153bd861c597639a56de02f4dac948161449e68bf5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "DEC_2025_N_00138_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_DEC_2025_N_00138_CONSIDERANDO_003", "normativo": "BR_FED_COFEN_DEC_2025_N_00138", "tipo_dispositivo": "considerando", "localizador": "Considerando 3", "dispositivo_superior": null, "ordem": 6, "transcricao_literal": "CONSIDERANDO a Decisão Cofen nº 167, de 15 de julho de 2024, que aprova atualização do Regime do Teletrabalho e suas diretrizes, com a decorrente atualização do Manual de Teletrabalho – MAN 309;", "sha256_texto": "6dadfcbe362da53e2f2245bfbf6f55fd48a38a19607afb35f74e749cfc2a3427", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "DEC_2025_N_00138_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_DEC_2025_N_00138_CONSIDERANDO_004", "normativo": "BR_FED_COFEN_DEC_2025_N_00138", "tipo_dispositivo": "considerando", "localizador": "Considerando 4", "dispositivo_superior": null, "ordem": 7, "transcricao_literal": "CONSIDERANDO que a aprovação de programas e políticas de gestão de pessoal, incluindo a concessão de teletrabalho, é de competência da Diretoria do Cofen, conforme o disposto no art. 23, incisos IV e XIII, do Regimento Interno; e", "sha256_texto": "4542031d671907015061054446f1dca7aef01346131658dc5379feba1ce0f3c6", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "DEC_2025_N_00138_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_DEC_2025_N_00138_CONSIDERANDO_005", "normativo": "BR_FED_COFEN_DEC_2025_N_00138", "tipo_dispositivo": "considerando", "localizador": "Considerando 5", "dispositivo_superior": null, "ordem": 8, "transcricao_literal": "CONSIDERANDO a deliberação da 218ª Reunião Ordinária de Diretoria, realizada em 8 de julho de 2025, e tudo o mais que consta nos autos do Processo SEI Cofen nº 00196.003265/2025-86.", "sha256_texto": "28239d373b7f4c171a7144891b2bbcf711e4b377f58cd08628a6e246c1fa5e92", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "DEC_2025_N_00138_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
