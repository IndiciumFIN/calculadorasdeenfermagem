{"identificador": "BR_FED_COFEN_PARCT_2023_N_00013_CTLN_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARCT_2023_N_00013_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00013_CTLN_SECAO_001", "ordem": 6, "transcricao_literal": "Trata-se de solicitação do Coren-MS a esta CTLN para emissão de parecer acerca da divergência de entendimento, se é necessário ter na formação, a comprovação das 100 horas de aulas práticas supervisionadas, ou se é possível o especialista comprovar estas horas práticas obtidas em cursos de capacitação.", "sha256_texto": "6d0af065b9baa755cefaf2250481410cb8853b28406c15a27d2695b7ff10b01b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00013_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
