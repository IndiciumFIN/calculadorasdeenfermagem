{"identificador": "BR_FED_COFEN_PARCT_2023_N_00013_CTLN_ART_004", "normativo": "BR_FED_COFEN_PARCT_2023_N_00013_CTLN", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 4º (citado/transcrito)", "dispositivo_superior": null, "ordem": 14, "transcricao_literal": "Art. 4º O Enfermeiro deverá ter pós-graduação lato sensu em Estética, de acordo com a legislação estabelecida pelo MEC, e que no mínimo tenha 100 (cem) horas de aulas práticas supervisionadas.", "sha256_texto": "365082f0fce3e059a6cfb2d1a8a5c8b04c30116b4044b964db151b61fb163d8f", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00013_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Artigo citado ou transcrito de outra norma (sequência não inicia em 1 no escopo); não é articulado próprio."}
