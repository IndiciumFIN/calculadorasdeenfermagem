{"identificador": "BR_FED_COFEN_PARCONS_2017_N_00277_PARAGRAFO_TEXTO_002", "normativo": "BR_FED_COFEN_PARCONS_2017_N_00277", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2017_N_00277_SECAO_003", "ordem": 8, "transcricao_literal": "Designada através da Portaria Cofen N° 1249/2017 de 20 de setembro de 2017, para emissão de parecer sob a ementa “OE 16. SOLICITAÇÃO DE ORIENTAÇÃO SOBRE INSERÇÃO E IMPLANTE SUBDÉRMICO”, após minuciosa análise das informações contidas no PAD COFEN N° 0486/2017, e após levar o assunto à discussão na Comissão de Saúde da Mulher do Cofen, teço considerações e ao final emito parecer.", "sha256_texto": "79316d9f5c4cf9197b835c0005cc0b8081cbb93958f4ca758e79fe66a23d5c7d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2017_N_00277_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "EQUIVALENTE_OCR", "similaridade": 99.5, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
