{"identificador": "BR_FED_COFEN_PARCONS_2017_N_00277_PARAGRAFO_TEXTO_016", "normativo": "BR_FED_COFEN_PARCONS_2017_N_00277", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2017_N_00277_SECAO_006", "ordem": 30, "transcricao_literal": "Diante do exposto, considerando os fatos discutidos a partir da análise realizada no constante do PAD do Cofen n° 486/2017, entendemos que o Enfermeiro possui competências técnicas, e poderá adquirir habilidades, se for capacitado, para a inserção e remoção de implantes subdérmico, dentre eles o Implanon®.", "sha256_texto": "2bb25e56ce624cf5f6a7c6c19a62e1dbcab36f940b91a42a8d7d6372e1b67e7d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2017_N_00277_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "EQUIVALENTE_OCR", "similaridade": 99.7, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
