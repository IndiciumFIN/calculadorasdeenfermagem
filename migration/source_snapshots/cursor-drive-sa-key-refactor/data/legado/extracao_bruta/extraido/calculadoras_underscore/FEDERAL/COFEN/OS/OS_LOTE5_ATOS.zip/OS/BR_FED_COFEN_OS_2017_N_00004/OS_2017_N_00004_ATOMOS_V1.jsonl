{"identificador": "BR_FED_COFEN_OS_2017_N_00004_CONSIDERANDO_002", "normativo": "BR_FED_COFEN_OS_2017_N_00004", "tipo_dispositivo": "considerando", "localizador": "Considerando 2", "dispositivo_superior": null, "ordem": 4, "transcricao_literal": "CONSIDERANDO os termos do Ofício n° 1925/2014-TCU/SELOG, datado de 03/09/2014, encaminhado ao Cofen, e que considerou irregular a prática de assinaturas de contratos, acordos e afins sem a prévia emissão de nota de empenho;", "sha256_texto": "47b35459b4d2ed35aecc23b21f41deee92ed340146d4dcf0f2b6b89626eefd6c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "OS_2017_N_00004_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "EQUIVALENTE_OCR", "similaridade": 99.5, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_OS_2017_N_00004_CONSIDERANDO_003", "normativo": "BR_FED_COFEN_OS_2017_N_00004", "tipo_dispositivo": "considerando", "localizador": "Considerando 3", "dispositivo_superior": null, "ordem": 5, "transcricao_literal": "CONSIDERANDO os termos do Memorando n° 20/DLC-PROGER/2017-P, de 6 de setembro de 2017, que recomenda a normatização interna dos trâmites processuais relativamente ao que dispõe o art. 60 da Lei n° 4.320, de 17 de março de 1964, objetivando mitigar riscos e promover a adequação de procedimentos relativos a contratos, acordos e afins;", "sha256_texto": "d8738232acad3f524f31cd539b3a6d6a2843aa475e4ca5a4d14501804a4801b7", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "OS_2017_N_00004_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "EQUIVALENTE_OCR", "similaridade": 99.4, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
