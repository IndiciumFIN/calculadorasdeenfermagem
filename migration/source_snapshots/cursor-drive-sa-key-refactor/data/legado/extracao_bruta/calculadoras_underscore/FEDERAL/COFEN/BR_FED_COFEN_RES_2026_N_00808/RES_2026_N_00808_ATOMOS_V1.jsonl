{"identificador": "BR_FED_COFEN_RES_2026_N_00808_EMENTA", "normativo": "BR_FED_COFEN_RES_2026_N_00808", "tipo_dispositivo": "ementa", "localizador": "Ementa", "dispositivo_superior": null, "ordem": 1, "transcricao_literal": "Altera o Plano de Cargos, Carreira de Salários do Cofen, aprovado pela Resolução Cofen nº 750/2024.", "sha256_texto": "0382b10beebb4de8e82eab0612116c7d41ea7640db55d846a9168998970b25ab", "fonte_literal": "DOU", "arquivo_fonte": "RES_0808_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00808_PREAMBULO", "normativo": "BR_FED_COFEN_RES_2026_N_00808", "tipo_dispositivo": "preambulo", "localizador": "Preâmbulo", "dispositivo_superior": null, "ordem": 2, "transcricao_literal": "O CONSELHO FEDERAL DE ENFERMAGEM - COFEN, no uso das atribuições que lhe são conferidas pela Lei nº 5.905, de 12 de julho de 1973, e pelo Regimento da Autarquia, aprovado pela Resolução Cofen nº 726, de 15 de setembro de 2023, ou outra que sobrevir, e", "sha256_texto": "b01fbf5e9d95a371728bbc76db723e101a6bb6dc8d7f8fa31bf1a6351edb4397", "fonte_literal": "DOU", "arquivo_fonte": "RES_0808_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00808_CONS_001", "normativo": "BR_FED_COFEN_RES_2026_N_00808", "tipo_dispositivo": "considerando", "localizador": "Considerando 1", "dispositivo_superior": null, "ordem": 3, "transcricao_literal": "CONSIDERANDO a prerrogativa estabelecida ao Cofen no art. 8º, inciso IV, da Lei nº 5.905/1973, de baixar provimentos e expedir instruções, para uniformidade de procedimento e bom funcionamento dos Conselhos Regionais;", "sha256_texto": "6a09be5f35e3ef6d80c0a64da5aad602726c7c149792bb91af4768e6b7fb1480", "fonte_literal": "DOU", "arquivo_fonte": "RES_0808_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00808_CONS_002", "normativo": "BR_FED_COFEN_RES_2026_N_00808", "tipo_dispositivo": "considerando", "localizador": "Considerando 2", "dispositivo_superior": null, "ordem": 4, "transcricao_literal": "CONSIDERANDO o disposto no art. 21, inciso XII, do Regimento Interno do Cofen, aprovado pela Resolução Cofen nº 726/2023, que autoriza o Conselho Federal de Enfermagem baixar Resoluções, Decisões e demais instrumentos legais no âmbito do Sistema Cofen/Conselhos Regionais de Enfermagem;", "sha256_texto": "155449ccac861973febb5e153bd861c597639a56de02f4dac948161449e68bf5", "fonte_literal": "DOU", "arquivo_fonte": "RES_0808_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00808_CONS_003", "normativo": "BR_FED_COFEN_RES_2026_N_00808", "tipo_dispositivo": "considerando", "localizador": "Considerando 3", "dispositivo_superior": null, "ordem": 5, "transcricao_literal": "CONSIDERANDO a necessidade de atualização das atribuições dos cargos de Enfermeiro e Enfermeiro Fiscal, constantes no Plano de Cargos e Salários do Conselho Federal de Enfermagem - Cofen;", "sha256_texto": "56badb887e0dd26bd57aa85c768aec28d04331702212e5f4125040161892eb1e", "fonte_literal": "DOU", "arquivo_fonte": "RES_0808_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00808_CONS_004", "normativo": "BR_FED_COFEN_RES_2026_N_00808", "tipo_dispositivo": "considerando", "localizador": "Considerando 4", "dispositivo_superior": null, "ordem": 6, "transcricao_literal": "CONSIDERANDO a decisão do Cofen em sua 587ª Reunião Ordinária de Plenário, realizada no dia 26 de março de 2026, e tudo o mais que consta no Processo SEI Cofen nº 00196.001566/2026-56; resolve:", "sha256_texto": "71063175419b457cda38682b7c8398272a26c1f9928202486e3d4937ada5151e", "fonte_literal": "DOU", "arquivo_fonte": "RES_0808_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00808_ART_001", "normativo": "BR_FED_COFEN_RES_2026_N_00808", "tipo_dispositivo": "artigo", "localizador": "Art. 1º", "dispositivo_superior": null, "ordem": 7, "transcricao_literal": "Art. 1º Alterar o Plano de Cargos, Carreira de Salários do Cofen, aprovado pela Resolução Cofen nº 750/2024 (publicada no Diário Oficial da União nº 89, seção 1, de 9 de maio de 2024), para atualizar as atribuições dos Cargos de Enfermeiro e Enfermeiro Fiscal, que passa a vigorar nos termos do Plano de Cargos da presente Resolução.", "sha256_texto": "6e0e257642c7e2f6cea399cbf0d83ba2d488007366a2de2ec30ae6da14c3cf0e", "fonte_literal": "DOU", "arquivo_fonte": "RES_0808_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00808_ART_002", "normativo": "BR_FED_COFEN_RES_2026_N_00808", "tipo_dispositivo": "artigo", "localizador": "Art. 2º", "dispositivo_superior": null, "ordem": 8, "transcricao_literal": "Art. 2º Esta Resolução entra em vigor na data de sua publicação no Diário Oficial da União.", "sha256_texto": "0a84b1eff170005446bcc79690e8fda27b903bf6da0c5f791b09689ffcaab885", "fonte_literal": "DOU", "arquivo_fonte": "RES_0808_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
