{"identificador": "BR_FED_COFEN_RES_2026_N_00807_EMENTA", "normativo": "BR_FED_COFEN_RES_2026_N_00807", "tipo_dispositivo": "ementa", "localizador": "Ementa", "dispositivo_superior": null, "ordem": 1, "transcricao_literal": "Aprova o Manual de Redistribuição de Cargos Efetivos no âmbito do Sistema Conselho Federal de Enfermagem e Conselhos Regionais de Enfermagem.", "sha256_texto": "d45f0db35ec09179943ba925be57b79a8f610dc682fcb7289bd331fed7f0b152", "fonte_literal": "DOU", "arquivo_fonte": "RES_0807_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00807_PREAMBULO", "normativo": "BR_FED_COFEN_RES_2026_N_00807", "tipo_dispositivo": "preambulo", "localizador": "Preâmbulo", "dispositivo_superior": null, "ordem": 2, "transcricao_literal": "O CONSELHO FEDERAL DE ENFERMAGEM - Cofen, no uso das atribuições que lhe são conferidas pela Lei nº 5.905, de 12 de julho de 1973, Resolução Cofen nº 726, de 15 de setembro de 2023, que aprova o Regimento Interno do Cofen e", "sha256_texto": "91ae2a6167f7c0c7862001aa16f0c13bc1c0376e9250790b7a01fd42b57db5f7", "fonte_literal": "DOU", "arquivo_fonte": "RES_0807_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00807_CONS_001", "normativo": "BR_FED_COFEN_RES_2026_N_00807", "tipo_dispositivo": "considerando", "localizador": "Considerando 1", "dispositivo_superior": null, "ordem": 3, "transcricao_literal": "CONSIDERANDO a competência do Cofen descrita no art. 8º, inciso IV, da Lei n° 5.905, de 12 de julho de 1973, para baixar provimentos e expedir instruções, para uniformidade de procedimento, e no art. 22, XXVIII, do Regimento Interno, para normatizar, orientar e supervisionar administrativamente o Sistema Cofen/Conselhos Regionais de Enfermagem;", "sha256_texto": "6c5ec7e765e778db5b6af67b9586a98617d9d1e2edc8bdb4ee88b34ba7e3824c", "fonte_literal": "DOU", "arquivo_fonte": "RES_0807_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00807_CONS_002", "normativo": "BR_FED_COFEN_RES_2026_N_00807", "tipo_dispositivo": "considerando", "localizador": "Considerando 2", "dispositivo_superior": null, "ordem": 4, "transcricao_literal": "CONSIDERANDO os princípios constitucionais da legalidade, impessoalidade, moralidade, publicidade e eficiência destinados à administração pública, insertos no art. 37 da Constituição Federal;", "sha256_texto": "4107616de9283dd9cabcc9547815224350f69b66b0d08ce056965c28b6396a54", "fonte_literal": "DOU", "arquivo_fonte": "RES_0807_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00807_CONS_003", "normativo": "BR_FED_COFEN_RES_2026_N_00807", "tipo_dispositivo": "considerando", "localizador": "Considerando 3", "dispositivo_superior": null, "ordem": 5, "transcricao_literal": "CONSIDERANDO a necessidade de padronizar procedimentos relativos à redistribuição de cargos efetivos ocupados por empregados públicos celetistas e, quando couber, das correspondentes vagas no âmbito do Sistema Cofen/Conselhos Regionais de Enfermagem, de forma a assegurar racionalidade administrativa, transparência e interesse público;", "sha256_texto": "74b1f4f568a226f1307faa35d6593e929cc8de8a3f8e2990d2ea4ca81cc088cb", "fonte_literal": "DOU", "arquivo_fonte": "RES_0807_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00807_CONS_004", "normativo": "BR_FED_COFEN_RES_2026_N_00807", "tipo_dispositivo": "considerando", "localizador": "Considerando 4", "dispositivo_superior": null, "ordem": 6, "transcricao_literal": "CONSIDERANDO a decisão do Cofen em sua 587ª Reunião Ordinária de Plenário, realizada no período de 23 a 27 de março de 2026, e tudo o mais que consta no Processo SEI nº 00196.000483/2026-40, resolve:", "sha256_texto": "598c7dab94fed07bc47a97b8d8d9ae8bd3e9bca550858d3ce51102e0336ee925", "fonte_literal": "DOU", "arquivo_fonte": "RES_0807_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00807_ART_001", "normativo": "BR_FED_COFEN_RES_2026_N_00807", "tipo_dispositivo": "artigo", "localizador": "Art. 1º", "dispositivo_superior": null, "ordem": 7, "transcricao_literal": "Art. 1º Aprovar o Manual de Redistribuição de Empregados Públicos e de Cargos Efetivos no âmbito do Sistema Conselho Federal de Enfermagem e Conselhos Regionais de Enfermagem, na forma do Anexo Único desta Resolução.", "sha256_texto": "9353583d0c6e14f742281ebc37857aa612c9e5a58283d08e1186528fc70bbd03", "fonte_literal": "DOU", "arquivo_fonte": "RES_0807_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00807_ART_002", "normativo": "BR_FED_COFEN_RES_2026_N_00807", "tipo_dispositivo": "artigo", "localizador": "Art. 2º", "dispositivo_superior": null, "ordem": 8, "transcricao_literal": "Art. 2º O Manual aprovado por esta Resolução estabelece orientações, critérios e procedimentos administrativos para a redistribuição de empregados públicos, e dos cargos efetivos por eles ocupados, bem como das correspondentes vagas, entre o Conselho Federal de Enfermagem e os Conselhos Regionais de Enfermagem, e entre estes últimos.", "sha256_texto": "8a2a6a08827aadcf7de455d40d5401fcf74ff75caec69c8831c26050c69c7a6a", "fonte_literal": "DOU", "arquivo_fonte": "RES_0807_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00807_ART_003", "normativo": "BR_FED_COFEN_RES_2026_N_00807", "tipo_dispositivo": "artigo", "localizador": "Art. 3º", "dispositivo_superior": null, "ordem": 9, "transcricao_literal": "Art. 3º O Manual e seus Anexos possuem natureza procedimental e instrumental, não criando direito subjetivo à redistribuição, a qual permanece condicionada ao interesse público, à análise técnica e à decisão da autoridade competente, mediante anuência expressa do empregado público ocupante do cargo e vedado qualquer prejuízo contratual direto ou indireto.", "sha256_texto": "1183a38cdf41d959227bd398423659a0e07e59333b046279db5be99579a868a8", "fonte_literal": "DOU", "arquivo_fonte": "RES_0807_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00807_ART_004", "normativo": "BR_FED_COFEN_RES_2026_N_00807", "tipo_dispositivo": "artigo", "localizador": "Art. 4º", "dispositivo_superior": null, "ordem": 10, "transcricao_literal": "Art. 4º A redistribuição de empregados públicos e dos cargos/funções por eles ocupados deverá observar, obrigatoriamente:", "sha256_texto": "62316ca7e9ae2793ee2c6d2a1456f9ef06ca40bb1b0790620aad575db4abedfa", "fonte_literal": "DOU", "arquivo_fonte": "RES_0807_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00807_ART_004_INC_I", "normativo": "BR_FED_COFEN_RES_2026_N_00807", "tipo_dispositivo": "inciso", "localizador": "Inciso I", "dispositivo_superior": "BR_FED_COFEN_RES_2026_N_00807_ART_004", "ordem": 11, "transcricao_literal": "I - a compatibilidade funcional;", "sha256_texto": "78c4525af1db804fd40dd83f456758a3f8d88971ef5c9c9fd6112871ad294138", "fonte_literal": "DOU", "arquivo_fonte": "RES_0807_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00807_ART_004_INC_II", "normativo": "BR_FED_COFEN_RES_2026_N_00807", "tipo_dispositivo": "inciso", "localizador": "Inciso II", "dispositivo_superior": "BR_FED_COFEN_RES_2026_N_00807_ART_004", "ordem": 12, "transcricao_literal": "II - a interseção remuneratória;", "sha256_texto": "219a8628ebf0742b3ebb14ad8c7c2112c6adbe077e01d404df821c2f0c0c6d87", "fonte_literal": "DOU", "arquivo_fonte": "RES_0807_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00807_ART_004_INC_III", "normativo": "BR_FED_COFEN_RES_2026_N_00807", "tipo_dispositivo": "inciso", "localizador": "Inciso III", "dispositivo_superior": "BR_FED_COFEN_RES_2026_N_00807_ART_004", "ordem": 13, "transcricao_literal": "III - a manutenção das atribuições essenciais do cargo; IV - o tempo mínimo de anos, após conclusão do estágio probatório/contrato de experiência, como empregado público concursado;", "sha256_texto": "dc41c8eaa35b4f50882f49d7fbc63e4e19de7f8a57c71d5e66f233cdbb8d0c4a", "fonte_literal": "DOU", "arquivo_fonte": "RES_0807_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00807_ART_004_INC_V", "normativo": "BR_FED_COFEN_RES_2026_N_00807", "tipo_dispositivo": "inciso", "localizador": "Inciso V", "dispositivo_superior": "BR_FED_COFEN_RES_2026_N_00807_ART_004", "ordem": 14, "transcricao_literal": "V - a ausência de punições disciplinares nos últimos 6 (seis) anos;", "sha256_texto": "4fe09ea54c0d04139c171ea4bac306de7c8dbfb28f28a8396671e27f2fe1fdec", "fonte_literal": "DOU", "arquivo_fonte": "RES_0807_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00807_ART_004_INC_VI", "normativo": "BR_FED_COFEN_RES_2026_N_00807", "tipo_dispositivo": "inciso", "localizador": "Inciso VI", "dispositivo_superior": "BR_FED_COFEN_RES_2026_N_00807_ART_004", "ordem": 15, "transcricao_literal": "VI - a inexistência de concurso em vigor para o mesmo cargo.", "sha256_texto": "7a6b5eafe771ac61e1b1949ab0b37dcedbac418f9f13df8f91f4e1eec93076a4", "fonte_literal": "DOU", "arquivo_fonte": "RES_0807_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00807_ART_005", "normativo": "BR_FED_COFEN_RES_2026_N_00807", "tipo_dispositivo": "artigo", "localizador": "Art. 5º", "dispositivo_superior": null, "ordem": 16, "transcricao_literal": "Art. 5º Compete às unidades de Gestão de Pessoas do Cofen e dos Conselhos Regionais de Enfermagem a correta instrução dos processos administrativos de redistribuição, nos termos do Manual aprovado, incluindo, no mínimo, manifestação fundamentada do órgão de origem, manifestação do órgão de destino com demonstração do interesse institucional, demonstrativo de compatibilidade funcional, memória de cálculo da interseção remuneratória, declaração de inexistência de concurso público impeditivo e anuência expressa do empregado.", "sha256_texto": "2de6b857555a04a538a527ea257a22db82826e8ff19e717d1294521ad1cbc264", "fonte_literal": "DOU", "arquivo_fonte": "RES_0807_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00807_ART_006", "normativo": "BR_FED_COFEN_RES_2026_N_00807", "tipo_dispositivo": "artigo", "localizador": "Art. 6º", "dispositivo_superior": null, "ordem": 17, "transcricao_literal": "Art. 6º Em caso de divergência entre o Manual, seu Anexo e outros atos normativos do Sistema Cofen/Conselhos Regionais de Enfermagem, prevalecerá a norma hierarquicamente superior.", "sha256_texto": "db808dbaad5bd4e1f240b848cf19b9150e7e01d516b08fd5053176064fb6016e", "fonte_literal": "DOU", "arquivo_fonte": "RES_0807_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00807_ART_007", "normativo": "BR_FED_COFEN_RES_2026_N_00807", "tipo_dispositivo": "artigo", "localizador": "Art. 7º", "dispositivo_superior": null, "ordem": 18, "transcricao_literal": "Art. 7º Permanecem válidos os atos de redistribuição praticados sob a égide de normas anteriores, desde que regularmente formalizados à época, não se aplicando retroativamente as disposições desta Resolução.", "sha256_texto": "dee0dcfca0294f66cd7e6b94849e3e105854669650a4cba76b2328f36346ad10", "fonte_literal": "DOU", "arquivo_fonte": "RES_0807_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00807_ART_008", "normativo": "BR_FED_COFEN_RES_2026_N_00807", "tipo_dispositivo": "artigo", "localizador": "Art. 8º", "dispositivo_superior": null, "ordem": 19, "transcricao_literal": "Art. 8º Os casos omissos serão dirimidos pelo Plenário do Cofen ouvida a área técnica competente.", "sha256_texto": "7ab0a680b6cad7b1a10ffc2879f9609e81467770e74f5b3c06a3c4401fae460f", "fonte_literal": "DOU", "arquivo_fonte": "RES_0807_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_RES_2026_N_00807_ART_009", "normativo": "BR_FED_COFEN_RES_2026_N_00807", "tipo_dispositivo": "artigo", "localizador": "Art. 9º", "dispositivo_superior": null, "ordem": 20, "transcricao_literal": "Art. 9º Esta Resolução entra em vigor na data de sua publicação no Diário Oficial da União.", "sha256_texto": "b89aa6bbd14fb160e4bb10aa0c51f9015877fdd99710a8b7355b23164c40f696", "fonte_literal": "DOU", "arquivo_fonte": "RES_0807_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
