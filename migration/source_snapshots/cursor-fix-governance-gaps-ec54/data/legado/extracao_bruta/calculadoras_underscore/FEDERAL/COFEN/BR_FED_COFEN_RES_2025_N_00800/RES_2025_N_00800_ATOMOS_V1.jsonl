{"identificador": "BR_FED_COFEN_RES_2025_N_00800_CONS_002", "normativo": "BR_FED_COFEN_RES_2025_N_00800", "tipo_dispositivo": "considerando", "localizador": "Considerando 2", "dispositivo_superior": null, "ordem": 4, "transcricao_literal": "CONSIDERANDO o disposto no art. 21, inciso XII, do Regimento Interno do Cofen, aprovado pela Resolução Cofen nº 726/2023, ou outra que sobrevir, que autoriza o Conselho Federal de Enfermagem baixar Resoluções, Decisões e demais instrumentos legais no âmbito do Sistema Cofen/Conselhos Regionais de Enfermagem;", "sha256_texto": "39bf68a77bceb03cf8877e5fae50ae95fa54e043c4cc2f2668cc7481d316022f", "fonte_literal": "DOU", "arquivo_fonte": "RES_0800_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
