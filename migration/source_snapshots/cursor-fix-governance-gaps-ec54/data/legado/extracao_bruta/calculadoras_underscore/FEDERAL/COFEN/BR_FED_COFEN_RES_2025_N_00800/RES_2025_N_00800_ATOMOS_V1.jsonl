{"identificador": "BR_FED_COFEN_RES_2025_N_00800_EMENTA", "normativo": "BR_FED_COFEN_RES_2025_N_00800", "tipo_dispositivo": "ementa", "localizador": "Ementa", "dispositivo_superior": null, "ordem": 1, "transcricao_literal": "Prorroga o prazo para a adequação dos Conselhos Regionais à Política de Educação Permanente, previsto na Resolução Cofen nº 778/2025, por mais 180 (cento e oitenta) dias.", "sha256_texto": "bb0a60ab2cbb464e999383661f15f7bd4f1c57a13be7ff51db5831dc4ac741e9", "fonte_literal": "DOU", "arquivo_fonte": "RES_0800_DOU.pdf", "verificacao_estrutura": "EXTRAIDO_DO_DOU_AUTOMATICO", "verificacao_literal": "EXTRAIDO_DO_DOU_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
