{"identificador": "BR_FED_COFEN_PARCT_2022_N_00060_CTLN_PARAGRAFO_TEXTO_039", "normativo": "BR_FED_COFEN_PARCT_2022_N_00060_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00060_CTLN_SECAO_003", "ordem": 45, "transcricao_literal": "Considerando todo o exposto, reforçamos que existem casos/situações, em que o risco à saúde e a vida impostos, afastam a necessidade da presença de acompanhante, seja para crianças ou adolescentes, podendo, portanto, a equipe de enfermagem administrar as medicações prescritas, bem como realizar demais procedimentos prescritos e indicados, de acordo com a necessidade do caso.", "sha256_texto": "9501b599739f05f1381b7d223b94dd164eb3a672edcb987f71f63b18bd6c4523", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00060_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
