{"identificador": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_SECAO_001", "normativo": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP", "tipo_dispositivo": "secao", "localizador": "I. RELATÓRIO", "dispositivo_superior": null, "ordem": 5, "transcricao_literal": "I. RELATÓRIO", "sha256_texto": "be40338beec0b641645a8d566c6af53d269630be331c5fbd2db3f4a98e651bf0", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00009_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_PARAGRAFO_TEXTO_002", "normativo": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_SECAO_001", "ordem": 6, "transcricao_literal": "Trata-se do pedido de registro do título de pós-graduação lato sensu em “Direito Médico” da profissional enfermeira Andréa Silveira Santana Franco. Nesse sentido, apresenta a requerente, junto ao Coren-BA, certificado de conclusão e histórico escolar emitidos pela Universidade Católica do Salvador, datados em 03 de maio de 2017.", "sha256_texto": "d7c9a6e1675559514df34e5cb0852bebd88f773c790c6badec21a65e4959a826", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00009_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_SECAO_001", "ordem": 7, "transcricao_literal": "Cumpre destacar que, em consulta realizada pelo Coren-BA, em 28/02/2023 e reiterada por esta Câmara Técnica, consta que o Curso supracitado está registrado na Plataforma e-MEC, cuja situação de funcionamento atual é de curso desativado, já a instituição mantenedora está ativa no referido portal.", "sha256_texto": "afe2fae68e8a1895b5d33b9350c1089e73102a95762278815cac31b9bc07022b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00009_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_SECAO_001", "ordem": 8, "transcricao_literal": "Fundamentando-se na Resolução Cofen nº 581/2018, o Coren-BA passa a solicitar maiores esclarecimentos, via parecer CTEP/COFEN, quanto ao registro do título de especialização lato sensu em “Direito Médico” solicitado pela requerente supramencionada.", "sha256_texto": "afcc4de3b94b5852372e33823c287b08ff565282f129f5ad03aa7b44c55d482c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00009_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_SECAO_002", "normativo": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP", "tipo_dispositivo": "secao", "localizador": "II. FUNDAMENTAÇÃO", "dispositivo_superior": null, "ordem": 9, "transcricao_literal": "II. FUNDAMENTAÇÃO", "sha256_texto": "685155de3de3ed3f2f8f8b81dbe74f0335422a2abbc215c5604d7e9096b7c5c5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00009_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_SECAO_002", "ordem": 10, "transcricao_literal": "Em 03 de março de 2023, foi recebida solicitação, via despacho, para emissão de parecer por esta Câmara Técnica de Educação e Pesquisa – CTEP/COFEN, acerca do registro do título de pós-graduação lato sensu em “Direito Médico” da profissional enfermeira Andréa Silveira Santana Franco.", "sha256_texto": "3ada20b322f5f73ec3423d05239ec4a95e3c02616a3609916e83e8a4d708bf9c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00009_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_SECAO_002", "ordem": 11, "transcricao_literal": "Com vistas a fundamentar sua solicitação, conforme mencionado no item anterior, apresentou a requerente o certificado de conclusão e histórico escolar.", "sha256_texto": "a1a77bee2996d021963d2d2dd262710fe32cda524f2ac969291fc527061d578e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00009_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_SECAO_002", "ordem": 12, "transcricao_literal": "Para análise deste processo a CTEP direcionou seu posicionamento na definição de “Direito Médico” e suas implicações ontológicas para a Medicina e Direito como disciplinas acadêmicas, profissões e ciências próprias, bem como desdobramentos deontológicos afetos a estas áreas de conhecimento. Ademais, evocou o Código Ética dos Profissionais da Enfermagem, bem como a Resolução Cofen nº 581/2018.Digite aqui o texto do item… …. .", "sha256_texto": "030f35e03b5378da7562e5930b7e8446709bfb8c474aea612a19d0e6d39f568c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00009_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_SECAO_002", "ordem": 13, "transcricao_literal": "Desse modo, considerando ser o “Direito Médico” objeto de interesse da medicina em perspectiva profissional (deontológica), cujas implicações estabelecem nexos com o Direito Positivo nas relações com o paciente/família/instituição de saúde e comunidade, fica, da forma como está posto na descrição do certificado apresentado pela proponente, bem como no rol de disciplinas descritas no histórico escolar, uma expressiva lacuna entre o campo de conhecimento e atuação da especialidade cursada em relação a Enfermagem e, notadamente, do que preconiza a Resolução Cofen nº 581/2018.", "sha256_texto": "f27cc8c9b33178f669fd23a7c7249ae72adff8c77d15ce5d568f99293b39dd86", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00009_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_SECAO_002", "ordem": 14, "transcricao_literal": "No rol de disciplinas, descritas no histórico escolar anexado, estão, por exemplo: Tópicos especiais do direito médico I e II; Ética Médica Aplicada; Contratos relacionados à atividade médica; Medicina e direito do trabalho; Medidas processuais relacionadas à atividade médica; Direito Médico-Empresarial. Sendo assim, muito embora apresente disciplinas que supõem transversalidade entre áreas distintas do conhecimento, como: Reflexões biomédicas sobre o início e o fim da vida; Fundamentos de Bioética; Políticas públicas e privadas em saúde; Metodologia da Pesquisa Científica, as especificidades do campo disciplinar centrados na Medicina, bem como o título descrito no certificado “Especialização em Direito Médico” distanciam da Enfermagem, em que pese a natureza sociológica da profissão e suas bases legais para o devido registro desta especialidade, pois, de acordo com a Resolução Cofen nº 581/2018, Art. 3º, parágrafo 1º “os títulos serão registrados de acordo com a denominação constante no diploma ou certificado apresentado”.", "sha256_texto": "d085ffb97428a8d254baa66e472593ceed14dd333217b7c674eac9e83474f1e5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00009_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_SECAO_002", "ordem": 15, "transcricao_literal": "Ao evocarmos o Código de Ética, sinalizamos as subjetividades que permeiam o princípio da alteridade que deve fundamentar as relações de trabalho, no âmbito da interdisciplinaridade, notadamente ao não desejarmos ao outro o que repelimos da nossa própria realidade, a saber: incursões que firam a autonomia, no campo disciplinar e deontológico das profissões. Nessa conjuntura, no Capítulo III do referido Código, que trata das proibições, tem-se no Art. 81, parte inicial, o destaque de que é proibido “prestar serviço que, por sua natureza, competem a outro profissional”.", "sha256_texto": "6dc17d9ade9503e4538fac4bf6a367219d25e8ba60e4edda9b6c57a3bcbbbea4", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00009_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 7", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_SECAO_002", "ordem": 16, "transcricao_literal": "Por outra perspectiva, cumpre destacar, que esta Câmara Técnica não se opõe ao registro de especialidades que abordem o “Direito Médico” no conjunto de suas discussões e competências, porém, conforme destacado, observa como incoerente o registro de especialidades, na Enfermagem, que se limitam ao Direito Médico como área específica descrita em diploma ou certificado. Nessa conjuntura, o entendimento desta Câmara vai ao encontro do atual fluxo das especialidades afetas a esta área de conhecimento, para uma perspectiva mais ampla, como ocorre, por exemplo, com a própria instituição formadora e certificadora implicada neste processo, pois em seu portal oficial a Universidade Católica do Salvador oferece, agora, o curso de especialização intitulada “Direito Médico, Biodireito e Bioética” (PÓS-CATÓLICA – https://pos.ucsal.br/todos-os-cursos/).", "sha256_texto": "d2f45d16f87bf2d5772289722ede19d1a7b3b9dc4da23232a292513ced56778d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00009_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_PARAGRAFO_TEXTO_012", "normativo": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 8", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_SECAO_002", "ordem": 17, "transcricao_literal": "Sendo estas as considerações, passamos à conclusão.", "sha256_texto": "704360155b783080f6fcd1f13edd6b5bb5f2b31adc72f1b32776ef20a7657633", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00009_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_SECAO_003", "normativo": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP", "tipo_dispositivo": "secao", "localizador": "III. CONCLUSÃO", "dispositivo_superior": null, "ordem": 18, "transcricao_literal": "III. CONCLUSÃO", "sha256_texto": "8c7e1360ea68d3681e2ee822aa41aba75cc7f69f87e83a200f76660890666064", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00009_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_PARAGRAFO_TEXTO_013", "normativo": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_SECAO_003", "ordem": 19, "transcricao_literal": "Considerando a análise dos documentos que constituem o Processo SEI nº 00196.0013412023-57, requerido pelo Coren-BA, a partir de manifestação de interesse da profissional enfermeira Andréa Silveira Santana Franco, que tem por objeto de análise registro do título de pós-graduação lato sensu em “Direito Médico;", "sha256_texto": "c8aa5ddea8036ff63d4bec2865e0c543fe581ef1c9ac16b10576a371804703ca", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00009_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_PARAGRAFO_TEXTO_014", "normativo": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_SECAO_003", "ordem": 20, "transcricao_literal": "Considerando a Resolução Cofen nº 581/2018, em seu art. 3º, parágrafo 1º, em que diz que “os títulos serão registrados de acordo com a denominação constante no diploma ou certificado apresentado”;", "sha256_texto": "6fa7832b9767d7553a20ef4590e64cfa9ff502be6a93c9261f20f470c3993c91", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00009_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_PARAGRAFO_TEXTO_015", "normativo": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_SECAO_003", "ordem": 21, "transcricao_literal": "Considerando o entendimento desta CTEP/Cofen sobre as incoerências deste registro em relação às especificidades ontológicas e deontológicas da Enfermagem em relação a Medicina e Direito;", "sha256_texto": "1cdc3dcbdab28a945e926bafea97ef68b3b8e5d8df2928d93df3abd01eb19e15", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00009_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_PARAGRAFO_TEXTO_016", "normativo": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_SECAO_003", "ordem": 22, "transcricao_literal": "Considerando ser esta Câmara Técnica de Educação e Pesquisa, órgão “permanente de natureza consultiva, propositiva e avaliativa sobre matéria relativa ao exercício da Enfermagem”, segundo Art. 1º do Regimento Interno do Cofen, no entanto, sem competência deliberativa;", "sha256_texto": "2782436d7b7b1c3b0b14727b70a1394644e92facfdeafd1c779059bfa93ae41a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00009_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_PARAGRAFO_TEXTO_017", "normativo": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00009_CTEP_SECAO_003", "ordem": 23, "transcricao_literal": "Considerando tudo mais que foi visto e analisado, sugere esta Câmara Técnica ao Egrégio Plenário deste Conselho, que neste caso, dê apreciação desfavorável ao registro do Título de Pós-graduação em “Direito Médico” da Enfermeira Andréa Silveira Santana Franco, emitido Universidade Católica do Salvador.", "sha256_texto": "68b6fe06765aa8c317fd33bdc611959750a7df25eeff3b59f1c1b5a707234c1b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00009_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
