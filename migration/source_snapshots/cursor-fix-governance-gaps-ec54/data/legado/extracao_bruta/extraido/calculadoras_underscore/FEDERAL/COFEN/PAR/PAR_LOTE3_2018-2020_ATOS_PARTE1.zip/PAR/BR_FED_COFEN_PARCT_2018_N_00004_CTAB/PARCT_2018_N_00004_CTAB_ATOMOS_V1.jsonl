{"identificador": "BR_FED_COFEN_PARCT_2018_N_00004_CTAB_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARCT_2018_N_00004_CTAB", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2018_N_00004_CTAB_SECAO_003", "ordem": 8, "transcricao_literal": "Em 05/06/2018 o Coren-PE solicitou que este Egrégio Conselho de classe emitisse parecer referente à prescrição de vacina e/ou soro antirrábico por profissional enfermeiro(a) por meio do OF. COREN/DIPRE-PE Nº 237/2018. Anexo ao documento citado foi encaminhado cópia do parecer emitido pela Enfermeira Fiscal Dra. Eline Barbosa da Nóbrega Ramos, sobre o assunto, o qual foi reprovado pela plenária, assim como cópia do despacho da conselheira Dra. Valdeísa Maria Pessoa Morais, no qual solicita este parecer.", "sha256_texto": "2a5dff17d444c290ebc27fd6d707aec35ecf4f07132a844f9587925acd59522b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2018_N_00004_CTAB_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARCT_2018_N_00004_CTAB_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARCT_2018_N_00004_CTAB", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2018_N_00004_CTAB_SECAO_003", "ordem": 9, "transcricao_literal": "Ato contínuo a Câmara Técnica de Atenção à Saúde (CTAS) encaminhou o Processo Administrativo Cofen nº 0778/2018 à Câmara Técnica de Atenção Básica em Saúde (CTAB).", "sha256_texto": "1ef637d0ddba8ca9daf63dc91559194e1da58b453f8ed129271e2557f2d39e2c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2018_N_00004_CTAB_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "EQUIVALENTE_OCR", "similaridade": 81.6, "cobertura_vocabulario": 0.889, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
