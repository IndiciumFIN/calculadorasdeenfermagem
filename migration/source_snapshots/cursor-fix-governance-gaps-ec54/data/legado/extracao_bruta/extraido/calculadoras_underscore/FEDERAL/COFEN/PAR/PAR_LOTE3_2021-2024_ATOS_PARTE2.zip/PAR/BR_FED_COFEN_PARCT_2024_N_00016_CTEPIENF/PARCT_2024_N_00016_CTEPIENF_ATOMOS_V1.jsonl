{"identificador": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_EMENTA", "normativo": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF", "tipo_dispositivo": "ementa", "localizador": "Ementa", "dispositivo_superior": null, "ordem": 4, "transcricao_literal": "Análise da emissão de diploma em meio físico pela Universidade Federal de Santa Catarina (UFSC) e o não reconhecimento do diploma no Coren São Paulo, pela inconformidade com a portaria do ministério da educação que exige diploma exclusivamente em meio digital.", "sha256_texto": "d3056e660f05f0e24855364f9869843e9002fdd693cf13078256c714d710e941", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00016_CTEPIENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_PARAGRAFO_TEXTO_001", "normativo": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": null, "ordem": 5, "transcricao_literal": "Ao Egrégio Plenário do Conselho Federal de Enfermagem,", "sha256_texto": "b8ae347963349b3c193592ed0f08490179bf0b265b491b4acefcfcffe4f83db6", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00016_CTEPIENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_SECAO_001", "normativo": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF", "tipo_dispositivo": "secao", "localizador": "I. RELATÓRIO", "dispositivo_superior": null, "ordem": 6, "transcricao_literal": "I. RELATÓRIO", "sha256_texto": "be40338beec0b641645a8d566c6af53d269630be331c5fbd2db3f4a98e651bf0", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00016_CTEPIENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_PARAGRAFO_TEXTO_002", "normativo": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_SECAO_001", "ordem": 7, "transcricao_literal": "O Coordenador geral das Câmaras técnicas, através do Memorando 156, (SEI nº 0400534) Informa a demanda recebida por meio do e-mail da Sra. Bianca Bertotti Sonaglio (SEI nº 0376760), em que a reclamante solicita auxílio devido à intercorrência envolvendo a emissão de diploma pela Universidade Federal de Santa Catarina (UFSC). O Conselho Regional de Enfermagem de São Paulo (Coren-SP) teria indeferido o pedido de inscrição da profissional, alegando que o diploma não atendia aos normativos exigidos pelo Ministério da Educação (MEC) para fins de registro.", "sha256_texto": "d0b53b1df700f0335a14f3d789244979413f3074e290995d46083be72bf74c4f", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00016_CTEPIENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_SECAO_001", "ordem": 8, "transcricao_literal": "Trata o presente da apreciação da Câmara Técnica de Educação e Pesquisa – CTEPi/Cofen, o parecer de reconhecimento do diploma de Graduação em Enfermagem emitido pela Universidade Federal de Santa Catarina, onde o Coren SP não reconhece o diploma, por não estar em conformidade com a Portaria do MEC 544/2019.", "sha256_texto": "bc5a73eddc901a5bea90653c36e6ab025a10c05dfc08db62a141e6ea915e0863", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00016_CTEPIENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_SECAO_002", "normativo": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF", "tipo_dispositivo": "secao", "localizador": "II. FUNDAMENTAÇÃO", "dispositivo_superior": null, "ordem": 9, "transcricao_literal": "II. FUNDAMENTAÇÃO", "sha256_texto": "685155de3de3ed3f2f8f8b81dbe74f0335422a2abbc215c5604d7e9096b7c5c5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00016_CTEPIENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_SECAO_002", "ordem": 10, "transcricao_literal": "As instituições de ensino superior ostentam autonomia administrativa, atribuída por Lei. Essa autonomia é muito ampla, abarcando desde a escolha e definição da grade curricular até a expedição de diplomas. Neste sentido é o artigo 52, inciso Vi da Lei de Diretrizes e Bases da Educação (Lei 9394/1996):", "sha256_texto": "2ef78c0ffed6d1b01fb342c0a0e25ff65171edda974d1c974b2e42cffb565f8f", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00016_CTEPIENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_ART_053", "normativo": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 53 (citado/transcrito)", "dispositivo_superior": null, "ordem": 11, "transcricao_literal": "Art. 53. No exercício de sua autonomia, são asseguradas às universidades, sem prejuízo de outras, as seguintes atribuições:", "sha256_texto": "f4632a0ea779b9612cccf604061c214b197f57edbb3f0abc918325dd170d942c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00016_CTEPIENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Artigo citado ou transcrito de outra norma (sequência não inicia em 1 no escopo); não é articulado próprio."}
{"identificador": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_SECAO_002", "ordem": 12, "transcricao_literal": "(…)", "sha256_texto": "cea48b15697d7107a26babe680d4cdb668648538a4a235de498cf569274fcc99", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00016_CTEPIENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_ART_053_INC_VI", "normativo": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF", "tipo_dispositivo": "inciso", "localizador": "Inciso VI", "dispositivo_superior": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_ART_053", "ordem": 13, "transcricao_literal": "VI – conferir graus, diplomas e outros títulos;", "sha256_texto": "21f61d5ee217bad3e7df4b918fba22c1515f98526b494d9c27c5fa16597496d9", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00016_CTEPIENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Dispositivo de artigo citado/transcrito."}
{"identificador": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_SECAO_002", "ordem": 14, "transcricao_literal": "Apesar da intenção do Ministério da Educação – MEC, ao editar a Portaria nº 544/2019, ter sido avançar e facilitar a burocracia estatal, inclusive assinando prazo de vinte e quatro meses para as instituições de ensino superior se adequassem à exigência de expedição de diploma exclusivamente pela via digital (art. 14), essa previsão não derroga a Lei.", "sha256_texto": "2d07d7a475a9e1503229658c4af154a15f7ab2358512ffa30bd12f62c98450f2", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00016_CTEPIENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_SECAO_002", "ordem": 15, "transcricao_literal": "E assim não o faz pelo fato de uma portaria, ainda que muito bem elaborada e coerente com os avanços tecnológicos, não tem o potencial de superar a lei, revogando-a.", "sha256_texto": "a479388e3ec8cc29ef5635449b700c7bede2acd1fdfd25264c9046ba67663b29", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00016_CTEPIENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_SECAO_002", "ordem": 16, "transcricao_literal": "Desse modo, o artigo 48 da Lei de Diretrizes e Bases da Educação ainda é plenamente válido. E ele é transparente ao dispor que os diplomas expedidos pela universidades são por elas próprias registrados e têm validade em todo território nacional. Senão vejamos a redação da Lei:", "sha256_texto": "1164e14848473dd80b79f0abff7ef0aed08bd379cca12f3069636195e39101f9", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00016_CTEPIENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_ART_048", "normativo": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 48 (citado/transcrito)", "dispositivo_superior": null, "ordem": 17, "transcricao_literal": "Art. 48. Os diplomas de cursos superiores reconhecidos, quando registrados, terão validade nacional como prova da formação recebida por seu titular.", "sha256_texto": "1a0983ce792860eb169141bcb6b3d216ba865377ce41492f0717edacc849b20c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00016_CTEPIENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Artigo citado ou transcrito de outra norma (sequência não inicia em 1 no escopo); não é articulado próprio."}
{"identificador": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_ART_048_PAR_01", "normativo": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF", "tipo_dispositivo": "paragrafo_transcrito", "localizador": "§ 1º", "dispositivo_superior": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_ART_048", "ordem": 18, "transcricao_literal": "§ 1º Os diplomas expedidos pelas universidades serão por elas próprias registrados, e aqueles conferidos por instituições não-universitárias serão registrados em universidades indicadas pelo Conselho Nacional de Educação.", "sha256_texto": "acaee5285865b20d57067c7ed8b6aae68b07c3c0f74f11785f9ee69bce348afa", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00016_CTEPIENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_ART_048_PAR_02", "normativo": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF", "tipo_dispositivo": "paragrafo_transcrito", "localizador": "§ 2º", "dispositivo_superior": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_ART_048", "ordem": 19, "transcricao_literal": "§ 2º Os diplomas de graduação expedidos por universidades estrangeiras serão revalidados por universidades públicas que tenham curso do mesmo nível e área ou equivalente, respeitando-se os acordos internacionais de reciprocidade ou equiparação.", "sha256_texto": "4dee3d534fdab3e6bf589ccf9cca4281cd22babb22c33c26c59de90cfc3c9e1e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00016_CTEPIENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_ART_048_PAR_03", "normativo": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF", "tipo_dispositivo": "paragrafo_transcrito", "localizador": "§ 3º", "dispositivo_superior": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_ART_048", "ordem": 20, "transcricao_literal": "§ 3º Os diplomas de Mestrado e de Doutorado expedidos por universidades estrangeiras só poderão ser reconhecidos por universidades que possuam cursos de pós-graduação reconhecidos e avaliados, na mesma área de conhecimento e em nível equivalente ou superior.", "sha256_texto": "804a7d7378a30e0977619a49ecb08d2418b0ea1d1c4ed6133c4a95d2b883407a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00016_CTEPIENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_SECAO_002", "ordem": 21, "transcricao_literal": "Portanto, ainda que seja modernizador o viés da Portaria MEC nº 544/2019, ela não tem o condão de revogar a lei federal que atribui autonomia às universidades.", "sha256_texto": "1d8f57e3df61b125eb845623c89273eaa426189ade91ed9727855520eeff45a5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00016_CTEPIENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 7", "dispositivo_superior": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_SECAO_002", "ordem": 22, "transcricao_literal": "Dessa forma, há que se concluir que os diplomas físicos expedidos pelas universidades ainda são absolutamente válidos e devem ser aceitos para fins de registro e cadastro junto ao Sistema COFEN/Conselhos Regionais. Não os aceitar é infringir a legislação de regência, criando um risco jurídico de responsabilização civil que não se apresenta razoável.", "sha256_texto": "82117e342e07c44c2fca8e7412f0dc9eef26d20fce31f874847f4a6ba36ae470", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00016_CTEPIENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_ART_048_PAR_03_INC_III", "normativo": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF", "tipo_dispositivo": "inciso", "localizador": "Inciso III", "dispositivo_superior": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_ART_048_PAR_03", "ordem": 23, "transcricao_literal": "III. CONCLUSÃO Considerando o parecer 0407544 do setor de processos administrativos;", "sha256_texto": "a4fee43af1ab404cddd5567f2dc095e885792120b8f6ae051a087b4bf2b65db3", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00016_CTEPIENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Dispositivo de artigo citado/transcrito."}
{"identificador": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 8", "dispositivo_superior": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_SECAO_002", "ordem": 24, "transcricao_literal": "Considerando o Ofício Circular 0413233 da Presidência do COFEN.", "sha256_texto": "cb5f78e7af81b9944a06dd8a450d2c184fb6bee53dba6c5d525e60dbd9821b67", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00016_CTEPIENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_PARAGRAFO_TEXTO_012", "normativo": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 9", "dispositivo_superior": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_SECAO_002", "ordem": 25, "transcricao_literal": "Considerando a nobre a intenção modernizadora da Portaria MEC nº 544/2019 de tornar todos os novos diplomas exclusivamente digitais;", "sha256_texto": "9c964c8c74227ef390da92a2aeed5b9185e20ff2d7b5e7a17f8e90fabd58a17b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00016_CTEPIENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_PARAGRAFO_TEXTO_013", "normativo": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 10", "dispositivo_superior": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_SECAO_002", "ordem": 26, "transcricao_literal": "Considerando a autonomia universitária concedida pela Lei 9394/1996 – Diretrizes e Bases da Educação prevalece, facultando às universidades a expedição de diplomas em meio físico se assim elas entenderem conveniente e oportuno.", "sha256_texto": "91771b2d705b64840f6ea8778ee1938210fa4c2836d4d8b37ba49e5f4bfb175e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00016_CTEPIENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_PARAGRAFO_TEXTO_014", "normativo": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 11", "dispositivo_superior": "BR_FED_COFEN_PARCT_2024_N_00016_CTEPIENF_SECAO_002", "ordem": 27, "transcricao_literal": "Por fim, sugere esta Câmara Técnica ao Egrégio Plenário deste Conselho do Cofen, que neste caso, dê apreciação favorável ao registro da Graduada em Enfermagem Bianca Bertotti Sonaglio, no COREN SP e acate e registre diplomas físicos oriundos de universidades federais, sob pena de em não o fazendo, arrostar para si responsabilidade civil.", "sha256_texto": "b254a455dff5ab8b23deeee756c2cbc22dbcb4c8d7494c255e7a668b712b5966", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00016_CTEPIENF_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
