{"identificador": "BR_FED_COFEN_PORT_2019_N_01975_PREAMBULO_001", "normativo": "BR_FED_COFEN_PORT_2019_N_01975", "tipo_dispositivo": "preambulo", "localizador": "Preâmbulo", "dispositivo_superior": null, "ordem": 2, "transcricao_literal": "O Presidente do Conselho Federal de Enfermagem – Cofen, em conjunto com o Primeiro-Secretário da Autarquia, no uso de suas atribuições legais e regimentais conferidas na Lei nº 5.905 de 12 de julho de 1973, bem como pelo Regimento Interno da Autarquia, aprovado pela Resolução Cofen nº 421, de 15 de fevereiro de 2012;", "sha256_texto": "63f400c873b89cac938ed42dd036c5a6e618290eed4660559b94e581b3c40322", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2019_N_01975_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "EQUIVALENTE_OCR", "similaridade": 99.7, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PORT_2019_N_01975_CONSIDERANDO_001", "normativo": "BR_FED_COFEN_PORT_2019_N_01975", "tipo_dispositivo": "considerando", "localizador": "Considerando 1", "dispositivo_superior": null, "ordem": 3, "transcricao_literal": "CONSIDERANDO que compete ao Conselho Federal de Enfermagem baixar provimentos e expedir instruções, para uniformidade de suas ações e procedimentos, resguardando o seu bom funcionamento, nos termos do art. 8º, inciso IV, da Lei nº 5.905/73;", "sha256_texto": "5a763984b16d0ab824b508d72c9383a1cf7a806b83c881525290874709a4a1bc", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2019_N_01975_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
