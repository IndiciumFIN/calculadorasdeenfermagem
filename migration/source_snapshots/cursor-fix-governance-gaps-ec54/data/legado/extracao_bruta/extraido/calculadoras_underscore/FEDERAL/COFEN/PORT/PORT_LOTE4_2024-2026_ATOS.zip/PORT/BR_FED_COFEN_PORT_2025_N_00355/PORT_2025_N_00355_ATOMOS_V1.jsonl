{"identificador": "BR_FED_COFEN_PORT_2025_N_00355_EMENTA", "normativo": "BR_FED_COFEN_PORT_2025_N_00355", "tipo_dispositivo": "ementa", "localizador": "Ementa", "dispositivo_superior": null, "ordem": 2, "transcricao_literal": "O Vice-Presidente do Conselho Federal de Enfermagem – COFEN, no uso de suas atribuições legais e regimentais conferidas na Lei nº 5.905 de 12 de julho de 1973, bem como pelo Regimento Interno da Autarquia, Resolução Cofen nº 726, de 15 de setembro de 2023; e termos da Decisão Cofen nº 60/2024;", "sha256_texto": "b493a0c59f9c3ebaca6e5d2f68d17364266c5ccf95c7a302ce8eba6a3ed43b9a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2025_N_00355_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PORT_2025_N_00355_CONSIDERANDO_001", "normativo": "BR_FED_COFEN_PORT_2025_N_00355", "tipo_dispositivo": "considerando", "localizador": "Considerando 1", "dispositivo_superior": null, "ordem": 3, "transcricao_literal": "CONSIDERANDO o Processo SEI nº 00196.001459/2025-47;", "sha256_texto": "638053e6b16d0f24bdae6ff47565756acbb9c0ac0bb3b7e91dd2c3913301a76a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2025_N_00355_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PORT_2025_N_00355_CONSIDERANDO_002", "normativo": "BR_FED_COFEN_PORT_2025_N_00355", "tipo_dispositivo": "considerando", "localizador": "Considerando 2", "dispositivo_superior": null, "ordem": 4, "transcricao_literal": "CONSIDERANDO o Memorando nº 070/2025 – COFEN/DADM/DGP (SEI nº 0604208), o qual recomenda que a execução de trabalhos de manutenção predial, previstos no Relatório de Inspeção Visual de Edificação Sede do Cofen (SEI nº 0604205), sejam realizados entre os dias 1º e 8 de março de 2025, procedimentos que se forem feitos durante dias úteis causariam embaraço às rotinas da Autarquia e paralisação nas atividades laborais. Sendo assim, a realização desses serviços em feriados e pontos facultativos tem menor impacto e melhor aproveitamento do serviço;", "sha256_texto": "499410cd3f85be1c456b5743bfe58e98fc754d4f3198e33056391732383edbd3", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2025_N_00355_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PORT_2025_N_00355_CONSIDERANDO_003", "normativo": "BR_FED_COFEN_PORT_2025_N_00355", "tipo_dispositivo": "considerando", "localizador": "Considerando 3", "dispositivo_superior": null, "ordem": 5, "transcricao_literal": "CONSIDERANDO a competência estabelecida à Presidência do Cofen no art. 24, XIV, do Regimento Interno do Cofen, de decidir, “ad referendum” do Plenário ou da Diretoria, nos casos que, possuam urgência, exijam a adoção de providências, obrigatoriamente submetendo a matéria à homologação do Plenário ou da Diretoria, preferencialmente na primeira reunião subsequente;", "sha256_texto": "ddb2067fb47664ad5f4d72dd15749ecc27162bd138f3a83bf87394a7a3158acf", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2025_N_00355_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
