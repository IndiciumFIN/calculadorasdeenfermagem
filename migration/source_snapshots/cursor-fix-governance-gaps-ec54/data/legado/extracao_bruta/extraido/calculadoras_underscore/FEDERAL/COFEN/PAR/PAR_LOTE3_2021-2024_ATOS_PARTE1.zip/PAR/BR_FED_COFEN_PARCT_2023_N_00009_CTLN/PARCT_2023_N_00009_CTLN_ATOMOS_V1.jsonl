{"identificador": "BR_FED_COFEN_PARCT_2023_N_00009_CTLN_PARAGRAFO_TEXTO_018", "normativo": "BR_FED_COFEN_PARCT_2023_N_00009_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 16", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00009_CTLN_SECAO_003", "ordem": 28, "transcricao_literal": "Enfatizamos ainda o Decreto de nº 94.406, de 08 de junho de 1987 que regulamenta a Lei nº 7.498, de 25 de junho de 1986. Ambos o destacam as atividades privativas do enfermeiro, vindo promover instrumento legal para o caso em tela.", "sha256_texto": "579ecad862ac1f1595156d381accecd4081c4829e402eef13e38018cb26d4bcc", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00009_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00009_CTLN_ART_004_INC_IV", "normativo": "BR_FED_COFEN_PARCT_2023_N_00009_CTLN", "tipo_dispositivo": "inciso", "localizador": "Inciso IV", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00009_CTLN_ART_004", "ordem": 29, "transcricao_literal": "IV – CONCLUSÃO Ante o exposto, enquanto membros da Câmara Técnica de Legislação e Normas do Conselho Federal de Enfermagem, somos unânimes em ratificar as ações privativas de enfermagem, devendo-as ser respeitadas em todos os serviços de saúde que possuam profissionais de enfermagem.", "sha256_texto": "d2cba96ba542d9aef12fbcf6d39e2b2359798ddc41833703cb0e216a7e36db0a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00009_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Dispositivo de artigo citado/transcrito."}
