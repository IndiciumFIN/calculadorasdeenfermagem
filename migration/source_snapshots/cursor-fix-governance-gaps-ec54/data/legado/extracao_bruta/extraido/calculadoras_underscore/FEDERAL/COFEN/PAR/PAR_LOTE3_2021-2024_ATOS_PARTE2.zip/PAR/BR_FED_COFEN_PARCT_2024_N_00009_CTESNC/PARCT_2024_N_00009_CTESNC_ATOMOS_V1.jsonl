{"identificador": "BR_FED_COFEN_PARCT_2024_N_00009_CTESNC_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARCT_2024_N_00009_CTESNC", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2024_N_00009_CTESNC_SECAO_001", "ordem": 8, "transcricao_literal": "Trata-se de manifestação deliberada na 571ª Reunião Ordinária de Plenário do COFEN, Ref. ao Processo SEI nº 00196.001171/2024-91, que determinou manifestação da Câmara Técnica de Enfermagem em Saúde do Neonato e da Criança em relação à aplicação do laser de baixa intensidade para alívio da cólica do recém-nascido, especificamente em relação a essa matéria, por meio de Parecer Técnico.", "sha256_texto": "83250523c8d18f184035b37f2edd6569508bc62ecd1529310abb769a528fcdb1", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2024_N_00009_CTESNC_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
