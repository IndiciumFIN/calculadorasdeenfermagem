{"identificador": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_PARAGRAFO_TEXTO_001", "normativo": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": null, "ordem": 1, "transcricao_literal": "Curso de Enfermagem “100% EaD” compromete qualidade do atendimento", "sha256_texto": "c72b588a83ab2c3eb10c2dfa480c143b515b3d1d17ec8f9bc85e877ca9b8e164", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_IMAGEM_001", "normativo": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD", "tipo_dispositivo": "imagem", "localizador": "Imagem woman-taking-e-learning-courses.jpg", "dispositivo_superior": null, "ordem": 2, "transcricao_literal": "[imagem: woman-taking-e-learning-courses.jpg]", "sha256_texto": "7b5156680c49cbac62da864e3d4f1249a9fc60b970c42472d510b46252347de4", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "CONTEUDO_EM_IMAGEM_SEM_TEXTO_LITERAL", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "url_imagem": "https://www.cofen.gov.br/wp-content/uploads/2025/02/woman-taking-e-learning-courses.jpg", "conteudo_em_imagem": false, "observacao": "Imagem ilustrativa/decorativa (foto ou logotipo), sem conteúdo normativo."}
{"identificador": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_PARAGRAFO_TEXTO_002", "normativo": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": null, "ordem": 3, "transcricao_literal": "Em parecer de número 30/2024, aprovado durante a 574ª Reunião Ordinária de Plenário, do Conselho Federal de Enfermagem (Cofen), análise da Câmara Técnica de Educação, Pesquisa e Inovação em Enfermagem (CAMTEC/CTEPIENF) reforça necessidade de formação prática presencial em áreas da saúde.", "sha256_texto": "bf2677ae8d2aee31cf245a378fe6afd69beb98029da6ce9333b0377730a0ff0a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": null, "ordem": 4, "transcricao_literal": "Para promover o desenvolvimento de habilidades psicomotoras e a capacidade de resposta em situações de emergência, de acordo com o Cofen, a formação em saúde demanda atividades presenciais, o que não pode ser plenamente alcançado em aprendizado limitado ao ambiente virtual.", "sha256_texto": "f14061fff9a84dc73d003620d87dd93c7eb0aa3eb51ff39250f9e7f946255952", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": null, "ordem": 5, "transcricao_literal": "Segundo a Organização Mundial da Saúde (OMS, 2010) é recomendada aos profissionais de saúde a combinação de ensino teórico e prático, visando o desenvolvimento de competências emocionais e interpessoais necessárias para a atuação segura e eficaz em contextos clínicos.", "sha256_texto": "840af1faa86c01d4c38f5c3b0feb544f61e0d7d9682ae6cdc09138d812446f0c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": null, "ordem": 6, "transcricao_literal": "Embora seja uma abordagem pedagógica válida e alinhada com a Lei nº 9394/96, a formação por competência, ofertada por algumas instituições de ensino, não deve excluir a supervisão de práticas complexas em especial nas áreas de atuação da saúde. Por isso, cursos técnicos voltados aos profissionais de Enfermagem na modalidade exclusiva à distância, segundo o Conselho Federal de Enfermagem (Cofen), que não atendem aos requisitos de presencialidade, expõe fragilidade e inadequação no cotidiano de clínicas, hospitais e demais estabelecimentos que prestam serviços de cuidado ambulatorial.", "sha256_texto": "e3d7bbac5c6ffa64a9b5bf18676844f6950cace534c99c8610b8b399c945c99d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": null, "ordem": 7, "transcricao_literal": "Alertando sobre a necessidade de atenção aos registros expressos nos diplomas de cursos técnicos de Enfermagem na modalidade EaD, os Conselhos Regionais devem orientar e verificar se os diplomas informam de maneira clara a carga horária prática e o cumprimento dos requisitos presenciais exigidos pela legislação vigente, prevenindo assim o registro de profissionais com formação específica para o exercício seguro da profissão.", "sha256_texto": "f0ef40955dcb15314db0b3bc374f785df2c300dd9ac03c75dfa076c345b92a05", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 7", "dispositivo_superior": null, "ordem": 8, "transcricao_literal": "A Resolução nº 1/2021 do Conselho Nacional de Educação (CNE) especifica as diretrizes para a Educação Profissional Técnica de Nível Médio e impõe requisitos mínimos para cursos da área da saúde, incluindo a obrigatoriedade de 50% de carga horária presencial.", "sha256_texto": "2a1fc138e95ab6b4a4a170dfc4651fb23042f8f3178dda839f34a109f47800e4", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 8", "dispositivo_superior": null, "ordem": 9, "transcricao_literal": "Essa resolução tem o objetivo de assegurar que, mesmo em um modelo EaD, os cursos cumpram um padrão mínimo de qualidade na formação prática. Portanto, é necessário que haja uma coordenação com as diretrizes nacionais para garantir que os requisitos regulatórios sejam cumpridos em todos os estados atendidos pelos cursos à distância.", "sha256_texto": "e955b377141c322d25ee5428d882dadd26179bad727fb676238c05a69b1e3f58", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 9", "dispositivo_superior": null, "ordem": 10, "transcricao_literal": "Novo marco regulatório deve combinar modalidades para ensino", "sha256_texto": "dbfc1c58442455d4a337331b4a600b24121ddb0749888d0fe01982ea3a5131bf", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_IMAGEM_002", "normativo": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD", "tipo_dispositivo": "imagem", "localizador": "Imagem Post-para-instagram-atencao-simples-amarelo.png", "dispositivo_superior": null, "ordem": 11, "transcricao_literal": "[imagem: Post-para-instagram-atencao-simples-amarelo.png]", "sha256_texto": "8d77b79084100ef11755b8bc32cadc8ab2eebc0ec83861f6401cdaaf863b52df", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "CONTEUDO_EM_IMAGEM_SEM_TEXTO_LITERAL", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "url_imagem": "https://www.cofen.gov.br/wp-content/uploads/2025/02/Post-para-instagram-atencao-simples-amarelo.png", "conteudo_em_imagem": false, "observacao": "Imagem ilustrativa/decorativa (foto ou logotipo), sem conteúdo normativo."}
{"identificador": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 10", "dispositivo_superior": null, "ordem": 12, "transcricao_literal": "O governo federal deve publicar no primeiro trimestre de 2025 um decreto para definir quais cursos poderão continuar a ser ministrados de forma remota, quais outros precisarão ter formato 100% presencial e quais poderão ser híbridos, com carga horária combinando as duas modalidades.", "sha256_texto": "89cb7957b95425a8d3d118d358cf61d718c4d0eef0d708ca2a28550173559ff6", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 11", "dispositivo_superior": null, "ordem": 13, "transcricao_literal": "Os termos da nova regulamentação vêm sendo discutidos desde meados de 2024, quando o Ministério da Educação (MEC) suspendeu a abertura de polos presenciais e de cursos a distância e congelou o número de vagas existentes – a restrição vigora até 10 de março.", "sha256_texto": "743d6b2a5a5b604703fbb337ef00add4b63a342feb3325c2d89b743b788dacc3", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_PARAGRAFO_TEXTO_012", "normativo": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 12", "dispositivo_superior": null, "ordem": 14, "transcricao_literal": "Inep aponta crescimento da educação à distância no setor privado", "sha256_texto": "668bf88cd94804694a62e2dab8583f6bf256719a63fbfd67d4064e022e9e8d49", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_PARAGRAFO_TEXTO_013", "normativo": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 13", "dispositivo_superior": null, "ordem": 15, "transcricao_literal": "Para cada aluno inscrito em um curso de graduação presencial no país em 2023, havia outro que optou pela EaD: em um quase empate, foram contabilizados 5 milhões de matrículas presenciais e 4,9 milhões em cursos a distância. Em 2019, a proporção era 72% de presenciais e 28% a distância, segundo o Censo da Educação Superior, divulgado em outubro de 2024 pelo Instituto Nacional de Estudos e Pesquisas Educacionais (Inep).", "sha256_texto": "5a76488da075d60cbb82c260f79243c2fa18490f8ab6dfb3cf33b09012f2cf7b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_PARAGRAFO_TEXTO_014", "normativo": "BR_FED_COFEN_NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 14", "dispositivo_superior": null, "ordem": 16, "transcricao_literal": "O setor educacional privado expandiu suas matrículas de graduação em EaD de 1 milhão em 2013 para 4,7 milhões em 2023.", "sha256_texto": "b7364824b1dec0a8bc636057c0bb5dbff69e968492030c81927a2149cbdc794e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "NAOATO_2025_SN_CURSO_ENFERMAGEM_100_EAD_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
