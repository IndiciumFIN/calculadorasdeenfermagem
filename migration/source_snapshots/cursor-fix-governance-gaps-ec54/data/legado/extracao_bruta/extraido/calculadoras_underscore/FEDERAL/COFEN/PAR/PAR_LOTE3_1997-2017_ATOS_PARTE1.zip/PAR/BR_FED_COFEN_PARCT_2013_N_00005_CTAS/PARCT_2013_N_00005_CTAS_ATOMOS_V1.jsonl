{"identificador": "BR_FED_COFEN_PARCT_2013_N_00005_CTAS_PARAGRAFO_TEXTO_015", "normativo": "BR_FED_COFEN_PARCT_2013_N_00005_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2013_N_00005_CTAS_SECAO_004", "ordem": 24, "transcricao_literal": "Considerado os pareceres dos Conselhos Regionais referente a questão acima, o procedimento de troca da sonda de nefrostomia somente deve ser realizado pelo profissional Medico, devido as características e complicações associadas ao procedimento, como explícitos no parágrafo abaixo.", "sha256_texto": "7ad815dccfc4d5f8675943cda477a46009b48d59a75760549926c577dc9409be", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2013_N_00005_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2013_N_00005_CTAS_PARAGRAFO_TEXTO_016", "normativo": "BR_FED_COFEN_PARCT_2013_N_00005_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2013_N_00005_CTAS_SECAO_004", "ordem": 25, "transcricao_literal": "Parecer Técnico n° 008/2010, Coren-ES, recomenda que a troca do cateter de nefrostomia é uma atividade médica. Parecer Técnico n° 010/2013, Coren-PR, recomenda que este procedimento deva ser executado pelo médico, não cabendo aos profissionais de enfermagem.", "sha256_texto": "272b202ecc4fa511f95a24a279a31257b1bb6622b880d327f3bea817cbb0a6b1", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2013_N_00005_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2013_N_00005_CTAS_SECAO_005", "normativo": "BR_FED_COFEN_PARCT_2013_N_00005_CTAS", "tipo_dispositivo": "secao", "localizador": "IV – DO PARECER", "dispositivo_superior": null, "ordem": 26, "transcricao_literal": "IV – DO PARECER", "sha256_texto": "a6eadd544e04ef40ceebd086c1c13681d0cca71e8c733f24cc25635bad4f9c72", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2013_N_00005_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2013_N_00005_CTAS_PARAGRAFO_TEXTO_017", "normativo": "BR_FED_COFEN_PARCT_2013_N_00005_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2013_N_00005_CTAS_SECAO_005", "ordem": 27, "transcricao_literal": "Conclui-se que a troca de sonda de Nefrostomia não deve ser realizada por profissionais de Enfermagem, pois trata-se de um procedimento em que é manipulada uma cavidade e estruturas profundas com riscos de complicações associadas.", "sha256_texto": "92c5db64ab2777d9501d98e2979962f1ce8d4e791927b509313db1b80c5ee95e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2013_N_00005_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
