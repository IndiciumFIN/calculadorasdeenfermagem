{"identificador": "BR_FED_COFEN_PORT_2014_N_00082_EMENTA", "normativo": "BR_FED_COFEN_PORT_2014_N_00082", "tipo_dispositivo": "ementa", "localizador": "Ementa", "dispositivo_superior": null, "ordem": 2, "transcricao_literal": "A Vice-Presidente Interina do Conselho Federal de Enfermagem – COFEN, em conjunto com o Primeiro-Secretário da Autarquia, no uso de suas atribuições legais e regimentais conferidas no art. 39 do Regimento Interno do Cofen, aprovado pela Resolução Cofen nº. 421/2012;", "sha256_texto": "88f6ffbbc46567996997d626415a93ce7ecd606ee0d74ab2fb7f7a44594eb4de", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2014_N_00082_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2014_N_00082_CONSIDERANDO_001", "normativo": "BR_FED_COFEN_PORT_2014_N_00082", "tipo_dispositivo": "considerando", "localizador": "Considerando 1", "dispositivo_superior": null, "ordem": 3, "transcricao_literal": "CONSIDERANDO que, “O Plenário do Conselho Federal de Enfermagem é órgão deliberativo e soberano do Sistema Cofen/Conselhos Regionais de Enfermagem, representado pelos Conselheiros Federais” (art. 6º, do Regimento Interno do Cofen), competindo-lhe “julgar os processos administrativos disciplinares contra Conselheiros efetivos e suplentes do Sistema Cofen/Conselhos Regionais de Enfermagem, respeitando a legislação em vigor” (art. 23, IX, do Regimento Interno do Cofen);", "sha256_texto": "a1990730bf6099257252cee2f419f7c5f498bf103b3e15638a2377b2a99826cc", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2014_N_00082_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2014_N_00082_CONSIDERANDO_002", "normativo": "BR_FED_COFEN_PORT_2014_N_00082", "tipo_dispositivo": "considerando", "localizador": "Considerando 2", "dispositivo_superior": null, "ordem": 4, "transcricao_literal": "CONSIDERANDO o disposto no art. 2º do Código de Processo Administrativo constante na Resolução Cofen nº 155/1992;", "sha256_texto": "a8a8e62c639a77fd6de78381f2858c18540507d916febe026edd4ca365c1b798", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2014_N_00082_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2014_N_00082_CONSIDERANDO_003", "normativo": "BR_FED_COFEN_PORT_2014_N_00082", "tipo_dispositivo": "considerando", "localizador": "Considerando 3", "dispositivo_superior": null, "ordem": 5, "transcricao_literal": "CONSIDERANDO tudo que consta no Processo Administrativo Cofen nº 741/2013, que trata de nota técnica da Controladoria-Geral com recomendações referentes a reformulações orçamentárias do Cofen no exercício de 2012, baixam as seguintes determinações:", "sha256_texto": "10be3d0d169208657606657f1a1445996f6a6c6e3be8d93e0457176742eef748", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2014_N_00082_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2014_N_00082_ART_001", "normativo": "BR_FED_COFEN_PORT_2014_N_00082", "tipo_dispositivo": "artigo", "localizador": "Art. 1º", "dispositivo_superior": null, "ordem": 6, "transcricao_literal": "Art. 1º Designar, conforme o artigo 3º, parágrafo 2º da Resolução Cofen nº 155 de 18 de novembro de 1992, Comissão de Processo Administrativo Disciplinar em face da Dra. Marcia Cristina Krempel – Brasileira, divorciada, Enfermeira regularmente inscrita no Coren-PR sob o nº 14118, por infração ao disposto no art. 79, § 1º, II, da Resolução Cofen nº 421/2012que aprova o Regimento Interno do Conselho Federal de Enfermagem;", "sha256_texto": "563e7cdafdc17e421e1782323ebb045b065c2aa62aee705ba33412186356c64b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2014_N_00082_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
