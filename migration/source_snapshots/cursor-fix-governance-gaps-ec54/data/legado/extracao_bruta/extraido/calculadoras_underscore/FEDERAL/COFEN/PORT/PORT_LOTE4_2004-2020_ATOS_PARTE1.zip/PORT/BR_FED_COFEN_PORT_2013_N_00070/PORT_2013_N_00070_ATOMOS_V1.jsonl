{"identificador": "BR_FED_COFEN_PORT_2013_N_00070_CONSIDERANDO_001", "normativo": "BR_FED_COFEN_PORT_2013_N_00070", "tipo_dispositivo": "considerando", "localizador": "Considerando 1", "dispositivo_superior": null, "ordem": 3, "transcricao_literal": "CONSIDERANDO o Processo Administrativo Cofen nº. 751/2012 que trata de denúncia em desfavor da Dra. Marcia Cristina Krempel, impetrada pela Dra. Isabel Cristina Reis Souza;", "sha256_texto": "edd317dcbfd9ff82451a906c090524849623763bec1d080772a57f373f55aa23", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2013_N_00070_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
