{"identificador": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_SECAO_002", "ordem": 8, "transcricao_literal": "A solicitação do profissional se deu com juntada de documentação e protocolada em 16 de abril de 2021 junto ao Conselho Federal de Enfermagem em que solicita o registro do seu Título de Especialização Lato sensu em “Tricologia e Terapias Capilares”", "sha256_texto": "6a8a917e52c71e7f47f5f4dc7fd3fcdf2b9c55332b13bfcae3b76acdb46321c7", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00043_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_SECAO_002", "ordem": 9, "transcricao_literal": "Apresenta a interessada, para fim de obtenção do registro, o certificado de conclusão e histórico escolar, gerados e assinados digitalmente, do curso de Especialização Lato Sensu em Tricologia e Terapias Capilares, emitidos pela Faculdade UNYLEYA.", "sha256_texto": "8e18eb93750648ae9bf01aa3514e24180c5d4f9e5d0139d39fe9b125d741d26a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00043_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_SECAO_002", "ordem": 10, "transcricao_literal": "Em consulta ao Cadastro Nacional de Cursos e Instituições de Educação Superior – Cadastro e-MEC constata-se que a Instituição Faculdade Unyleya possui cadastro ativo e que o em comento possui autorização de funcionamento, desde 20 de agosto de 201 na modalidade a distância (ver Anexo).", "sha256_texto": "6cf72fac308c56c77a7c96064fcb258c163278d5726f1f40787a7279aa3d5c72", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00043_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_SECAO_002", "ordem": 11, "transcricao_literal": "Sobre a solicitação, manifesta-se através do memorando no 074/2021/SIRC/DGEP/COGEN, a chefe do Setor de Inscrição, Registro e Cadastro do Cofen, que assim conclui:", "sha256_texto": "fccd4a5eb21d2c81beda577f0085b4f6b1441bb4f124ae1a113e207f73220283", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00043_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_SECAO_002", "ordem": 12, "transcricao_literal": "Diante da necessidade de definirmos se a especialidade está abarcada no rol das", "sha256_texto": "18323b50432d4220ade19152c1b5524b71743800165877c17e08de94988e8cff", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00043_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_SECAO_002", "ordem": 13, "transcricao_literal": "áreas de abrangência definidas no anexo à Resolução Cofcn no 581/2018; pairam", "sha256_texto": "8319d07561c8fee44a18a70133f521974ffa11018b618d74eae350a3c9602be7", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00043_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 7", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_SECAO_002", "ordem": 14, "transcricao_literal": "dúvidas sobre a possibilidade de se proceder o seu cadastramento no sistema e ao seu posterior registro do título.", "sha256_texto": "e3af2450b396463546ba298f79d370b99c04827958bf02a9f9d9e546b5eac75d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00043_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 8", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_SECAO_002", "ordem": 15, "transcricao_literal": "Sendo assim, tendo em vista o que dispõe o artigo 70 da Resolução Cofen no 581/2018, sugerimos a deflagração de Processo Administrativo que tenha por objeto a análise do requerimento de registro do título de especialização lato sensu em “Tricologia e Terapias Capilares”, assim como, se for o caso, a inclusão em reunião de Plenário (podendo o órgão colegiado, antes da edição do ato decisório, se valer da opinião da Câmara de Educação e Pesquisa — CTEP).", "sha256_texto": "ec99bed20c601a8abd401fe5b2c38e71b81ee8bbf79e140eb783dfd6fabdd1cb", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00043_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 9", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_SECAO_002", "ordem": 16, "transcricao_literal": "Diante da manifestação do SIRC/DGEP/COFEN, o PAD chegou a esta Câmara Técnica de Educação e Pesquisa para manifestação.", "sha256_texto": "ded42604548f0cc0bd4eae8c4b019dfb0cc0f4943c3b063a84171b3ef7056c7e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00043_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_PARAGRAFO_TEXTO_012", "normativo": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 10", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_SECAO_002", "ordem": 17, "transcricao_literal": "Em relação à especialidade que o requerente solicita registro de título junto ao Cofen, tem-se como resultado de definição, em rápida busca à Enciclopédia Livre Wikipédia, que a “tricologia (do grego TPIZóg, thñcos, “cabelo”;and -Royíu, -logia) é o ramo da ciência que trata dos pelos ou cabelos. Originou-se na Inglaterra em 1902. Seu estudo contém a função de solucionar vários problemas capilares. Existe, no Brasil, assim como em outros países, um im.eresse crescente pelos tratamentos alternativos e preventivos” tendo-se ainda que a “Tricologia congrega profissionais ligados a esta ciência (químicos, biólogos, biomédicos, cosmetólogos, farmacêuticos, nutricionistas e médicos) e tem como objetivo integrar as áreas da saúde e da estética”.", "sha256_texto": "bedbb554f9c9d406d7968247bb3345fd3e6b221e2307345bc288387ff0d296ea", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00043_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_PARAGRAFO_TEXTO_013", "normativo": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 11", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_SECAO_002", "ordem": 18, "transcricao_literal": "Como é possível se verificar da definição, a Tricologia é uma área de atuação ampla por narte das diversas profissões que compreendem a área da saúde e da estética, o que leva a depreender que também pode ser área de atuação do Enfermeiro, visto que sua atuação se dá tanto na saúde como na estética.", "sha256_texto": "9c9ea1b96ce9bc938c372c5fe294f8f2b184910aeb14342f8e4f9e72ff389f24", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00043_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_PARAGRAFO_TEXTO_014", "normativo": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 12", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_SECAO_002", "ordem": 19, "transcricao_literal": "A atuação do Enfermeiro na estética foi regulamentada no Brasil, pelo Conselho Federal de Enfermagem, com a edição da Resolução Cofen no 529/2016, alterada pela Resolução Cofen 626/2020, nesse sentido, permitindo a atuação do Enfermeiro nessa área, definindo para tanto os procedimentos autorizados.", "sha256_texto": "3576016f60a47f71635dd38cf2c0853fe09b994a7106eee77e5034646e8c6bb9", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00043_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_PARAGRAFO_TEXTO_015", "normativo": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 13", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_SECAO_002", "ordem": 20, "transcricao_literal": "Nesse mesmo sentido a Estética, como especialidade do Enfermeiro, consta do rol de especialidades da Resolução Cofen no 581/2018, estando incluída na ÁREA I — Saúde Coletiva; Saúde da Criança e do adolescente; Saúde do Adulto (Saúde do homem e Saúde da Mulher; Saúde do Idoso; Urgências e Emergências), item 15 Enfermagem em Estética.", "sha256_texto": "8aa4486d5f5a439df6e25c70e2fde7169696d9f5f42ad17589e3e580d0f6994e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00043_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_PARAGRAFO_TEXTO_016", "normativo": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 14", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_SECAO_002", "ordem": 21, "transcricao_literal": "De outro lado, a atuação dos Enfermeiros na área de estética, bem como a própria norma que regulamentou a matéria, Resolução Cofen no 529/2016, foi motivo de diversos questionamentos, inclusive judiciais, em relação aos procedimentos autorizados para Enfermeiros, o que levou o Cofen a alterar a norma, com a edição da Resolução Cofen n 626/2020, ficando a atuação restrita aos procedimentos listados.", "sha256_texto": "5fdbfb6281868906ae5be7c3019f47e7cc2de0c61431e49a0a80480ffc1b4ec3", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00043_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_SECAO_003", "normativo": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP", "tipo_dispositivo": "secao", "localizador": "III – CONCLUSÃO", "dispositivo_superior": null, "ordem": 22, "transcricao_literal": "III – CONCLUSÃO", "sha256_texto": "4a687eec6bdb00270291daf999e7cdaf76d5d2df2aae4f7d23cc2d7bd7536d10", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00043_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_PARAGRAFO_TEXTO_017", "normativo": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_SECAO_003", "ordem": 23, "transcricao_literal": "Considerando a Lei NO 5.905, de 12 de julho de 1973, que “Dispõe sobre a criação dos Conselhos Federal e Regionais de Enfermagem e dá outras providências”, em seu Art- 20 dispõe que “O Conselho Federal e os Conselhos Regionais são órgãos disciplinadores do exercício da profissão de enfermeiro e das demais profissões compreendidas nos serviços de Enfermagem” (BRASIL 1973);", "sha256_texto": "c3b1d0ba0a80214ff761b41d21ea606e8ab1b73eda3570ab2624f8c0ffaa4d52", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00043_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_PARAGRAFO_TEXTO_018", "normativo": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_SECAO_003", "ordem": 24, "transcricao_literal": "Considerando o Código de Etica dos Profissionais de Enfermagem (COFEN, 201 7, s/p.), no Capítulo II – Dos Deveres, em seu Art. 55, cita que os profissionais de Enfermagem devem buscar “aprimorar os conhecimentos técnico-científicos, ético-políticos, socioeducativos e culturais, em beneficio da pessoa, família e coletividade e do desenvolvimento da profissão”,", "sha256_texto": "e774ced454e8c2fab4b4be84c1d41276afa48f67dd1ace911d9b5922168b413a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00043_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_PARAGRAFO_TEXTO_019", "normativo": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_SECAO_003", "ordem": 25, "transcricao_literal": "Considerando a Lei NO 7.498, de 25 de junho de 1986, que “Dispõe sobre a regulamentação do exercício da Enfermagem e dá outras providências” (BRASIL, 1986, s/p.), em seu Art. 7′ garante que “A Enfermagem e suas atividades Auxiliares somente podem ser exercidas por pessoas legalmente habilitadas e inscritas no Conselho Regional de Enfermagem com jurisdição na área onde ocorre o exercício”;", "sha256_texto": "b47237b9df757a570115b86860d45d00fac11d38abca66540b9a303d55cd019e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00043_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_PARAGRAFO_TEXTO_020", "normativo": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_SECAO_003", "ordem": 26, "transcricao_literal": "Considerando ser esta Câmara Técnica, “órgão permanente de natureza consultiva, propositiva e avaliativa sobre matéria relativa ao exercício da Enferma oem”, segundo Art. 1 0 do Regimento Interno do Cofen, no entanto, sem competência deliberativa (Cofen, 2012);", "sha256_texto": "509e2ffc8e6f2687d776164cc5a2536969cef3398909efd6aedaa807cd1f8a8f", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00043_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_PARAGRAFO_TEXTO_021", "normativo": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_SECAO_003", "ordem": 27, "transcricao_literal": "Considerando o Art. 13 do Regimento Interno das Câmaras Técnicas do Cofên, que compete à CTEP: “VI — subsidiar o Sistema Cofen/Coren em ações quer promovam o desenvolvimento técnico-científico em Enfermagem; VII pronunciar-se, mediante Parecer", "sha256_texto": "6d7b0b98a1a4eed67bf3790456228d8c2a7fb06da9c3f9799c10cf0677379540", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00043_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_PARAGRAFO_TEXTO_022", "normativo": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_SECAO_003", "ordem": 28, "transcricao_literal": "J” (COFEN, 2019);", "sha256_texto": "6bf8168b11c7f256a472a24086ce23c69e9c3bdba5f57b8ea58dc5657b335b76", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00043_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_PARAGRAFO_TEXTO_023", "normativo": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 7", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_SECAO_003", "ordem": 29, "transcricao_literal": "Considerando a análise do PAD NO 0467/2021, com base nos documentos que o constituem, em estrita observância à legislação e normatização vigente;", "sha256_texto": "2d5f8709e2b4d8cbb9ff38a2e93bc1458be2303ffe98b21a2d6c97cf48eac7f2", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00043_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_PARAGRAFO_TEXTO_024", "normativo": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 8", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_SECAO_003", "ordem": 30, "transcricao_literal": "Considerando ser esta Câmara Técnica de Educação e Pesquisa, órgão “permanente de natureza consultiva, propositiva e avaliativa sobre matéria relativa ao exercício da", "sha256_texto": "ae7598b189088e06c99dbcf9494dbb8b3dc991e56a11788ef171e0a1ad40cee6", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00043_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_PARAGRAFO_TEXTO_025", "normativo": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 9", "dispositivo_superior": "BR_FED_COFEN_PARCT_2021_N_00043_CTEP_SECAO_003", "ordem": 31, "transcricao_literal": "Enfermagem”, segundo Art. 1 0 do Regimento Interno do Cofen, no entanto, sem competência deliberativa, e- considerando que a especialidade em Tricologia e Terapias Capilares não encontra guarida na norma que trata do procedimentos estéticos autorizados para Enfermeiros, qual seja a Resolução Cofen no 626/2020, sugerimos o não acatamento do presente pleito que solicita o registro do título de Especialização lato sensu em “Tricologia e Terapias Capilares da Psicoterapias da Enfermeira Simone Bunholi Pastore.", "sha256_texto": "ab7af77b867cc811d310c6e98618b5b45b645e81f8d2c5afd03901480a623a0e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2021_N_00043_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
