{"identificador": "BR_FED_COFEN_PARCONS_2017_N_00243_PARAGRAFO_TEXTO_021", "normativo": "BR_FED_COFEN_PARCONS_2017_N_00243", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 19", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2017_N_00243_SECAO_003", "ordem": 38, "transcricao_literal": "O Hospital São Paulo ligado à Universidade Federal – LTNIFESP elaborou protocolo para Utilização do Cateter Central de Inserção Periférica (PICC) para as Unidades de Internação, Terapia Intensiva e Unidades Pediátricas como procedimento de assistência em atendimento de enfermagem e médico – emissão fevereiro de 2017 – válido por 2 anos.", "sha256_texto": "c1189c62a2879796336450fe8948a6894c69a5987eb087a301c5d98068ddfdf8", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2017_N_00243_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "EQUIVALENTE_OCR", "similaridade": 99.4, "cobertura_vocabulario": 0.97, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARCONS_2017_N_00243_PARAGRAFO_TEXTO_022", "normativo": "BR_FED_COFEN_PARCONS_2017_N_00243", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 20", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2017_N_00243_SECAO_003", "ordem": 39, "transcricao_literal": "“A indicação e decisão de passagem do PICC deve ser", "sha256_texto": "76cd4dcf3d11e55d48b9c0a1b40d1a78e18a20ba496e59e8d8c7d658d900b7a4", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2017_N_00243_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARCONS_2017_N_00243_PARAGRAFO_TEXTO_023", "normativo": "BR_FED_COFEN_PARCONS_2017_N_00243", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 21", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2017_N_00243_SECAO_003", "ordem": 40, "transcricao_literal": "compartilhada entre médico e enfermeiro. Quanto a participação de profissionais de nível médio, o CORENSP dispõe que durante a punção venosa periférica para a inserção do PICC. a mesma deve ocorrer por enfermeiro habilitado, auxiliado por outro enfermeiro, cabendo ao Técnico e ao Auxiliar de Enfermagem a manutenção do posicionamento adequado do paciente e o fornecimento de materiais e equipamentos para a intervenção (COREN/SP- parecer 006/2009) “.", "sha256_texto": "c5ddfeea8e16f2dd66fbc1a6f9f656219f38183bbb50491c194c03dd66c3f685", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2017_N_00243_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "EQUIVALENTE_OCR", "similaridade": 99.8, "cobertura_vocabulario": 0.976, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARCONS_2017_N_00243_ART_002_3_INC_III", "normativo": "BR_FED_COFEN_PARCONS_2017_N_00243", "tipo_dispositivo": "inciso", "localizador": "Inciso III", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2017_N_00243_ART_002_3", "ordem": 41, "transcricao_literal": "III. DA ANÁLISE E CONCLUSÃO Observamos que vários Regionais deliberaram Decisões e/ou Parecer Técnico sobre a PICC, normantizando a competência técnica e legal para o Enfermeiro inserir, manipular e retirar o PICC, guiada pelo ultrassom e utilizando anestésico subcutâneo para inserção do PICC encontra-se amparada pela legislação maior, Decreto 94.406/87, regulamentador da Lei no 7.498/86, no seu Artigo 8°, Inciso 1, alíneas “c”, “g”, “h” e Inciso II, alíneas: “b “, “e “, “h “, “1 “. Dispondo ainda a referida lei no Artigo 11, Inciso 1, alínea “m “, ser competência privativa do Enfermeiro, cuidados de maior complexidade técnica e que exijam conhecimentos de base científica e capacidade de tomar decisões imediatas.", "sha256_texto": "c72df4d3b84554dfd64ea9a4e93abad2c0964ec383a09538b8bb4b0a5fd46be5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2017_N_00243_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Dispositivo de artigo citado/transcrito.", "conferencia_pdf": {"resultado": "EQUIVALENTE_OCR", "similaridade": 98.8, "cobertura_vocabulario": 0.984, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARCONS_2017_N_00243_PARAGRAFO_TEXTO_024", "normativo": "BR_FED_COFEN_PARCONS_2017_N_00243", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 22", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2017_N_00243_SECAO_003", "ordem": 42, "transcricao_literal": "Concluo que há Regionais diversos legislando sobre o assunto, de maneira muito segura e ponderada, exigindo do profissional enfermeiro qualificação adequada. Portanto, sou de Parecer de Permanência da atual Resolução vigente.", "sha256_texto": "bc2f90e8b67898cf51ec8b7548c409a36fb297292f9f5f2c14cda9da5a6daa7e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2017_N_00243_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
