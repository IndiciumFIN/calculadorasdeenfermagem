{"identificador": "BR_FED_COFEN_PARCONS_2017_N_00243_PARAGRAFO_TEXTO_002", "normativo": "BR_FED_COFEN_PARCONS_2017_N_00243", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2017_N_00243_SECAO_002", "ordem": 8, "transcricao_literal": "Por designação do Presidente desta Autarquia Federal, através da Portaria COFEN N° 1090 de 16 de agosto de 2017, concede vistas aos autos do PROCESSO ADMINISTRATIVO N° 348/2016, procedente da CÂMARA TÉCNICA DE LEGISLAÇÃO E NORMAS – CTLN, que elaborou a revisão e atualização da Resolução COFEN N° 258/2001, que aprova a Inserção de Cateter Periférico Central pelo enfermeiro – PICC com anestesia local e guiado por ultrassonografia.", "sha256_texto": "96dde02b975c8b29d34f0f39134728feb7dc0e0f9a6b91881f46413f9e9c89b0", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2017_N_00243_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "EQUIVALENTE_OCR", "similaridade": 99.3, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARCONS_2017_N_00243_SECAO_003", "normativo": "BR_FED_COFEN_PARCONS_2017_N_00243", "tipo_dispositivo": "secao", "localizador": "II. DOS FATOS", "dispositivo_superior": null, "ordem": 9, "transcricao_literal": "II. DOS FATOS", "sha256_texto": "ba22c3c5e25e22b227960e63c251e20978c9ee4214b96a37d9bb277e7771145d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2017_N_00243_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "EQUIVALENTE_OCR", "similaridade": 83.3, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARCONS_2017_N_00243_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARCONS_2017_N_00243", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2017_N_00243_SECAO_003", "ordem": 10, "transcricao_literal": "O PICC – (Peripherally Inserted Central Catheter) é confeccionado em materiais bioestáveis e biocompatíveis e de baixa trombogenic idade (silicone e poliuretano), inserido por meio de veia periférica e posicionado na veia cava superior ou inferior. Foi introduzido nas unidades de terapia intensiva no Brasil nos anos 90 e tem sido amplamente utilizado por enfermeiros especialmente em crianças, recém-nascidos, pacientes idosos, oncológicos e com dificuldade venosa para infusão de substâncias irritantes ao vaso sanguíneo (Oliveira et al., 2014). Tem como finalidade a promoção da terapia intravenosa por tempo prolongado e de forma segura, garantindo a preservação da rede venosa periférica, diminuindo o estresse, dor e desconforto gerado por múltiplas venopunções. As suas indicações vêm da necessidade de acesso venoso por tempo prolongado (além de 6 dias), administração de soluções hipertônicas e/ou vesicantes (Nutrição Parenteral Total com osmolaridade maior que 600 mlOsmol/L e soro glicosado com concentração superior a 12,5%, quimioterapia, entre outros).", "sha256_texto": "3f4e2c27265fd17e1541a61006a0356de62d8f81a60488f6ea25ce1009a6a47c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2017_N_00243_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "EQUIVALENTE_OCR", "similaridade": 99.9, "cobertura_vocabulario": 0.979, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARCONS_2017_N_00243_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARCONS_2017_N_00243", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2017_N_00243_SECAO_003", "ordem": 11, "transcricao_literal": "O emprego desta terapêutica exige determinadas particularidades práticas que vão desde a seleção do vaso sanguíneo até a conservação do acesso. Por isso é de extrema importância que o enfermeiro tenha conhecimentos básicos em relação à fisiologia e à anatomia da rede venosa. (RODRIGUES, CHAVES, CARDOSO, 2006).", "sha256_texto": "37e07e08c36f91700f23682592d2571f415b9066159e895860e927eb0daa2814", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2017_N_00243_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARCONS_2017_N_00243_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_PARCONS_2017_N_00243", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2017_N_00243_SECAO_003", "ordem": 12, "transcricao_literal": "Após pesquisas realizadas em diferentes instituições que oferecem o curso de capacitação aos enfermeiros para introdução do PICC notou-se que, a duração do curso depende do conteúdo programado e não obedece a um padrão. As diversas escolas formadoras se preocupam em garantir uma bagagem teórica contemplando noções de anatomia, fisiologia, técnicas de inserção, manutenção e possíveis complicações. O conteúdo prático objetiva dar ao profissional em formação a experiência necessária para atuar com segurança.", "sha256_texto": "53d50e4ea765e8823ad4cd6c90f444e9970c9c1cbe5f168a744c908425dcd438", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2017_N_00243_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARCONS_2017_N_00243_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARCONS_2017_N_00243", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCONS_2017_N_00243_SECAO_003", "ordem": 13, "transcricao_literal": "O Conselho Federal de Enfermagem já normatizou através da Resolução Cofen n° 258/2001, dando parâmetros para o enfermeiro atuar com segurança nesta área.", "sha256_texto": "65dc6dc9b18275c25ca0c4bcc813858555d0d31664e659b8a4aea9913e5c6b95", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_2017_N_00243_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "EQUIVALENTE_OCR", "similaridade": 99.3, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
