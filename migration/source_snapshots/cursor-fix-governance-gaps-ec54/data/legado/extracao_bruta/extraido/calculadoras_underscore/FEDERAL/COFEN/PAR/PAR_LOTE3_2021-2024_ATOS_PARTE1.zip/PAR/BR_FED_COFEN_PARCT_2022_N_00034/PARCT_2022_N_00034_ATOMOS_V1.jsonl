{"identificador": "BR_FED_COFEN_PARCT_2022_N_00034_ANEXO_001_ITEM_LISTA_003", "normativo": "BR_FED_COFEN_PARCT_2022_N_00034", "tipo_dispositivo": "item_lista", "localizador": "Item de lista 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00034_ANEXO_001_PARAGRAFO_TEXTO_012", "ordem": 26, "transcricao_literal": "Ante a Resolução vigente, não restam dúvidas a esta CTLN, de que no Sistema Cofen/Conselhos Regionais de Enfermagem, está normatizado o processo de transporte de pacientes no âmbito da equipe de enfermagem, estabelecidas suas competências legais, sendo esse o documento norteador de todo o sistema para regrar sua conduta fiscalizatória, ética e disciplinar.", "sha256_texto": "f6e6e5b1243e7d70750dfe4018f41682df519bdddc96957e0197517128bf3155", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00034_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "1"}
