{"identificador": "BR_FED_COFEN_PARCT_2022_N_00034_ANEXO_001_ITEM_LISTA_004", "normativo": "BR_FED_COFEN_PARCT_2022_N_00034", "tipo_dispositivo": "item_lista", "localizador": "Item de lista 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00034_ANEXO_001_SECAO_004", "ordem": 28, "transcricao_literal": "Frente ao questionamento do Coren-MG, o posicionamento da CTLN, baseado na Resolução Cofen nº 588/2018, é unânime em afirmar que compete a equipe de enfermagem a assistência ao paciente durante todo o transcurso de seu transporte, não sendo, no entanto, sua competência, a condução do meio de transporte (maca ou cadeira de rodas), o fato de não ser competência da enfermagem, não significa vedação da atividade.", "sha256_texto": "6a0c466b4034778b443e16e775a12089fad19f9ecfd78aa2f8a571d288749f79", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00034_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "1"}
