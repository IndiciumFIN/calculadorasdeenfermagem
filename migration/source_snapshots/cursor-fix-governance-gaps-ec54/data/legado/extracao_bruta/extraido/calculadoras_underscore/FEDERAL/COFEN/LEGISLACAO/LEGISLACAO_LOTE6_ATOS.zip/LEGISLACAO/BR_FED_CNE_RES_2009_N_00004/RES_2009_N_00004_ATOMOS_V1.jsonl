{"identificador": "BR_FED_CNE_RES_2009_N_00004_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_CNE_RES_2009_N_00004", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_CNE_RES_2009_N_00004_SECAO_003", "ordem": 20, "transcricao_literal": "Carga horária mínima dos cursos de graduação considerados da área de saúde, bacharelados, na", "sha256_texto": "052838de7033f4166237e747b949cd180573ef2c7cd8c1f3c50b5e4cb902569c", "fonte_literal": "PDF_SITE_TEXTO", "arquivo_fonte": "RES_2009_N_00004_PDF_SITE.pdf", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_PDF_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
