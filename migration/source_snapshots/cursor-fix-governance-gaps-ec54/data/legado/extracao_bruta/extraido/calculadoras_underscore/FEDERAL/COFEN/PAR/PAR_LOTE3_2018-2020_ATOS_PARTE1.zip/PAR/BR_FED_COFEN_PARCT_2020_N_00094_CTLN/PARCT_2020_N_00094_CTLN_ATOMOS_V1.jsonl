{"identificador": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_SECAO_003", "ordem": 11, "transcricao_literal": "É o relatório, em síntese. Passa-se à análise.", "sha256_texto": "6404752d9e23eb1bbf70ae6d70dd3cdd20ef2b941e5f10b99e4288153687902a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00094_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_SECAO_004", "normativo": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN", "tipo_dispositivo": "secao", "localizador": "III – DA FUNDAMENTAÇÃO E ANÁLISE", "dispositivo_superior": null, "ordem": 12, "transcricao_literal": "III – DA FUNDAMENTAÇÃO E ANÁLISE", "sha256_texto": "25a54c4c3344607f284b1279878cbe10facdf2a0cc52e3f39b9d124abbf9a3f1", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00094_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_SECAO_004", "ordem": 13, "transcricao_literal": "O Consultório Virtual da Saúde da Família é uma plataforma disponibilizada pelo Ministério da Saúde para assegurar a realização de consultas remotas na Atenção Primária a Saúde (APS), a princípio, durante a pandemia, com pretensão de aperfeiçoar e estender sua aplicabilidade.", "sha256_texto": "4f712be721ccd59c2ffbc9fe69ca0e6146b53bfefc1599bc6ba7ba084ec3bd2a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00094_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_SECAO_004", "ordem": 14, "transcricao_literal": "A operacionalização dessa estratégia se apresenta como um meio seguro para que o paciente e o profissional de saúde possam interagir a distância, oferecendo alternativas e condições para a APS de ampliar o acesso, manter ou retomar o atendimento de condições sensíveis nas unidades de saúde, como acompanhamento de pacientes com doenças crônicas, diabetes e hipertensão, dentre outras que se fizerem oportunas e possíveis através da consulta virtual.", "sha256_texto": "1dc6c71263074d8d0dcf53421496b4348433538e86fd3fee633f065324c3c98f", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00094_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_SECAO_004", "ordem": 15, "transcricao_literal": "O Consultório Virtual de Saúde da Família é uma alternativa para a APS ampliar o acesso, manter ou retomar o atendimento, principalmente, o acompanhamento de pacientes com doenças crônicas, além de identificar possíveis casos de Covid-19, sem exposição desnecessária, bem como manter seu acompanhamento a nível domiciliar para os casos que assim permitirem. Para tanto, a operacionalização da teleconsulta é uma decisão do gestor local e dos profissionais da APS, mas que também depende da condição clínica do paciente.", "sha256_texto": "e3ab6eee5aca8ce08135201a1d79c5f722c5d65a7c7f4c129a761d54c2a4fcd1", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00094_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_SECAO_004", "ordem": 16, "transcricao_literal": "Para viabilizar esse atendimento remoto da população pelos profissionais que atuam na APS, o Ministério da Saúde desenvolveu o Consultório Virtual de Saúde da Família em parceria com o Hospital Albert Einstein. Com a plataforma, os profissionais de saúde vão poder atender os usuários que já eram acompanhados na unidade de saúde, assim como responder às demandas", "sha256_texto": "8885fd2ec24db8c87dd931f638a63caefa58ab0cbf081bd2da2b531792ec2640", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00094_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_SECAO_004", "ordem": 17, "transcricao_literal": "espontâneas de maneira mais segura, tendo como exigência a utilização de prontuário eletrônico, para que permita o devido registro das informações pelo profissional, bem como acompanhamento dessas informações pela equipe multiprofissional.", "sha256_texto": "3e1e6ef92183993d98cefb5f857b1b3dd11c5b10be9d1d2709743e7478e40531", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00094_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_PARAGRAFO_TEXTO_012", "normativo": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_SECAO_004", "ordem": 18, "transcricao_literal": "Mesmo que não seja usada a plataforma disponibilizada pelo MS, o Consultório Virtual, as consultas a distância podem ser feitas por telefone, computador ou WhatsApp, levando em consideração a estrutura ofertada pela gestão local e os canais com que os pacientes têm maior afinidade, desde que haja registro das atividades pelo profissional no prontuário eletrônico, seja na modalidade PEC (prontuário eletrônico do cidadão) ou CDS (coleta de dados simplificada).", "sha256_texto": "339a0fef7c467509c836eb64096b9fae18f47b943787f5d116db4c5fe859ba83", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00094_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_PARAGRAFO_TEXTO_013", "normativo": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 7", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_SECAO_004", "ordem": 19, "transcricao_literal": "Os profissionais de saúde que realizarem ações de teleconsulta deverão:", "sha256_texto": "d9fa3f9a5d7d262d7204029ca2c16be983b3f7630f2cc35496ac2d0bfa153521", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00094_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_PARAGRAFO_TEXTO_014", "normativo": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 8", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_SECAO_004", "ordem": 20, "transcricao_literal": "· Atender aos preceitos éticos de beneficência, não maleficência, sigilo das informações e autonomia;", "sha256_texto": "d85c16f2e99ecaf08cb251fcf3e1a7cec2394883bccc5ee0a95f1db9f047c3e1", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00094_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_PARAGRAFO_TEXTO_015", "normativo": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 9", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_SECAO_004", "ordem": 21, "transcricao_literal": "· Observar as normas e orientações do Ministério da Saúde sobre notificação compulsória, em especial as listadas no Protocolo de Manejo Clínico do Coronavírus (Covid-19), disponível no endereço eletrônico do Ministério da Saúde;", "sha256_texto": "252ceefe26e71a50926935117c659e7f7bc4184d262319185f9a7225deb47f6e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00094_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
