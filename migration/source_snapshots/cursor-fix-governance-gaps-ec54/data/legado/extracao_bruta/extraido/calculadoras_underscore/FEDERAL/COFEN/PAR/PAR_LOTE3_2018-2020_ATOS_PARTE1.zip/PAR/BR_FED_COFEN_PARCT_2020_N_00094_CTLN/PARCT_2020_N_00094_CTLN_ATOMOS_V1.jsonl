{"identificador": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_PARAGRAFO_TEXTO_022", "normativo": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 16", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_SECAO_004", "ordem": 28, "transcricao_literal": "· O recurso do programa de apoio à informatização da Atenção Primária pode ser usado para contratação em comodato dos equipamentos que vão permitir a realização dos teleatendimentos;", "sha256_texto": "df1cbe31d098deae04139811580f434d701dfc025a4bde18aadfbf11e780563b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00094_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_PARAGRAFO_TEXTO_023", "normativo": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 17", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_SECAO_004", "ordem": 29, "transcricao_literal": "· Garantir condições para o registro clínico do atendimento no Prontuário Eletrônico do Cidadão.", "sha256_texto": "81533d461f22ffc53bcfa1c037a7f192c470b75df5dabd938a7dc8ed88809c5c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00094_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_PARAGRAFO_TEXTO_024", "normativo": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 18", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_SECAO_004", "ordem": 30, "transcricao_literal": "O projeto, além de viabilizar a plataforma de consultório virtual, deve dar segurança a todos, utilizando assinatura com certificação digital do ICP-Brasil para os profissionais da APS.", "sha256_texto": "b80459303e6463ac636bcc7fdfdcd6decb9923889ec301c36cab79a945dfb9b1", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00094_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_PARAGRAFO_TEXTO_025", "normativo": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 19", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_SECAO_004", "ordem": 31, "transcricao_literal": "Sobre a operacionalização da plataforma, a mesma permitirá aos profissionais da APS registrar a consulta a distância, emitir atestados e receitas e enviar endereço eletrônico para videoconferência com seus pacientes. Os dados serão validados, e o suporte da plataforma fará contato por e-mail ou telefone para a emissão da certificação digital, que será gratuita e com validade de cinco anos.", "sha256_texto": "96cf3866345adf759e7beccb3843510292b1d23e04da74bf8ec061fbd4f92b5b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00094_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_PARAGRAFO_TEXTO_026", "normativo": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 20", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_SECAO_004", "ordem": 32, "transcricao_literal": "A teleconsulta se dará pelo canal com que o paciente tenha mais afinidade, podendo ser realizada por telefone ou videoconferência. A escolha pelo tipo de modalidade de atendimento está condicionada à situação clínica, e cabe a decisão ao profissional e da pessoa a ser atendida. Ao final do atendimento, o paciente receberá no seu e-mail o desfecho e pesquisa de satisfação. O cidadão poderá solicitar o atendimento por demanda espontânea ou programada, fazendo uma solicitação de agendamento de consulta a distância para a equipe de saúde normalmente responsável por seu atendimento.", "sha256_texto": "17ed428bb39083b71400afacfbaf16700c3108cb500912b5160ee6713a25a84b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00094_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_PARAGRAFO_TEXTO_027", "normativo": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 21", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_SECAO_004", "ordem": 33, "transcricao_literal": "Sobre as normativas do Cofen, temos a Resolução nº 634/2020, que autoriza e normatiza, “ad referendum” do Plenário do Cofen a teleconsulta de enfermagem como forma de combate à pandemia provocada pelo novo coronavírus (Sars-Cov-2), mediante consultas, esclarecimentos, encaminhamentos e orientações com uso de meios tecnológicos, e dá outras providências. Nesta Resolução, temos as seguintes definições:", "sha256_texto": "0f34c90bc4485c061bc7b7c939b140f39e5ff086daa1924a7feb35d8bd11a7c9", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00094_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_PARAGRAFO_TEXTO_028", "normativo": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 22", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_SECAO_004", "ordem": 34, "transcricao_literal": "[…]", "sha256_texto": "b94f345ea5affa7e142e643b8126fe247c9c63bd7242bdd33d9231123deede9b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00094_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_ART_002", "normativo": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 2º (citado/transcrito)", "dispositivo_superior": null, "ordem": 35, "transcricao_literal": "Art. 2º Os meios eletrônicos utilizados para a teleconsulta devem ser suficientes para resguardar, armazenar e preservar a interação eletrônica entre o enfermeiro e seu paciente, respeitando-se os preceitos estabelecidos no Código de Ética dos Profissionais da Enfermagem no que tange à integridade, em todos os seus aspectos, das informações resultantes da consulta, que constituirá o registro de atendimento do paciente.", "sha256_texto": "a51842d729195ce2213af4d98259d81517cfa9614a42c2a409166613f64b65f2", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00094_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Artigo citado ou transcrito de outra norma (sequência não inicia em 1 no escopo); não é articulado próprio."}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_ART_002_PAR_UNICO", "normativo": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN", "tipo_dispositivo": "paragrafo_transcrito", "localizador": "Parágrafo único", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_ART_002", "ordem": 36, "transcricao_literal": "Parágrafo único. É de responsabilidade do enfermeiro e/ou da instituição de saúde, a guarda dos registros eletrônicos ou digital em prontuário/formulário específico para teleconsulta.", "sha256_texto": "f27a7f73d13ee593bfda22312ab41749da6c5c3a3ee7a7d2db26e8c35e63f9b4", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00094_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_ART_003", "normativo": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 3º (citado/transcrito)", "dispositivo_superior": null, "ordem": 37, "transcricao_literal": "Art. 3º A teleconsulta deve ser devidamente consentida pelo paciente e ou seu representante legal e realizada por livre decisão e sob responsabilidade profissional do enfermeiro.", "sha256_texto": "0f4e3e0bcda2422b42ee6a253cdb4e3fcb6a46bccf0c220bc2fdb61862c84ec0", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00094_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Artigo citado ou transcrito de outra norma (sequência não inicia em 1 no escopo); não é articulado próprio."}
