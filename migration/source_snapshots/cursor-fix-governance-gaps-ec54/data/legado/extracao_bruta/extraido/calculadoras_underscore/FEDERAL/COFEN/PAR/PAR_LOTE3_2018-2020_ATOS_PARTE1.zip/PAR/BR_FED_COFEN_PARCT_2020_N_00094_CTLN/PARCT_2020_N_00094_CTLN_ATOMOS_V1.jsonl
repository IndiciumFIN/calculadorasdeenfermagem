{"identificador": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00094_CTLN_SECAO_003", "ordem": 9, "transcricao_literal": "O requerente, Rui Teixeira Lima Jr., Consultor Técnico da Coordenação Geral de Garantia dos Atributos da Atenção Primária – Departamento de Saúde da Família/MS, encaminhou via email ao Cofen, consulta se há algum conflito entre a execução do Projeto Consultório Virtual da Saúde", "sha256_texto": "46f03a0347804a191232dfa73a7e1f6fb04f1fcc2a3f1e47eefcbaf1b2e3d704", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00094_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
