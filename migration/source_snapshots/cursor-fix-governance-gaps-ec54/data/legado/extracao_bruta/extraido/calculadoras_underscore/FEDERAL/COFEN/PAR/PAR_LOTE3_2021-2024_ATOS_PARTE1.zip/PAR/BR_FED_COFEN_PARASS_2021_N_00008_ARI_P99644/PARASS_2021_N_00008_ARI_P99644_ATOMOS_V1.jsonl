{"identificador": "BR_FED_COFEN_PARASS_2021_N_00008_ARI_P99644_PARAGRAFO_TEXTO_016", "normativo": "BR_FED_COFEN_PARASS_2021_N_00008_ARI_P99644", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 15", "dispositivo_superior": "BR_FED_COFEN_PARASS_2021_N_00008_ARI_P99644_SECAO_001", "ordem": 21, "transcricao_literal": "A interessada solicita O Termo de Anuência que é um documento emitido pelo Cofen, aceitando o estudo em mídias digitais e finaliz.ado com as entrevistas semi estruturadas com os enfermeiros que aceitarem.", "sha256_texto": "704ca46a41aef462e2b8af38467a13b94b4a6131485fdd794e9a4d1a9c5d286e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2021_N_00008_ARI_P99644_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARASS_2021_N_00008_ARI_P99644_PARAGRAFO_TEXTO_017", "normativo": "BR_FED_COFEN_PARASS_2021_N_00008_ARI_P99644", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 16", "dispositivo_superior": "BR_FED_COFEN_PARASS_2021_N_00008_ARI_P99644_SECAO_001", "ordem": 22, "transcricao_literal": "Caso o Cofen aceite enviar à interessada o Termo de Anuência, estará concordando com a pesquisa e que os enfermeiros entrevistados seráo cientes dessa aprovação e que assume riscos e benefícios da pesquisa. Riscos — invasão de privacidade, revelação de dados gravados de entrevistas. Benefícios — entender como a gestão da pandemia Cocid – 19 impactou na rotina laboral dos profissionais de EnferiTiagem.", "sha256_texto": "7a429b7784b3893df9c62f44e5c57ff1513c40a899cf5a0c65a2c4af543e9d04", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2021_N_00008_ARI_P99644_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARASS_2021_N_00008_ARI_P99644_PARAGRAFO_TEXTO_018", "normativo": "BR_FED_COFEN_PARASS_2021_N_00008_ARI_P99644", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 17", "dispositivo_superior": "BR_FED_COFEN_PARASS_2021_N_00008_ARI_P99644_SECAO_001", "ordem": 23, "transcricao_literal": "Notificamos que sem o termo de anuência do Cofen haverá inviabilidade da pesquisa, pois são exigências do CEP.", "sha256_texto": "decb08f2ee38838f20ee91861623d702f4b0c2b56e5378c46da9cdddb45d5347", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2021_N_00008_ARI_P99644_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
