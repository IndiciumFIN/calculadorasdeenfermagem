{"identificador": "BR_FED_COFEN_PARASS_2021_N_00008_ARI_P99644_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_PARASS_2021_N_00008_ARI_P99644", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_COFEN_PARASS_2021_N_00008_ARI_P99644_SECAO_001", "ordem": 12, "transcricao_literal": "No entanto, frente à pandemia as entrevistas semi estruturadas serão realizadas através de plataforma virtual com o Google Meet e Zoon. Nesse sentido, não existiria um local físico, de modo que qualquer profissional de enfermagem de qualquer região do país poderia participar da pesquisa.", "sha256_texto": "261bee425a1d8b33712ca630cac28073fb21816dd837ddac1571457a9bd66eca", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2021_N_00008_ARI_P99644_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
