{"identificador": "BR_FED_COFEN_PARGT_2017_N_00002_GTAE_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_PARGT_2017_N_00002_GTAE", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARGT_2017_N_00002_GTAE_SECAO_003", "ordem": 13, "transcricao_literal": "Os membros do GTAE reunidos nesta data concluem que o profissional inscrito como REMIDO, são profissionais regularmente inscritos nos Conselhos, podendo exercer a profissão, são alcançados pelo Código de Ética no exercício da profissão, estando apenas isentos de pagamento da anuidade, devendo cumprir todas as obrigações legais e éticas.", "sha256_texto": "b25d8dfdd53124425741eedc2fa8269bc9e706533e210065c5864260638eb7cd", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARGT_2017_N_00002_GTAE_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
