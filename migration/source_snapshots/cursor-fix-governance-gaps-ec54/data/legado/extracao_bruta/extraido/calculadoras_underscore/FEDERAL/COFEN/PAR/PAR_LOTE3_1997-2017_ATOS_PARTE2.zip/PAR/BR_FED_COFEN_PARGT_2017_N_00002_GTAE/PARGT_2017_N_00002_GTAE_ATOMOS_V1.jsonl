{"identificador": "BR_FED_COFEN_PARGT_2017_N_00002_GTAE_PARAGRAFO_TEXTO_001", "normativo": "BR_FED_COFEN_PARGT_2017_N_00002_GTAE", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARGT_2017_N_00002_GTAE_SECAO_001", "ordem": 5, "transcricao_literal": "Através do Oficio Coren-MG/GAB nº 1661/2017 protocolado no Cofen em 07/03/2017, o Presidente do Coren-MG Dr. Marcos Rubio, busca responder consulta formulada por Setor interno do Conselho se o profissional inscrito portador de inscrição Remida é obrigado a votar nas eleições do Coren-MG.", "sha256_texto": "45b5464ed94ce5adb50bdf6e666ddf3b50d9a0ebca4b22c90da2800a96b81d7d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARGT_2017_N_00002_GTAE_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARGT_2017_N_00002_GTAE_PARAGRAFO_TEXTO_002", "normativo": "BR_FED_COFEN_PARGT_2017_N_00002_GTAE", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARGT_2017_N_00002_GTAE_SECAO_001", "ordem": 6, "transcricao_literal": "O Grupo de Trabalho de Acompanhamento Eleitoral-GTAE é órgão de apoio e resposta às dúvidas suscitadas pelos profissionais de enfermagem, instituído pela Portaria Cofen 175/2017, em obediência ao que estabelece o art. 16, V, da Resolução Cofen 523/2017, do Código Eleitoral do Sistema Cofen/Conselhos Regionais de Enfermagem.", "sha256_texto": "e18b671643acffc302e469cc8f6587a885b37df31dbf18355e31a0a275d58a8e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARGT_2017_N_00002_GTAE_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
