{"identificador": "BR_FED_COFEN_PARCT_2020_N_00104_CTLN_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARCT_2020_N_00104_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00104_CTLN_SECAO_003", "ordem": 11, "transcricao_literal": "A questão é de simples solução, uma vez que devemos apenas compreender se o parcelamento da dívida tributária (anuidades e outros) torna o devedor regular perante o COREN.", "sha256_texto": "bb9c65b3456df9b28adc7c90c052c2727ae507b917e9d994b8220a567db47e11", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00104_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
