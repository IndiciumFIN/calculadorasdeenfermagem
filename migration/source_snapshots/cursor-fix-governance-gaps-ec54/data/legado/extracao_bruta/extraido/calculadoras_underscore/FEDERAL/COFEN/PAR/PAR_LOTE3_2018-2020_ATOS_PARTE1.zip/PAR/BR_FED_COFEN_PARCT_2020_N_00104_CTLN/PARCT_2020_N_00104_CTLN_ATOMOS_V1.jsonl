{"identificador": "BR_FED_COFEN_PARCT_2020_N_00104_CTLN_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_PARCT_2020_N_00104_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00104_CTLN_SECAO_003", "ordem": 13, "transcricao_literal": "Conforme art. 151, VI do CTN, a exigibilidade do crédito tributário fica suspensa com o parcelamento do débito, vejamos:", "sha256_texto": "343050e61065f6269d281d98f91c5cb4b67cf4d3a59e12e1b2afd50ace145a6c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00104_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
