{"identificador": "BR_FED_COFEN_PARCT_2022_N_00006_CTLN_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_PARCT_2022_N_00006_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00006_CTLN_SECAO_004", "ordem": 20, "transcricao_literal": "Parecer elaborado por Cleide Mazuela Canavezi, Coren-SP nº 12.721, Rachel Cristine Diniz da Silva, Coren-ES nº 109.251 e Jose Gilmar Costa de Souza Junior – Coren-PE nº 120107 e José Adailton Cruz Pereira, COREN/AC nº 85030.", "sha256_texto": "ded3133dadb73c03da4640a30f8d9cae86e87e805950e0986f70eaab6fca5cf4", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00006_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
