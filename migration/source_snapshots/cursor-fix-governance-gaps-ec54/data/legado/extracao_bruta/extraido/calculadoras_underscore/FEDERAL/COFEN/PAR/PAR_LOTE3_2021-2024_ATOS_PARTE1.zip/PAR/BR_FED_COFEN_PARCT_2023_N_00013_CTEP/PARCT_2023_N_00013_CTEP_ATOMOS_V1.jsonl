{"identificador": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP_PARAGRAFO_TEXTO_002", "normativo": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP_SECAO_001", "ordem": 6, "transcricao_literal": "Trata-se o presente de Solicitação de Registro de Título de especialização técnica de nível médio em “Enfermagem em Centro Obstétrico, Neonatologia e Aleitamento Materno” formulado pela profissional Alessandra da Silva Elias, Técnica de Enfermagem, inscrita no Coren-RS sob o nº 1102347-TEC.", "sha256_texto": "38931e06eb6771b141bde33f1ce82f2c822c2d23f740f62cb007898cd7824940", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00013_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP_SECAO_001", "ordem": 7, "transcricao_literal": "Apresenta a requerente, certificado de Conclusão do Curso de Especialização Técnica em Enfermagem em Centro Obstétrico, Neonatologia e Aleitamento Materno, desenvolvido na modalidade presencial e histórico escolar com carga horária de 360h/a, emitido pela Escola Técnica Cristo Redentor.", "sha256_texto": "2d6c9f8a86a4e5f849e8317b9d572d7ecb26462f66177adabcdc66ffa2e9922c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00013_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP_SECAO_001", "ordem": 8, "transcricao_literal": "Apresenta também o credenciamento da Escola Técnica Cristo Redentor junto ao Conselho Estadual de Educação do Rio Grande do Sul, deliberação nº 302/2021, sob o processo CEEd nº 21/2700-0000223-0 – Especialização Técnica em Enfermagem em Centro Obstétrico, Neonatologia e Aleitamento Materno – eixo tecnológico Ambiente e Saúde.", "sha256_texto": "37f74f041d366ee6923c17539392732f21c9008cde7e41829a8ff6d1f31de5da", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00013_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP_SECAO_001", "ordem": 9, "transcricao_literal": "Diante do requerimento, manifestou-se, via memo 062/2023 – Cofen/DGEP/DIRC, a chefe da Divisão de Inscrição, Registro e Cadastro do Cofen, encaminhando para análise da Câmara Técnica de Educação e Pesquisa – CTEP/Cofen com vistas a emitir parecer.", "sha256_texto": "2b2ff4e07ac5fbbaf5dad8ab3fea49795719eee231541d084e250c0fed556984", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00013_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP_SECAO_001", "ordem": 10, "transcricao_literal": "Motivou o encaminhamento à CTEP, o fato de a Divisão de Inscrição, Registro e Cadastro do Cofen – DIRC/Cofen, entender que a especialidade não está abarcada no rol das áreas de abrangência definidas no anexo da resolução COFEN nº 609/2019, tendo em vista, que segundo a DIRC que, na lista de especialidades previstas para o Técnico de Enfermagem não consta a área de “Enfermagem Obstétrica”. Assim existem dúvidas sobre a possibilidade de se proceder ao seu cadastramento no sistema e ao posterior registro do título.", "sha256_texto": "41e05e86a4c788c3f1aa0e9a3671b7f7da0251fa9cfc3bdf7b489a3cf05d0534", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00013_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP_SECAO_001", "ordem": 11, "transcricao_literal": "Instada a CTEP/Cofen a se manifestar sobre a matéria, passa-se a análise.", "sha256_texto": "2ededa944d399020a09d99523dac1887c188059ef55ceb88d4ff5e73e16152f2", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00013_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP_SECAO_002", "normativo": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP", "tipo_dispositivo": "secao", "localizador": "II. FUNDAMENTAÇÃO E ANÁLISE", "dispositivo_superior": null, "ordem": 12, "transcricao_literal": "II. FUNDAMENTAÇÃO E ANÁLISE", "sha256_texto": "1fa6c01d11b45a48d022c33fbd31cd41a937e29617b1e4ba262dee17fd7e5d52", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00013_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP_SECAO_002", "ordem": 13, "transcricao_literal": "Quanto a legislação que versa sobre a matéria tem-se que a Resolução Cofen nº 609/2019, que atualiza, no âmbito do Sistema Cofen/Conselhos Regionais de Enfermagem, os procedimentos para registro de especialização técnica de nível médio em Enfermagem concedida aos Técnicos de Enfermagem e aos Auxiliares de Enfermagem. Observa-se de pronto que a especialidade não está abarcada no rol das áreas de abrangência definidas no anexo da resolução COFEN nº 609/2019, pois, na lista de especialidades previstas para o Técnico de Enfermagem anexa à norma supracitada, não consta a área de “Enfermagem Obstétrica”.", "sha256_texto": "3bb5c90cd9f0f27eff86176297b27a32c6e9e2b52042cba0f4b2fb82e4515db6", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00013_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP_SECAO_002", "ordem": 14, "transcricao_literal": "Para o devido registro, a Resolução citada prevê a necessidade de carga horária mínima de 300h/a, senão vejamos:", "sha256_texto": "61ff9eb1b7240541de84c4d18300adc9142de75bb74e50645dba9faab738d11d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00013_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP_PARAGRAFO_TRANSCRITO_001", "normativo": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP", "tipo_dispositivo": "paragrafo_transcrito", "localizador": "Parágrafo (transcrito)", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP_SECAO_002", "ordem": 15, "transcricao_literal": "§ 3º Os cursos de especialização para Técnico de Enfermagem e Auxiliar de Enfermagem deverão ter, no mínimo, 300 (trezentas) horas, equivalente a 25% da carga mínima indicada no Catálogo Nacional de Cursos de Nível Técnico para a habilitação profissional a que se vincula, de acordo com a Resolução CNE/CEB nº 06/2012.", "sha256_texto": "c6fe93209a9762e984a5aa69d1926e7a6721c642c9450551f77d0390f339057f", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00013_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP_SECAO_002", "ordem": 16, "transcricao_literal": "Relativo a esse particular, a especialização em questão atende a exigência da Resolução Cofen 609/2019.", "sha256_texto": "7c30ab617a5ab966a7465871b8883b795f0dca08ecb5533a9ec7c3e92bd1f1ca", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00013_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP_SECAO_002", "ordem": 17, "transcricao_literal": "No que tange a ausência da especialidade no rol listado pela norma do Cofen, há previsão do devido procedimento para esse caso. Vejamos:", "sha256_texto": "ab21e44fff54543378edf5ce27c834b63bf18ba8d4be3b8aa2eefb945a1891a2", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00013_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP_ART_004", "normativo": "BR_FED_COFEN_PARCT_2023_N_00013_CTEP", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 4º (citado/transcrito)", "dispositivo_superior": null, "ordem": 18, "transcricao_literal": "Art. 4º O título de especialização será registrado mediante apresentação de:", "sha256_texto": "4d7b9a9c073c9e3f562dc756209491abe96dcd520651395ff497fd123e9bbe74", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00013_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Artigo citado ou transcrito de outra norma (sequência não inicia em 1 no escopo); não é articulado próprio."}
