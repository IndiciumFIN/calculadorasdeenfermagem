{"identificador": "BR_FED_COFEN_PORT_2008_N_00384_EPIGRAFE_001", "normativo": "BR_FED_COFEN_PORT_2008_N_00384", "tipo_dispositivo": "epigrafe", "localizador": "Epígrafe", "dispositivo_superior": null, "ordem": 1, "transcricao_literal": "PORTARIA COFEN Nº. 384 DE 21 DE NOVEMBRO DE 2008", "sha256_texto": "c4e27bc369914ae33e81cd5788aafb1fb8e31b3fc2cdc59b53408b17a084e0c5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2008_N_00384_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2008_N_00384_PREAMBULO_001", "normativo": "BR_FED_COFEN_PORT_2008_N_00384", "tipo_dispositivo": "preambulo", "localizador": "Preâmbulo", "dispositivo_superior": null, "ordem": 2, "transcricao_literal": "O Presidente do Conselho Federal de Enfermagem – COFEN, juntamente com o Primeiro Secretário da Autarquia, no uso de suas atribuições legais e regimentais, com base no Código Eleitoral dos Conselhos de Enfermagem (Resolução COFEN nº 209/1998);", "sha256_texto": "5b609e553cfb4a123cf0f708d13f8828209631dcb752f2ec29328c7b2cf217d0", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2008_N_00384_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2008_N_00384_CONSIDERANDO_001", "normativo": "BR_FED_COFEN_PORT_2008_N_00384", "tipo_dispositivo": "considerando", "localizador": "Considerando 1", "dispositivo_superior": null, "ordem": 3, "transcricao_literal": "CONSIDERANDO que há a intenção de membros da Diretoria desta Autarquia, bem como Conselheiros Federais, de se candidatarem no pleito eleitoral do COFEN, que será realizado no dia 19 de fevereiro de 2009;", "sha256_texto": "a2e51ace58ba1aa795f3d989b5203077fa1ac754825fe8119ec7fd28294a21d7", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2008_N_00384_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2008_N_00384_CONSIDERANDO_002", "normativo": "BR_FED_COFEN_PORT_2008_N_00384", "tipo_dispositivo": "considerando", "localizador": "Considerando 2", "dispositivo_superior": null, "ordem": 4, "transcricao_literal": "CONSIDERANDO ainda o disposto no art. 2º, § 4º do Código Eleitoral dos Conselhos de Enfermagem, e tudo o que mais consta do PAD-COFEN nº 578/2008, baixam as seguintes determinações:", "sha256_texto": "2e2b9e993ad25ebea48a6137126d3f4eb721fdcf086bf5a447cc5b505eb511c7", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2008_N_00384_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2008_N_00384_ART_001", "normativo": "BR_FED_COFEN_PORT_2008_N_00384", "tipo_dispositivo": "artigo", "localizador": "Art. 1º", "dispositivo_superior": null, "ordem": 5, "transcricao_literal": "Art. 1º – Designar as enfermeiras Cleide Mazuela Canavezi – COREN-SP nº 12.721, Simone Florentino Diniz – COREN-PE nº 54.177 e o Conselheiro Federal Suplente Marcelino da Silva Cavalcante – COREN-RO nº 80.619, para integrarem a Comissão Eleitoral do COFEN, sob a presidência do primeiro, para organizar e dirigir os atos eleitorais relativos às eleições para a composição do Plenário do COFEN, Triênio 2009/2012, nos termos do art. 2º, § 5º da Resolução nº 209/1998.", "sha256_texto": "a61de0b05db07cccaac8a258ad507922dd90e26690f9e34b730586ee4d880a77", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2008_N_00384_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2008_N_00384_ART_002", "normativo": "BR_FED_COFEN_PORT_2008_N_00384", "tipo_dispositivo": "artigo", "localizador": "Art. 2º", "dispositivo_superior": null, "ordem": 6, "transcricao_literal": "Art. 2º – À Comissão Eleitoral compete a análise da documentação das chapas concorrentes e seus pedidos de inscrição, observando o disposto no art. 81 da norma eleitoral vigente.", "sha256_texto": "8072c81d81113539010e62e418e8543e3813c47817d4108b860992774772c32c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2008_N_00384_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2008_N_00384_ART_003", "normativo": "BR_FED_COFEN_PORT_2008_N_00384", "tipo_dispositivo": "artigo", "localizador": "Art. 3º", "dispositivo_superior": null, "ordem": 7, "transcricao_literal": "Art. 3º – As demais atribuições da Comissão Eleitoral estão dispostas no Código Eleitoral aprovado pela Resolução COFEN nº 209/1998.", "sha256_texto": "d712210eb3534134d97536d78e421a26322a95550bf43a4fc85e5bf2fdf82121", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2008_N_00384_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
