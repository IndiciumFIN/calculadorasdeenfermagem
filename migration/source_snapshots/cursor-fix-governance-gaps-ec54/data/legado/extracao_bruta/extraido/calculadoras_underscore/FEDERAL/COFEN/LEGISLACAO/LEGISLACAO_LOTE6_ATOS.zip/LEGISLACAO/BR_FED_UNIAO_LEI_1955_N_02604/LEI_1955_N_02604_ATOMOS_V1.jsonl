{"identificador": "BR_FED_UNIAO_LEI_1955_N_02604_ART_005", "normativo": "BR_FED_UNIAO_LEI_1955_N_02604", "tipo_dispositivo": "artigo", "localizador": "Art. 5º", "dispositivo_superior": null, "ordem": 30, "transcricao_literal": "Art.5º. – São atribuições dos auxiliares de enfermagem, enfermeiros práticos e práticos de enfermagem, todas as atividades da profissão, excluídas as constantes nos itens do art. 3, sempre sob orientação médica ou de enfermeiro.", "sha256_texto": "83605f6a12c2ad353fc24ac550e84120314b9e334a5d64e5a7c318bbc2cb15f7", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "LEI_1955_N_02604_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_UNIAO_LEI_1955_N_02604_ART_006", "normativo": "BR_FED_UNIAO_LEI_1955_N_02604", "tipo_dispositivo": "artigo", "localizador": "Art. 6º", "dispositivo_superior": null, "ordem": 31, "transcricao_literal": "Art.6º. – São atribuições das parteiras as demais atividades da enfermagem obstétrica não constantes dos itens do art. 4.", "sha256_texto": "514acddcacff11c501dcf528bd758579d7a97cffb7f918e968e21f24bbc1e20c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "LEI_1955_N_02604_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_UNIAO_LEI_1955_N_02604_ART_007", "normativo": "BR_FED_UNIAO_LEI_1955_N_02604", "tipo_dispositivo": "artigo", "localizador": "Art. 7º", "dispositivo_superior": null, "ordem": 32, "transcricao_literal": "Art.7º. – Só poderão exercer a enfermagem, em qualquer parte do território nacional, os profissionais cujos títulos tenham sido registrados ou inscritos no Departamento Nacional de Saúde ou na repartição sanitária correspondente nos Estados e Territórios.", "sha256_texto": "5529e0465c87b4bcb87a6ced1ce76e1666765428e0479890c9153a8aa84dc4be", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "LEI_1955_N_02604_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_UNIAO_LEI_1955_N_02604_ART_008", "normativo": "BR_FED_UNIAO_LEI_1955_N_02604", "tipo_dispositivo": "artigo", "localizador": "Art. 8º", "dispositivo_superior": null, "ordem": 33, "transcricao_literal": "Art.8º. – O Ministério do Trabalho, Indústria e Comércio só expedirá carteira profissional aos portadores de diplomas, registros ou títulos de profissionais de enfermagem mediante a apresentação do registro dos mesmos no Departamento Nacional de Saúde ou na repartição sanitária correspondente nos Estados e Territórios.", "sha256_texto": "5ef3fbbeb17879911c4716f72b974756d7c45a34e2c3f8f9924781949c0e98c4", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "LEI_1955_N_02604_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_UNIAO_LEI_1955_N_02604_ART_009", "normativo": "BR_FED_UNIAO_LEI_1955_N_02604", "tipo_dispositivo": "artigo", "localizador": "Art. 9º", "dispositivo_superior": null, "ordem": 34, "transcricao_literal": "Art.9º. – Ao Serviço Nacional de Fiscalização da Medicina, órgão integrante do Departamento Nacional de Saúde, cabe fiscalizar, em todo o território nacional, diretamente ou por intermédio das repartições sanitárias correspondentes nos Estados e Territórios, tudo que se relacione com o exercício da enfermagem.", "sha256_texto": "81bc07df5191dd719e71cfb0804a811bbad6e3c4a0ee6473ee5de8d90cda17f0", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "LEI_1955_N_02604_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_UNIAO_LEI_1955_N_02604_ART_010", "normativo": "BR_FED_UNIAO_LEI_1955_N_02604", "tipo_dispositivo": "artigo", "localizador": "Art. 10", "dispositivo_superior": null, "ordem": 35, "transcricao_literal": "Art.10 – Vetado.", "sha256_texto": "9c94f46f572dcba90d175173dddd26bc4442abb2dc8e2d9d7c3bea023fed8dcc", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "LEI_1955_N_02604_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_UNIAO_LEI_1955_N_02604_ART_011", "normativo": "BR_FED_UNIAO_LEI_1955_N_02604", "tipo_dispositivo": "artigo", "localizador": "Art. 11", "dispositivo_superior": null, "ordem": 36, "transcricao_literal": "Art.11 – Dentro do prazo de 120 (cento e vinte) dias da publicação da presente lei, os hospitais, clínicas, sanatórios, casas de saúde, departamentos de saúde e instituições congêneres deverão remeter ao Serviço Nacional de Fiscalização da Medicina a relação pormenorizada dos profissionais de enfermagem, da qual conste idade, nacionalidade, preparo técnico, títulos de habilitação profissional, tempo de serviço de enfermagem e função que exercem.", "sha256_texto": "644fec0303ab5f2da3d33bee1c1dc9bd065e3da54df7f7e8d4b2fa33ed08a00e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "LEI_1955_N_02604_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_UNIAO_LEI_1955_N_02604_ART_012", "normativo": "BR_FED_UNIAO_LEI_1955_N_02604", "tipo_dispositivo": "artigo", "localizador": "Art. 12", "dispositivo_superior": null, "ordem": 37, "transcricao_literal": "Art.12 – Todos os profissionais de enfermagem são obrigados a notificar, anualmente, à autoridade respectiva sua residência e sede de serviço onde exercem atividade.", "sha256_texto": "af0ac984a4641afdb606785b7768807bf60e271e7e8c92f5921d2526cc99d1c4", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "LEI_1955_N_02604_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_UNIAO_LEI_1955_N_02604_ART_013", "normativo": "BR_FED_UNIAO_LEI_1955_N_02604", "tipo_dispositivo": "artigo", "localizador": "Art. 13", "dispositivo_superior": null, "ordem": 38, "transcricao_literal": "Art.13 – O prazo de vigência do Decreto nº 8.778, de 22 de janeiro de 1946, é fixado em 1 (um) ano, a partir da publicação da presente lei.", "sha256_texto": "96a56e545dd265b9a23aeca6878af4ae3a23833569fd15d5571077181a22316e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "LEI_1955_N_02604_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
