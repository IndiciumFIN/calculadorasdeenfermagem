{"identificador": "BR_FED_COFEN_PARASS_2021_N_00008_ARI_PARAGRAFO_TEXTO_002", "normativo": "BR_FED_COFEN_PARASS_2021_N_00008_ARI", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARASS_2021_N_00008_ARI_SECAO_001", "ordem": 7, "transcricao_literal": "A Dra Selda, Diretora Geral do Hospital e Maternidade Frei Damião em Ofício N Q 0261/2020, encaminhado à Presidente do Cofen, Dra Betania Maria Pereira dos Santos, apresentou considerações sobre as instabilidades críticas da Covid 19 e no ofício trouxe como base:", "sha256_texto": "f372cfb51aa401ec9c50cd80e7df108e0be08d940d0778570c9490469f26cc7d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2021_N_00008_ARI_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARASS_2021_N_00008_ARI_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARASS_2021_N_00008_ARI", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARASS_2021_N_00008_ARI_SECAO_001", "ordem": 8, "transcricao_literal": "Que o Hospital e Maternidade Frei Damião (Unidade I e II e 11), é referência para mulheres gestantes e pacientes clínicos suspeitos ou. confirmados para Covid 19, com capacidade instalada de 22 leitos de UTI adulto, 15 leitos de UTI neonatal e 132 Leitos de enfermaria (classificação laranja);", "sha256_texto": "8cd586b7fd71f07a5cb276185b0c8ae659d0fa16bd18d293cbbcc33a16646006", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARASS_2021_N_00008_ARI_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
