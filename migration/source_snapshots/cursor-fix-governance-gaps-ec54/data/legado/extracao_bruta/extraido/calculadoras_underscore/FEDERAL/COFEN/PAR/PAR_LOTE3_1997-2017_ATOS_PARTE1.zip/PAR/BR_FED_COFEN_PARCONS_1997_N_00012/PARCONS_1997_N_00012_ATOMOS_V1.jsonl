{"identificador": "BR_FED_COFEN_PARCONS_1997_N_00012_CONSIDERANDO_001", "normativo": "BR_FED_COFEN_PARCONS_1997_N_00012", "tipo_dispositivo": "considerando", "localizador": "Considerando 1", "dispositivo_superior": "BR_FED_COFEN_PARCONS_1997_N_00012_SECAO_002", "ordem": 19, "transcricao_literal": "CONSIDERANDO a Lei nº 7.498 de 25 de junho de 1986 e o seu Decreto regulamentador 94.406 de 08 de junho de 1987.", "sha256_texto": "a9934bb63999543406493590690deea125aa101a4d054d71c2a75985599a286c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_1997_N_00012_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCONS_1997_N_00012_CONSIDERANDO_002", "normativo": "BR_FED_COFEN_PARCONS_1997_N_00012", "tipo_dispositivo": "considerando", "localizador": "Considerando 2", "dispositivo_superior": "BR_FED_COFEN_PARCONS_1997_N_00012_SECAO_002", "ordem": 20, "transcricao_literal": "CONSIDERANDO que no Programa de Controle do Diabetes Mellitus o teste de glicemia capilar é de vital importância para o diagnóstico e tratamento.", "sha256_texto": "bbc7b04f1384a71abd6e4dd8d210120399de7f8a5addd5096ed05944c7b25b19", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCONS_1997_N_00012_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
