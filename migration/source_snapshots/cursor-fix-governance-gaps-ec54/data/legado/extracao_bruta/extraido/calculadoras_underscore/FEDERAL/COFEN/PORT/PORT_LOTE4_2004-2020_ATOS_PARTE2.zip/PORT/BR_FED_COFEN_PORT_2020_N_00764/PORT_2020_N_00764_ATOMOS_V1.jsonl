{"identificador": "BR_FED_COFEN_PORT_2020_N_00764_PREAMBULO_001", "normativo": "BR_FED_COFEN_PORT_2020_N_00764", "tipo_dispositivo": "preambulo", "localizador": "Preâmbulo", "dispositivo_superior": null, "ordem": 2, "transcricao_literal": "O Presidente do Conselho Federal de Enfermagem – Cofen, no uso de suas atribuições legais e regimentais conferidas na Lei nº 5.905 de 12 de julho de 1973, bem como pelo Regimento Interno da Autarquia, aprovado pela Resolução Cofen nº. 421, de 15 de fevereiro de 2012;", "sha256_texto": "d3e2b33bc393714d3065d70af18850015fd7893a3498ac205db3c039bc181df9", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2020_N_00764_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PORT_2020_N_00764_CONSIDERANDO_001", "normativo": "BR_FED_COFEN_PORT_2020_N_00764", "tipo_dispositivo": "considerando", "localizador": "Considerando 1", "dispositivo_superior": null, "ordem": 3, "transcricao_literal": "CONSIDERANDO que compete ao Conselho Federal de Enfermagem baixar provimentos e expedir instruções, para uniformidade de suas ações e procedimentos, resguardando o seu bom funcionamento, nos termos do art. 8º, inciso IV, da Lei nº 5.905/73;", "sha256_texto": "5a763984b16d0ab824b508d72c9383a1cf7a806b83c881525290874709a4a1bc", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PORT_2020_N_00764_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
