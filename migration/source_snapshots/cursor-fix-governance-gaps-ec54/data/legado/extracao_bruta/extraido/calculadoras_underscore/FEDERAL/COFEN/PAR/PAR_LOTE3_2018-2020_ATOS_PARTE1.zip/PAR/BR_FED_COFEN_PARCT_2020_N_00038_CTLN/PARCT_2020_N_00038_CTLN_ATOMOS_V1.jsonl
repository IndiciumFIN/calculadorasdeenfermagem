{"identificador": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN_SECAO_003", "ordem": 8, "transcricao_literal": "A REQUERENTE Dra. Ana Lucia Telles Fonseca encaminhou, ao Sr. Presidente do Conselho Federal de Enfermagem, Dr. Manoel Carlos Neri da Silva, o Parecer Técnico Fiscal nº 492.003/20, de 20 de maio de 2020, cujo objeto versa acerca do Exercício Profissional de Enfermagem frente à Prescrição Médica Digital, enquanto durar a crise ocasionada pelo coronavírus (SARS-CoV-2), para conhecimento.", "sha256_texto": "fc04e596d768d8432b8d86159f5ed75abb2551b8b541cd55a1285827d19f3194", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00038_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN_SECAO_003", "ordem": 9, "transcricao_literal": "É o relatório, em síntese. Passa-se à análise.", "sha256_texto": "6404752d9e23eb1bbf70ae6d70dd3cdd20ef2b941e5f10b99e4288153687902a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00038_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN_SECAO_004", "normativo": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN", "tipo_dispositivo": "secao", "localizador": "III – DA FUNDAMENTAÇÃO E ANÁLISE", "dispositivo_superior": null, "ordem": 10, "transcricao_literal": "III – DA FUNDAMENTAÇÃO E ANÁLISE", "sha256_texto": "25a54c4c3344607f284b1279878cbe10facdf2a0cc52e3f39b9d124abbf9a3f1", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00038_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN_SECAO_004", "ordem": 11, "transcricao_literal": "A Portaria do Ministério da Saúde nº 467 de 20 de março de 2020, dispõe em caráter excepcional e temporário, sobre as ações de Telemedicina, com o objetivo de regulamentar e operacionalizar as medidas de enfrentamento da emergência de saúde pública de importância internacional previstas no art. 3º da Lei nº 13.979, de 6 de fevereiro de 2020, decorrente da epidemia de COVID-19.", "sha256_texto": "b95997521777a98460a5713a8a9c036b95836489ebb37ab732b19f72808d95f0", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00038_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN_SECAO_004", "ordem": 12, "transcricao_literal": "Em 26 de março de 2020, foi apresentado o Projeto de Lei nº 696, de autoria da Câmara dos Deputados, que deu origem à Lei nº 13.989/2020, sancionada pelo Presidente da República em 16 de abril de 2020.", "sha256_texto": "c96b30406c697962326452bcad7472e050d36bedf4f8808505dd3e6a510d4935", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00038_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN_SECAO_004", "ordem": 13, "transcricao_literal": "A referida Lei, entretanto, foi sancionada com dois vetos ao Projeto de Lei aprovado, sendo um deles a disposição que reconhecia a validade de receitas médicas apresentadas em suporte digital, sejam assinadas eletronicamente ou digitalizadas, sendo dispensada a apresentação do documento em meio físico. O veto teve como fundamento a existência de risco em equiparar a validade de um documento digitalizado ao documento assinado eletronicamente, diante da facilidade de falsificação do primeiro, o que poderia levar ao acesso inadequado a medicamentos de venda controlada.", "sha256_texto": "203f0dc4a924ac2134704fe2f2c61742a526d32b53cac3067956504fb75a7ace", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00038_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN_SECAO_004", "ordem": 14, "transcricao_literal": "Tal cenário leva à pertinente discussão acerca da adequação de referido veto ao cenário legislativo brasileiro atual, bem como com relação à eficácia da Lei de Telemedicina, diante da limitação imposta à emissão de receitas médicas.", "sha256_texto": "4c0756f11d2ac65edb1a20e78d0878e0604a6f68c1cbdbbf9663345b31df165c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00038_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN_SECAO_004", "ordem": 15, "transcricao_literal": "Diante da omissão da Lei de Telemedicina e do fato de que a impossibilidade de emissão de receitas em suporte digital compromete em parte a efetividade da norma, aplicam-se à questão as supramencionadas regras legislativas, das quais se destacam a MP 2.200-2/2001, que trata da assinatura eletrônica, e o Decreto nº 10.278/2020, que regulamentou a digitalização de documentos.", "sha256_texto": "8c52a167a7794e27b1fe450a2294732482ee30e2e0f5fcc236b3a984c2466f2d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00038_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN_SECAO_004", "ordem": 16, "transcricao_literal": "Em face do cenário atual e por interpretação sistemática do ordenamento jurídico, é possível afirmar que é autorizada a emissão de receitas médicas em consultas remotas, desde que tais documentos eletrônicos sejam assinados com certificação ICP-Brasil, conforme requerido pela Portaria nº 467/2020, ou atendam aos demais requisitos estabelecidos no artigo 6º de tal norma, conforme descrito abaixo:", "sha256_texto": "b1c70d92ce4705ed63ef3f29e077b307d1f4e4ce5e001fe4cb6a900de3d74aa1", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00038_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN_ART_006", "normativo": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 6º (citado/transcrito)", "dispositivo_superior": null, "ordem": 17, "transcricao_literal": "Art. 6º A emissão de receitas e atestados médicos à distância será válida em meio eletrônico, mediante:", "sha256_texto": "a472f7f659c54187e18da5a7cb9c9fcc2dcea45c924ec1a085919fb305f94dac", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00038_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Artigo citado ou transcrito de outra norma (sequência não inicia em 1 no escopo); não é articulado próprio."}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN_ART_006_INC_I", "normativo": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN", "tipo_dispositivo": "inciso", "localizador": "Inciso I", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN_ART_006", "ordem": 18, "transcricao_literal": "I – uso de assinatura eletrônica, por meio de certificados e chaves emitidos pela Infraestrutura de Chaves Públicas Brasileira – ICP-Brasil;", "sha256_texto": "fedae47a09313c8da47dfc92778ff5664244e68db0dbda6fb24edd4efe43a171", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00038_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Dispositivo de artigo citado/transcrito."}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN_ART_006_INC_II", "normativo": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN", "tipo_dispositivo": "inciso", "localizador": "Inciso II", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00038_CTLN_ART_006", "ordem": 19, "transcricao_literal": "II – o uso de dados associados à assinatura do médico de tal modo que qualquer modificação posterior possa ser detectável; ou", "sha256_texto": "f81af80274de487853f9923273ffa44da9cb17d05b105df72040b8ebabf0844f", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00038_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Dispositivo de artigo citado/transcrito."}
