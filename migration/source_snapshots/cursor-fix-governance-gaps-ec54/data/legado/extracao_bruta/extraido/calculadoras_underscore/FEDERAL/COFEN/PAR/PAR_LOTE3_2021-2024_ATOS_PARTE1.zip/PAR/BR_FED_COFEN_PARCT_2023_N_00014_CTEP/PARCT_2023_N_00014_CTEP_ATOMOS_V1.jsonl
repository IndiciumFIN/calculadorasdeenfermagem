{"identificador": "BR_FED_COFEN_PARCT_2023_N_00014_CTEP_PARAGRAFO_TEXTO_027", "normativo": "BR_FED_COFEN_PARCT_2023_N_00014_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 22", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00014_CTEP_SECAO_002", "ordem": 35, "transcricao_literal": "Terapias bio-oxidativas: uma alternativa para tratamento do câncer e outras doenças. Disponível em: <https://tribunademinas.com.br/colunas/alice-amaral/17-05-2018/terapias-bio-oxidativas-uma-alternativa-para-tratamento-do-cancer-e-outras-doencas.html>. Acesso em: 25 abr. 2023.", "sha256_texto": "89f339f1593d846d8510b953a31b7c2ebd1f641bc47fb0af7759cd2df135a126", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00014_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
