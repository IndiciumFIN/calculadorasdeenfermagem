{"identificador": "BR_FED_COFEN_PARCT_2022_N_00043_CTLN_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_PARCT_2022_N_00043_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00043_CTLN_SECAO_002", "ordem": 10, "transcricao_literal": "Agência Nacional de Vigilância Sanitária (Anvisa), de acordo com o bulário disponibilizado, indica que o medicamento Noripurum® EV (sacarato de hidróxido férrico) é indicado para anemias ferropênicas graves; distúrbios de absorção gastrointestinal ou impossibilidade de se utilizar a ferroterapia por via oral nos casos de intolerância aos preparados orais de ferro em doenças", "sha256_texto": "9dab10299a94142d18a29f73501275fb1b454cff5ab1a26ad108a5d48940c2a5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00043_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00043_CTLN_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARCT_2022_N_00043_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00043_CTLN_SECAO_002", "ordem": 11, "transcricao_literal": "inflamatórias gastrointestinais e nos casos em que a falta de resposta à ferroterapia seja suspeita de falta de adesão ao tratamento; anemias ferropênicas graves no 30º trimestre da gravidez ou no puerpério; correção da anemia ferropênica no pré-operatório de grandes cirurgias; anemia ferropriva que acompanha a insuficiência renal crônica. (BRASIL, Anvisa, 2009).", "sha256_texto": "b69dad99a7d25f5d40ca997dea496ac3216dbdac92b38c0b244dd525b294b422", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00043_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00043_CTLN_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_PARCT_2022_N_00043_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00043_CTLN_SECAO_002", "ordem": 12, "transcricao_literal": "Entre as contraindicações estão: hipersensibilidade conhecida ao sacarato de hidróxido férrico, ao medicamento Noripurum® ou a qualquer um dos seus excipientes; anemias não ferropênicas; situações de sobrecarga férrica; distúrbios da utilização do ferro. (BRASIL, Anvisa, 2009).", "sha256_texto": "68b9356ce86568cb24bf29a8ebc64296d098fcdd00dd253c5b639cc57c47c1dd", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00043_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
