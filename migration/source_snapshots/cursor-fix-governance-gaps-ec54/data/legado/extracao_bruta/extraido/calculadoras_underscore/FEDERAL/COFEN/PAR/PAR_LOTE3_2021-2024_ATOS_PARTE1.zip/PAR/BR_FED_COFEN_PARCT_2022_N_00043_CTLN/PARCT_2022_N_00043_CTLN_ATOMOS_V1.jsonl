{"identificador": "BR_FED_COFEN_PARCT_2022_N_00043_CTLN_ART_078_INC_III", "normativo": "BR_FED_COFEN_PARCT_2022_N_00043_CTLN", "tipo_dispositivo": "inciso", "localizador": "Inciso III", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00043_CTLN_ART_078", "ordem": 54, "transcricao_literal": "III – CONCLUSÃO Frente ao questionamento da profissional, o posicionamento da CTLN, baseado nos diversos pareceres emanados dos Conselhos Regionais que aprovam a administração do Noripurum® nos diversos cenários da assistência, é unânime em afirmar que compete a equipe de enfermagem a assistência ao paciente durante toda a administração do referido medicamento, mediante prescrição.", "sha256_texto": "ee14e68c2bd49f303cc00b5f18e6912052787f6bf3f8828199b82d1323e95d44", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00043_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Dispositivo de artigo citado/transcrito."}
