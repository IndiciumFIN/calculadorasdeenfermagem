{"identificador": "BR_FED_COFEN_PARCT_2022_N_00043_CTLN_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_PARCT_2022_N_00043_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 7", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00043_CTLN_SECAO_002", "ordem": 16, "transcricao_literal": "administrar por via intravenosa e nunca íntramuscular; administrar a solução por infusão, por injeção endovenosa lenta ou diretamente na linha do dialisador; a solução diluída deve ser marrom e límpida; cada ampola é destinada a uma única aplicação. (BRASIL, Anvisa, 2009).", "sha256_texto": "cba032c5064f6751d5c54e9547009db5d41f1ac7bdc7b664fbe7776aa91b9250", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00043_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
