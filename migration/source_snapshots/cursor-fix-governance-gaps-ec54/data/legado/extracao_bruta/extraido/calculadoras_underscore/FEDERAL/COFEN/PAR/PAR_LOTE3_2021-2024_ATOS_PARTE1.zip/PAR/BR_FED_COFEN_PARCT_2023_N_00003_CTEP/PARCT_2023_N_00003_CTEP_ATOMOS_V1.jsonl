{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_EMENTA", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "ementa", "localizador": "Ementa", "dispositivo_superior": null, "ordem": 6, "transcricao_literal": "Solicitação de parecer quanto a legalidade da participação do Enfermeiro do serviço de saúde como preceptor no acompanhamento dos alunos indígenas do curso de graduação em Enfermagem Intercultural Indígena.", "sha256_texto": "3fbaabfd85ef25108ce6cc0fe2800c9bcab65608ca50cb16c035d4f9af8cf2a9", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_PARAGRAFO_TEXTO_002", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": null, "ordem": 7, "transcricao_literal": "Ilustríssima Sra. Presidente do Conselho Federal de Enfermagem,", "sha256_texto": "c523451e2aa323dbda64e64140e757e32845efe27d16ab1f65e5409032903c53", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_001", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "secao", "localizador": "I. RELATÓRIO", "dispositivo_superior": null, "ordem": 8, "transcricao_literal": "I. RELATÓRIO", "sha256_texto": "be40338beec0b641645a8d566c6af53d269630be331c5fbd2db3f4a98e651bf0", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_001", "ordem": 9, "transcricao_literal": "Trata-se de solicitação, encaminhada via documento eletrônico (e-mail), subscrita pelos professores Vagner Ferreira do Nascimento e Ana Cláudia Pereira Terças Trettel, membros da Comissão de Estruturação Curricular do Curso de Enfermagem Intercultural Indígena Universidade do Estado de Mato Grosso (UNEMAT), campus de Barra do Bugres, em que solicitam parecer quanto a legalidade da participação do Enfermeiro do serviço de saúde como preceptor no acompanhamento dos alunos indígenas do curso de graduação em Enfermagem Intercultural Indígena durante os cinco anos de graduação no quadrilátero assistência-gerenciamento-educação-pesquisa, sabendo-se que o professor da Universidade exercerá o papel de orientador e coordenador das atividades de preceptoria, atuando em estreita parceria com o enfermeiro preceptor no planejamento e realização do processo de ensino-aprendizagem, acompanhamento e avaliações do acadêmico.", "sha256_texto": "dd5c8b6c14989237469a88e6f1267602fa12078af4667813a6c8a83ae76ee162", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_001", "ordem": 10, "transcricao_literal": "Justificam o seu pedido em razão da perspectiva de implantação do curso de Bacharelado em Enfermagem da Universidade do Estado de Mato Grosso (UNEMAT), o qual deverá instituir mudanças no processo de ensino aprendizagem, incorporando práticas de metodologias ativas e ampliando a integração ensino-serviço-comunidade (modalidade formação em serviço).", "sha256_texto": "e28f186c3b892dba8c3d34b1c592e786f322f86c7a6e1c234c8a498a4a080e97", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_001", "ordem": 11, "transcricao_literal": "Acrescentam que o referido curso, já aprovado pelo Parecer 016/2022- AGFD/PROEG/UNEMAT, se trata do curso de Enfermagem Intercultural Indígena e que existe uma forte demanda das comunidades indígenas de Mato Grosso, nos últimos 15 anos, solicitando o oferecimento de um curso de enfermagem exclusivo para este público.", "sha256_texto": "a0510cf69369ec27cc22c73e27d8be4d8b09efa8e8877f8f183e55db5b73f607", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_001", "ordem": 12, "transcricao_literal": "Acrescentam ainda que a preceptoria de enfermagem agregará possibilidades de interação e participação direta na dinâmica ensino-serviço-comunidade, que na medida que oportuniza ricos ambientes de aprendizagem aponta para o estudante indígena os fenômenos e desafios que emergem no cotidiano em saúde, suas necessidades de aprimoramento, criticidade e fundamentos para a tomada de decisão e intervenções.", "sha256_texto": "5c0c129634c1298d43618a03aaadc34e47fab1ae1fb9ed8addf44c546304190f", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_001", "ordem": 13, "transcricao_literal": "Instada esta Câmara Técnica de Educação e Pesquisa – CTEP/Cofen, a se manifestar sobre a matéria, passa-se a análise.", "sha256_texto": "72fa592c2077652b2838c077d8d6316bc272a40ce6dbeb18781fe14df8b799da", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_002", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "secao", "localizador": "II. FUNDAMENTAÇÃO e ANÁLISE", "dispositivo_superior": null, "ordem": 14, "transcricao_literal": "II. FUNDAMENTAÇÃO e ANÁLISE", "sha256_texto": "3279e4c459e5b175c7ff8f08015f05e3a43fdc20fe9687b0b66051a5fe148e41", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_002", "ordem": 15, "transcricao_literal": "Em documento eletrônico, recebido no Setor de Protocolo do Cofen em 06/10/2022 o professor Dr. Vagner Ferreira do Nascimento, da Universidade do Estado de Mato Grosso (UNEMAT) encaminha documento em que este e demais professores pertencentes à Comissão de Estruturação Curricular do Curso de Enfermagem Intercultural Indígena solicitam parecer do Conselho Federal de Enfermagem sobre a legalidade da preceptoria em Enfermagem Intercultural Indígena.", "sha256_texto": "57a8b31caafa29e76cec32da661b01e5b20a61b851e6696dcf05730a74edf1b5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_002", "ordem": 16, "transcricao_literal": "Consideram para tal a Lei 8.080/1990, a Constituição Federal em seu artigo 200, a Portaria 1.111 de 05 de julho de 2005 (MEC) que estabelece que a formação do enfermeiro deve atender as necessidades sociais da saúde, com ênfase no sistema único de saúde (SUS), bem como o conceito de preceptoria proposto pelo Ministério da Saúde:", "sha256_texto": "9ce11cb507cc7936fa9d83dc766bcbb75b4ce18a90dccea899ac885ac7e0616f", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_002", "ordem": 17, "transcricao_literal": "“função de supervisão docente-assistencial por área específica de atuação ou de especialidade profissional, dirigida aos profissionais de saúde com curso de graduação e mínimo de três anos de experiência em área de aperfeiçoamento ou especialidade ou titulação acadêmica de especialização ou de residência, que exerçam atividade de organização do processo de aprendizagem especializado e de orientação técnica aos profissionais ou estudantes, respectivamente em aperfeiçoamento ou especialização ou em estágio ou vivência de graduação ou de extensão.”", "sha256_texto": "aa0a7ee26ab0d336a492551dd30448ecb5d033f1840852f950bc801d18f7f837", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_002", "ordem": 18, "transcricao_literal": "Apontam ainda os requerentes em seu documento que a Universidade do Estado do Mato Grosso já possui a modalidade de preceptoria em saúde tanto para formação de profissionais Enfermeiros como para Médicos, legalizada e implementada com resoluções vigentes de Bolsa Preceptoria Enfermagem — BPEnf (Resolução n.º 041/2017/CONSUNI) e Bolsa Preceptoria Médica – BPMed (Resolução n.º 012/2016 — Ad Referendum do CONSUNI) da UNEMAT.", "sha256_texto": "4f4e15e0b0ef8b37926d820c249b23083c70a5a6babc4b2ae34683b1fbf6fc6d", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_PARAGRAFO_TEXTO_012", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_002", "ordem": 19, "transcricao_literal": "Assinalam também a importância da criação do referido curso, especifico para os povos indígenas da região, visto ser uma demanda antiga desta população e destacam o pioneirismo da UNEMAT na formação superior de indígenas mato-grossenses.", "sha256_texto": "165eda955e0bfb2bd0105e2f8d20115931b65102f62feec3991bb5a57481ecfe", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_PARAGRAFO_TEXTO_013", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_002", "ordem": 20, "transcricao_literal": "Por fim consideram os benefícios advindos da formação profissional em ambiente próprio, com respeito às peculiaridades da população e afirmam que os “enfermeiros podem ser beneficiados com uma formação intercultural, e impactar positivamente na assistência, ao conseguir integrar os diversos saberes e, além disso, agregarem os profissionais às equipes de cuidado legitimado e de referência da comunidade indígena (pajés, curandeiros e parteiras), em prol da integralidade de uma prática transcultural, em que se deixa de considerar tais conhecimentos em dualidade, e sim como essenciais e complementares”.", "sha256_texto": "9e78ecef84031c8b8536476bb989731421389e18c7cbafb681222e639f0614fe", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_PARAGRAFO_TEXTO_014", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 7", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_002", "ordem": 21, "transcricao_literal": "Destaque-se que a solicitação foi submetida a apreciação da Comissão Nacional de Enfermagem em Saúde Intercultural – CONENFSI do Cofen, que após uma série de argumentações, em que destacam a importância e relevância do referido curso, conclui pelo entendimento que “a questão trazida à lume, não possui correspondência com o rol de atribuições desta CONENFSI. A nosso ver, trata-se de matéria afeita a competência da Câmara Técnica de Ensino e Pesquisa – CTEP”.", "sha256_texto": "11dc927c1705eecc190124daa3752beb705a88f8acee05e03b57ba56c2aaea7e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_PARAGRAFO_TEXTO_015", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 8", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_002", "ordem": 22, "transcricao_literal": "Diante da solicitação e dos argumentos expostos pelos requerentes do parecer, avista-se que a dúvida principal situa-se na possibilidade de que os Enfermeiros do serviço, que atuam em unidades de saúde situadas dentro das comunidades indígenas, possam atuar como preceptores de acadêmicos de Enfermagem, em processo de formação, sendo supervisionados ainda por professores da Instituição de Ensino.", "sha256_texto": "bcd4b1e5cc1b503a90ca9cc02e7fae223a2957ccb0f9b127390c4bdcea2b71fb", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_PARAGRAFO_TEXTO_016", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 9", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_002", "ordem": 23, "transcricao_literal": "Nesse sentido tem-se em princípio que a própria normatização citada no documento já responde ao questionamento, visto que citada a Resolução n.º 041/2017/CONSUNI que trata da Bolsa Preceptoria Enfermagem — BPEnf é o documento que regulamenta a questão da preceptoria no âmbito dos cursos de Enfermagem naquela Instituição de Ensino.", "sha256_texto": "2992baf81ad44c12dac78cf40b200fa087751112d5e01e778c49e9eb867ae644", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_PARAGRAFO_TEXTO_017", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 10", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_002", "ordem": 24, "transcricao_literal": "Cabe salientar ainda que as Universidades, conforme previsão do artigo 207 da Constituição Federal, gozam de autonomia didático-científica, administrativa e de gestão financeira e patrimonial, e obedecerão ao princípio de indissociabilidade entre ensino, pesquisa e extensão, portanto não havendo o que se questionar em relação à possibilidade de criação de cursos e nem em relação à edição de normativos que tratem da sua organização didático-pedagógica.", "sha256_texto": "9a351b8eca5a2ca56a5d8f00a6fb0557a68d5e0adcfeda19b6212577032ccb1e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_PARAGRAFO_TEXTO_018", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 11", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_002", "ordem": 25, "transcricao_literal": "Em relação a preocupação dos membros da Comissão de Estruturação Curricular do Curso de Enfermagem Intercultural Indígena Universidade do Estado de Mato Grosso, que são professores/Enfermeiros, consideramos legítima e importante, visto que demonstram total interesse em ofertar um curso com a qualidade que a sociedade merece, bem como em conformidade com os normativos legais e éticos.", "sha256_texto": "aa97fd3942ecc9f01aae37fd085adcfe1a2876b4cc39af4a86f51f141f449fa0", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_PARAGRAFO_TEXTO_019", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 12", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_002", "ordem": 26, "transcricao_literal": "Em assim sendo, compreendem os membros desta Câmara Técnica de Educação e Pesquisa do Cofen que, em princípio, e diante do que fora apresentado pelos requerentes, não se vislumbra nenhuma ilegalidade, desde que seguidos todos os trâmites previstos para a formalização do vínculo entre a Instituição de Ensino e o Enfermeiro do serviço, para a atuação dos Enfermeiros como preceptores dos acadêmicos do curso de Enfermagem Intercultural Indígena a ser implantado.", "sha256_texto": "ff6d956e1a3e1d06b42de9cc3da60941540c743ce577521dce6dd0074967efc5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_003", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "secao", "localizador": "III. CONCLUSÃO", "dispositivo_superior": null, "ordem": 27, "transcricao_literal": "III. CONCLUSÃO", "sha256_texto": "8c7e1360ea68d3681e2ee822aa41aba75cc7f69f87e83a200f76660890666064", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_PARAGRAFO_TEXTO_020", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_003", "ordem": 28, "transcricao_literal": "Considerando a análise dos documentos apresentados que solicitam parecer quanto à legalidade da participação do Enfermeiro do serviço de saúde como preceptor no acompanhamento dos alunos indígenas do curso de graduação em Enfermagem Intercultural Indígena;", "sha256_texto": "b03257a1ecc3b28e8bdb299093c592af17b3610f57d193802197374a638ca5da", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_PARAGRAFO_TEXTO_021", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_003", "ordem": 29, "transcricao_literal": "Considerando a manifestação da Comissão Nacional de Enfermagem em Saúde Intercultural – CONENFSI do Cofen que entendeu não estar no rol de suas atribuições pronunciar-se sobre essa matéria, sugerindo o seu encaminhamento a esta CTEP/Cofen;", "sha256_texto": "ff73fb606314247fac078e5ba55bb4b0f33d2eeb15af13e60062a5808e4c8610", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_PARAGRAFO_TEXTO_022", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_003", "ordem": 30, "transcricao_literal": "Considerando o entendimento de que a questão apresentada se situa na previsão do artigo 207 da CF, que trata da autonomia universitária;", "sha256_texto": "e70d51c72a875caafe85e5d237d1d14f9ef581cfddaec1e7be5f694a9ebee9fe", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_PARAGRAFO_TEXTO_023", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_003", "ordem": 31, "transcricao_literal": "Considerando que a Universidade do Estado do Mato Grosso já possui regramento próprio que disciplina a questão das preceptorias, dentre elas a preceptoria em Enfermagem;", "sha256_texto": "0cd72e5a5d03de7aa615b3529cd1fb62106739d3d0a494863aa3f0c24b4634f6", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_PARAGRAFO_TEXTO_024", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_003", "ordem": 32, "transcricao_literal": "Considerando ser esta Câmara Técnica de Educação e Pesquisa, órgão “permanente de natureza consultiva, propositiva e avaliativa sobre matéria relativa ao exercício da Enfermagem”, segundo Art. 1º do Regimento Interno do Cofen, no entanto, sem competência deliberativa;", "sha256_texto": "2782436d7b7b1c3b0b14727b70a1394644e92facfdeafd1c779059bfa93ae41a", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_PARAGRAFO_TEXTO_025", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_003", "ordem": 33, "transcricao_literal": "Assim nos manifestamos:", "sha256_texto": "4a5d3535f2fae1e034ef47e536ae0e1605eedc14e33f7e23636b0f55ffca081f", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_PARAGRAFO_TEXTO_026", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 7", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_003", "ordem": 34, "transcricao_literal": "Que não se vislumbra qualquer ilegalidade para a atuação de Enfermeiros como preceptores no acompanhamento dos acadêmicos indígenas do curso de graduação em Enfermagem Intercultural Indígena da Universidade do Estado do Mato Grosso, desde que, atendidos todos os normativos vigentes, em especial a Resolução n.º 041/2017/CONSUNI, que trata da Bolsa Preceptoria Enfermagem — BPEnf e legislação educacional vigente sobre o tema.", "sha256_texto": "167d2ceef4665563e9e45701686e10f44d2ddd6b26ab7d1851a3bd2645ad7666", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_PARAGRAFO_TEXTO_027", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 8", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_003", "ordem": 35, "transcricao_literal": "SMJ, é o parecer.", "sha256_texto": "2d0f085f100e9785a43653cdcd90817f899b64b7595ea0e20865e094104b0cf5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_PARAGRAFO_TEXTO_028", "normativo": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 9", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00003_CTEP_SECAO_003", "ordem": 36, "transcricao_literal": "Parecer elaborado por: Dr. Gilvan Brolini, Coren – RR Nº 103.289, Coordenador da CTEP; Dr. Ítalo Rodolfo Silva, Coren – RJ Nº 319.539, Secretário da CTEP e Dr. Jorge Domingos de Sousa Filho, Coren – RO Nº 111.710, membro da CTEP.", "sha256_texto": "215cfae40bec796b697ba1d21f05eeeb9d2d78a2535c57e9d095aa59a9eb62ad", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00003_CTEP_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
