{"identificador": "BR_FED_COFEN_PARCT_2023_N_00008_CTLN_REPUB_ART_008_INC_I_ALI_I_2", "normativo": "BR_FED_COFEN_PARCT_2023_N_00008_CTLN_REPUB", "tipo_dispositivo": "alinea", "localizador": "Alínea i", "dispositivo_superior": "BR_FED_COFEN_PARCT_2023_N_00008_CTLN_REPUB_ART_008_INC_I", "ordem": 36, "transcricao_literal": "i) Discutir com o colega nefrologista consultor sobre a escolha pela terapia de anticoagulação que melhor se aplica ao paciente em questão ii) Definir o paciente como contraindicado ao uso de anticoagulação regional com citrato, com base nos critérios acima iii) Acompanhar o enfermeiro responsável pelo leito na aplicação do protocolo, validando os ajustes quando necessário e realizando intervenções adicionais quando pertinente (por exemplo, acréscimo de anticoagulação sistêmica ou interrupção do uso de citrato na suspeita de acúmulo/toxicidade)", "sha256_texto": "eb051d0fd25507e217e57e04693c138eeb61c10d2b4d76f00c8424d2fa6946a9", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2023_N_00008_CTLN_REPUB_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Dispositivo de artigo citado/transcrito."}
