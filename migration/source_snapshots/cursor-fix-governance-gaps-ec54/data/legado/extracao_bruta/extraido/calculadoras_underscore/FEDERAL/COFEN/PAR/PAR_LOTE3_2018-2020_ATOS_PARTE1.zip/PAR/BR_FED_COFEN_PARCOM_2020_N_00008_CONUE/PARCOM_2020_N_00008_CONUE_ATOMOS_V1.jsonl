{"identificador": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE_CONSIDERANDO_004", "normativo": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE", "tipo_dispositivo": "considerando", "localizador": "Considerando 4", "dispositivo_superior": null, "ordem": 34, "transcricao_literal": "CONSIDERANDO a Portaria no 2.048/02 que aprova o Regulamento Técnico dos Sistemas Estaduais de Urgência e Emergência, e classifica as Unidades Móveis em 6 tipos: (BRASIL, 2002)", "sha256_texto": "c02ee9185be3f5a1e3c737fdfbf907b7d2dc981ffa6e8e45d7eda799a4752b9b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCOM_2020_N_00008_CONUE_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 10", "dispositivo_superior": null, "ordem": 35, "transcricao_literal": "Tipo A – Ambulância de Transporte: Destinada para remoções simples e de caráter eletivo de pacientes em decúbito horizontal de pacientes que não apresentam risco de vida para remoções simples e de caráter eletivo.", "sha256_texto": "ca2055b32bb32546674e4e66b41b205acbf8bdf236c91a3c4de0b06cf6c2aaaa", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCOM_2020_N_00008_CONUE_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 11", "dispositivo_superior": null, "ordem": 36, "transcricao_literal": "Tipo B – Ambulância de Suporte Básico: veículo destinado ao transporte inter- hospitalar de pacientes com risco de vida conhecido e ao atendimento pre?-hospitalar de pacientes com risco de vida desconhecido, não classificado com potencial de necessitar de intervenção médica no local e/ou durante transporte ate? o serviço de destino.", "sha256_texto": "d4c51aad7b8fe6fae5f065a2018a90c2040428084a4aa6edc5f6eec6f5bd1d86", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCOM_2020_N_00008_CONUE_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE_PARAGRAFO_TEXTO_012", "normativo": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 12", "dispositivo_superior": null, "ordem": 37, "transcricao_literal": "Tipo C – Ambulância de Resgate: veículo de atendimento de urgências pre?- hospitalares de pacientes vítimas de acidentes ou pacientes em locais de difícil acesso, com equipamentos de salvamento (terrestre, aquático e em alturas).", "sha256_texto": "945a06c4ec734ae8b2c2ec257ee960901a7b4d6ab88283b0ea8f52be203473ee", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCOM_2020_N_00008_CONUE_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE_PARAGRAFO_TEXTO_013", "normativo": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 13", "dispositivo_superior": null, "ordem": 38, "transcricao_literal": "Tipo D – Ambulância de Suporte Avançado: veículo destinado ao atendimento e transporte de pacientes de alto risco em emergências pre?-hospitalares e/ou de transporte inter-hospitalar que necessitam de cuidados médicos intensivos. Deve contar com os equipamentos médicos necessários para esta função.", "sha256_texto": "5d3256283556c9aaa2c5f32997fa85b0d7f63030da6dce012388dcf317f7ca46", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCOM_2020_N_00008_CONUE_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE_PARAGRAFO_TEXTO_014", "normativo": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 14", "dispositivo_superior": null, "ordem": 39, "transcricao_literal": "Tipo E – Aeronave de Transporte Médico: aeronave de asa fixa ou rotativa utilizada para transporte inter-hospitalar de pacientes e aeronave de asa rotativa para ações de resgate, dotada de equipamentos médicos homologados pelo Departamento de Aviação Civil – DAC.", "sha256_texto": "0f9ca93b144050c338e8d76a6a5670bdad2277f1951c9f7587f341d1c7e1a26b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCOM_2020_N_00008_CONUE_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE_PARAGRAFO_TEXTO_015", "normativo": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 15", "dispositivo_superior": null, "ordem": 40, "transcricao_literal": "Tipo F – Embarcação de Transporte Médico: veículo motorizado aquaviário, destinado ao transporte por via marítima ou fluvial. Deve possuir os equipamentos médicos necessários ao atendimento de pacientes conforme sua gravidade (BRASIL, 2002).", "sha256_texto": "6435feeb1521a70e01fd8097ee08e603e9653feb6d0d935408dc4fb9b86d4da2", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCOM_2020_N_00008_CONUE_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE_CONSIDERANDO_005", "normativo": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE", "tipo_dispositivo": "considerando", "localizador": "Considerando 5", "dispositivo_superior": null, "ordem": 41, "transcricao_literal": "CONSIDERANDO o Capítulo VI da Portaria no 2048/02 que traz a conceituação sobre as transferências e Transporte Inter-Hospitalar e diz que o transporte inter-hospitalar refere-se a? transferência de pacientes entre unidades não hospitalares ou hospitalares de atendimento às urgências e emergências, unidades de diagnóstico, terapêutica ou outras unidades de saúde que funcionem como bases de estabilização para pacientes graves, de caráter público ou privado e tem como principais finalidades:", "sha256_texto": "f8a94dd4de4be40677105f8724429f3655d097948b2f0f7c564edbc9749c91a9", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCOM_2020_N_00008_CONUE_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE_PARAGRAFO_TEXTO_016", "normativo": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 16", "dispositivo_superior": null, "ordem": 42, "transcricao_literal": "A – A transferência de pacientes de serviços de saúde de menor complexidade para serviços de referência de maior complexidade seja para elucidação diagnóstica, internação clínica, cirúrgica ou em unidade de terapia intensiva, sempre que as condições locais de atendimento combinadas a? avaliação clínica de cada paciente assim exigirem;", "sha256_texto": "76cdc405ccb62880e3a7002527894ed440d795bdf3202583d0c35922eba99ca8", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCOM_2020_N_00008_CONUE_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE_PARAGRAFO_TEXTO_017", "normativo": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 17", "dispositivo_superior": null, "ordem": 43, "transcricao_literal": "B – A transferência de pacientes de centros de referência de maior complexidade para unidades de menor complexidade, seja para elucidação diagnóstica, internação clínica, cirúrgica ou em unidade de terapia intensiva, seja em seus municípios de residência ou não, para conclusão do tratamento, sempre que a condição clínica do paciente e a estrutura da unidade de menor complexidade assim o permitirem, com o objetivo de agilizar a utilização dos recursos especializados na assistência aos pacientes mais graves e/ou complexos (BRASIL, 2002).", "sha256_texto": "62ef85f40abe0eaada4bb06fcbe543a4da1926419dc4960b2e4c7dd690dd4b61", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCOM_2020_N_00008_CONUE_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE_CONSIDERANDO_006", "normativo": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE", "tipo_dispositivo": "considerando", "localizador": "Considerando 6", "dispositivo_superior": null, "ordem": 44, "transcricao_literal": "CONSIDERANDO que o transporte inter-hospitalar, em qualquer de suas modalidades, de acordo com a disponibilidade de recursos e a situação clínica do paciente a ser transportado, deve ser realizado em veículos adequados e equipados de acordo com o estabelecido no Capítulo IV da referida Portaria (BRASIL, 2002).", "sha256_texto": "b09668ad8479a3ad90e8ccdc6948f6cd0f41fc0ee49093282d742509eafdade6", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCOM_2020_N_00008_CONUE_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE_ITEM_LISTA_014", "normativo": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE", "tipo_dispositivo": "item_lista", "localizador": "Item de lista 1", "dispositivo_superior": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE_INCISO_005", "ordem": 45, "transcricao_literal": "Da Conclusão", "sha256_texto": "0bf75d6c3cd8048253f6151e977694e7936ad77e09fd9e5bc215e08a42edeafa", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCOM_2020_N_00008_CONUE_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "1"}
{"identificador": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE_PARAGRAFO_TEXTO_018", "normativo": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 18", "dispositivo_superior": null, "ordem": 46, "transcricao_literal": "À luz da legislação que norteia as ações da equipe de enfermagem e considerando a Portaria GM 2048/2002 que classifica os veículos para atendimento pré-hospitalar e/ou transporte de pacientes em 6 tipos (A,B,C,D,E e F), sendo o tipo B “Unidade de Suporte Básico de Vida” composta por técnico ou auxiliar de enfermagem, podem realizar o transporte de pacientes com risco conhecido entre unidades extra hospitalares sem a presença do enfermeiro, desde que, o enfermeiro como sendo responsável pela equipe avalie o paciente quanto ao grau de dependência, antes da realização do transporte:", "sha256_texto": "1679f25bcfdeacc2f52949644f0645cd32d2ac5e59087184dde89b60297636e4", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCOM_2020_N_00008_CONUE_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE_PARAGRAFO_TEXTO_019", "normativo": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 19", "dispositivo_superior": null, "ordem": 47, "transcricao_literal": "Paciente de cuidados mínimos (PCM): recomenda-se que seja realizado pelo Auxiliar de Enfermagem e/ou Técnico de Enfermagem.", "sha256_texto": "cb7d3842e32b6b2782d91e83753cb823746b9bd6033192e7537a3dc030171c82", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCOM_2020_N_00008_CONUE_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE_PARAGRAFO_TEXTO_020", "normativo": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 20", "dispositivo_superior": null, "ordem": 48, "transcricao_literal": "Paciente de cuidados intermediários (PCI): recomenda-se que seja realizado pelo Técnico de Enfermagem.", "sha256_texto": "91dac4bd33e63b03b7eb6531e29e08a0978e3972032e584603d238323cce42e3", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCOM_2020_N_00008_CONUE_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE_PARAGRAFO_TEXTO_021", "normativo": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 21", "dispositivo_superior": null, "ordem": 49, "transcricao_literal": "Compete às gerências de enfermagem das instituições de saúde desenvolver protocolos de acordo com as características de suas rotinas internas, devidamente aprovadas pela Diretoria Técnica da Unidade, bem como estabelecer estratégias e ações voltadas para a segurança do paciente.", "sha256_texto": "ec71c5f9659eaacd284d2ceaac58b2fd3ca00807ba949d97d92dab9335bbe5d3", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCOM_2020_N_00008_CONUE_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE_PARAGRAFO_TEXTO_022", "normativo": "BR_FED_COFEN_PARCOM_2020_N_00008_CONUE", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 22", "dispositivo_superior": null, "ordem": 50, "transcricao_literal": "Além de que qualquer conduta a ser realizada pelo profissional de enfermagem, o mesmo esteja seguro frente a? sua competência técnica, científica, ética e legal, assegurando a pessoa, família e coletividade, livre de danos decorrentes de imperícia, negligência e imprudência.", "sha256_texto": "657ba89d52ddde348f5eb9fd127d3e680e9c6a8d8509001e4a0b4aa9e8b50d6b", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCOM_2020_N_00008_CONUE_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
