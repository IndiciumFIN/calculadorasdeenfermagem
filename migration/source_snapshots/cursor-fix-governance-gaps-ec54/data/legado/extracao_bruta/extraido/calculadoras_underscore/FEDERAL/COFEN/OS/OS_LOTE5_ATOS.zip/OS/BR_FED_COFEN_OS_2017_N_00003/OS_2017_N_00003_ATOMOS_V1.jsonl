{"identificador": "BR_FED_COFEN_OS_2017_N_00003_CONSIDERANDO_001", "normativo": "BR_FED_COFEN_OS_2017_N_00003", "tipo_dispositivo": "considerando", "localizador": "Considerando 1", "dispositivo_superior": null, "ordem": 4, "transcricao_literal": "CONSIDERANDO os termos do Acórdão 2.476/2016-TCU-PLENÁRIO e do Acórdão 1.924/2017-TCU, e seus respectivos relatórios, contendo determinações e orientações sobre a necessidade de se efetuar controle mais eficiente e eficaz, aprimorando dessa forma os processos internos da autarquia, tornando a gestão mais eficiente e voltada para o controle de resultados;", "sha256_texto": "24d9097f9f4c249073dc51661d0d565a6775d3a9e7ebe2887cbe6bd4cd046569", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "OS_2017_N_00003_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
