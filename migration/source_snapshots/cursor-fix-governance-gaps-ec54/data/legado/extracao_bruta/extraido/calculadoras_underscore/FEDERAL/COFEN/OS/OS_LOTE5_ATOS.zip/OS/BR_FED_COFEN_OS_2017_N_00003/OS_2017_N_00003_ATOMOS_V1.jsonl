{"identificador": "BR_FED_COFEN_OS_2017_N_00003_ART_001", "normativo": "BR_FED_COFEN_OS_2017_N_00003", "tipo_dispositivo": "artigo", "localizador": "Art. 1º", "dispositivo_superior": null, "ordem": 8, "transcricao_literal": "Art. 1º Determinar a implantação de controle, preferencialmente na fase antecedente à homologação dos processos de licitação e de contratação, objetivando uma análise completa de todas as fases desses processos, desde a sua abertura.", "sha256_texto": "dfaa10a893ca17fb50be613b2055f4e5e6e4bec90e3edf64fa420483d373df60", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "OS_2017_N_00003_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_OS_2017_N_00003_ART_001_PAR_01", "normativo": "BR_FED_COFEN_OS_2017_N_00003", "tipo_dispositivo": "paragrafo", "localizador": "§ 1º", "dispositivo_superior": "BR_FED_COFEN_OS_2017_N_00003_ART_001", "ordem": 9, "transcricao_literal": "§ 1º A análise a que se refere o caput deste artigo, a ser realizada pela Controladoria-Geral, entre outras rotinas exigidas em lei e em normativos do Conselho Federal de Enfermagem, examinará a conformidade e a legalidade dos processos licitatórios e de contratação, devendo, para tanto, se fundamentar na legislação pertinente, nos Acórdãos do Tribunal de Contas da União e nas orientações dos órgãos de controle.", "sha256_texto": "f2fda0ca43a1e7fb216a7a6dc3f80c91f74a724a9fcb7729a1bf4eb38e9189f3", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "OS_2017_N_00003_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
