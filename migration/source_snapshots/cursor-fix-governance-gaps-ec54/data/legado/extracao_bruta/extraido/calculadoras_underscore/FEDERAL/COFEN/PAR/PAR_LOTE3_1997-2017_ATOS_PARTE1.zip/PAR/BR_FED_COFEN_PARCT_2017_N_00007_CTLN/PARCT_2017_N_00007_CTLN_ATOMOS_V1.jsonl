{"identificador": "BR_FED_COFEN_PARCT_2017_N_00007_CTLN_ITEM_002", "normativo": "BR_FED_COFEN_PARCT_2017_N_00007_CTLN", "tipo_dispositivo": "item", "localizador": "Item 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2017_N_00007_CTLN_SECAO_003", "ordem": 8, "transcricao_literal": "3. Sabe-se que os procedimentos para a efetivação de registros de profissionais no âmbito do Sistema Cofen/Conselhos Regionais estão regulamentados pela Resolução Cofen N° 536/2017, em cujo bojo está instituído o Manual de Procedimentos Administrativos para registro e inscrição de profissionais de enfermagem.", "sha256_texto": "454dc59272c0cc8d52287bc73faba3f2cba118a96b57d5889802dee159921cb3", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2017_N_00007_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "numeracao": "3"}
