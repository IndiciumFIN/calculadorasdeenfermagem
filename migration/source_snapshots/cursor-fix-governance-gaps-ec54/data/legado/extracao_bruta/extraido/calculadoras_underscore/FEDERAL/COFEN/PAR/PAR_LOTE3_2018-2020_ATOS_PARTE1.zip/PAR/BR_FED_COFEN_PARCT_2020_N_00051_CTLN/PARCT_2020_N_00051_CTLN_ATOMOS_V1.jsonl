{"identificador": "BR_FED_COFEN_PARCT_2020_N_00051_CTLN_ITEM_LISTA_004", "normativo": "BR_FED_COFEN_PARCT_2020_N_00051_CTLN", "tipo_dispositivo": "item_lista", "localizador": "Item de lista 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00051_CTLN_PARAGRAFO_TEXTO_004", "ordem": 16, "transcricao_literal": "No Ministério da Educação, a regulamentação sobre o ensino profissional é competência do Conselho Nacional de Educação, através da Câmara de Educação Superior – CES (Nível Superior) e da Câmara de Educação Básica – CEB (Nível Médio). Entretanto constatamos a não existência de normatização específica que verse sobre a matéria, tanto no ensino médio como no ensino superior.", "sha256_texto": "39ae565956a50e023472988a1d1a4e95265429a888329361ee793d86f8e8fffe", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00051_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "1"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00051_CTLN_ITEM_LISTA_005", "normativo": "BR_FED_COFEN_PARCT_2020_N_00051_CTLN", "tipo_dispositivo": "item_lista", "localizador": "Item de lista 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00051_CTLN_PARAGRAFO_TEXTO_004", "ordem": 17, "transcricao_literal": "Inobstante a situação relatada acima, quanto ao nível superior, nos chamou atenção o disposto no artigo 6º da RESOLUÇÃO CNE/CES Nº 3, DE 7 DE NOVEMBRO DE 2001, que institui Diretrizes Curriculares Nacionais do Curso de Graduação em Enfermagem:", "sha256_texto": "be0d371dc7abe3642f0df5dc391baa1707c7e13df922f283f1c46566dea51e52", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00051_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "marcador_lista": "1"}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00051_CTLN_ART_006", "normativo": "BR_FED_COFEN_PARCT_2020_N_00051_CTLN", "tipo_dispositivo": "artigo_transcrito", "localizador": "Art. 6º (citado/transcrito)", "dispositivo_superior": null, "ordem": 18, "transcricao_literal": "Art. 6º Os conteúdos essenciais para o Curso de Graduação em Enfermagem devem estar relacionados com todo o processo saúde-doença do cidadão, da família e da comunidade, integrado à realidade epidemiológica e profissional, proporcionando a integralidade das ações do cuidar em enfermagem. Os conteúdos devem contemplar:", "sha256_texto": "1a0956967ec80d0808af5eb59bfebb9fea8585f5aac09d6253780d33d5d91b4c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00051_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Artigo citado ou transcrito de outra norma (sequência não inicia em 1 no escopo); não é articulado próprio."}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00051_CTLN_ART_006_INC_I", "normativo": "BR_FED_COFEN_PARCT_2020_N_00051_CTLN", "tipo_dispositivo": "inciso", "localizador": "Inciso I", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00051_CTLN_ART_006", "ordem": 19, "transcricao_literal": "I – Ciências Biológicas e da Saúde – incluem-se os conteúdos (teóricos e práticos) de base moleculares e celulares dos processos normais e alterados, da estrutura e função dos tecidos, órgãos, sistemas e aparelhos, aplicados às situações decorrentes do processo saúde-doença no desenvolvimento da prática assistencial de Enfermagem;", "sha256_texto": "762c7bcb5c61ec75ffb0838e08dfd6aab57fae75927e124c514336c77ebb2e18", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00051_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Dispositivo de artigo citado/transcrito."}
{"identificador": "BR_FED_COFEN_PARCT_2020_N_00051_CTLN_ART_006_INC_II", "normativo": "BR_FED_COFEN_PARCT_2020_N_00051_CTLN", "tipo_dispositivo": "inciso", "localizador": "Inciso II", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00051_CTLN_ART_006", "ordem": 20, "transcricao_literal": "II – Ciências Humanas e Sociais – incluem-se os conteúdos referentes às diversas dimensões da relação indivíduo/sociedade, contribuindo para a compreensão dos determinantes sociais, culturais, comportamentais, psicológicos, ecológicos, éticos e legais, nos níveis individual e coletivo, do processo saúde-doença;", "sha256_texto": "26bd322db9055524fbf1fbc5ac51223e8f640527963ef99d8d1a6a9d5a181042", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00051_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "observacao": "Dispositivo de artigo citado/transcrito."}
