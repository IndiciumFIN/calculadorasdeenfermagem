{"identificador": "BR_FED_COFEN_PARCT_2020_N_00051_CTLN_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARCT_2020_N_00051_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2020_N_00051_CTLN_SECAO_003", "ordem": 37, "transcricao_literal": "Parecer elaborado pelo membro da CTLN, Cleide Mazuela Canavezi Coren-SP 12.721 e Jebson Medeiros de Souza, COREN-AC 95.621, com contribuições da coordenadora da CTLN, e dos demais membros da CTLN – Rachel Cristine Diniz da Silva, Coren-ES nº 109251, Bernardo Alem, Coren-RR nº 66.014 e Emília Maria Rodrigues Miranda Damasceno, Coren-TO n. 122.726.", "sha256_texto": "acac357b7df16825ebc365af8781bc1a8b5c1d84be14f478b0bd6b67e709e637", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2020_N_00051_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
