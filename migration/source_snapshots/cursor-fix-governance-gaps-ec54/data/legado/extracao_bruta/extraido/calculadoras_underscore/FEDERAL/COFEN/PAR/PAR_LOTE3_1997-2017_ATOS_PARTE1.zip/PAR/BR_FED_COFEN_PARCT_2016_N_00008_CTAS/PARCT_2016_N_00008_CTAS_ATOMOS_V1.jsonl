{"identificador": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS_SECAO_004", "ordem": 15, "transcricao_literal": "O Decreto n2 94.406/87 que regulamenta a Lei do Exercício Profissional apresenta no art. 10, inciso II, ainda no âmbito das atribuições de técnicos de enfermagem, o seguinte teor:", "sha256_texto": "d57580cb5f1f0013aac9e5c4de16c42bf9008c482c12736afd3f085f1179fa43", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2016_N_00008_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
