{"identificador": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS_PARAGRAFO_TEXTO_013", "normativo": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 10", "dispositivo_superior": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS_SECAO_004", "ordem": 24, "transcricao_literal": "O inciso VII traz a seguinte redação:", "sha256_texto": "c9610a27231dd98b088e51fcab2a7aedeaf6d8c8c19bed161fad86f4f58dacbc", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2016_N_00008_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS_PARAGRAFO_TEXTO_014", "normativo": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 11", "dispositivo_superior": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS_SECAO_004", "ordem": 25, "transcricao_literal": "[…] VII – executar os trabalhos de rotina vinculados à alta de pacientes:", "sha256_texto": "a6efc60b0b2ec07f8a1f71545170d72b3494dc814d898fd702448d6b83a389ab", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2016_N_00008_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS_PARAGRAFO_TEXTO_015", "normativo": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 12", "dispositivo_superior": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS_SECAO_004", "ordem": 26, "transcricao_literal": "As atividades de cuidado ao paciente que envolve a retirada de roupa de cama e montagem do leito dos pacientes são atividades de menor complexidade técnica, de natureza repetitiva, delegadas e supervisionadas pelo enfermeiro, à profissionais de nível médio de enfermagem, estando dentro do conjunto de competências profissionais requeridas a categoria de técnicos e auxiliares de enfermagem, e caracterizam-se como precípuas da profissão e da atenção terapêutica de enfermagem.", "sha256_texto": "b062e04bf38fec4388f422f216108ad2f58b03447af28e71d2fc92998de96de8", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2016_N_00008_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS_PARAGRAFO_TEXTO_016", "normativo": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 13", "dispositivo_superior": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS_SECAO_004", "ordem": 27, "transcricao_literal": "Não se deve pensar que tais atividades são menos relevantes quando se trata de sua execução, pois envolvem a utilização de conhecimentos científicos que resguardem a integridade do paciente e a segurança do ambiente terapêutico na prevenção e controle de infecções hospitalares, portanto sendo sua execução pertinente aos profissionais de enfermagem, que durante sua formação possuem conteúdos específicos que os habilitam para estes procedimentos.", "sha256_texto": "173ac7259052e3ee8ee9eba3143f6be35fbe47409dca3f4a02b3a4b9ebdeb340", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2016_N_00008_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS_SECAO_005", "normativo": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS", "tipo_dispositivo": "secao", "localizador": "III – DO PARECER", "dispositivo_superior": null, "ordem": 28, "transcricao_literal": "III – DO PARECER", "sha256_texto": "dc50ed7a17e1447a5e4d77d19b3335dcabc87e6af18a7d285b051b0b417c7734", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2016_N_00008_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS_PARAGRAFO_TEXTO_017", "normativo": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS_SECAO_005", "ordem": 29, "transcricao_literal": "Considerando as questões que envolvem os riscos e a segurança das pessoas submetidas a cuidados de enfermagem em ambientes hospitalares, deve-se tomar especial atenção e responsabilidade para que estejam garantidos os procedimentos terapêuticos que protejam a vida e a saúde. Neste sentido o recolhimento da roupa de cama suja de pacientes, com posterior destinação em locais corretos para manipulação pelo pessoal de limpeza hospitalar e lavanderia, constitui competência de enfermagem.", "sha256_texto": "ab97bef91d152806ddedab42f02c7486af537520ab850fb4b176c180913fa586", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2016_N_00008_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS_PARAGRAFO_TEXTO_018", "normativo": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS_SECAO_005", "ordem": 30, "transcricao_literal": "Face ao exposto e considerando a legislação pertinente ao exercício profissional de enfermagem, o amparo legal conferido a estes profissionais para a prestação de assistência em ações de proteção à saúde humana, somos de parecer favorável que compete à equipe de enfermagem, a manipulação da roupa de cama de pacien tes em instituições hospitalares públicas, privadas e aquelas caracterizadas como de formação em saúde de nível superior.", "sha256_texto": "9e6fe4f89c404a5d21859c665c5ee44826420f337500d0c352f3d9112dbfd593", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2016_N_00008_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS_PARAGRAFO_TEXTO_019", "normativo": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS_SECAO_005", "ordem": 31, "transcricao_literal": "É o parecer, salvo melhor juízo.", "sha256_texto": "ca26d1fed82fefde9273dd2c3c911667f3dd7c6f9248d1ac34f21332824b7302", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2016_N_00008_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
