{"identificador": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_COFEN_PARCT_2016_N_00008_CTAS_SECAO_004", "ordem": 17, "transcricao_literal": "Já em relação aos demais membros da equipe de enfermagem, a saber, o auxiliar de enfermagem, o Decreto n 94.406/87 apresenta no art. art. 11 inciso III alínea 1 a seguinte redação:", "sha256_texto": "576e7144a0d386245cf2ec26629470a6f0f062960a038112fc361104f85c2976", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2016_N_00008_CTAS_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
