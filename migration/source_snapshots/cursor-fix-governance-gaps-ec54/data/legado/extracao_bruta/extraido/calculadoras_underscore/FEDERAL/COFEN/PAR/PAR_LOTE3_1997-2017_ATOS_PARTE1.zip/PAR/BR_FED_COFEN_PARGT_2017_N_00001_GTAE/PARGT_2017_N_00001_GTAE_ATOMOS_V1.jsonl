{"identificador": "BR_FED_COFEN_PARGT_2017_N_00001_GTAE_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARGT_2017_N_00001_GTAE", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARGT_2017_N_00001_GTAE_SECAO_003", "ordem": 15, "transcricao_literal": "Os membros do GTAE reunido nesta data concluem que não assiste razão nem há fundamentação na questão trazida pelo Presidente do Coren-MG, mantendo o entendimento que pessoas com mesmo vinculo familiar até terceiro grau não poderão compor a mesma chapa com vista às eleições do Sistema Cofen/Conselhos de Enfermagem 2017, pelo princípio da moralidade, pluralidade e transparência.", "sha256_texto": "59adccf6a49774387235b4beb4d10ba6a64434bf87c2223959f4b8f50b3de6cd", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARGT_2017_N_00001_GTAE_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
