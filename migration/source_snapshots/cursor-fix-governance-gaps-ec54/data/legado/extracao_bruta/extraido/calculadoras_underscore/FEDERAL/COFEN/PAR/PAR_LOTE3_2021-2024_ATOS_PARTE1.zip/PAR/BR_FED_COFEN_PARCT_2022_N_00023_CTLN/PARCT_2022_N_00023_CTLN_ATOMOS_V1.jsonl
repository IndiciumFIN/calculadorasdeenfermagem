{"identificador": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": null, "ordem": 5, "transcricao_literal": "Parecer sobre legalidade de exercício profissional técnico voluntário, sem vínculo empregatício para o Enfermeiro RT. O parecer aponta pela ilegalidade da concessão de RT para Enfermeiro que não tenha vínculo empregatício formalizado com a empresa.", "sha256_texto": "3b3b2138bde7b71906ff588751cb0a82822387041b22afd5d018528236b7eb2c", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00023_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_SECAO_001", "normativo": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN", "tipo_dispositivo": "secao", "localizador": "I – DO HISTÓRICO", "dispositivo_superior": null, "ordem": 6, "transcricao_literal": "I – DO HISTÓRICO", "sha256_texto": "0d2dad3a0cba1dfe246253a36acec4e3b54edfc58098f1c10fb4139cffe78930", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00023_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_SECAO_001", "ordem": 7, "transcricao_literal": "Trata-se de solicitação a esta CTLN sobre requerimento de registro da Anotação de Responsabilidade Técnica de Enfermagem para atuação de trabalho voluntário em instituição filantrópica Casa de Pietá, cuja razão social é a Associação de Amparo e Recuperação dos Dependentes Químicos de Três Pontas Minas Gerais – MG.", "sha256_texto": "eddd5347fc852460d05bcc121520d574810953da4a883acc7add914e6d534a72", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00023_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_SECAO_002", "normativo": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN", "tipo_dispositivo": "secao", "localizador": "II – ANÁLISE", "dispositivo_superior": null, "ordem": 8, "transcricao_literal": "II – ANÁLISE", "sha256_texto": "d1dc0c98d26753f1eec9a0821b6a3736cc55c5853d7e5e32724adf3216920c02", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00023_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_SECAO_002", "ordem": 9, "transcricao_literal": "Trata-se de demanda aberta, enviada por correspondência eletrônica (via e-mail) para o Cofen datada em 20 de dezembro de 2021, protocolo Cofen de numeração 16388218832124658730 enviado para a presidência. Alega o interessado que o assunto objeto da demanda é referente a decisão de uma enfermeira, pretender dedicar seu tempo vago, para atuar como responsável técnica voluntária da “Casa de Pietá” do Estado de Minas Gerais, onde por se tratar de uma entidade sem fins lucrativos, sobrevive de doações da comunidade e do trabalho de voluntários que dedicam parte do seu tempo para ajudar pessoas que desejam se libertar dos vícios de drogas e que a entidade possui um funcionário voluntário e a diretoria.", "sha256_texto": "15c5e2cf46a4639e6d38c59b1c3437f7920f65587c0066de1d15c3afe6746f77", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00023_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_PARAGRAFO_TEXTO_006", "normativo": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_SECAO_002", "ordem": 10, "transcricao_literal": "Que teria enviado toda a documentação necessária para o Coren MG, mas que foi informado que seria necessário possuir vínculo empregatício com a instituição, algo que não teriam condições financeiras de cumprir e que a entidade está tentando regularizar sua situação burocrática, e que tal demanda é uma exigência da vigilância sanitária para a obtenção do alvará de funcionamento.", "sha256_texto": "14cca2ffc20902150e34295bc0af299ec76fa43a39f0d2e639080fe995d7a0ab", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00023_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_SECAO_003", "normativo": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN", "tipo_dispositivo": "secao", "localizador": "III – FUNDAMENTAÇÃO", "dispositivo_superior": null, "ordem": 11, "transcricao_literal": "III – FUNDAMENTAÇÃO", "sha256_texto": "b0578697253316495c86a32eb86c6af6c4b921f85ac66abc9a6062061df88daf", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00023_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_PARAGRAFO_TEXTO_007", "normativo": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_SECAO_003", "ordem": 12, "transcricao_literal": "Sobre a matéria e seu arcabouço legal, o Conselho Federal de Enfermagem, no art. 8º, IV, da Lei nº 5.905/73 possui a prerrogativa de baixar provimentos e expedir instruções, para uniformidade de procedimento e bom funcionamento dos Conselhos Regionais;", "sha256_texto": "70637b9f2e6447d52e62990973d28ae99af7fff3aa715c36cbe1c738f0e38aa5", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00023_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_PARAGRAFO_TEXTO_008", "normativo": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_SECAO_003", "ordem": 13, "transcricao_literal": "Conforme o inciso II, art. 22 de seu Regimento Interno, esse órgão possui a função de orientar, disciplinar, normatizar e defender o exercício da profissão de Enfermagem, sem prejuízo das atribuições dos Conselhos Regionais de Enfermagem;", "sha256_texto": "823282c4c9c8171dad780cb1f93c2f846b293fb44e27c0c27d06917a623cdf54", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00023_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_SECAO_003", "ordem": 14, "transcricao_literal": "Em relação a competência desse órgão federal, encontra-se estabelecida no art. 22, inciso X do Regimento Interno do Cofen, de baixar Resoluções, Decisões e demais instrumentos legais no âmbito da Autarquia;", "sha256_texto": "bc595d7e00ba4d7a7e56a03d2eaeb323c85f4f6969a1737429704e4c06be1319", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00023_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_SECAO_003", "ordem": 15, "transcricao_literal": "No que tange a Lei de Nº 7.498, de 25 de junho de 1986, o art. 11, inciso I, alíneas “a”, “b” e “c”, da Lei, e o art. 8º, inciso I, alíneas “a”, “b” e “c”, do Decreto nº 94.406, de 08 de junho de 1987, destacam as atividades desenvolvidas pelo enfermeiro, vindo promover aparato legal para a Resolução que resguarda a Anotação de Responsabilidade Técnica normatizada pelo Cofen de Nº 509/ 2016;", "sha256_texto": "8314e4b3163e09e1bebe0c8682f17cf35d220377e9ea092e1218003547fa3454", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00023_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_PARAGRAFO_TEXTO_011", "normativo": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_SECAO_003", "ordem": 16, "transcricao_literal": "Sobre a Resolução Cofen de Nº 509/ 2016 o Art. 1º normatiza a Anotação de Responsabilidade Técnica, pelo Serviço de Enfermagem, bem como, as atribuições do Enfermeiro Responsável Técnico, embasamento esse, que fundamenta o teor dessa matéria.", "sha256_texto": "6541b35f4b7cdb39aeb9a54092a8ec355be6a44ef270e3ef326ba87974297af7", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00023_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_PARAGRAFO_TEXTO_012", "normativo": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 6", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_SECAO_003", "ordem": 17, "transcricao_literal": "Para fins de entendimento, objetivando ratificar a função do Enfermeiro enquanto Responsável Técnico (RT) esse profissional está incumbido por força de normatização no âmbito do Sistema Cofen/Coren’s de responder por todo serviço de enfermagem de uma instituição. Sendo esse o elo entre o enfermeiro, a empresa/instituição e o Conselho Regional de Enfermagem (Coren). Para que o enfermeiro possa assegurar o elo entre a empresa/instituição e o Conselho Regional de Enfermagem, ele necessita possuir registro no Coren da jurisdição onde ocorre o exercício, nesse caso, o Coren MG. Esse profissional planeja, organiza, coordena, executa e avalia os serviços de enfermagem da instituição, atribuições relativas aos ditames da lei do exercício dos profissionais de enfermagem e para desenvolver as atribuições é imprescindível possuir vínculo empresarial.", "sha256_texto": "6e55e002f483ce8d8daa5de7f677ed7adbeaad1d57c3ca163f2d263a55b9e8d3", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00023_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_PARAGRAFO_TEXTO_013", "normativo": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 7", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_SECAO_003", "ordem": 18, "transcricao_literal": "Nos aspectos relacionados a possuir vínculo empregatício com a empresa, não seria de bom alvitre e legal um profissional responder pelos serviços de Enfermagem sem estar devidamente oficializado. Portanto, deve ser concedido o vínculo empregatício. Passo a descrever o Artigo 7º da Resolução abaixo descriminada.", "sha256_texto": "42f7b3803d0055af244264152833cb0e2c011b89ce81f0667328750013ef8317", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00023_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_PARAGRAFO_TEXTO_014", "normativo": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 8", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_SECAO_003", "ordem": 19, "transcricao_literal": "No Art. 7º da Resolução Cofen de Nº 509/ 2016 cita que os encargos financeiros decorrentes da CRT e ART são de responsabilidade exclusiva da empresa/instituição que designou o enfermeiro para a função de RT, nesse sentido, destacamos a palavra “designou”, onde, salvo melhor juízo, corrobora para uma efetivação de vinculação.", "sha256_texto": "6fec841588784eea823ff1fa9697d103ec491424fd9fc5fc299527880ac53df4", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00023_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_PARAGRAFO_TEXTO_015", "normativo": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 9", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_SECAO_003", "ordem": 20, "transcricao_literal": "Ainda referente ao artigo supracitado, deixa claro a necessidade do vínculo empregatício com a empresa, pois o gestor é quem nomeia o Responsável Técnico de Enfermagem. Para que a empresa responda pelas ações praticadas pelo profissional requer a efetivação do vínculo, pois seria impossível o profissional circular nas dependências de uma unidade de saúde para exercer ações administrativas ou mesmo assistencial, sem a devida anuência ou reconhecimento legal por parte da gestão.", "sha256_texto": "b455d7ea2a7c8ef0b743511dd36952d9aa5c538ceb27f98eab026efc6cf636dc", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00023_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_PARAGRAFO_TEXTO_016", "normativo": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 10", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_SECAO_003", "ordem": 21, "transcricao_literal": "A Resolução Cofen de Nº 509/ 2016 retrata no Parágrafo único que, as instituições públicas e filantrópicas nas quais o enfermeiro RT requerente esteja vinculado, poderão requerer, mediante a comprovação de sua natureza institucional, ao Conselho Regional de Enfermagem a isenção do recolhimento das taxas de ART e emissão de CRT. Nessa perspectiva, entende-se que a empresa que possui essas prerrogativas, pode solicitar a isenção de taxas requeridas pelo o órgão, no entanto, não invalida a efetivação do vínculo empregatício para com o enfermeiro. O enfermeiro, pode desempenhar suas funções de forma gratuita, objetivando contribuir de forma individual ou coletividade nos diversos serviços de saúde, no entanto, em se tratando de Responsabilidade Técnica deve haver um vínculo empresarial, uma vez que existe normativa para essa matéria no Conselho Federal de Enfermagem", "sha256_texto": "62f9ede5a4026cfed8b85ce378ecd19241d7776b0b0bf8af480866eda4fb7015", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00023_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_SECAO_004", "normativo": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN", "tipo_dispositivo": "secao", "localizador": "IV – CONCLUSÃO", "dispositivo_superior": null, "ordem": 22, "transcricao_literal": "IV – CONCLUSÃO", "sha256_texto": "afe4ea5478bb9f3bb84b0bc10f63022dab32fb32885f1abc1a7b54ba03ec57cd", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00023_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_PARAGRAFO_TEXTO_017", "normativo": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 1", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_SECAO_004", "ordem": 23, "transcricao_literal": "Os argumentos utilizados por parte do interessado, referente a liberação da Anotação de Responsabilidade Técnica de Enfermagem, para atuação de trabalho voluntário em instituição filantrópica nome fantasia Casa de Pietá, cuja razão social é a Associação de Amparo e Recuperação dos Dependentes Químicos de três pontas Minas Gerais – MG, não se aplica a essa matéria, pois para que o enfermeiro possa gerenciar o serviço de enfermagem de qualquer instituição de saúde, quer pública, privada ou filantrópica requer uma contratação, para que o serviço possa ser legalizado, sendo esse o vínculo empregatício com a empresa.", "sha256_texto": "463c91bca6cc1e27d87b5fb83788cdc9cdf72b66fdef95a32dd29d38a83cd0ab", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00023_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_PARAGRAFO_TEXTO_018", "normativo": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 2", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_SECAO_004", "ordem": 24, "transcricao_literal": "Nos acostamos a decisão do Coren MG, onde em respeito a ética normativa, aparou a necessidade do vínculo empregatício do Enfermeiro para com a empresa, para assumir a Responsabilidade Técnica de Enfermagem.", "sha256_texto": "02cfb3bbc20afeb10c400823242c64107ae01c9b256854ff6c6d1aa7f6ad4367", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00023_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_PARAGRAFO_TEXTO_019", "normativo": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_SECAO_004", "ordem": 25, "transcricao_literal": "O Enfermeiro pode diante suas disponibilidades de tempo e vontade própria desempenhar ações voluntárias, excetuando a Responsabilidade Técnica, pois essa envolve vínculo empregatício com a empresa.", "sha256_texto": "85b865c6197510fe8a3479c3ac02b43b84c01962c3a3f5df039bd2b249f0a6c6", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00023_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
{"identificador": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_PARAGRAFO_TEXTO_020", "normativo": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2022_N_00023_CTLN_SECAO_004", "ordem": 26, "transcricao_literal": "Ante o exposto, enquanto membros da Câmara Técnica de Legislação e Normas do Conselho Federal de Enfermagem, somos unânimes em ratificar a necessidade do vínculo empregatício do Enfermeiro para com a empresa, diante das razões já fundamentadas nessa matéria.", "sha256_texto": "4a06e6469ac702fc7e4cafac701ec974ae8a2089108a601e85b952931a0dc6c8", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2022_N_00023_CTLN_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO"}
