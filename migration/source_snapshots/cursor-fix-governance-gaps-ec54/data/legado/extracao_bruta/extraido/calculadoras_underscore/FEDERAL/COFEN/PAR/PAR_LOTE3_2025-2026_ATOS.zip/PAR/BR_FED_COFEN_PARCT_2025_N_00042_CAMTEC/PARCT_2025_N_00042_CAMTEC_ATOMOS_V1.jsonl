{"identificador": "BR_FED_COFEN_PARCT_2025_N_00042_CAMTEC_ITEM_004", "normativo": "BR_FED_COFEN_PARCT_2025_N_00042_CAMTEC", "tipo_dispositivo": "item", "localizador": "Item 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2025_N_00042_CAMTEC_SECAO_003", "ordem": 13, "transcricao_literal": "4. É importante salientar que a Organização Mundial da Saúde (OMS) vem estimulando o uso da Medicina Tradicional/Medicina Complementar/Alternativa nos sistemas de saúde de forma integrada às técnicas da medicina ocidental modernas e que em seu documento “Estratégia da OMS sobre Medicina Tradicional 2002-2005” preconizou o desenvolvimento de políticas observando os requisitos de segurança, eficácia, qualidade, uso racional e acesso;", "sha256_texto": "508b5c69d3b70ef201a85c6012245e631f29cb0825f18e3e5a7ed449371292e7", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2025_N_00042_CAMTEC_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "numeracao": "4", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
