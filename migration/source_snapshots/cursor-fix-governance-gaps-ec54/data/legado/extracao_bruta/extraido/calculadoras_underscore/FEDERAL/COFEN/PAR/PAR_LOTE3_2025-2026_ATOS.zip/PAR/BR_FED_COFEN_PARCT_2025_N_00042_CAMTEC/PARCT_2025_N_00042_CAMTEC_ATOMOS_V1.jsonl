{"identificador": "BR_FED_COFEN_PARCT_2025_N_00042_CAMTEC_PARAGRAFO_TEXTO_009", "normativo": "BR_FED_COFEN_PARCT_2025_N_00042_CAMTEC", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_PARCT_2025_N_00042_CAMTEC_SECAO_004", "ordem": 24, "transcricao_literal": "Ventosaterapia, é uma outra forma de estímulo aos pontos da Acupuntura. É um recurso terapêutico que utiliza copos de vidro ou de material plástico, para produzir sucção em pontos específicos do corpo, com fins terapêuticos.", "sha256_texto": "e1af09d7294bedee4f5b258ea3436361d183075fc0a46f8b0914b36c8d2c3419", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2025_N_00042_CAMTEC_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_PARCT_2025_N_00042_CAMTEC_PARAGRAFO_TEXTO_010", "normativo": "BR_FED_COFEN_PARCT_2025_N_00042_CAMTEC", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_PARCT_2025_N_00042_CAMTEC_SECAO_004", "ordem": 25, "transcricao_literal": "Moxabustão, a terapêutica consiste no aquecimento dos pontos de acupuntura por meio da queima de moxa. A moxa é um artefato produzido com uma porção da erva “Artemisia Sinensis” macerada, podendo apresentar-se sob forma de bastão, cones de tamanhos diversos, ou pequenos cilindros, que serão utilizados no procedimento da moxabustão.", "sha256_texto": "f2f23fbff59ebdea532f989e2d92562ed130aba40d9537c47b0439f96dda5013", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "PARCT_2025_N_00042_CAMTEC_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "TEXTO_PDF", "normalizacao": "caixa, acentos, pontuação e espaços"}}
