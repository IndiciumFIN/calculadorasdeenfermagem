{"identificador": "BR_FED_COFEN_OFC_2016_N_00101_PARAGRAFO_TEXTO_003", "normativo": "BR_FED_COFEN_OFC_2016_N_00101", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 3", "dispositivo_superior": "BR_FED_COFEN_OFC_2016_N_00101_SECAO_002", "ordem": 7, "transcricao_literal": "Em aditamento ao nosso Ofício Circular nº 0096/2016/GAB/PRES, de 1º de agosto de 2016, e em cumprimento à deliberação do Plenário desta Instituição em sua 479ª Reunião Ordinária, foi decidida a revogação dos Pareceres Técnico Jurídico do Coren-PE nº 042/2015 e 027/2016 da CTEP/Cofen/2016, da Instituição Residência Saúde.", "sha256_texto": "937e772b89320357b01b0be9979293f4bac37e7b1566b435458ae200aab1178e", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "OFC_2016_N_00101_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "EQUIVALENTE_OCR", "similaridade": 99.7, "cobertura_vocabulario": 0.968, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_OFC_2016_N_00101_PARAGRAFO_TEXTO_004", "normativo": "BR_FED_COFEN_OFC_2016_N_00101", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 4", "dispositivo_superior": "BR_FED_COFEN_OFC_2016_N_00101_SECAO_002", "ordem": 8, "transcricao_literal": "Ressaltamos, decorrente disso, que os diplomas de Cursos Técnicos de Enfermagem na modalidade EAD, inscritos no SISTEC/MEC, sujeitos aos critérios da Resolução CNE/CEB nº 01/2016, portanto legalizados, devem ser registrados pelos Conselhos Regionais de Enfermagem.", "sha256_texto": "e89c62f4e4d7f8b3046483a6106163afa6b5501957182199ebb5aeb49274d372", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "OFC_2016_N_00101_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
{"identificador": "BR_FED_COFEN_OFC_2016_N_00101_PARAGRAFO_TEXTO_005", "normativo": "BR_FED_COFEN_OFC_2016_N_00101", "tipo_dispositivo": "paragrafo_texto", "localizador": "Parágrafo de texto 5", "dispositivo_superior": "BR_FED_COFEN_OFC_2016_N_00101_SECAO_002", "ordem": 9, "transcricao_literal": "Por fim, recomenda-se aos Conselhos Regionais de Enfermagem que acompanhem o desenvolvimento dos pólos de atendimento de instituições EAD em seus Estados e remetam relatórios ao Cofen informando, inclusive, se há o cumprimento da carga horária de atividades EAD. Caso sejam constatadas irregularidades, o Regional deve comunicar à sede da instituição de ensino para que, no prazo legal de 60 (sessenta) dias, adote medidas de correção.", "sha256_texto": "50bc07dda54e2ee2d6e001d454d28a2b1972fa86cdfaea83c845e32b36e17fbd", "fonte_literal": "SITE_COFEN_HTML", "arquivo_fonte": "OFC_2016_N_00101_CONTEUDO_SITE_API.json", "verificacao_estrutura": "SEGMENTACAO_AUTOMATICA", "verificacao_literal": "TEXTO_DO_SITE_REVISAO_HUMANA_PENDENTE", "situacao": "ATOMIZADO_PENDENTE_REVISAO", "conferencia_pdf": {"resultado": "IDENTICO_NORMALIZADO", "similaridade": 100.0, "cobertura_vocabulario": 1.0, "metodo": "OCR", "normalizacao": "caixa, acentos, pontuação e espaços"}}
