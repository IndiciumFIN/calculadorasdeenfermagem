{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "urn:cko:sidecar:candidate:relation_candidate:1.0.0",
  "title": "CKO Candidate relation_candidate",
  "required": [
    "relation_id",
    "subject_id",
    "predicate",
    "object_id",
    "relation_status",
    "target_verified",
    "clinical_release_allowed"
  ],
  "properties": {
    "relation_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "predicate": {
      "type": "string",
      "minLength": 1
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_atom_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope": {
      "type": [
        "string",
        "null"
      ]
    },
    "relation_status": {
      "const": "CANDIDATE"
    },
    "target_verified": {
      "const": false
    },
    "clinical_release_allowed": {
      "const": false
    }
  }
}
