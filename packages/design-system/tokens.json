{
  "theme": "ce_canonical",
  "version": "1.0.0",
  "colors": {
    "primary": "#1A3E74",
    "primary_mid": "#1E4D8C",
    "primary_dark": "#163269",
    "accent_vigente": "#10B981",
    "accent_revogado": "#EF4444",
    "text_main": "#1A202C",
    "text_muted": "#4A5568",
    "background": "#FFFFFF",
    "surface": "#F8FAFC"
  },
  "typography": {
    "font_family": "Inter, system-ui, sans-serif",
    "heading_weight": "600",
    "body_weight": "400"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px"
  },
  "rules": {
    "no_alternative_palettes": true,
    "gradient_only_when_explicit": true,
    "white_background_is_institutional": true,
    "no_tech_effects_by_default": true,
    "layers_are_optional": true
  }
}
